{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cms-auth/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cms-callback/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/now-playing/?$",
			"dest": "_render"
		},
		{
			"src": "^/oz-bali/?$",
			"dest": "_render"
		},
		{
			"src": "^/oz-bandung/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}