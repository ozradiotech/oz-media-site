---
// The footer shared by OZ Bandung and its OZ News pages. Every style uses the same sizes and spacing;
// the styles only change colour, the logo's backing and (Ozubathon) the marigold pinstripe along the top.
interface Props {
	/** Where "Back to top" jumps to: the first section of the page. */
	topHref?: string;
}

import { consentEnabled } from '../lib/analytics-config';

const { topHref = '#top' } = Astro.props;
const columns = [
	{
		title: 'EXPLORE',
		links: [
			{ label: 'OZ NEWS', href: '/oz-bandung/news' },
			{ label: 'ABOUT', href: '/about', external: true },
			{ label: 'PRIVACY POLICY', href: '/privacy-policy', external: true },
		],
	},
	{
		title: 'FOLLOW',
		links: [
			{ label: 'INSTAGRAM', href: 'https://www.instagram.com/ozradiobandung/', external: true },
			{ label: 'TIKTOK', href: 'https://www.tiktok.com/@ozradio', external: true },
			{ label: 'THREADS', href: 'https://www.threads.net/@ozradiobandung', external: true },
		],
	},
	{
		title: 'GET IN TOUCH',
		links: [
			{ label: 'EMAIL', href: 'mailto:ozmedianet.id@gmail.com' },
			{ label: 'WHATSAPP', href: 'https://wa.me/6285111391031', external: true },
		],
	},
];
---

<footer class="site-footer" aria-label="Site footer">
	<div class="site-footer-main">
		<div class="site-footer-brand">
			<a class="site-footer-wordmark" href="/" aria-label="OZ Media home" data-sticker><img src="/images/logo-oz-media.png" alt="OZ Media" width="725" height="197" loading="lazy" decoding="async" /></a>
		</div>
		{columns.map((column) => (
			<div class="site-footer-column">
				<h2>{column.title}</h2>
				{column.links.map((link) => (
					<a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>
				))}
			</div>
		))}
	</div>
	<div class="site-footer-bottom">
		<span>© {new Date().getFullYear()} OZ MEDIA</span>
		{consentEnabled && (
			<p class="site-footer-cookies">
				ANALYTICS COOKIES ARE ONLY SET IF YOU ALLOW THEM
				<button type="button" data-consent-open>COOKIE SETTINGS</button>
			</p>
		)}
		<a href={topHref}>BACK TO TOP ↑</a>
	</div>
</footer>

<style>
	.site-footer {
		padding: clamp(32px, 6vw, 72px) clamp(32px, 6vw, 96px) 18px;
		background: var(--c-footer);
		color: var(--c-on-stage);
		font-family: var(--font-jakarta);
	}

	.site-footer-main,
	.site-footer-bottom {
		width: min(1800px, 100%);
		margin: 0 auto;
	}

	.site-footer-main {
		display: grid;
		grid-template-columns: 1.5fr repeat(3, 1fr);
		gap: clamp(20px, 4vw, 52px);
		padding-bottom: clamp(28px, 5vw, 56px);
	}

	.site-footer-brand {
		max-width: 260px;
	}

	.site-footer-wordmark {
		display: inline-block;
		text-decoration: none;
	}

	/* The logo sits on a cream tab in Retro and straight on the ink in the Ozubathon styles; the padding is
	   kept in both so the logo is the same size either way. */
	.site-footer-wordmark img {
		width: 150px;
		height: auto;
		display: block;
		padding: 5px;
		border-radius: 2px;
		background: var(--c-surface);
		box-sizing: border-box;
	}

	.site-footer-column {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
	}

	.site-footer-column h2 {
		margin: 3px 0 8px;
		color: var(--c-accent);
		font-family: var(--font-jakarta);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.site-footer-column a {
		color: var(--c-footer-muted);
		font-size: 10px;
		line-height: 1.7;
		text-decoration: none;
	}

	.site-footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding-top: 15px;
		border-top: 1px solid rgb(255 255 243 / 18%);
		color: var(--c-footer-muted);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.site-footer-bottom a {
		color: var(--c-on-stage);
		text-decoration: none;
	}

	.site-footer-cookies {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 10px;
		margin: 0;
	}

	.site-footer-cookies button {
		padding: 0;
		border: 0;
		background: none;
		color: var(--c-on-stage);
		font: inherit;
		letter-spacing: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	.site-footer-cookies button:hover,
	.site-footer-cookies button:focus-visible {
		color: var(--c-accent);
	}

	.site-footer-cookies button:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 3px;
	}

	.site-footer-column a:hover,
	.site-footer-column a:focus-visible,
	.site-footer-bottom a:hover,
	.site-footer-bottom a:focus-visible {
		color: var(--c-accent);
	}

	.site-footer a:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 3px;
	}

	/* Ozubathon: a marigold pinstripe along the top, like the ring round the logo's lozenge. */
	:global(:root[data-theme='night']) .site-footer {
		box-shadow: inset 0 2px 0 var(--c-accent), inset 0 5px 0 var(--c-footer), inset 0 6px 0 rgb(var(--ozb-glow, 242 189 87) / 60%);
	}

	:global(:root[data-theme='night']) .site-footer-wordmark img {
		background: none;
	}

	/* The footer is ink in both tones, so links keep the bright marigold on hover in the light one too. */
	:global(:root[data-theme='night'][data-tone='light']) .site-footer {
		--c-accent-strong: var(--c-accent);
	}

	@media (max-width: 650px) {
		.site-footer {
			padding: 32px 18px 18px;
		}

		.site-footer-main {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 24px 16px;
		}

		.site-footer-brand {
			grid-column: 1 / -1;
		}

		.site-footer-bottom {
			align-items: flex-start;
			flex-direction: column;
			gap: 10px;
		}
	}
</style>
