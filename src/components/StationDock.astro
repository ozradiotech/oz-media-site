---
// The mini player. On the OZ News pages, while OZ Bandung's stream plays, the client router (StationRouter.astro)
// carries the station's broadcast panels (data-station in oz-bandung.astro) into the slot below, still playing, and
// OZ Bandung's page script keeps driving them. On OZ Bandung itself (persist={false}) the page script moves the
// station into the slot once the visitor scrolls past the broadcast section, and back as it comes into view again.
// Whenever the slot holds no streaming station, the dock is hidden.
interface Props {
	/** Whether the slot receives the station from the client router (the news pages). OZ Bandung fills it itself. */
	persist?: boolean;
}

const { persist = true } = Astro.props;
---

<aside class="station-dock" data-station-dock aria-label="OZ Radio Bandung player">
	<div class="station-dock-bar">
		<a class="station-dock-link" href="/oz-bandung#listen"><span class="station-dock-dot" aria-hidden="true"></span>OZ RADIO BANDUNG</a>
		<button class="station-dock-stop" type="button" data-station-stop aria-label="Stop the stream">
			<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
		</button>
	</div>
	{persist ? <div data-station-placeholder data-station-dock-slot transition:persist="oz-station"></div> : <div data-station-dock-slot></div>}
</aside>

<style is:global>
	/* Shown only while the carried-in station is streaming (OZ Bandung's script sets data-streaming on it). */
	.station-dock {
		position: fixed;
		z-index: 60;
		right: 20px;
		bottom: 20px;
		width: 340px;
		overflow: hidden;
		border: var(--box-border, 1px solid #000000);
		border-radius: var(--box-radius, 14px);
		background: var(--c-stage);
		color: var(--c-on-stage);
		box-shadow: var(--box-shadow);
		font-family: var(--font-jakarta, Arial, sans-serif);
		animation: station-dock-in 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.station-dock:not(:has([data-station][data-streaming])) {
		display: none;
	}

	.station-dock-bar {
		min-height: 36px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 0 6px 0 14px;
		border-bottom: 1px solid rgb(255 255 243 / 14%);
	}

	.station-dock-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--c-on-stage);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-decoration: none;
	}

	.station-dock-link:hover,
	.station-dock-link:focus-visible {
		color: var(--c-accent);
	}

	.station-dock-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--c-signal, #f2bd57);
		box-shadow: 0 0 0 3px rgb(242 189 87 / 22%);
	}

	.station-dock-stop {
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--c-on-stage-muted);
		cursor: pointer;
	}

	.station-dock-stop svg {
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 2.2;
	}

	.station-dock-stop:hover,
	.station-dock-stop:focus-visible {
		background: rgb(255 255 243 / 10%);
		color: var(--c-on-stage);
	}

	.station-dock-link:focus-visible,
	.station-dock-stop:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 2px;
	}

	/* The carried-in panels. Only the playing one is shown; the listener count stays on the station page. */
	.station-dock .broadcast-panel[hidden],
	.station-dock .listener-stats {
		display: none;
	}

	.station-dock .audio-bar {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 14px;
	}

	.station-dock .audio-bar .icon {
		color: var(--c-accent);
		font-size: 20px;
	}

	.station-dock .audio-copy {
		min-width: 0;
		flex: 1;
		display: grid;
		gap: 2px;
		font-size: 12px;
	}

	.station-dock .audio-copy strong {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.station-dock .audio-copy span {
		color: var(--c-on-stage-muted);
	}

	.station-dock .audio-player {
		width: 100%;
	}

	.station-dock .audio-player audio {
		width: 100%;
		height: 36px;
	}

	/* With Video.js the player carries the track itself, on one row: play, now playing, live badge. */
	.station-dock .audio-bar.has-videojs > :not(.audio-player) {
		display: none;
	}

	.station-dock .video-js.vjs-oz {
		--oz-surface: #141412;
		--oz-ink: #FFFFF3;
		--oz-muted: #A8A89C;
		--oz-line: rgb(255 255 243 / 18%);
		--oz-accent-soft: rgb(242 189 87 / 18%);

		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-rows: auto;
		grid-template-areas: 'play info live';
		gap: 0 12px;
	}

	.station-dock .vjs-oz .vjs-play-control {
		width: 40px;
		height: 40px;
	}

	.station-dock .vjs-oz .oz-waveform,
	.station-dock .vjs-oz .vjs-volume-panel {
		display: none;
	}

	.station-dock .vjs-oz .oz-track-title {
		font-size: 13px;
	}

	.station-dock .video-frame {
		aspect-ratio: 16 / 9;
		background: #000000;
	}

	.station-dock .video-frame iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.station-dock .video-placeholder {
		display: none;
	}

	@media (max-width: 560px) {
		.station-dock {
			right: 12px;
			bottom: 12px;
			left: 12px;
			width: auto;
		}

		/* Video stays a corner thumbnail, so the article remains readable around it. */
		.station-dock:has([data-station][data-streaming='video']) {
			left: auto;
			width: min(240px, 62vw);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.station-dock {
			animation: none;
		}
	}

	@keyframes station-dock-in {
		from {
			opacity: 0;
			translate: 0 16px;
		}
	}
</style>
