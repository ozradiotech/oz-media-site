---
// Goes in <head>: applies the stored site style before first paint, so the page never flashes the wrong one.
import '../styles/themes.css';

// The style a first-time visitor sees: 'night' (the Ozubathon style on OZ Bandung), 'day' (its light take) or 'retro'.
// Visitors who have already picked a style from the menu keep their own choice.
const defaultTheme = 'day';
const themeColors = { retro: '#FFFFF3', night: '#0E0D0B', day: '#FBF5E6' };
---

<meta name="theme-color" content={themeColors[defaultTheme]} data-theme-color />
<script is:inline define:vars={{ defaultTheme, themeColors }}>
	(() => {
		const known = (value) => value === 'night' || value === 'day' || value === 'retro';
		// ?theme=night (or day, or retro) in the URL picks a style and remembers it, so a style can be shared as a link.
		let theme = new URLSearchParams(location.search).get('theme');
		try {
			if (known(theme)) localStorage.setItem('oz-theme', theme);
			else theme = localStorage.getItem('oz-theme');
		} catch {}
		if (!known(theme)) theme = defaultTheme;
		document.querySelector('[data-theme-color]')?.setAttribute('content', themeColors[theme]);
		if (theme === 'retro') return;
		// Day shares night's layout and swaps in a light palette.
		document.documentElement.dataset.theme = 'night';
		if (theme === 'day') document.documentElement.dataset.tone = 'light';
	})();
	// Pages with the client router (StationRouter.astro) take the next page's <html> attributes on navigation; hand
	// the style over first, so the new page never flashes the wrong one.
	document.addEventListener('astro:before-swap', (event) => {
		const { theme, tone } = document.documentElement.dataset;
		const next = event.newDocument;
		if (theme) next.documentElement.dataset.theme = theme;
		if (tone) next.documentElement.dataset.tone = tone;
		const color = document.querySelector('[data-theme-color]')?.getAttribute('content');
		if (color) next.querySelector('[data-theme-color]')?.setAttribute('content', color);
	});
</script>
