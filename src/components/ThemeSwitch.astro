---
// Switch between the Retro (default) and Night Shift site styles. The choice is remembered per browser.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<button class:list={['theme-switch', className]} type="button" role="switch" aria-checked="false" aria-label="Night Shift style" title="Switch site style" data-theme-switch>
	<span class="theme-switch-label" aria-hidden="true">
		<span class="theme-switch-name theme-switch-name-retro">RETRO</span>
		<span class="theme-switch-name theme-switch-name-night">NIGHT</span>
	</span>
	<span class="theme-switch-track" aria-hidden="true">
		<span class="theme-switch-knob">
			<svg viewBox="0 0 24 24" width="12" height="12"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
		</span>
	</span>
</button>

<style>
	.theme-switch {
		min-height: 40px;
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 9px;
		padding: 0 4px 0 10px;
		border: 1px solid transparent;
		border-radius: 999px;
		background: none;
		color: var(--c-text);
		font: inherit;
		cursor: pointer;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		transition: border-color 180ms ease, background-color 180ms ease;
	}

	.theme-switch:hover {
		border-color: var(--c-line);
	}

	.theme-switch:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 2px;
	}

	/* Both names share one slot, so the switch keeps its width when the label changes. */
	.theme-switch-label {
		display: grid;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.theme-switch-name {
		grid-area: 1 / 1;
		text-align: right;
		transition: opacity 180ms ease, translate 180ms ease;
	}

	.theme-switch-name-night,
	.theme-switch[aria-checked='true'] .theme-switch-name-retro {
		opacity: 0;
		translate: 0 4px;
	}

	.theme-switch[aria-checked='true'] .theme-switch-name-night {
		opacity: 1;
		translate: 0 0;
	}

	.theme-switch-track {
		position: relative;
		width: 44px;
		height: 24px;
		flex: none;
		border: 1.5px solid var(--c-outline);
		border-radius: 999px;
		background: var(--c-surface);
		transition: background-color 220ms ease, border-color 220ms ease;
	}

	.theme-switch-knob {
		position: absolute;
		top: 2px;
		left: 2px;
		width: 17px;
		height: 17px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--c-accent);
		box-shadow: 0 0 0 1.5px var(--c-outline);
		color: var(--c-on-accent);
		transition: translate 260ms cubic-bezier(0.3, 1.4, 0.5, 1), box-shadow 220ms ease;
	}

	.theme-switch-knob svg {
		fill: currentColor;
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.theme-switch[aria-checked='true'] .theme-switch-track {
		border-color: var(--c-accent);
		background: var(--c-stage);
	}

	.theme-switch[aria-checked='true'] .theme-switch-knob {
		translate: 20px 0;
		box-shadow: 0 0 12px rgb(242 189 87 / 70%);
	}

	.theme-switch[aria-checked='true'] .theme-switch-knob svg {
		opacity: 1;
	}

	:global(:root[data-theme='night']) .theme-switch-label {
		font-family: var(--font-mono);
		font-weight: 400;
	}

	@media (max-width: 650px) {
		.theme-switch {
			min-width: 44px;
			min-height: 44px;
			justify-content: center;
			padding: 0;
		}

		.theme-switch-label {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-switch-name,
		.theme-switch-knob,
		.theme-switch-track {
			transition: none;
		}
	}
</style>

<script>
	const THEME_KEY = 'oz-theme';
	const NIGHT_COLOR = '#0E0D0B';
	const RETRO_COLOR = '#FFFFF3';
	const root = document.documentElement;
	const switches = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-switch]'));

	const isNight = () => root.dataset.theme === 'night';

	const sync = () => {
		switches.forEach((button) => button.setAttribute('aria-checked', String(isNight())));
		document.querySelector('[data-theme-color]')?.setAttribute('content', isNight() ? NIGHT_COLOR : RETRO_COLOR);
	};

	const apply = (night: boolean) => {
		if (night) root.dataset.theme = 'night';
		else delete root.dataset.theme;
		sync();
	};

	const store = (night: boolean) => {
		try {
			localStorage.setItem(THEME_KEY, night ? 'night' : 'retro');
		} catch {}
	};

	switches.forEach((button) => {
		button.addEventListener('click', () => {
			const night = !isNight();
			store(night);
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!document.startViewTransition || reducedMotion) {
				apply(night);
				return;
			}
			// Sweep the new style in as a circle growing from the switch.
			const box = button.getBoundingClientRect();
			const x = box.left + box.width / 2;
			const y = box.top + box.height / 2;
			root.style.setProperty('--theme-x', `${x}px`);
			root.style.setProperty('--theme-y', `${y}px`);
			root.style.setProperty('--theme-r', `${Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))}px`);
			root.classList.add('is-theme-switching');
			const transition = document.startViewTransition(() => apply(night));
			transition.finished.finally(() => root.classList.remove('is-theme-switching'));
		});
	});

	// Keep other open tabs in step.
	window.addEventListener('storage', (event) => {
		if (event.key === THEME_KEY) apply(event.newValue === 'night');
	});

	sync();
</script>
