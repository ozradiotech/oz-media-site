---
import { Font } from 'astro:assets';
import '../styles/typography.css';
import '../styles/page-transitions.css';
import '../styles/retro.css';
import SectionNav from '../components/SectionNav.astro';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import BandungRibbon from '../components/BandungRibbon.astro';
import { getCollection, render } from 'astro:content';
import { ageRanges } from '../lib/listener';

const audioStreamUrl = 'https://streaming.ozradio.id:8443/ozbandung';
// Livestream: set videoId to embed one live broadcast, or channelId (UC…) to embed whatever that channel is
// streaming right now. videoId wins when both are set; leave both empty to show the placeholder.
const youtubeLive = { videoId: 'WNDcep4MWBE', channelId: '@edwintismail2020' };
const youtubeLiveEmbedUrl = youtubeLive.videoId
	? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeLive.videoId)}`
	: youtubeLive.channelId
		? `https://www.youtube-nocookie.com/embed/live_stream?channel=${encodeURIComponent(youtubeLive.channelId)}`
		: '';
const youtubeChannelUrl = 'https://www.youtube.com/@OZMEDIANET';
const youtubeVideos = [
	{ id: 'UDmfDJTzg4w', title: 'Featured video' },
	{ id: 'dn73m2_u71E', title: 'Studio session' },
	{ id: 'ZStRwkoiTQY', title: 'Live set' },
];
const instagramUrl = 'https://www.instagram.com/ozradiobandung';
const tiktokUrl = 'https://www.tiktok.com/@ozradio';
const threadsUrl = 'https://www.threads.net/@ozradiobandung';

const [programs, announcers, activities, news] = await Promise.all([
	getCollection('programs'),
	getCollection('announcers'),
	getCollection('activities'),
	getCollection('news'),
]);
const orderedPrograms = programs.sort((a, b) => a.data.order - b.data.order);
const orderedAnnouncers = announcers.sort((a, b) => a.data.order - b.data.order);
const orderedActivities = activities.sort((a, b) => a.data.order - b.data.order);
const orderedNews = news.sort((a, b) => {
	const dateDifference = (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0);
	return dateDifference || a.data.title.localeCompare(b.data.title);
});
const hostsById = new Map(orderedAnnouncers.map((announcer) => [announcer.id, announcer]));
const programsWithBody = await Promise.all(orderedPrograms.map(async (entry) => ({
	entry,
	Content: (await render(entry)).Content,
})));
const announcersWithBody = await Promise.all(orderedAnnouncers.map(async (entry) => ({
	entry,
	Content: (await render(entry)).Content,
})));
const activitiesWithBody = await Promise.all(orderedActivities.map(async (entry) => ({
	entry,
	Content: (await render(entry)).Content,
})));
const newsWithBody = await Promise.all(orderedNews.map(async (entry) => ({
	entry,
	Content: (await render(entry)).Content,
})));
const featuredNews = newsWithBody;

// Unsplash serves resized images on request; CMS uploads in /public are served as-is.
const optimizeImageUrl = (src: string, width: number) => {
	if (!src.startsWith('https://images.unsplash.com/')) return src;
	const url = new URL(src);
	url.searchParams.set('w', String(width));
	url.searchParams.set('q', '75');
	url.searchParams.set('auto', 'format');
	return url.toString();
};

// Ozubathon: the anniversary livestream marathon, shown by the night style only. `start` drives the countdown, the
// live hour counter and the wrap-up message; `dateLabel` is what the page prints, so it can stay vague until the date is set.
const ozubathon = {
	start: '2026-12-23T19:00:00+07:00',
	hours: 55,
	dateLabel: '23 DECEMBER 2026',
};
const ozubathonStartMs = Date.parse(ozubathon.start);
const ozubathonUntil = Math.max(0, ozubathonStartMs - Date.now());
const ozubathonInitial = {
	days: Math.floor(ozubathonUntil / 86400000),
	hours: Math.floor(ozubathonUntil / 3600000) % 24,
	minutes: Math.floor(ozubathonUntil / 60000) % 60,
	seconds: Math.floor(ozubathonUntil / 1000) % 60,
};
const pad2 = (value: number) => String(value).padStart(2, '0');
const tickerPhrases = ['55 LOUD AND LIVE', 'OZUBATHON', `${ozubathon.hours} HOURS NONSTOP`, 'OZ RADIO BANDUNG ANNIVERSARY'];

const sections = [
	{ id: 'listen', label: 'ON AIR' },
	{ id: 'programs', label: 'PROGRAMS' },
	{ id: 'announcer', label: 'ANNOUNCER' },
	{ id: 'online', label: 'ONLINE' },
	{ id: 'activities', label: 'ON GROUND' },
	{ id: 'news', label: 'OZ-NEWS' },
	{ id: 'contact', label: 'CONTACT' },
];
---

<!doctype html>
<html lang="en" data-page="bandung">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<ThemeHead />
		<meta name="description" content="Listen, watch and connect with OZ Media." />
		<Font cssVariable="--font-tango" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-jakarta" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-mono" />
		<title>OZ Media</title>
		<script type="speculationrules" is:inline set:html={JSON.stringify({ prefetch: [{ where: { href_matches: '/' }, eagerness: 'moderate' }] })} />
		<script is:inline>
			// Logo hand-off for the view transition with the home page (see src/styles/page-transitions.css).
			addEventListener('pagereveal', (event) => {
				const root = document.documentElement;
				const topbarLogo = document.querySelector('[data-topbar-logo]');
				topbarLogo?.style.removeProperty('view-transition-name');
				if (!event.viewTransition) return;
				if (window.scrollY < 1) {
					// At the top the static hero logo is the target; it hands back to the morphing topbar logo once revealed.
					root.classList.add('vt-arriving', 'vt-arrived');
					event.viewTransition.finished.finally(() => root.classList.remove('vt-arriving'));
				} else {
					// Restored mid-page: the topbar logo is already where it belongs.
					topbarLogo?.style.setProperty('view-transition-name', 'oz-bandung-logo');
				}
			});
			// The Ozubathon lockup is lazy (retro never shows it); in the night style it's above the fold, so fetch it now.
			if (document.documentElement.dataset.theme === 'night') {
				const preload = Object.assign(document.createElement('link'), { rel: 'preload', as: 'image', type: 'image/webp', fetchPriority: 'high' });
				preload.setAttribute('imagesrcset', '/images/ozubathon-420.webp 420w, /images/ozubathon-838.webp 838w');
				preload.setAttribute('imagesizes', '(max-width: 650px) 84vw, 560px');
				document.head.append(preload);
			}
			addEventListener('pageswap', (event) => {
				if (event.viewTransition) document.querySelector('[data-topbar-logo]')?.style.setProperty('view-transition-name', 'oz-bandung-logo');
			});
		</script>
	</head>
	<body>
		<main class="bandung-page">
			<header class="topbar" data-topbar>
				<a class="wordmark" href="/" aria-label="OZ Radio home" data-topbar-logo data-sticker><img src="/images/logo-oz-bandung.png" alt="OZ Radio Bandung" width="1246" height="648" /></a>
				<nav class="topbar-nav" aria-label="Page sections" data-topbar-nav>
					{sections.map((section) => (
						<a class="topbar-nav-link" href={`#${section.id}`} data-topbar-section-id={section.id}>
							{section.label}
						</a>
					))}
				</nav>
				<ThemeSwitch class="topbar-theme-switch" nightLabel="55 LIVE" nightName="Ozubathon" />
			</header>

			<section class="hero-screen" id="top" aria-labelledby="hero-title" data-hero>
				<div class="bg-art" aria-hidden="true"></div>
				<h1 class="hero-title" id="hero-title" data-sticker>
					<img class="hero-logo" src="/images/logo-oz-bandung.png" alt="OZ Radio Bandung" width="1246" height="648" fetchpriority="high" data-hero-logo />
				</h1>
				<div class="ozb-event" role="group" aria-label="Ozubathon" data-ozb data-ozb-start={ozubathonStartMs} data-ozb-hours={ozubathon.hours} data-ozb-state="soon">
					<span class="ozb-presents" aria-hidden="true">PRESENTS</span>
					<img class="ozb-logo" data-src="/images/ozubathon-838.webp" data-srcset="/images/ozubathon-420.webp 420w, /images/ozubathon-838.webp 838w" sizes="(max-width: 650px) 84vw, 560px" alt="55 Ozubathon: loud and live" width="838" height="499" decoding="async" data-ozb-logo />
					<p class="ozb-deck">{ozubathon.hours} hours of nonstop live radio for our anniversary. <span>{ozubathon.dateLabel}</span></p>
					<div class="ozb-status">
						<p class="ozb-chip">
							<span class="ozb-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
							<span data-ozb-label>STARTS IN</span>
						</p>
						<div class="ozb-countdown" role="timer" aria-live="off" data-ozb-countdown>
							<span class="ozb-unit"><b data-ozb-unit="days">{pad2(ozubathonInitial.days)}</b><small>DAYS</small></span>
							<span class="ozb-unit"><b data-ozb-unit="hours">{pad2(ozubathonInitial.hours)}</b><small>HRS</small></span>
							<span class="ozb-unit"><b data-ozb-unit="minutes">{pad2(ozubathonInitial.minutes)}</b><small>MIN</small></span>
							<span class="ozb-unit"><b data-ozb-unit="seconds">{pad2(ozubathonInitial.seconds)}</b><small>SEC</small></span>
						</div>
						<div class="ozb-progress" hidden data-ozb-progress>
							<p><b data-ozb-hour>01</b> / {ozubathon.hours} <small>HOURS ON AIR</small></p>
							<span class="ozb-progress-track" aria-hidden="true"><span data-ozb-bar></span></span>
						</div>
					</div>
				</div>
				<nav class="hero-nav" aria-label="Page sections" data-hero-nav>
					{sections.map((section) => (
						<a class="hero-nav-link" href={`#${section.id}`} data-hero-section-id={section.id}>
							{section.label}
						</a>
					))}
				</nav>
				<a class="hero-scroll-cue" href="#listen" data-hero-cue>
					<span>SCROLL</span>
					<span class="hero-scroll-line" aria-hidden="true"></span>
				</a>
			</section>

			<div class="ozb-ticker" aria-hidden="true" data-ozb-ticker>
				<div class="ozb-ticker-track">
					{[0, 1].map(() => (
						<span class="ozb-ticker-run">
							{tickerPhrases.concat(tickerPhrases).map((phrase) => <span>{phrase}</span>)}
						</span>
					))}
				</div>
			</div>

			<section class="screen listen-screen" id="listen" aria-label="On air">
				<div class="bg-art" aria-hidden="true"><BandungRibbon seam="air" edge="bottom" /></div>
				<div class="screen-content listen-content">
					<div class="broadcast-layout">
						<section class="live-chat" aria-labelledby="live-chat-title" data-live-chat data-chat-room="bandung">
							<div class="live-chat-heading">
								<h2 id="live-chat-title">LIVE CHAT</h2>
								<span class="live-chat-slow-mode" data-chat-slow-mode hidden></span>
								<label class="live-chat-mod-control" data-chat-mod-control hidden>
									SLOW MODE
									<select>
										<option value="0">Off</option>
										<option value="5">5s</option>
										<option value="10">10s</option>
										<option value="30">30s</option>
										<option value="60">60s</option>
									</select>
								</label>
							</div>
							<div class="live-chat-feed">
								<ol class="live-chat-messages" data-chat-messages data-viewer="guest" role="log" aria-label="Chat messages"></ol>
								<p class="live-chat-empty" data-chat-empty>Loading chat...</p>
								<button class="live-chat-jump" type="button" data-chat-jump hidden>New messages ↓</button>
								<div class="live-chat-menu" data-chat-menu role="menu" aria-label="Message options" hidden>
									<button type="button" role="menuitem" data-chat-action="report">Report message</button>
									<button type="button" role="menuitem" data-chat-action="delete">Delete message</button>
									<button type="button" role="menuitem" data-chat-action="timeout">Mute for 10 minutes</button>
									<button type="button" role="menuitem" class="is-danger" data-chat-action="ban">Ban from chat</button>
								</div>
							</div>
							<div class="live-chat-footer">
								<p class="live-chat-status" data-chat-status role="status" hidden></p>
								<button class="google-signin live-chat-signin" type="button" data-chat-signin>
									<svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true">
										<path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
										<path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
										<path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
										<path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
									</svg>
									<span>Sign in with Google to chat</span>
								</button>
								<form class="live-chat-compose" data-chat-form hidden>
									<span class="live-chat-self" data-chat-self-avatar></span>
									<input name="message" maxlength="200" autocomplete="off" enterkeyhint="send" placeholder="Say something..." aria-label="Chat message" />
									<button type="submit">Send</button>
								</form>
							</div>
						</section>

						<div class="broadcast" aria-label="OZ Bandung broadcast">
							<div class="broadcast-heading">
								<div class="broadcast-label"><span class="live-dot idle-dot"></span> LIVE FROM THE STUDIO</div>
								<span class="on-air">ON AIR</span>
							</div>
							<div class="broadcast-backdrop" aria-hidden="true">
								<img src="/images/studio-livestream.jpg" alt="" loading="lazy" decoding="async" />
							</div>
							<div class="broadcast-options">
								<button class="broadcast-option" type="button" data-tune-in>
									<span class="tune-in-icon" aria-hidden="true">▶</span>
									<span data-tune-in-label>Tune in</span>
									<span class="tune-in-frequency">103.1 FM · BANDUNG</span>
								</button>
							</div>
							<div class="broadcast-panel" data-broadcast-panel="audio" hidden>
								<div class="audio-bar">
									<span class="icon" aria-hidden="true">♫</span>
									<div class="audio-copy">
										<strong data-track-title>{audioStreamUrl ? 'Loading track...' : 'Audio stream unavailable'}</strong>
										<span data-track-artist aria-live="polite"></span>
									</div>
									{audioStreamUrl ? (
										<div class="audio-player" data-audio-player data-stream-url={audioStreamUrl}>
											<audio controls preload="none" crossorigin="anonymous" src={audioStreamUrl} aria-label="OZ Bandung audio stream">
												Your browser does not support audio playback.
											</audio>
										</div>
									) : (
										<span class="stream-status">AUDIO NOT CONNECTED</span>
									)}
								</div>
								<div class="listener-stats" aria-live="polite" aria-label="Live listener statistics">
									<span>LISTENERS <strong data-listener-count>—</strong></span>
								</div>
							</div>
							<div class="broadcast-panel" data-broadcast-panel="video" hidden>
								<div class="video-frame">
									{youtubeLiveEmbedUrl ? (
										<iframe
											title="OZ Bandung YouTube livestream"
											data-youtube-live={youtubeLiveEmbedUrl}
											allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
											referrerpolicy="strict-origin-when-cross-origin"
											allowfullscreen
										></iframe>
									) : (
										<div class="video-placeholder">
											<img src="/images/studio-livestream.jpg" alt="" aria-hidden="true" loading="lazy" decoding="async" />
											<span class="placeholder-play" aria-hidden="true">▶</span>
											<p>Studio stream coming soon</p>
											<span class="placeholder-caption">YOUTUBE LIVESTREAM · CHANNEL TO BE ADDED</span>
										</div>
									)}
								</div>
							</div>
						</div>
					</div>

					<dialog class="listener-dialog" data-listener-dialog aria-labelledby="listener-dialog-title">
						<form class="listener-form" data-listener-form>
							<button class="dialog-close" type="button" data-dialog-close aria-label="Close">×</button>
							<p class="eyebrow" data-dialog-eyebrow>OZ RADIO BANDUNG</p>
							<h2 id="listener-dialog-title" data-dialog-title>Choose how to tune in</h2>
							<div class="broadcast-selection" data-broadcast-selection role="group" aria-label="Choose a broadcast">
								<button class="broadcast-option" type="button" data-select-broadcast="audio">♫ <span>Listen to audio stream</span></button>
								<button class="broadcast-option" type="button" data-select-broadcast="video">▶ <span>Watch the livestream</span></button>
							</div>
							<div data-listener-fields hidden>
								<label class="listener-field">Name<input name="name" autocomplete="name" required maxlength="80" /></label>
								<label class="listener-field">Age<select name="age" required>
									<option value="" selected disabled>Select age range</option>
									{ageRanges.map((range) => <option value={range}>{range}</option>)}
								</select></label>
								<label class="listener-field">Gender<select name="gender" required>
									<option value="" selected disabled>Select gender</option>
									<option value="Female">Female</option>
									<option value="Male">Male</option>
								</select></label>
								<div class="listener-field location-field">
									<label for="listener-location">Location</label>
									<input
										id="listener-location"
										name="location"
										autocomplete="off"
										required
										maxlength="100"
										placeholder="Start typing your city"
										role="combobox"
										aria-autocomplete="list"
										aria-expanded="false"
										aria-controls="listener-location-options"
										data-location-input
									/>
									<ul class="location-options" id="listener-location-options" role="listbox" aria-label="Location suggestions" data-location-options hidden></ul>
								</div>
							</div>
							<div class="google-auth" data-google-auth hidden>
								<button class="google-signin" type="button" data-google-signin>
									<svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true">
										<path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
										<path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
										<path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
										<path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
									</svg>
									<span>Sign in with Google</span>
								</button>
								<div class="google-user" data-google-user hidden>
									<img data-google-avatar alt="" width="28" height="28" referrerpolicy="no-referrer" hidden />
									<span>Signed in as <strong data-google-name></strong></span>
									<button class="google-signout" type="button" data-google-signout>Sign out</button>
								</div>
								<p class="google-auth-note" data-google-auth-note aria-live="polite">Sign in with Google to save your details.</p>
							</div>
							<div class="listener-confirmation" data-listener-confirmation hidden aria-live="polite"></div>
							<button class="listener-submit" type="submit" data-listener-submit hidden>Continue</button>
						</form>
					</dialog>

					<aside class="ad-space" aria-label="Advertisement space">
						<span class="ad-tag">ADVERTISEMENT</span>
						<strong>Advertisement.</strong>
						<span>AD SPACE · BANDUNG</span>
					</aside>
				</div>

			</section>

			<section class="screen screen-sand" id="programs" aria-labelledby="programs-title">
				<div class="bg-art" aria-hidden="true"><BandungRibbon seam="air" edge="top" /><BandungRibbon seam="announcer" edge="bottom" /></div>
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">ON AIR PROGRAM</p>
							<h2 id="programs-title">Our<span> on air</span> program</h2>
						</div>
					</div>
					<div class="program-carousel" data-program-carousel aria-roledescription="carousel" aria-label="On air programs">
						<div class="carousel-stage">
							<button class="carousel-chevron carousel-chevron-previous" type="button" data-program-previous aria-label="Previous programs">
								<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 4.5 7.5 12l7.5 7.5" /></svg>
							</button>
							<div class="program-slides">
									{programsWithBody.map(({ entry: program, Content }, index) => (
										<article
											class:list={['program-slide', { 'is-active': index < 3 }]}
											data-program-slide
											data-program-card
											aria-haspopup="dialog"
											aria-label={`Open program details: ${program.data.title}, slide ${index + 1} of ${programsWithBody.length}`}
											role="button"
											tabindex="0"
											aria-roledescription="slide"
											hidden={index >= 3}
										>
											<img src={optimizeImageUrl(program.data.image, 900)} alt={program.data.imageAlt} loading="lazy" decoding="async" />
											<div class="program-slide-copy">
												<span class="card-index">{String(index + 1).padStart(2, '0')} / ON AIR</span>
												<h3>{program.data.title}</h3>
											</div>
											<template data-program-body><Content /></template>
											<template data-program-meta>
												<ul data-program-schedule-items>
													{program.data.schedule.map((slot) => (
														<li class="program-slot"><span class="program-slot-days">{slot.days}</span><span class="program-slot-time">{slot.time}</span></li>
													))}
												</ul>
