		position: absolute;
		bottom: 10px;
		left: 50%;
		padding: 6px 12px;
		border: 1px solid #f2bd57;
		border-radius: 999px;
		background: #FFF0D1;
		color: #000000;
		font: inherit;
		font-size: 11px;
		font-weight: 700;
		cursor: pointer;
		transform: translateX(-50%);
	}

	/* Messages and avatars are created by oz-chat.ts, so they are outside this page's scoped styles: hence :global(). */
	.live-chat-messages :global(.chat-message) {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 8px 12px 8px 18px;
		transition: background-color 180ms ease, opacity 180ms ease;
	}

	.live-chat-messages :global(.chat-message:hover),
	.live-chat-messages :global(.chat-message:focus-within) {
		background: rgb(216 216 204 / 28%);
	}

	.live-chat-messages :global(.chat-message.is-own) {
		background: rgb(255 240 209 / 70%);
		box-shadow: inset 2px 0 0 #f2bd57;
	}

	.live-chat-messages :global(.chat-message.is-pending) {
		opacity: 0.5;
	}

	.live-chat :global(.chat-avatar) {
		flex: none;
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		border: 1px solid #D8D8CC;
		border-radius: 50%;
		background: #EDEDE2;
		color: #77776F;
		font-size: 12px;
		font-weight: 700;
		object-fit: cover;
	}

	.live-chat-messages :global(.chat-message-body) {
		min-width: 0;
		flex: 1;
	}

	.live-chat-messages :global(.chat-message-meta) {
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 6px;
		line-height: 1.3;
	}

	.live-chat-messages :global(.chat-message-meta strong) {
		min-width: 0;
		overflow: hidden;
		color: #000000;
		font-size: 12px;
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.live-chat-messages :global(.chat-message-meta time) {
		flex: none;
		color: #77776F;
		font-size: 10px;
		letter-spacing: 0.04em;
	}

	.live-chat-messages :global(.chat-mod-badge) {
		flex: none;
		padding: 2px 5px;
		border-radius: 2px;
		background: #f2bd57;
		color: #000000;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1;
	}

	.live-chat-messages :global(.chat-message-body p) {
		margin: 3px 0 0;
		color: #000000;
		font-size: 13px;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.live-chat-messages :global(.chat-message-more) {
		flex: none;
		width: 26px;
		height: 26px;
		display: grid;
		place-items: center;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 2px;
		background: none;
		color: #77776F;
		font: inherit;
		font-size: 16px;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
	}

	.live-chat-messages :global(.chat-message-more:hover),
	.live-chat-messages :global(.chat-message-more:focus-visible),
	.live-chat-messages :global(.chat-message-more[aria-expanded="true"]) {
		border-color: #f2bd57;
		background: #FFF0D1;
		color: #000000;
	}

	/* The ⋯ button only shows when the viewer can act on the message (oz-chat.ts sets data-viewer). */
	.live-chat-messages[data-viewer="guest"] :global(.chat-message-more),
	.live-chat-messages[data-viewer="member"] :global(.chat-message:is(.is-own, .is-mod) .chat-message-more),
	.live-chat-messages :global(.chat-message.is-pending .chat-message-more) {
		visibility: hidden;
	}

	@media (hover: hover) {
		.live-chat-messages :global(.chat-message:not(:hover, :focus-within) .chat-message-more:not([aria-expanded="true"])) {
			opacity: 0;
		}
	}

