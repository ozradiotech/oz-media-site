		flex-direction: column;
		overflow: hidden;
		border: var(--box-border);
		border-radius: var(--box-radius);
		background: var(--c-surface);
		box-shadow: var(--box-shadow);
	}

	.live-chat-heading {
		min-height: 48px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 0 18px;
		border-bottom: var(--box-border);
		background: var(--c-accent);
	}

	.live-chat-heading h2,
	.live-chat-heading span {
		margin: 0;
		color: var(--c-on-accent);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.live-chat-heading h2 {
		margin-right: auto;
	}

	.live-chat-mod-control {
		display: flex;
		align-items: center;
		gap: 6px;
		color: var(--c-on-accent);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.live-chat-mod-control select {
		padding: 2px 4px;
		border: 1px solid var(--c-line);
		border-radius: 2px;
		background: var(--c-field);
		color: var(--c-text);
		font: inherit;
		letter-spacing: 0;
	}

	.live-chat-feed {
		position: relative;
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}

	.live-chat-messages {
		flex: 1;
		min-height: 0;
		margin: 0;
		padding: 10px 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		list-style: none;
	}

	.live-chat-empty {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		margin: 0;
		padding: 20px;
		color: var(--c-muted);
		font-size: 13px;
		line-height: 1.6;
		text-align: center;
		pointer-events: none;
	}

	.live-chat-jump {
		position: absolute;
		bottom: 10px;
		left: 50%;
		padding: 6px 12px;
		border: 1px solid var(--c-accent);
		border-radius: 999px;
		background: var(--c-accent-soft);
		color: var(--c-text);
		font: inherit;
		font-size: 11px;
		font-weight: 700;
		cursor: pointer;
		transform: translateX(-50%);
	}

	/* Messages and avatars are created by oz-chat.ts, so they are outside this page's scoped styles: hence :global(). */
	.live-chat-messages :global(.chat-message) {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 8px 12px 8px 18px;
		transition: background-color 180ms ease, opacity 180ms ease;
	}

	.live-chat-messages :global(.chat-message:hover),
	.live-chat-messages :global(.chat-message:focus-within) {
		background: color-mix(in srgb, var(--c-line) 28%, transparent);
	}

	.live-chat-messages :global(.chat-message.is-own) {
		background: color-mix(in srgb, var(--c-accent-soft) 70%, transparent);
		box-shadow: inset 2px 0 0 var(--c-accent);
	}

	.live-chat-messages :global(.chat-message.is-pending) {
		opacity: 0.5;
	}

	.live-chat :global(.chat-avatar) {
		flex: none;
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		border: 1px solid var(--c-line);
		border-radius: 50%;
		background: var(--c-surface-2);
		color: var(--c-muted);
		font-size: 12px;
		font-weight: 700;
		object-fit: cover;
	}

	.live-chat-messages :global(.chat-message-body) {
		min-width: 0;
		flex: 1;
	}

	.live-chat-messages :global(.chat-message-meta) {
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 6px;
		line-height: 1.3;
	}

	.live-chat-messages :global(.chat-message-meta strong) {
		min-width: 0;
		overflow: hidden;
		color: var(--c-text);
		font-size: 12px;
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.live-chat-messages :global(.chat-message-meta time) {
		flex: none;
		color: var(--c-muted);
		font-size: 10px;
		letter-spacing: 0.04em;
	}

	.live-chat-messages :global(.chat-mod-badge) {
		flex: none;
		padding: 2px 5px;
		border-radius: 2px;
		background: var(--c-accent);
		color: var(--c-on-accent);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1;
	}

	.live-chat-messages :global(.chat-message-body p) {
		margin: 3px 0 0;
		color: var(--c-text);
		font-size: 13px;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.live-chat-messages :global(.chat-message-more) {
		flex: none;
		width: 26px;
		height: 26px;
		display: grid;
		place-items: center;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 2px;
		background: none;
		color: var(--c-muted);
		font: inherit;
		font-size: 16px;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
	}

	.live-chat-messages :global(.chat-message-more:hover),
	.live-chat-messages :global(.chat-message-more:focus-visible),
	.live-chat-messages :global(.chat-message-more[aria-expanded="true"]) {
		border-color: var(--c-accent);
		background: var(--c-accent-soft);
		color: var(--c-text);
	}

	/* The ⋯ button only shows when the viewer can act on the message (oz-chat.ts sets data-viewer). */
	.live-chat-messages[data-viewer="guest"] :global(.chat-message-more),
	.live-chat-messages[data-viewer="member"] :global(.chat-message:is(.is-own, .is-mod) .chat-message-more),
	.live-chat-messages :global(.chat-message.is-pending .chat-message-more) {
		visibility: hidden;
	}

	@media (hover: hover) {
		.live-chat-messages :global(.chat-message:not(:hover, :focus-within) .chat-message-more:not([aria-expanded="true"])) {
			opacity: 0;
		}
	}

	.live-chat-menu {
		position: absolute;
		z-index: 2;
		min-width: 180px;
		display: grid;
		padding: 4px;
		border: 1px solid var(--c-line);
		border-radius: 4px;
		background: var(--c-surface);
		box-shadow: 0 12px 28px rgb(0 0 0 / 12%);
	}

	.live-chat-menu button {
		padding: 9px 12px;
		border: 0;
		border-radius: 2px;
		background: none;
		color: var(--c-text);
		font: inherit;
		font-size: 12px;
		font-weight: 700;
		text-align: left;
		cursor: pointer;
	}

	.live-chat-menu button:hover,
	.live-chat-menu button:focus-visible {
		outline: 0;
		background: var(--c-accent-soft);
	}

	.live-chat-menu button.is-danger {
		color: var(--c-danger);
	}

	.live-chat-footer {
		display: grid;
		gap: 8px;
		padding: 12px 14px 14px;
		border-top: 1px solid var(--c-line);
	}

	.live-chat-status {
		margin: 0;
		color: var(--c-danger);
		font-size: 11px;
		line-height: 1.4;
	}

	.live-chat-signin {
		width: 100%;
		min-height: 46px;
	}

	.live-chat-compose {
		min-height: 46px;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 0 6px 0 10px;
		border: 1px solid var(--c-line);
		border-radius: 2px;
		background: var(--c-field);
	}

	.live-chat-compose:focus-within {
		border-color: var(--c-accent);
	}

	.live-chat-self {
		display: flex;
	}

	.live-chat-compose input {
		min-width: 0;
		flex: 1;
		padding: 10px 0;
		border: 0;
		outline: 0;
		background: none;
		color: var(--c-text);
		font: inherit;
		font-size: 13px;
	}

	.live-chat-compose button {
		flex: none;
		min-width: 56px;
		padding: 8px 12px;
		border: 0;
		border-radius: 2px;
		background: var(--c-inverse);
		color: var(--c-on-inverse);
		font: inherit;
		font-size: 11px;
		font-weight: 700;
		cursor: pointer;
	}

	.live-chat-compose button:disabled {
		cursor: default;
		opacity: 0.45;
	}

	.broadcast-options {
		position: absolute;
		z-index: 1;
		top: 50%;
		left: 50%;
		display: flex;
		justify-content: center;
		transform: translate(-50%, -50%);
	}

	.broadcast-option {
		min-height: 64px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 9px;
		border: 0;
		background: var(--c-surface);
		color: var(--c-muted);
		font: inherit;
		font-size: 12px;
		font-weight: 700;
		cursor: pointer;
		transition: color 180ms ease, background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.broadcast-option[aria-pressed='true'] {
		background: var(--c-accent-soft);
		color: var(--c-text);
		box-shadow: inset 0 -2px var(--c-accent);
	}

	.broadcast-option:hover,
	.broadcast-option:focus-visible {
		color: var(--c-text);
	}

	.broadcast-options .broadcast-option {
		min-height: 92px;
		flex: initial;
		flex-direction: column;
		justify-content: center;
		gap: 10px;
		padding: 10px 22px;
		background: transparent;
		color: var(--c-on-stage);
		font-family: var(--font-tango);
		font-size: clamp(20px, 2.4vw, 30px);
		letter-spacing: -0.02em;
	}

	.broadcast-options .broadcast-option:hover,
	.broadcast-options .broadcast-option:focus-visible {
		background: transparent;
		color: var(--c-accent);
	}

	.tune-in-icon {
		width: clamp(72px, 8vw, 96px);
		height: clamp(72px, 8vw, 96px);
		display: grid;
		place-items: center;
		padding-left: 0.15em;
		border: 2px solid var(--c-outline);
		border-radius: 50%;
		background: var(--c-accent);
		color: var(--c-on-accent);
		font-size: clamp(22px, 2.4vw, 30px);
		line-height: 1;
		box-shadow: 5px 5px 0 var(--c-on-stage);
		transition: transform 180ms ease, box-shadow 180ms ease;
	}

	.broadcast-options .broadcast-option:hover .tune-in-icon {
		box-shadow: 7px 7px 0 var(--c-on-stage);
		transform: translate(-2px, -2px);
	}

	.tune-in-frequency {
		color: var(--c-on-stage-muted);
		font-family: var(--font-jakarta);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.16em;
		white-space: nowrap;
	}

	.broadcast.is-streaming .broadcast-options {
		position: absolute;
		z-index: 2;
		top: 7px;
		left: auto;
		right: 8px;
		transform: none;
	}

	.broadcast.is-streaming .broadcast-heading .on-air {
		visibility: hidden;
	}

	.broadcast.is-streaming .broadcast-options .broadcast-option {
		width: auto;
		min-height: 32px;
		flex: initial;
		flex-direction: row;
		gap: 0;
		padding: 0 10px;
		border: 1.5px solid var(--c-outline);
		border-radius: 8px;
		background: var(--c-surface);
		color: var(--c-text);
		font-family: var(--font-jakarta);
		font-size: 12px;
		letter-spacing: 0;
	}

	.broadcast.is-streaming .broadcast-options .broadcast-option:hover {
		background: var(--c-accent-soft);
		color: var(--c-text);
	}

	.broadcast.is-streaming .tune-in-icon,
	.broadcast.is-streaming .tune-in-frequency {
		display: none;
	}

	.broadcast-selection {
		display: grid;
		gap: 8px;
	}

	.broadcast-selection .broadcast-option {
		justify-content: space-between;
		padding: 0 14px;
		border: 1px solid var(--c-line);
		border-radius: 2px;
		text-align: left;
	}

	.broadcast-selection .broadcast-option:hover {
		transform: translateY(-1px);
		border-color: var(--c-accent);
		background: var(--c-accent-soft);
	}

	.broadcast-option:focus-visible,
	.listener-submit:focus-visible,
	.dialog-close:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: -3px;
	}

	.broadcast-panel[hidden],
	.broadcast-empty[hidden] {
		display: none;
	}

	.broadcast-panel:not([hidden]) {
		animation: broadcast-reveal 300ms ease both;
	}

	.broadcast-panel[data-broadcast-panel='audio']:not([hidden]) {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.broadcast-panel[data-broadcast-panel='video']:not([hidden]) {
		flex: 1;
		min-height: 0;
	}

	.broadcast-empty {
		padding: 24px 16px;
		color: var(--c-muted);
		font-size: 10px;
		text-align: center;
	}

	.stream-status {
		color: var(--c-on-stage-muted);
		font-size: 7px;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.listener-dialog {
		width: min(460px, calc(100% - 28px));
		max-width: none;
		max-height: min(90dvh, 680px);
		overflow: auto;
		padding: clamp(22px, 5vw, 34px);
		border: 1px solid var(--c-line);
		border-radius: 4px;
		background: var(--c-surface);
		color: var(--c-text);
		box-shadow: 0 24px 80px rgb(0 0 0 / 55%);
	}

	.article-dialog {
		width: min(820px, calc(100% - 28px));
		max-width: none;
		max-height: min(92dvh, 960px);
		overflow: auto;
		overscroll-behavior: contain;
		scroll-padding-top: 64px;
		padding: 0;
		border: 1px solid var(--c-line);
		border-radius: 4px;
		background: var(--c-surface);
		color: var(--c-text);
		box-shadow: 0 24px 80px rgb(0 0 0 / 55%);
	}

	.news-list-dialog {
		width: min(760px, calc(100% - 28px));
		max-width: none;
		max-height: min(90dvh, 820px);
		overflow: auto;
		padding: 0;
		border: 1px solid var(--c-line);
		border-radius: 4px;
		background: var(--c-surface);
		color: var(--c-text);
		box-shadow: 0 24px 80px rgb(0 0 0 / 55%);
	}

	.news-list-dialog[open] {
		animation: dialog-reveal 220ms ease-out both;
	}

	.news-list-dialog::backdrop {
		background: rgb(0 0 0 / 78%);
		backdrop-filter: blur(3px);
		animation: backdrop-reveal 220ms ease-out both;
	}

	.news-list-content {
		padding: clamp(20px, 4vw, 34px);
	}

	.news-list-content > .eyebrow {
		margin: 0 40px 8px 0;
		color: var(--c-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.news-list-content h2 {
		margin: 0 40px 20px 0;
		font-size: clamp(28px, 5vw, 44px);
		letter-spacing: -0.03em;
	}

	.news-list-content h2 span {
		color: var(--c-accent-strong);
	}

	.news-list-sort-label {
		display: block;
		margin-bottom: 6px;
		color: var(--c-muted);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.news-list-sort {
		min-height: 36px;
		margin-bottom: 16px;
		padding: 0 28px 0 10px;
		border: 1px solid var(--c-line);
		border-radius: 2px;
		background: var(--c-surface);
		color: var(--c-text);
		font: inherit;
		font-size: 12px;
	}

	.news-list-items {
		display: grid;
		gap: 8px;
	}

	.news-list-item {
		display: grid;
		width: 100%;
		grid-template-columns: minmax(90px, 0.32fr) minmax(0, 1fr);
		gap: 16px;
		padding: 10px;
		border: 1px solid var(--c-line);
		border-radius: 3px;
		background: transparent;
		color: var(--c-text);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.news-list-item:hover {
		border-color: var(--c-accent);
		background: var(--c-accent-faint);
	}

	.news-list-item:focus-visible,
	.news-list-sort:focus-visible,
	.news-list-trigger:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 3px;
	}

	.news-list-item img {
		width: 100%;
		height: 100%;
		min-height: 90px;
		max-height: 150px;
		object-fit: cover;
	}

	.news-list-item-copy {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
	}

	.news-list-item-copy h3 {
		margin: 0;
		font-size: clamp(14px, 2vw, 18px);
		line-height: 1.15;
	}

	.news-list-item-copy p {
		margin: 0;
		color: var(--c-text-2);
		font-size: 11px;
		line-height: 1.45;
	}

	.news-list-item-copy time {
		margin-top: auto;
		color: var(--c-muted);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.article-dialog[open] {
		animation: dialog-reveal 220ms ease-out both;
	}

	.article-dialog::backdrop {
		background: rgb(0 0 0 / 78%);
		backdrop-filter: blur(3px);
		animation: backdrop-reveal 220ms ease-out both;
	}

	/* Sticky but zero-height, so it overlays the photo instead of pushing it down, and stays put while reading. */
	.article-dialog-bar {
		position: sticky;
		z-index: 2;
		top: 0;
		height: 0;
	}

	.article-dialog-progress {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		background: var(--c-accent);
		transform: scaleX(var(--article-progress, 0));
		transform-origin: left;
		pointer-events: none;
	}

	.article-dialog-close {
		box-shadow: 0 4px 14px rgb(0 0 0 / 22%);
	}

	/* The whole photo is shown at its own proportions: full width when landscape, centred when it is tall. */
	.article-dialog-image {
		display: block;
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: min(70dvh, 640px);
		margin: 0 auto;
	}

	/* Reading column: ~65 characters a line, larger text and roomier leading than the rest of the site. */
	.article-dialog-copy {
		max-width: calc(66ch + 2 * clamp(20px, 5vw, 48px));
		margin: 0 auto;
		padding: clamp(22px, 5vw, 44px) clamp(20px, 5vw, 48px) clamp(32px, 6vw, 56px);
		font-size: clamp(16px, 1.1vw + 12px, 18px);
	}

	.article-dialog-copy .eyebrow {
		margin: 0 0 12px;
		color: var(--c-accent-strong);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.article-dialog-copy h2 {
		margin: 0 0 14px;
		font-size: clamp(26px, 4.6vw, 42px);
		letter-spacing: -0.025em;
		line-height: 1.1;
		text-wrap: balance;
	}

	.article-dialog-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 14px;
		margin: 0 0 22px;
		padding-bottom: 18px;
		border-bottom: 1px solid var(--c-line);
		color: var(--c-muted);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.article-dialog-meta time:not([hidden]) + span:not(:empty)::before {
		content: '·';
		margin-right: 14px;
	}

	/* The summary reads as the standfirst. */
	.article-dialog-description {
		margin: 0;
		color: var(--c-text);
		font-size: 1.12em;
		font-weight: 500;
		line-height: 1.6;
		white-space: pre-wrap;
		text-wrap: pretty;
	}

	.article-dialog-body {
		margin-top: 1.6em;
		color: var(--c-text);
		font-size: 1em;
		line-height: 1.75;
		overflow-wrap: break-word;
		text-wrap: pretty;
	}

	:global(.article-dialog-body > :first-child) {
		margin-top: 0;
	}

	:global(.article-dialog-body > :last-child) {
		margin-bottom: 0;
	}

	:global(.article-dialog-body p),
	:global(.article-dialog-body ul),
	:global(.article-dialog-body ol) {
		margin: 0 0 1.25em;
	}

	:global(.article-dialog-body ul),
	:global(.article-dialog-body ol) {
		padding-left: 1.4em;
	}

	:global(.article-dialog-body li + li) {
		margin-top: 0.4em;
	}

	:global(.article-dialog-body h2),
	:global(.article-dialog-body h3),
	:global(.article-dialog-body h4) {
		margin: 1.8em 0 0.6em;
		color: var(--c-text);
		line-height: 1.25;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	:global(.article-dialog-body h2) { font-size: 1.4em; }
	:global(.article-dialog-body h3) { font-size: 1.2em; }
	:global(.article-dialog-body h4) { font-size: 1.05em; }

	:global(.article-dialog-body a) {
		color: var(--c-link);
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	:global(.article-dialog-body strong) {
		color: var(--c-text);
	}

	:global(.article-dialog-body img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 1.6em auto;
		border-radius: 3px;
	}

	:global(.article-dialog-body blockquote) {
		margin: 1.6em 0;
		padding: 0.2em 0 0.2em 1.1em;
		border-left: 3px solid var(--c-accent);
		color: var(--c-text-2);
		font-size: 1.08em;
		font-style: italic;
	}

	:global(.article-dialog-body blockquote p:last-child) {
		margin-bottom: 0;
	}

	:global(.article-dialog-body hr) {
		margin: 2em 0;
		border: 0;
		border-top: 1px solid var(--c-line);
	}

	:global(.article-dialog-body code) {
		padding: 0.1em 0.35em;
		border-radius: 3px;
		background: var(--c-accent-faint);
		font-size: 0.9em;
	}

	:global(.article-dialog-body table) {
		display: block;
		max-width: 100%;
		margin: 1.6em 0;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: 0.9em;
	}

	:global(.article-dialog-body th),
	:global(.article-dialog-body td) {
		padding: 0.5em 0.75em;
		border: 1px solid var(--c-line);
		text-align: left;
	}

	.article-dialog-status {
		margin: 2em 0 0;
		padding-top: 14px;
		border-top: 1px solid var(--c-line);
		color: var(--c-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.article-dialog .dialog-close,
	.news-list-dialog .dialog-close {
		position: absolute;
		z-index: 1;
		top: 12px;
		right: 12px;
	}

	.listener-dialog[open] {
		animation: dialog-reveal 220ms ease-out both;
	}

	.listener-dialog::backdrop {
		background: rgb(0 0 0 / 78%);
		backdrop-filter: blur(3px);
		animation: backdrop-reveal 220ms ease-out both;
	}

	.listener-form {
		position: relative;
		display: grid;
		gap: 14px;
	}

	.listener-form .eyebrow {
		margin: 0;
		color: var(--c-accent);
	}

	.listener-form h2 {
		margin: 0 30px 4px 0;
		font-size: 25px;
		line-height: 1.1;
	}

	.dialog-close {
		position: absolute;
		top: -12px;
		right: -12px;
		width: 34px;
		height: 34px;
		border: 1px solid var(--c-line);
		border-radius: 50%;
		background: var(--c-surface);
		color: var(--c-text);
		font-size: 20px;
		cursor: pointer;
		transition: background-color 180ms ease, transform 180ms ease;
	}

	.dialog-close:hover {
		transform: rotate(90deg);
		background: var(--c-accent-soft);
	}

	.listener-field {
		display: grid;
		gap: 6px;
		color: var(--c-muted);
		font-size: 10px;
		font-weight: 700;
	}

	.listener-field input,
	.listener-field select {
		width: 100%;
		min-height: 42px;
		padding: 9px 10px;
		border: 1px solid var(--c-line);
		border-radius: 2px;
		background: var(--c-surface);
		color: var(--c-text);
		font: inherit;
		font-size: 13px;
	}

	.listener-field input:focus,
	.listener-field select:focus {
		border-color: var(--c-accent);
		outline: 1px solid var(--c-accent);
	}

	/* Sits in the flow rather than floating, so the dialog's own scrolling never clips it. */
	.location-options {
		max-height: 220px;
		margin: -2px 0 0;
		padding: 4px 0;
		overflow-y: auto;
		list-style: none;
		border: 1px solid var(--c-line);
		border-radius: 2px;
		background: var(--c-surface);
	}

	.location-options li {
		padding: 9px 10px;
		color: var(--c-text);
		font-size: 12px;
		font-weight: 500;
		line-height: 1.35;
		cursor: pointer;
	}

	.location-options li:hover,
	.location-options li[aria-selected='true'] {
		background: var(--c-accent-soft);
	}

	.listener-submit {
		min-height: 42px;
		margin-top: 3px;
		border: 1px solid var(--c-accent);
		border-radius: 2px;
		background: var(--c-accent);
		color: var(--c-on-accent);
		font: inherit;
		font-size: 10px;
		font-weight: 800;
		cursor: pointer;
	}

	.google-auth {
		display: grid;
		gap: 10px;
		padding-top: 14px;
		border-top: 1px solid var(--c-line);
	}

	.google-signin {
		min-height: 42px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		border: 1px solid var(--c-line);
		border-radius: 2px;
		background: var(--c-field);
		color: var(--c-text);
		font: inherit;
		font-size: 12px;
		font-weight: 700;
		cursor: pointer;
		transition: border-color 180ms ease, background-color 180ms ease;
	}

	.google-signin:hover,
	.google-signin:focus-visible {
		border-color: var(--c-accent);
		background: var(--c-accent-soft);
	}

	.google-signin:disabled {
		cursor: wait;
		opacity: 0.6;
	}

	.google-user {
		display: flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
		font-size: 12px;
	}

	.google-auth[hidden],
	.google-user[hidden],
	.google-signin[hidden] {
		display: none;
	}

	.google-user img {
		flex: none;
		border-radius: 50%;
	}

	.google-user span {
		min-width: 0;
		flex: 1;
		overflow-wrap: anywhere;
		color: var(--c-muted);
	}

	.google-user strong {
		color: var(--c-text);
	}

	.google-signout {
		flex: none;
		padding: 4px 0;
		border: 0;
		background: none;
		color: var(--c-muted);
		font: inherit;
		font-size: 10px;
		font-weight: 700;
		text-decoration: underline;
		cursor: pointer;
	}

	.google-signout:hover,
	.google-signout:focus-visible {
		color: var(--c-text);
	}

	.google-auth-note {
		margin: 0;
		color: var(--c-muted);
		font-size: 11px;
		line-height: 1.5;
	}

	.listener-confirmation p {
		margin: 0 0 13px;
		color: var(--c-muted);
		font-size: 12px;
		line-height: 1.5;
	}

	.listener-confirmation dl {
		display: grid;
		grid-template-columns: 80px 1fr;
		gap: 9px 12px;
		margin: 0;
		padding: 14px 0;
		border-top: 1px solid var(--c-line);
		border-bottom: 1px solid var(--c-line);
	}

	.listener-confirmation dt {
		color: var(--c-muted);
		font-size: 9px;
		font-weight: 700;
		text-transform: uppercase;
	}

	.listener-confirmation dd {
		min-width: 0;
		margin: 0;
		font-size: 11px;
		overflow-wrap: anywhere;
	}

	.broadcast-heading {
		min-height: 48px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 0 18px;
		border-bottom: var(--box-border);
		background: var(--c-accent);
	}

	.broadcast-label,
	.on-air,
	.broadcast-heading .on-air {
		color: var(--c-accent);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.video-frame {
		width: 100%;
		height: 100%;
		aspect-ratio: 16 / 9;
		background: var(--c-stage);
	}

	.video-frame iframe {
		width: 100%;
		height: 100%;
		border: 0;
	}

	.video-placeholder {
		position: relative;
		overflow: hidden;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 10px;
		color: #FFFFFF;
		text-align: center;
	}

	.video-placeholder::after {
		position: absolute;
		inset: 0;
		background: rgb(0 0 0 / 48%);
		content: '';
	}

	.video-placeholder img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.video-placeholder > :not(img) {
		position: relative;
		z-index: 1;
	}

	.placeholder-play {
		width: 34px;
		height: 34px;
		display: grid;
		place-items: center;
		margin-bottom: 8px;
		border: 1px solid var(--c-accent);
		border-radius: 50%;
		color: var(--c-accent);
		font-size: 10px;
	}

	.video-placeholder p {
		margin: 0 0 7px;
		font-size: clamp(14px, 2vw, 19px);
		font-weight: 700;
		letter-spacing: -0.03em;
	}

	.placeholder-caption,
	.ad-space > span,
	.card-index,
	.card-status {
		color: var(--c-muted);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.video-placeholder .placeholder-caption {
		color: #FFFFFF;
	}

	.audio-bar {
		min-height: 124px;
		flex: 1;
		display: grid;
		grid-template-columns: 32px minmax(0, 1fr);
		align-content: center;
		align-items: center;
		gap: 9px 12px;
		padding: 12px 16px;
	}

	.listener-stats {
		display: flex;
		justify-content: flex-start;
		padding: 8px 16px 10px;
		border-top: 1px solid rgb(255 255 243 / 14%);
		background: rgb(20 20 18 / 70%);
		color: var(--c-on-stage-muted);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.listener-stats strong {
		margin-left: 5px;
		color: var(--c-accent);
		font-size: 12px;
		letter-spacing: 0;
	}

	.icon,
	.card-symbol {
		color: var(--c-accent);
	}

	.icon {
		font-size: 26px;
	}

	.audio-copy {
		min-width: 0;
		flex: 1;
		display: grid;
		gap: 4px;
	}

	.audio-copy strong {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		font-size: 14px;
		line-height: 1.4;
		overflow-wrap: anywhere;
	}

	.audio-copy span {
		overflow-wrap: anywhere;
		color: var(--c-on-stage-muted);
		font-size: 12px;
	}

	.audio-player {
		grid-column: 1 / -1;
		width: 100%;
		max-width: 320px;
		justify-self: center;
	}

	/* The OZ Video.js theme is light by default; flip its palette for the dark broadcast panel. */
	.broadcast :global(.video-js.vjs-oz) {
		--oz-surface: #141412;
		--oz-ink: #FFFFF3;
		--oz-muted: #A8A89C;
		--oz-line: rgb(255 255 243 / 18%);
		--oz-accent-soft: rgb(242 189 87 / 18%);
	}

	/* The Video.js player shows the track metadata itself, so it takes the whole bar. */
	.audio-bar.has-videojs {
		display: flex;
		padding: 16px 18px;
	}

	.audio-bar.has-videojs .icon,
	.audio-bar.has-videojs .audio-copy {
		display: none;
	}

	.audio-bar.has-videojs .audio-player {
		max-width: none;
		min-width: 0;
		min-height: 0;
		align-self: stretch;
		flex: 1;
		display: flex;
	}

	audio {
		width: 100%;
		height: 34px;
	}

	.play-icon {
		width: 30px;
		height: 30px;
		display: grid;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 50%;
		background: var(--c-accent);
		color: var(--c-on-accent);
		font-size: 9px;
	}

	.ad-space {
		min-height: 62px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 18px;
		padding: 10px 14px;
		border: 2px dashed color-mix(in srgb, var(--c-outline) 30%, transparent);
		border-radius: var(--box-radius);
		background: var(--c-surface);
	}

	.ad-space strong {
		font-size: 12px;
		font-weight: 600;
	}

	.ad-space > span {
		font-size: 7px;
	}

	.section-heading {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: clamp(16px, 3vh, 28px);
	}

	.section-heading .eyebrow {
		margin-bottom: 8px;
	}

	.section-heading h2 {
		max-width: 680px;
		margin: 0;
		font-size: clamp(30px, 5.4vw, 58px);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 0.98;
	}

	.section-deck {
		max-width: 210px;
	}

	.feature-grid {
		display: grid;
		gap: 18px;
		
	}

	.activity-grid {
		--activity-column-count: var(--activity-desktop-columns);
		min-height: 0;
		display: grid;
		flex: 1 1 0;
		grid-template-columns: repeat(var(--activity-column-count), minmax(0, 1fr));
		align-items: start;
		gap: 18px;
		overflow-x: hidden;
		overflow-y: auto;
		/* Room for the cards' block shadow and hover lift. */
		padding: 6px 12px calc(var(--box-offset) + 10px) 4px;
		overscroll-behavior-y: contain;
		scroll-behavior: smooth;
		scrollbar-color: var(--c-scrollbar) transparent;
		scrollbar-gutter: stable;
		scrollbar-width: thin;
	}

	.feature-card {
		min-width: 0;
		overflow: hidden;
		border: var(--box-border);
		border-radius: var(--box-radius);
		background: var(--c-surface);
		box-shadow: var(--box-shadow);
	}

	.program-carousel {
		width: 100%;
	}

	.announcer-marquee {
		width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		/* Room for the cards' block shadow and hover lift. */
		padding: 8px 0 calc(var(--box-offset) + 6px);
		scrollbar-width: none;
	}

	.announcer-marquee::-webkit-scrollbar {
		display: none;
	}

	.announcer-track {
		width: max-content;
		display: flex;
		animation: announcer-scroll 38s linear infinite;
	}

	.announcer-marquee:hover .announcer-track,
	.announcer-marquee.is-paused .announcer-track {
		animation-play-state: paused;
	}

	.announcer-group {
		width: max-content;
		flex: 0 0 auto;
		display: flex;
		gap: 18px;
		padding-right: 18px;
	}

	.announcer-card {
		position: relative;
		isolation: isolate;
		width: clamp(200px, 22vw, 250px);
		aspect-ratio: 4 / 5;
		flex: 0 0 auto;
		overflow: hidden;
		border: var(--box-border);
		border-radius: var(--box-radius);
		background: var(--c-stage-2);
		box-shadow: var(--box-shadow);
	}

	.announcer-card[data-announcer-card] {
		cursor: pointer;
		transform: perspective(900px) rotateX(var(--card-tilt-y, 0deg)) rotateY(var(--card-tilt-x, 0deg)) scale(var(--card-scale, 1));
		transform-style: preserve-3d;
		transition: transform 180ms ease, box-shadow 180ms ease;
	}

	.announcer-card[data-announcer-card]:hover {
		--card-scale: 1.04;
		box-shadow: var(--box-shadow-hover);
	}

	.screen-dark .announcer-card {
		border-color: var(--c-on-stage);
		box-shadow: var(--box-offset) var(--box-offset) 0 var(--c-accent);
	}

	.screen-dark .announcer-card[data-announcer-card]:hover {
		box-shadow: calc(var(--box-offset) + 2px) calc(var(--box-offset) + 2px) 0 var(--c-on-stage);
	}

	.announcer-card[data-announcer-card]:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 3px;
	}

	.announcer-card::after {
		position: absolute;
		z-index: -1;
		inset: 0;
		background: linear-gradient(to bottom, transparent 30%, rgb(0 0 0 / 18%) 52%, rgb(0 0 0 / 88%) 100%);
		opacity: 0;
		transition: opacity 180ms ease;
		content: '';
	}

	.announcer-card[data-announcer-card]:hover::after,
	.announcer-card[data-announcer-card]:focus-visible::after {
		opacity: 1;
	}

	.announcer-card img {
		position: absolute;
		z-index: -2;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
		transition: transform 320ms ease;
	}

	.announcer-card[data-announcer-card]:hover img,
	.announcer-card[data-announcer-card]:focus-visible img {
		transform: scale(1.04);
	}

	.announcer-card-copy {
		position: absolute;
		inset: auto 0 0;
		padding: 16px;
		color: var(--c-on-stage);
	}

	.announcer-card-copy .card-index {
		color: var(--c-accent);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.announcer-card-copy h3,
	.announcer-card-copy p {
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 180ms ease, transform 180ms ease;
	}

	.announcer-card[data-announcer-card]:hover h3,
	.announcer-card[data-announcer-card]:hover p,
	.announcer-card[data-announcer-card]:focus-visible h3,
	.announcer-card[data-announcer-card]:focus-visible p {
		opacity: 1;
		transform: translateY(0);
	}

	.announcer-card-copy h3 {
		margin: 8px 0 5px;
		font-size: clamp(17px, 2.1vw, 24px);
		letter-spacing: -0.02em;
	}

	.announcer-card-copy p {
		margin: 0;
		color: rgb(255 255 243 / 75%);
		font-size: 10px;
		line-height: 1.5;
	}

	@keyframes announcer-scroll {
		to { transform: translateX(-50%); }
	}

	/* Photos are 600×750, so capping the portrait at 300px wide keeps it at 2x density and sharp. */
	.announcer-dialog {
		--announcer-photo-width: min(300px, calc((min(90dvh, 520px) - 2px) * 0.8));
		width: min(680px, calc(100% - 28px));
		max-width: none;
		max-height: min(90dvh, 520px);
		padding: 0;
		overflow: hidden;
		border: 1px solid var(--c-line);
		border-radius: 4px;
		background: var(--c-surface);
		color: var(--c-text);
		box-shadow: 0 24px 80px rgb(0 0 0 / 55%);
	}

	.announcer-dialog[open] {
		display: grid;
		grid-template-columns: var(--announcer-photo-width) minmax(0, 1fr);
		animation: announcer-dialog-in 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.announcer-dialog::backdrop {
		background: rgb(0 0 0 / 78%);
		backdrop-filter: blur(3px);
		animation: backdrop-reveal 220ms ease-out both;
	}

	.announcer-dialog.is-closing {
		animation: announcer-dialog-out 180ms ease-in both;
	}

	.announcer-dialog.is-closing::backdrop {
		animation: backdrop-hide 180ms ease-in both;
	}

	.announcer-dialog-photo {
		position: relative;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		align-self: start;
		background: var(--c-stage-2);
	}

	.announcer-dialog-photo::after {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, transparent 70%, rgb(0 0 0 / 35%));
		content: '';
		pointer-events: none;
	}

	.announcer-dialog-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.announcer-dialog[open] .announcer-dialog-photo img {
		animation: announcer-photo-in 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.announcer-dialog-copy {
		position: relative;
		display: flex;
		flex-direction: column;
		max-height: min(90dvh, 520px);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: clamp(24px, 4vw, 38px) clamp(20px, 4vw, 34px);
	}

	.announcer-dialog-copy::before {
		width: 42px;
		height: 3px;
		margin-bottom: 18px;
		background: var(--c-accent);
		content: '';
		transform-origin: left;
	}

	.announcer-dialog-copy .eyebrow {
		margin: 0 40px 10px 0;
		color: var(--c-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.announcer-dialog-copy h2 {
		margin: 0 0 14px;
		font-size: clamp(26px, 4.4vw, 40px);
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.announcer-dialog-summary {
		margin: 0;
		color: var(--c-text-2);
		font-size: 14px;
		font-weight: 700;
		line-height: 1.6;
	}

	.announcer-dialog-body {
		margin-top: 16px;
		padding-top: 16px;
		border-top: 1px solid var(--c-line);
		color: var(--c-text-2);
		font-size: 14px;
		line-height: 1.7;
	}

	:global(.announcer-dialog-body > :first-child) {
		margin-top: 0;
	}

	:global(.announcer-dialog-body p),
	:global(.announcer-dialog-body ul),
	:global(.announcer-dialog-body ol) {
		margin: 0 0 1em;
	}

	:global(.announcer-dialog-body a) {
		color: var(--c-link);
		text-decoration: underline;
	}

	.announcer-dialog[open] .announcer-dialog-copy::before {
		animation: announcer-rule-in 420ms 120ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.announcer-dialog[open] .announcer-dialog-copy > * {
		animation: announcer-copy-in 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.announcer-dialog[open] .announcer-dialog-copy > :nth-child(1) { animation-delay: 100ms; }
	.announcer-dialog[open] .announcer-dialog-copy > :nth-child(2) { animation-delay: 150ms; }
	.announcer-dialog[open] .announcer-dialog-copy > :nth-child(3) { animation-delay: 200ms; }
	.announcer-dialog[open] .announcer-dialog-copy > :nth-child(4) { animation-delay: 250ms; }

	.announcer-dialog .dialog-close {
		position: absolute;
		z-index: 1;
		top: 12px;
		right: 12px;
	}

	@keyframes announcer-dialog-in {
		from {
			opacity: 0;
			transform: translateY(18px) scale(0.96);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes announcer-dialog-out {
		to {
			opacity: 0;
			transform: translateY(10px) scale(0.98);
		}
	}

	@keyframes announcer-photo-in {
		from {
			opacity: 0;
			transform: scale(1.06) translateX(-12px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes announcer-copy-in {
		from {
			opacity: 0;
			transform: translateX(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes announcer-rule-in {
		from { transform: scaleX(0); }
		to { transform: scaleX(1); }
	}

	@keyframes backdrop-hide {
		to { opacity: 0; }
	}

	@media (max-width: 560px) {
		.announcer-dialog {
			max-height: 90dvh;
			overflow-y: auto;
			overscroll-behavior: contain;
		}

		.announcer-dialog[open] {
			grid-template-columns: minmax(0, 1fr);
		}

		.announcer-dialog-photo {
			width: min(240px, 62vw);
			margin: 20px auto 0;
			border-radius: 3px;
		}

		.announcer-dialog-copy {
			max-height: none;
			overflow: visible;
		}
	}

	/* Program popup: the whole photo on the left, details on the right. The box takes the photo's shape:
	   the photo sets the height and width (via --program-ratio, set when it opens), and the details scroll beside it. */
	.program-dialog {
		--program-ratio: 1;
		--program-image-max-width: min(calc(100vw - 28px - clamp(320px, 32vw, 420px) - 2px), 820px);
		--program-image-height: min(calc(90dvh - 2px), 700px, calc(var(--program-image-max-width) / var(--program-ratio)));
		width: fit-content;
		max-width: calc(100% - 28px);
		max-height: none;
		padding: 0;
		overflow: hidden;
		border: 1px solid var(--c-line);
		border-radius: 4px;
		background: var(--c-surface);
		color: var(--c-text);
		box-shadow: 0 24px 80px rgb(0 0 0 / 55%);
	}

	.program-dialog[open] {
		display: grid;
		grid-template-columns: auto clamp(320px, 32vw, 420px);
		animation: announcer-dialog-in 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.program-dialog::backdrop {
		background: rgb(0 0 0 / 78%);
		backdrop-filter: blur(3px);
		animation: backdrop-reveal 220ms ease-out both;
	}

	.program-dialog.is-closing {
		animation: announcer-dialog-out 180ms ease-in both;
	}

	.program-dialog.is-closing::backdrop {
		animation: backdrop-hide 180ms ease-in both;
	}

	.program-dialog-media {
		display: grid;
		place-items: center;
		overflow: hidden;
		background: var(--c-stage-2);
	}

	.program-dialog-media img {
		display: block;
		width: auto;
		height: var(--program-image-height);
		aspect-ratio: var(--program-ratio);
	}

	.program-dialog[open] .program-dialog-media img {
		animation: announcer-photo-in 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	/* Size containment keeps the text from stretching the box; the photo decides its height. A very wide, short photo still leaves room to read. */
	.program-dialog-copy {
		contain: size;
		display: flex;
		flex-direction: column;
		min-height: min(420px, calc(90dvh - 2px));
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: clamp(24px, 4vw, 38px) clamp(20px, 4vw, 34px);
	}

	.program-dialog[open] .program-dialog-copy > * {
		animation: announcer-copy-in 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.program-dialog[open] .program-dialog-copy > :nth-child(1) { animation-delay: 100ms; }
	.program-dialog[open] .program-dialog-copy > :nth-child(2) { animation-delay: 150ms; }
	.program-dialog[open] .program-dialog-copy > :nth-child(3) { animation-delay: 200ms; }
	.program-dialog[open] .program-dialog-copy > :nth-child(4) { animation-delay: 250ms; }
	.program-dialog[open] .program-dialog-copy > :nth-child(5) { animation-delay: 300ms; }

	.program-dialog-copy .eyebrow {
		margin: 0 40px 10px 0;
		color: var(--c-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.program-dialog-copy h2 {
		margin: 0 0 18px;
		font-size: clamp(26px, 4.4vw, 40px);
		letter-spacing: -0.03em;
		line-height: 1.05;
		text-wrap: balance;
	}

	.program-dialog-block {
		margin: 0 0 18px;
	}

	.program-dialog-label {
		display: flex;
		align-items: center;
		gap: 6px;
		margin: 0 0 8px;
		color: var(--c-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.program-dialog-label svg {
		fill: none;
		stroke: var(--c-accent-strong);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.program-schedule,
	.program-hosts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.program-slot {
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		padding: 7px 12px;
		border: 1px solid var(--c-accent);
		border-radius: 999px;
		background: var(--c-accent-soft);
		font-size: 13px;
		line-height: 1.3;
	}

	.program-slot-days {
		font-weight: 700;
	}

	.program-slot-time {
		color: var(--c-text-2);
		font-variant-numeric: tabular-nums;
	}

	.program-slot-tba {
		border-style: dashed;
		background: transparent;
		color: var(--c-text-2);
	}

	.program-dialog-body {
		margin: 0 0 18px;
		color: var(--c-text-2);
		font-size: 14px;
		line-height: 1.7;
	}

	:global(.program-dialog-body > :first-child) {
		margin-top: 0;
	}

	:global(.program-dialog-body > :last-child) {
		margin-bottom: 0;
	}

	:global(.program-dialog-body p),
	:global(.program-dialog-body ul),
	:global(.program-dialog-body ol) {
		margin: 0 0 1em;
	}

	:global(.program-dialog-body a) {
		color: var(--c-link);
		text-decoration: underline;
	}

	.program-dialog-hosts {
		margin: auto 0 0;
		padding-top: 16px;
		border-top: 1px solid var(--c-line);
	}

	.program-dialog-hosts[hidden] {
		display: none;
	}

	.program-host {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 5px 14px 5px 5px;
		border: 1px solid var(--c-line);
		border-radius: 999px;
		background: var(--c-field);
		font-size: 13px;
		font-weight: 700;
	}

	.program-host img {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--c-stage-2);
		object-fit: cover;
		object-position: center 15%;
	}

	.program-dialog[open] .program-slot,
	.program-dialog[open] .program-host {
		animation: announcer-copy-in 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.program-dialog[open] .program-slot:nth-child(2),
	.program-dialog[open] .program-host:nth-child(2) { animation-delay: 60ms; }
	.program-dialog[open] .program-slot:nth-child(3),
	.program-dialog[open] .program-host:nth-child(3) { animation-delay: 120ms; }

	.program-dialog .dialog-close {
		position: absolute;
		z-index: 2;
		top: 12px;
		right: 12px;
	}

	@media (max-width: 680px) {
		.program-dialog {
			width: calc(100% - 28px);
			max-height: 90dvh;
			overflow-y: auto;
			overscroll-behavior: contain;
		}

		.program-dialog[open] {
			grid-template-columns: minmax(0, 1fr);
		}

		.program-dialog-media img {
			width: 100%;
			height: auto;
		}

		.program-dialog-copy {
			contain: none;
			min-height: 0;
			overflow: visible;
		}
	}

	.program-slides {
		display: grid;
		align-items: start;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.program-slide {
		position: relative;
		isolation: isolate;
		min-width: 0;
		aspect-ratio: 5 / 4;
		overflow: hidden;
		border: var(--box-border);
		border-radius: var(--box-radius);
		background: var(--c-surface);
		box-shadow: var(--box-shadow);
	}

	.program-slide[data-program-card],
	.activity-card[data-article-card],
	.lead-story[data-article-card] {
		cursor: pointer;
	}

	.program-slide[data-program-card]:hover,
	.activity-card[data-article-card]:hover,
	.lead-story[data-article-card]:hover {
		box-shadow: var(--box-shadow-hover);
	}

	.lead-story[data-article-card] {
		transition: box-shadow 180ms ease;
	}

	.program-slide[data-program-card] {
		transform: perspective(900px) rotateX(var(--card-tilt-y, 0deg)) rotateY(var(--card-tilt-x, 0deg)) scale(var(--card-scale, 1));
		transform-style: preserve-3d;
		transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
	}

	.program-slide[data-program-card]:hover {
		--card-scale: 1.04;
	}

	.program-slide[data-program-card]:focus-visible,
	.activity-card[data-article-card]:focus-visible,
	.lead-story[data-article-card]:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 3px;
	}

	.program-slide.from-next {
		animation: program-slide-from-next 420ms ease both;
	}

	.program-slide.from-previous {
		animation: program-slide-from-previous 420ms ease both;
	}

	.program-slide[hidden] {
		display: none;
	}

	.program-slide img {
		position: absolute;
		z-index: -2;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Text stays in the DOM for the article popup and screen readers, but is not shown on the card. */
	.program-slide-copy {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Carousel chevrons sit on the left and right edges, in the same outlined, hard-shadow style as the cards. */
	.carousel-stage {
		position: relative;
	}

	.carousel-chevron {
		--chevron-size: 46px;
		position: absolute;
		z-index: 2;
		top: 50%;
		width: var(--chevron-size);
		height: var(--chevron-size);
		display: grid;
		place-items: center;
		padding: 0;
		border: var(--box-border);
		border-radius: 50%;
		background: var(--c-surface);
		box-shadow: 4px 4px 0 var(--c-shadow);
		color: var(--c-text);
		cursor: pointer;
		translate: 0 -50%;
		transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
	}

	.carousel-chevron-previous {
		left: calc(var(--chevron-size) / -2);
	}

	.carousel-chevron-next {
		right: calc(var(--chevron-size) / -2);
	}

	/* Inside a card or next to another column there's no margin to hang over, so these sit just inside the edge. */
	.carousel-chevron-inset {
		--chevron-size: 38px;
	}

	.carousel-chevron-previous.carousel-chevron-inset {
		left: 10px;
	}

	.carousel-chevron-next.carousel-chevron-inset {
		right: 10px;
	}

	.carousel-chevron[hidden] {
		display: none;
	}

	.carousel-chevron svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 3;
		stroke-linecap: square;
	}

	.carousel-chevron:hover {
		background: var(--c-accent-soft);
		box-shadow: 6px 6px 0 var(--c-accent);
		transform: translate(-2px, -2px);
	}

	.carousel-chevron:active {
		box-shadow: 0 0 0 var(--c-shadow);
		transform: translate(4px, 4px);
	}

	.carousel-chevron-inset svg {
		width: 18px;
		height: 18px;
	}

	.carousel-chevron:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 3px;
	}

	.program-carousel-controls,
	.program-pagination {
		display: flex;
		align-items: center;
	}

	.program-carousel-controls {
		justify-content: space-between;
		gap: 16px;
