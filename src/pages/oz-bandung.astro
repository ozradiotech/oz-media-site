	}

	.program-dot:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 4px;
	}

	.program-count {
		color: var(--c-muted);
		font-size: 9px;
		font-variant-numeric: tabular-nums;
	}

	@keyframes program-slide-from-next {
		from { opacity: 0.65; translate: 28px 0; }
		to { opacity: 1; translate: 0 0; }
	}

	@keyframes program-slide-from-previous {
		from { opacity: 0.65; translate: -28px 0; }
		to { opacity: 1; translate: 0 0; }
	}

	.card-index {
