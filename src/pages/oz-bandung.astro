	.section-heading .eyebrow {
		margin-bottom: 8px;
	}

	.section-heading h2 {
		max-width: 680px;
		margin: 0;
		font-size: clamp(30px, 5.4vw, 58px);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 0.98;
	}

	.section-deck {
		max-width: 210px;
	}

	.feature-grid {
		display: grid;
		gap: 18px;
		
	}

	.activity-grid {
		--activity-column-count: var(--activity-desktop-columns);
		min-height: 0;
		display: grid;
		flex: 1 1 0;
		grid-template-columns: repeat(var(--activity-column-count), minmax(0, 1fr));
		align-items: start;
		gap: 18px;
		overflow-x: hidden;
		overflow-y: auto;
		/* Room for the cards' block shadow and hover lift. */
		padding: 6px 12px calc(var(--box-offset) + 10px) 4px;
		overscroll-behavior-y: contain;
		scroll-behavior: smooth;
		scrollbar-color: #B8B8AA transparent;
		scrollbar-gutter: stable;
		scrollbar-width: thin;
	}

	.feature-card {
		min-width: 0;
		overflow: hidden;
		border: var(--box-border);
		border-radius: var(--box-radius);
		background: #FFFFF3;
		box-shadow: var(--box-shadow);
	}

	.program-carousel {
		width: 100%;
	}

	.announcer-marquee {
		width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		/* Room for the cards' block shadow and hover lift. */
		padding: 8px 0 calc(var(--box-offset) + 6px);
		scrollbar-width: none;
	}

	.announcer-marquee::-webkit-scrollbar {
		display: none;
	}

	.announcer-track {
		width: max-content;
		display: flex;
		animation: announcer-scroll 38s linear infinite;
	}

	.announcer-marquee:hover .announcer-track,
	.announcer-marquee.is-paused .announcer-track {
		animation-play-state: paused;
	}

	.announcer-group {
		width: max-content;
		flex: 0 0 auto;
		display: flex;
		gap: 18px;
		padding-right: 18px;
	}

	.announcer-card {
		position: relative;
		isolation: isolate;
		width: clamp(200px, 22vw, 250px);
		aspect-ratio: 4 / 5;
		flex: 0 0 auto;
		overflow: hidden;
		border: var(--box-border);
		border-radius: var(--box-radius);
		background: #20201D;
		box-shadow: var(--box-shadow);
	}

	.announcer-card[data-announcer-card] {
		cursor: pointer;
		transform: perspective(900px) rotateX(var(--card-tilt-y, 0deg)) rotateY(var(--card-tilt-x, 0deg)) scale(var(--card-scale, 1));
		transform-style: preserve-3d;
		transition: transform 180ms ease, box-shadow 180ms ease;
	}

	.announcer-card[data-announcer-card]:hover {
		--card-scale: 1.04;
		box-shadow: var(--box-shadow-hover);
	}

	.screen-dark .announcer-card {
		border-color: #FFFFF3;
		box-shadow: var(--box-offset) var(--box-offset) 0 #f2bd57;
	}

	.screen-dark .announcer-card[data-announcer-card]:hover {
		box-shadow: calc(var(--box-offset) + 2px) calc(var(--box-offset) + 2px) 0 #FFFFF3;
	}

	.announcer-card[data-announcer-card]:focus-visible {
		outline: 2px solid #f2bd57;
		outline-offset: 3px;
	}

	.announcer-card::after {
		position: absolute;
		z-index: -1;
		inset: 0;
		background: linear-gradient(to bottom, transparent 30%, rgb(0 0 0 / 18%) 52%, rgb(0 0 0 / 88%) 100%);
		opacity: 0;
		transition: opacity 180ms ease;
		content: '';
	}

	.announcer-card[data-announcer-card]:hover::after,
	.announcer-card[data-announcer-card]:focus-visible::after {
		opacity: 1;
	}

	.announcer-card img {
		position: absolute;
		z-index: -2;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
		transition: transform 320ms ease;
	}

	.announcer-card[data-announcer-card]:hover img,
	.announcer-card[data-announcer-card]:focus-visible img {
		transform: scale(1.04);
	}

	.announcer-card-copy {
		position: absolute;
		inset: auto 0 0;
		padding: 16px;
		color: #FFFFF3;
	}

	.announcer-card-copy .card-index {
		color: #f2bd57;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.announcer-card-copy h3,
	.announcer-card-copy p {
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 180ms ease, transform 180ms ease;
	}

	.announcer-card[data-announcer-card]:hover h3,
	.announcer-card[data-announcer-card]:hover p,
	.announcer-card[data-announcer-card]:focus-visible h3,
	.announcer-card[data-announcer-card]:focus-visible p {
		opacity: 1;
		transform: translateY(0);
	}

	.announcer-card-copy h3 {
		margin: 8px 0 5px;
		font-size: clamp(17px, 2.1vw, 24px);
		letter-spacing: -0.02em;
	}

	.announcer-card-copy p {
		margin: 0;
		color: rgb(255 255 243 / 75%);
		font-size: 10px;
		line-height: 1.5;
	}

	@keyframes announcer-scroll {
		to { transform: translateX(-50%); }
	}

	/* Photos are 600×750, so capping the portrait at 300px wide keeps it at 2x density and sharp. */
	.announcer-dialog {
		--announcer-photo-width: min(300px, calc((min(90dvh, 520px) - 2px) * 0.8));
		width: min(680px, calc(100% - 28px));
		max-width: none;
		max-height: min(90dvh, 520px);
		padding: 0;
		overflow: hidden;
		border: 1px solid #D8D8CC;
