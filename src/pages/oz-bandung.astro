---
import SectionNav from '../components/SectionNav.astro';

const audioStreamUrl = '';
const twitchChannel = '';
const youtubeChannelUrl = '';
const instagramUrl = '';

const sections = [
	{ id: 'listen', label: 'ON AIR' },
	{ id: 'programs', label: 'PROGRAMS' },
	{ id: 'online', label: 'ONLINE' },
	{ id: 'activities', label: 'ON GROUND' },
	{ id: 'news', label: 'OZ-NEWS' },
	{ id: 'contact', label: 'CONTACT' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#181714" />
		<meta name="description" content="Listen, watch and connect with OZ Radio Bandung." />
		<title>OZ Bandung — OZ Radio</title>
	</head>
	<body>
		<main class="bandung-page">
			<section class="screen listen-screen" id="listen" aria-labelledby="listen-title">
				<header class="topbar">
					<a class="wordmark" href="/" aria-label="OZ Radio home">O<span>Z</span></a>
					<span class="location-tag"><span class="live-dot"></span> BANDUNG, WEST JAVA</span>
				</header>

				<div class="screen-content listen-content">
					<div class="screen-heading listen-heading">
						<div>
							<p class="eyebrow">PLACEHOLDER · 01</p>
							<h1 id="listen-title">OZ Radio <span>Bandung</span></h1>
						</div>
					</div>

					<div class="broadcast" aria-label="OZ Bandung broadcast">
						<div class="broadcast-heading">
							<div class="broadcast-label"><span class="live-dot idle-dot"></span> LIVE FROM THE STUDIO</div>
							<span class="on-air">AUDIO + VIDEO</span>
						</div>
						<div class="video-frame">
							{twitchChannel ? (
								<iframe
									title="OZ Bandung Twitch livestream"
									data-twitch-channel={twitchChannel}
									allow="autoplay; fullscreen"
									allowfullscreen
								></iframe>
							) : (
								<div class="video-placeholder">
									<span class="placeholder-play" aria-hidden="true">▶</span>
									<p>Lorem ipsum dolor sit amet</p>
									<span class="placeholder-caption">TWITCH LIVESTREAM · CHANNEL TO BE ADDED</span>
								</div>
							)}
						</div>
						<div class="audio-bar">
							<span class="icon" aria-hidden="true">♫</span>
							<div class="audio-copy">
								<strong>OZ Bandung Radio</strong>
								<span>{audioStreamUrl ? 'Streaming now' : 'Audio stream link coming soon'}</span>
							</div>
							{audioStreamUrl ? (
								<audio controls preload="none" src={audioStreamUrl} aria-label="OZ Bandung audio stream">
									Your browser does not support audio playback.
								</audio>
							) : (
								<span class="play-icon" aria-hidden="true">▶</span>
							)}
						</div>
					</div>

					<aside class="ad-space" aria-label="Advertisement space">
						<span class="ad-tag">ADVERTISEMENT</span>
						<strong>Advertisement.</strong>
						<span>AD SPACE · BANDUNG</span>
					</aside>
				</div>

				<SectionNav sections={sections} current="listen" />
			</section>

			<section class="screen" id="programs" aria-labelledby="programs-title">
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">02 / ON AIR PROGRAM</p>
							<h2 id="programs-title">Our<span> on air</span> program</h2>
						</div>
						<p class="section-deck">Placeholder for general description.</p>
					</div>
					<div class="feature-grid program-grid">
						<article class="feature-card program-card">
							<span class="card-index">01 / TYPE</span>
							<span class="card-symbol" aria-hidden="true">♫</span>
							<div><h3>OZ Riental</h3><p>Description.</p></div>
							<span class="card-status">PROGRAM DETAILS COMING SOON</span>
						</article>
						<article class="feature-card program-card">
							<span class="card-index">02 / TYPE</span>
							<span class="card-symbol" aria-hidden="true">◌</span>
							<div><h3>OZ We Go</h3><p>Description.</p></div>
							<span class="card-status">PROGRAM DETAILS COMING SOON</span>
						</article>
						<article class="feature-card program-card">
							<span class="card-index">03 / TYPE</span>
							<span class="card-symbol" aria-hidden="true">✳</span>
							<div><h3>Morning Rush</h3><p>Description.</p></div>
							<span class="card-status">PROGRAM DETAILS COMING SOON</span>
						</article>
						<article class="feature-card program-card">
							<span class="card-index">04 / TYPE</span>
							<span class="card-symbol" aria-hidden="true">♫</span>
							<div><h3>Main Aman</h3><p>Description.</p></div>
							<span class="card-status">PROGRAM DETAILS COMING SOON</span>
						</article>
						<article class="feature-card program-card">
							<span class="card-index">05 / TYPE</span>
							<span class="card-symbol" aria-hidden="true">◌</span>
							<div><h3>Thursday Nite Club</h3><p>Description.</p></div>
							<span class="card-status">PROGRAM DETAILS COMING SOON</span>
						</article>
						<article class="feature-card program-card">
							<span class="card-index">06 / TYPE</span>
							<span class="card-symbol" aria-hidden="true">✳</span>
							<div><h3>Miming Bebeg</h3><p>Description.</p></div>
							<span class="card-status">PROGRAM DETAILS COMING SOON</span>
						</article>
					</div>
				</div>
				<SectionNav sections={sections} current="programs" />
			</section>

			<section class="screen" id="online" aria-labelledby="online-title">
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">03 / ONLINE</p>
							<h2 id="online-title">Online <span>digital</span></h2>
						</div>
						<p class="section-deck">Placeholder for general description.</p>
					</div>
					<div class="feature-grid social-grid">
						<article class="feature-card social-card youtube-card">
							<div class="social-topline"><span class="social-mark">▶</span><span>OZ RADIO BANDUNG · YOUTUBE</span></div>
							<div class="channel-preview">
								<span class="preview-play">▶</span>
								<span class="preview-caption">PODCASTS<br />&amp; LIVESTREAMS</span>
								<span class="preview-duration">CHANNEL PREVIEW</span>
							</div>
							<div class="social-card-bottom">
								<div><h3>Watch podcasts.</h3><p>Live sets, studio sessions and more from OZ Radio Bandung.</p></div>
								<a class="outline-link" href={youtubeChannelUrl || undefined} aria-disabled={!youtubeChannelUrl}>
									{youtubeChannelUrl ? 'VISIT YOUTUBE ↗' : 'CHANNEL LINK COMING SOON'}
								</a>
							</div>
						</article>
						<article class="feature-card social-card instagram-card">
							<div class="social-topline"><span class="social-mark instagram-mark">◎</span><span>OZ RADIO BANDUNG · INSTAGRAM</span></div>
							<div class="instagram-preview">
								<div class="insta-tile tile-one"><span>IMG</span></div>
								<div class="insta-tile tile-two"><span>IMG</span></div>
								<div class="insta-tile tile-three"><span>IMG</span></div>
							</div>
							<div class="social-card-bottom">
								<div><h3>Stay in the loop.</h3><p>Behind the scenes and everything.</p></div>
								<a class="outline-link" href={instagramUrl || undefined} aria-disabled={!instagramUrl}>
									{instagramUrl ? 'VISIT INSTAGRAM ↗' : 'PROFILE LINK COMING SOON'}
								</a>
							</div>
						</article>
					</div>
				</div>
				<SectionNav sections={sections} current="online" />
			</section>

			<section class="screen" id="activities" aria-labelledby="activities-title">
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">04 / ON GROUND ACTIVITY</p>
							<h2 id="activities-title">On ground <span>activity.</span></h2>
						</div>
						<p class="section-deck">Placeholder for general description.</p>
					</div>
					<div class="feature-grid activity-grid">
						<article class="feature-card activity-card">
							<div class="activity-art art-listen"><span>LISTEN<br />CLOSER</span></div>
							<div class="activity-info"><span class="card-index">LIVE MUSIC</span><h3>OZubathon</h3><p>Lorem ipsum dolor sit amet.</p><span class="card-status">UPCOMING EVENTS COMING SOON</span></div>
						</article>
						<article class="feature-card activity-card">
							<div class="activity-art art-meet"><span>MEET<br />IN PERSON</span></div>
							<div class="activity-info"><span class="card-index">COMMUNITY</span><h3>Siaran Di Cafe</h3><p>Lorem ipsum dolor sit amet.</p><span class="card-status">UPCOMING EVENTS COMING SOON</span></div>
						</article>
						<article class="feature-card activity-card">
							<div class="activity-art art-create"><span>MAKE<br />SOME NOISE</span></div>
							<div class="activity-info"><span class="card-index">WORKSHOPS</span><h3>Placeholder</h3><p>Lorem ipsum dolor sit amet.</p><span class="card-status">UPCOMING EVENTS COMING SOON</span></div>
						</article>
					</div>
				</div>
				<SectionNav sections={sections} current="activities" />
			</section>

			<section class="screen" id="news" aria-labelledby="news-title">
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">05 / OZ NEWS TODAY</p>
							<h2 id="news-title">OZ <span>News.</span></h2>
						</div>
						<p class="section-deck">Placeholder for general description.</p>
					</div>
					<div class="news-layout">
						<article class="feature-card lead-story">
							<div class="story-art"><span class="story-stamp">OZ<br />NEWS</span><span class="story-date">LATEST<br />FROM BDG</span></div>
							<div class="story-copy">
								<span class="card-index">THE LATEST · EDITORIAL</span>
								<h3>News title</h3>
								<p>Lorem ipsum dolor sit amet consectetur adipiscing elit.</p>
								<span class="card-status">FIRST STORY COMING SOON</span>
							</div>
						</article>
						<aside class="feature-card calendar-card">
							<div class="calendar-head"><span class="card-index">SAVE THE DATE</span><span class="calendar-icon">▦</span></div>
							<div class="calendar-date"><span>OZ NEWS</span><strong>Event<br />calendar.</strong></div>
							<div class="calendar-event"><span class="live-dot idle-dot"></span><div><strong>Next OZ Radio event</strong><span>Date and details to be announced</span></div></div>
							<a class="outline-link" href="#activities">EXPLORE ACTIVITIES ↓</a>
						</aside>
					</div>
				</div>
				<SectionNav sections={sections} current="news" />
			</section>

			<section class="screen contact-screen" id="contact" aria-labelledby="contact-title">
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">06 / LET'S TALK BUSINESS</p>
							<h2 id="contact-title">Contact <span>Information.</span></h2>
						</div>
						<p class="section-deck">Partnerships, collaborations, ideas — we’re listening.</p>
					</div>
					<div class="contact-layout">
						<div class="contact-intro"><span class="contact-mark">O<span>Z</span></span><p>Let’s make something meaningful together.</p><span class="card-status">CONTACT DETAILS TO BE ADDED</span></div>
						<div class="contact-details">
							<div class="contact-item"><span>EMAIL</span><strong>TBA</strong><small>Business &amp; general enquiries</small></div>
							<div class="contact-item"><span>PHONE / WHATSAPP</span><strong>TBA</strong><small>Reach the OZ team</small></div>
							<div class="contact-item"><span>STUDIO</span><strong>Bandung, West Java</strong><small>Full address coming soon</small></div>
							<div class="contact-item"><span>PARTNERSHIPS</span><strong>Let’s work together</strong><small>Contact information coming soon</small></div>
						</div>
					</div>
				</div>
				<SectionNav sections={sections} current="contact" />
				<footer class="contact-footer"><br /><span>FOOTER</span><br /></footer>
			</section>
		</main>
	</body>
</html>

<script>
	const twitchPlayer = document.querySelector<HTMLIFrameElement>('[data-twitch-channel]');
	const channel = twitchPlayer?.dataset.twitchChannel;

	if (twitchPlayer && channel) {
		const playerUrl = new URL('https://player.twitch.tv/');
		playerUrl.searchParams.set('channel', channel);
		playerUrl.searchParams.set('parent', window.location.hostname);
		playerUrl.searchParams.set('muted', 'true');
		twitchPlayer.src = playerUrl.toString();
	}
</script>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-block: 0;
	}

	:global(body) {
		margin: 0;
		background: #181714;
		color: #f5f1e8;
		font-family: Arial, Helvetica, sans-serif;
	}

	:global(a) {
		color: inherit;
	}

	.bandung-page {
		width: 100%;
	}

	.screen {
		width: min(1280px, 100%);
		height: 100svh;
		height: 100dvh;
		min-height: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 12px;
		overflow: hidden;
		margin: 0 auto;
		padding: clamp(14px, 3vh, 26px) clamp(20px, 5vw, 64px);
		border-bottom: 1px solid #37352f;
	}

	.topbar,
	.section-topline,
	.section-footer,
	.contact-footer {
		min-height: 28px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}

	.wordmark {
		font-size: 25px;
		font-weight: 900;
		letter-spacing: -0.09em;
		text-decoration: none;
	}

	.wordmark span,
	h1 span,
	.section-heading h2 span,
	.contact-mark > span {
		color: #f2bd57;
	}

	.back-link,
	.location-tag,
	.section-label,
	.section-footer,
	.contact-footer {
		color: #aaa59b;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-decoration: none;
	}

	.back-link:hover,
	.section-footer a:hover,
	.contact-footer a:hover {
		color: #f5f1e8;
	}

	.location-tag,
	.on-air,
	.broadcast-label {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.live-dot {
		width: 7px;
		height: 7px;
		flex: 0 0 auto;
		border-radius: 50%;
		background: #f2bd57;
		box-shadow: 0 0 0 4px rgba(242, 189, 87, 0.14);
	}

	.idle-dot {
		background: #77736b;
		box-shadow: 0 0 0 4px rgb(119 115 107 / 14%);
	}

	.screen-content {
		width: min(100%, 1050px);
		margin: auto;
	}

	.listen-content {
		max-width: 880px;
	}

	.screen-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: clamp(12px, 2vh, 20px);
	}

	.eyebrow {
		margin: 0 0 9px;
		color: #aaa59b;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.17em;
	}

	h1 {
		margin: 0;
		font-size: clamp(32px, 5vw, 56px);
		font-weight: 800;
		letter-spacing: -0.075em;
		line-height: 1;
	}

	.intro-copy,
	.section-deck {
		max-width: 240px;
		margin: 0;
		color: #aaa59b;
		font-size: 11px;
		line-height: 1.6;
	}

	.broadcast {
		overflow: hidden;
		border: 1px solid #37352f;
		border-radius: 4px;
		background: #201f1b;
	}

	.broadcast-heading {
		min-height: 36px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 0 13px;
	}

	.broadcast-label,
	.on-air,
	.broadcast-heading .on-air {
		color: #f2bd57;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.video-frame {
		width: 100%;
		aspect-ratio: 16 / 7;
		background:
			radial-gradient(ellipse at 50% 110%, rgba(242, 189, 87, 0.14), transparent 53%),
			#11110f;
	}

	.video-frame iframe {
		width: 100%;
		height: 100%;
		border: 0;
	}

	.video-placeholder {
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 10px;
		text-align: center;
	}

	.placeholder-play {
		width: 34px;
		height: 34px;
		display: grid;
		place-items: center;
		margin-bottom: 8px;
		border: 1px solid #f2bd57;
		border-radius: 50%;
		color: #f2bd57;
		font-size: 10px;
	}

	.video-placeholder p {
		margin: 0 0 7px;
		font-size: clamp(14px, 2vw, 19px);
		font-weight: 700;
		letter-spacing: -0.03em;
	}

	.placeholder-caption,
	.ad-space > span,
	.card-index,
	.card-status {
		color: #aaa59b;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.audio-bar {
		min-height: 56px;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 8px 13px;
		border-top: 1px solid #37352f;
	}

	.icon,
	.card-symbol {
		color: #f2bd57;
	}

	.icon {
		font-size: 18px;
	}

	.audio-copy {
		min-width: 0;
		flex: 1;
		display: grid;
		gap: 4px;
	}

	.audio-copy strong {
		font-size: 10px;
	}

	.audio-copy span {
		color: #aaa59b;
		font-size: 9px;
	}

	audio {
		width: min(260px, 42%);
		height: 34px;
	}

	.play-icon {
		width: 30px;
		height: 30px;
		display: grid;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 50%;
		background: #f2bd57;
		color: #181714;
		font-size: 9px;
	}

	.ad-space {
		min-height: 62px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 10px;
		padding: 10px 14px;
		border: 1px dashed #514b40;
		border-radius: 3px;
		background: #201f1b;
	}

	.ad-space strong {
		font-size: 12px;
		font-weight: 600;
	}

	.ad-space > span {
		font-size: 7px;
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: clamp(16px, 3vh, 28px);
	}

	.section-heading .eyebrow {
		margin-bottom: 8px;
	}

	.section-heading h2 {
		max-width: 680px;
		margin: 0;
		font-size: clamp(30px, 5.4vw, 58px);
		font-weight: 800;
		letter-spacing: -0.075em;
		line-height: 0.98;
	}

	.section-deck {
		max-width: 210px;
	}

	.feature-grid {
		display: grid;
		gap: 12px;
	}

	.program-grid,
	.activity-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.feature-card {
		min-width: 0;
		overflow: hidden;
		border: 1px solid #37352f;
		border-radius: 3px;
		background: #201f1b;
	}

	.program-card {
		min-height: clamp(218px, 32vh, 290px);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: clamp(14px, 2vw, 22px);
	}

	.card-index {
		font-size: 8px;
	}

	.card-symbol {
		font-size: clamp(27px, 4vw, 40px);
	}

	.feature-card h3 {
		margin: 0 0 7px;
		font-size: clamp(17px, 2.3vw, 24px);
		letter-spacing: -0.05em;
	}

	.feature-card p {
		margin: 0;
		color: #aaa59b;
		font-size: 10px;
		line-height: 1.6;
	}

	.card-status {
		display: block;
		padding-top: 11px;
		border-top: 1px solid #37352f;
		font-size: 7px;
	}

	.social-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.social-card {
		padding: clamp(12px, 2vw, 18px);
	}

	.social-topline {
		display: flex;
		align-items: center;
		gap: 9px;
		color: #aaa59b;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.09em;
	}

	.social-mark {
		color: #f2bd57;
		font-size: 15px;
	}

	.channel-preview {
		position: relative;
		aspect-ratio: 16 / 7;
		display: grid;
		place-items: center;
		overflow: hidden;
		margin: 12px 0;
		background:
			linear-gradient(130deg, transparent 46%, rgba(242, 189, 87, 0.16) 46% 48%, transparent 48%),
			radial-gradient(ellipse at 70% 120%, rgba(242, 189, 87, 0.26), transparent 50%),
			#12110f;
	}

	.preview-play {
		width: 37px;
		height: 37px;
		display: grid;
		place-items: center;
		border: 1px solid #f2bd57;
		border-radius: 50%;
		color: #f2bd57;
		font-size: 10px;
	}

	.preview-caption {
		position: absolute;
		top: 14px;
		left: 15px;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.13em;
		line-height: 1.6;
	}

	.preview-duration {
		position: absolute;
		right: 10px;
		bottom: 9px;
		color: #aaa59b;
		font-size: 7px;
		letter-spacing: 0.1em;
	}

