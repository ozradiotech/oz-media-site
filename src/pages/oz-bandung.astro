<script>
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const topbar = document.querySelector<HTMLElement>('[data-topbar]');
	const topbarLogo = topbar?.querySelector<HTMLElement>('[data-topbar-logo]');
	const heroLogo = hero?.querySelector<HTMLImageElement>('[data-hero-logo]');
	const heroNav = hero?.querySelector<HTMLElement>('[data-hero-nav]');

	if (hero && topbar && topbarLogo && heroLogo && heroNav) {
		type Box = { left: number; top: number; width: number; height: number };
		type MorphPair = { element: HTMLElement; slot: HTMLElement; dockedBox: Box; slotBox: Box };

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const topbarLinks = Array.from(topbar.querySelectorAll<HTMLElement>('[data-topbar-section-id]'));
		const heroLinks = Array.from(heroNav.querySelectorAll<HTMLElement>('[data-hero-section-id]'));
		const pairs: MorphPair[] = [
			{ element: topbarLogo, slot: heroLogo },
			...topbarLinks.flatMap((link) => {
				const slot = heroLinks.find((heroLink) => heroLink.dataset.heroSectionId === link.dataset.topbarSectionId);
				return slot ? [{ element: link, slot }] : [];
			}),
		].map((pair) => ({ ...pair, dockedBox: { left: 0, top: 0, width: 1, height: 1 }, slotBox: { left: 0, top: 0, width: 1, height: 1 } }));

		const dockOffset = 64;
		let morphDistance = 1;
		let currentProgress = -1;
		let targetProgress = 0;
		let frame = 0;

		const easeInOut = (value: number) => value < 0.5 ? 4 * value ** 3 : 1 - (-2 * value + 2) ** 3 / 2;
		const toBox = (rect: DOMRect, scrollY = 0): Box => ({ left: rect.left, top: rect.top + scrollY, width: rect.width || 1, height: rect.height || 1 });

		const measure = () => {
			topbar.classList.add('is-measuring');
			pairs.forEach((pair) => { pair.element.style.transform = ''; });
			pairs.forEach((pair) => {
				pair.dockedBox = toBox(pair.element.getBoundingClientRect());
				pair.slotBox = toBox(pair.slot.getBoundingClientRect(), window.scrollY);
			});
			topbar.classList.remove('is-measuring');
			morphDistance = Math.max(1, hero.offsetHeight - dockOffset);
			currentProgress = -1;
		};

		const render = (progress: number) => {
			const eased = easeInOut(progress);
			const isDocked = progress >= 1;
			topbar.classList.toggle('is-morphing', !isDocked);
			topbar.style.setProperty('--hero-progress', String(eased));
			hero.style.setProperty('--hero-progress', String(eased));
			pairs.forEach(({ element, dockedBox, slotBox }) => {
				if (isDocked) {
					element.style.transform = '';
					return;
				}
				// Start from where the slot sits at the top of the page, so items glide straight into the bar instead of scrolling off first.
				const slotTop = slotBox.top;
				const width = slotBox.width + (dockedBox.width - slotBox.width) * eased;
				const centerX = slotBox.left + slotBox.width / 2 + (dockedBox.left + dockedBox.width / 2 - slotBox.left - slotBox.width / 2) * eased;
				const centerY = slotTop + slotBox.height / 2 + (dockedBox.top + dockedBox.height / 2 - slotTop - slotBox.height / 2) * eased;
				const translateX = centerX - (dockedBox.left + dockedBox.width / 2);
				const translateY = centerY - (dockedBox.top + dockedBox.height / 2);
				element.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${width / dockedBox.width})`;
			});
		};

		const tick = () => {
			frame = 0;
			targetProgress = Math.min(1, Math.max(0, window.scrollY / morphDistance));
			const isFirstFrame = currentProgress < 0;
			const nextProgress = isFirstFrame || reducedMotion.matches
				? targetProgress
				: currentProgress + (targetProgress - currentProgress) * 0.22;
			const settledProgress = Math.abs(targetProgress - nextProgress) < 0.001 ? targetProgress : nextProgress;
			const hasMoved = settledProgress !== currentProgress;
			currentProgress = settledProgress;
			if (hasMoved) render(currentProgress);
			if (currentProgress !== targetProgress) frame = window.requestAnimationFrame(tick);
		};

		const requestTick = () => {
			if (!frame) frame = window.requestAnimationFrame(tick);
		};

		const remeasure = () => {
			window.cancelAnimationFrame(frame);
			measure();
			tick();
		};

		measure();
		document.documentElement.classList.add('has-hero-morph');
		heroNav.inert = true;
		tick();
		topbar.classList.add('is-entering');
		window.setTimeout(() => topbar.classList.remove('is-entering'), 1400);

		window.addEventListener('scroll', requestTick, { passive: true });
		window.addEventListener('resize', () => {
			window.cancelAnimationFrame(frame);
			frame = window.requestAnimationFrame(remeasure);
		});
		window.addEventListener('load', remeasure);
		document.fonts?.ready.then(remeasure);
		[heroLogo, topbarLogo.querySelector('img')].forEach((image) => {
			if (image instanceof HTMLImageElement && !image.complete) image.addEventListener('load', remeasure, { once: true });
		});
	}

	const topbarNavLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-topbar-section-id]'));
	if (topbarNavLinks.length) {
		const highlightTopbarLink = (sectionId: string) => {
			topbarNavLinks.forEach((link) => {
				if (link.dataset.topbarSectionId === sectionId) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
			});
			// On narrow screens the nav scrolls sideways; keep the current link in view.
			const currentLink = topbarNavLinks.find((link) => link.dataset.topbarSectionId === sectionId);
			const nav = currentLink?.parentElement;
			if (currentLink && nav && nav.scrollWidth > nav.clientWidth) {
				nav.scrollTo({
					left: currentLink.offsetLeft - nav.offsetLeft - (nav.clientWidth - currentLink.offsetWidth) / 2,
					behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
				});
			}
		};

		// A section is current while it crosses the middle of the viewport; the hero clears the highlight.
		const topbarSectionObserver = new IntersectionObserver((entries) => {
			const currentSection = entries.find((entry) => entry.isIntersecting);
			if (currentSection) highlightTopbarLink((currentSection.target as HTMLElement).id);
		}, { rootMargin: '-50% 0px -50% 0px' });

		document.querySelectorAll<HTMLElement>('[data-hero], .screen[id]').forEach((section) => topbarSectionObserver.observe(section));
	}

	const sectionNav = document.querySelector<HTMLElement>('[data-section-nav]');
	if (sectionNav) {
		const sectionLinks = Array.from(sectionNav.querySelectorAll<HTMLAnchorElement>('[data-section-id]'));
		const topbarSectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-topbar-section-id]'));
		const previousSectionLink = sectionNav.querySelector<HTMLAnchorElement>('[data-section-previous]');
		const nextSectionLink = sectionNav.querySelector<HTMLAnchorElement>('[data-section-next]');
		const sectionProgress = sectionNav.querySelector<HTMLElement>('[data-section-progress]');

		const updateSectionNavigation = (sectionId: string) => {
			const currentIndex = sectionLinks.findIndex((link) => link.dataset.sectionId === sectionId);
			if (currentIndex < 0) return;

			const previousSection = sectionLinks[currentIndex - 1];
			const nextSection = sectionLinks[currentIndex + 1];
			if (previousSectionLink) {
				previousSectionLink.href = previousSection ? `#${previousSection.dataset.sectionId}` : '/';
				previousSectionLink.textContent = previousSection ? `← ${previousSection.dataset.sectionLabel}` : '← ALL LOCATIONS';
			}
			if (nextSectionLink) {
				nextSectionLink.href = nextSection ? `#${nextSection.dataset.sectionId}` : '/oz-bali/';
				nextSectionLink.textContent = nextSection ? `${nextSection.dataset.sectionLabel} →` : 'NEXT: BALI →';
			}
			sectionProgress?.setAttribute('aria-label', `Section ${currentIndex + 1} of ${sectionLinks.length}`);
			sectionLinks.forEach((link, linkIndex) => {
				if (linkIndex === currentIndex) link.setAttribute('aria-current', 'step');
				else link.removeAttribute('aria-current');
			});
			topbarSectionLinks.forEach((link) => {
				if (link.dataset.topbarSectionId === sectionId) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
			});
		};

		const sectionObserver = new IntersectionObserver((entries) => {
			const visibleSection = entries
				.filter((entry) => entry.isIntersecting)
				.sort((first, second) => second.intersectionRatio - first.intersectionRatio)[0];
			if (visibleSection) updateSectionNavigation((visibleSection.target as HTMLElement).id);
		}, { threshold: 0.5 });

		document.querySelectorAll<HTMLElement>('.screen[id]').forEach((section) => sectionObserver.observe(section));
		updateSectionNavigation(window.location.hash.slice(1) || 'listen');
	}

	const youtubeCarousel = document.querySelector<HTMLElement>('[data-youtube-carousel]');
	const youtubePlayer = youtubeCarousel?.querySelector<HTMLElement>('[data-youtube-player]');
	const youtubeVideoButtons = youtubeCarousel?.querySelectorAll<HTMLButtonElement>('[data-youtube-video]');
	const youtubeCurrentTitle = youtubeCarousel?.querySelector<HTMLElement>('[data-youtube-current-title]');
	const youtubeCurrentCount = youtubeCarousel?.querySelector<HTMLElement>('[data-youtube-current-count]');

	if (youtubeCarousel && youtubePlayer && youtubeVideoButtons?.length && youtubeCurrentTitle && youtubeCurrentCount) {
		const videos = Array.from(youtubeVideoButtons, (button) => ({
			id: button.dataset.youtubeId ?? '',
			title: button.dataset.youtubeTitle ?? '',
		}));
		let currentVideoIndex = 0;
		// The YouTube player is heavy, so a thumbnail stands in until the visitor presses play.
		let isPlayerActivated = false;

		const loadVideoIframe = (video: { id: string; title: string }, autoplay: boolean) => {
			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(video.id)}${autoplay ? '?autoplay=1' : ''}`;
			iframe.title = video.title;
			iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			iframe.allowFullscreen = true;
			iframe.referrerPolicy = 'strict-origin-when-cross-origin';
			youtubePlayer.replaceChildren(iframe);
		};

		const showVideo = (index: number) => {
			currentVideoIndex = (index + videos.length) % videos.length;
			const video = videos[currentVideoIndex];

			youtubePlayer.replaceChildren();
			if (video.id && isPlayerActivated) {
				loadVideoIframe(video, false);
			} else if (video.id) {
				const facade = document.createElement('button');
				facade.type = 'button';
				facade.className = 'youtube-facade';
				facade.setAttribute('aria-label', `Play ${video.title}`);
				const thumbnail = document.createElement('img');
				thumbnail.src = `https://i.ytimg.com/vi/${encodeURIComponent(video.id)}/hqdefault.jpg`;
				thumbnail.alt = '';
				thumbnail.loading = 'lazy';
				thumbnail.decoding = 'async';
				const playIcon = document.createElement('span');
				playIcon.className = 'preview-play';
				playIcon.setAttribute('aria-hidden', 'true');
				playIcon.textContent = '▶';
				facade.append(thumbnail, playIcon);
				facade.addEventListener('click', () => {
					isPlayerActivated = true;
					loadVideoIframe(video, true);
				});
				youtubePlayer.append(facade);
			} else {
				const placeholder = document.createElement('div');
				placeholder.className = 'youtube-placeholder';
				placeholder.textContent = `Add a YouTube video ID for "${video.title}"`;
				youtubePlayer.append(placeholder);
			}

			youtubeCurrentTitle.textContent = video.title;
			youtubeCurrentCount.textContent = `${String(currentVideoIndex + 1).padStart(2, '0')} / ${String(videos.length).padStart(2, '0')}`;
			youtubeVideoButtons.forEach((button, buttonIndex) => {
				button.setAttribute('aria-pressed', String(buttonIndex === currentVideoIndex));
			});
		};

		youtubeCarousel.querySelector('[data-youtube-previous]')?.addEventListener('click', () => {
			showVideo(currentVideoIndex - 1);
		});
		youtubeCarousel.querySelector('[data-youtube-next]')?.addEventListener('click', () => {
			showVideo(currentVideoIndex + 1);
		});
		youtubeVideoButtons.forEach((button, index) => {
			button.addEventListener('click', () => showVideo(index));
		});
		showVideo(0);
	}

	// Instagram and TikTok embeds pull in large third-party scripts, so load them only when the section is near.
	const onlineSection = document.querySelector<HTMLElement>('#online');
	if (onlineSection) {
		const embedObserver = new IntersectionObserver((entries) => {
			if (!entries.some((entry) => entry.isIntersecting)) return;
			embedObserver.disconnect();
			['https://www.instagram.com/embed.js', 'https://www.tiktok.com/embed.js'].forEach((src) => {
				const script = document.createElement('script');
				script.src = src;
				script.async = true;
				document.body.append(script);
			});
		}, { rootMargin: '400px 0px' });
		embedObserver.observe(onlineSection);
	}

	const articleDialog = document.querySelector<HTMLDialogElement>('[data-article-dialog]');
	const programDialog = document.querySelector<HTMLDialogElement>('[data-program-dialog]');
	const newsListDialog = document.querySelector<HTMLDialogElement>('[data-news-list-dialog]');
	const activityGrid = document.querySelector<HTMLElement>('#activity-grid');
	const activityCards = activityGrid?.querySelectorAll<HTMLElement>('[data-activity-card]');
	if (activityGrid && activityCards?.length) {
		const cards = Array.from(activityCards);
		let lastLayoutWidth = 0;
		let lastColumnCount = 0;

		const layoutActivityCards = () => {
			const gridWidth = activityGrid.clientWidth;
			const columnCount = Number.parseInt(getComputedStyle(activityGrid).getPropertyValue('--activity-column-count'), 10) || 1;
			if (gridWidth === lastLayoutWidth && columnCount === lastColumnCount) return;
			lastLayoutWidth = gridWidth;
			lastColumnCount = columnCount;
			const columns = Array.from({ length: columnCount }, () => {
				const column = document.createElement('div');
				column.className = 'activity-column';
				return column;
			});

			activityGrid.replaceChildren(...columns);
			cards.forEach((card, index) => columns[index % columnCount].append(card));
			const cardHeights = new Map(cards.map((card) => [card, card.getBoundingClientRect().height]));
			const columnHeights = Array<number>(columnCount).fill(0);
			const columnGap = Number.parseFloat(getComputedStyle(columns[0]).rowGap) || 0;

			columns.forEach((column) => column.replaceChildren());
			cards.forEach((card) => {
				const shortestColumn = columnHeights.indexOf(Math.min(...columnHeights));
				columns[shortestColumn].append(card);
				columnHeights[shortestColumn] += (cardHeights.get(card) ?? 0) + columnGap;
			});
		};

		layoutActivityCards();

		let resizeFrame = 0;
		window.addEventListener('resize', () => {
			window.cancelAnimationFrame(resizeFrame);
			resizeFrame = window.requestAnimationFrame(layoutActivityCards);
		});
	}

	const announcerMarquee = document.querySelector<HTMLElement>('[data-announcer-marquee]');
	const announcerDialog = document.querySelector<HTMLDialogElement>('[data-announcer-dialog]');
	if (announcerMarquee) {
		let isMarqueeVisible = false;
		let isMarqueeFocused = false;
		const syncMarqueePause = () => {
			announcerMarquee.classList.toggle('is-paused', document.hidden || !isMarqueeVisible || isMarqueeFocused || Boolean(announcerDialog?.open));
		};
		syncMarqueePause();
		// Only keyboard focus pauses the strip. A clicked card keeps focus (and gets it back when its popup closes),
		// which would otherwise leave the strip stopped until the visitor clicked somewhere else.
		announcerMarquee.addEventListener('focusin', (event) => {
			isMarqueeFocused = event.target instanceof Element && event.target.matches(':focus-visible');
			syncMarqueePause();
		});
		announcerMarquee.addEventListener('focusout', (event) => {
			if (event.relatedTarget instanceof Node && announcerMarquee.contains(event.relatedTarget)) return;
			isMarqueeFocused = false;
			syncMarqueePause();
		});
		document.addEventListener('visibilitychange', syncMarqueePause);

		// Photos scrolling in from the side would otherwise load and decode mid-animation, so fetch them all just before the section appears.
		const preloadObserver = new IntersectionObserver((entries) => {
			if (!entries.some((entry) => entry.isIntersecting)) return;
			preloadObserver.disconnect();
			announcerMarquee.querySelectorAll('img').forEach((image) => { image.loading = 'eager'; });
		}, { rootMargin: '600px 0px' });
		preloadObserver.observe(announcerMarquee);

		// The animation keeps running off-screen unless it is paused.
		new IntersectionObserver((entries) => {
			isMarqueeVisible = entries.some((entry) => entry.isIntersecting);
			syncMarqueePause();
		}).observe(announcerMarquee);

		const announcerImage = announcerDialog?.querySelector<HTMLImageElement>('[data-announcer-image]');
		const announcerTitle = announcerDialog?.querySelector<HTMLElement>('[data-announcer-title]');
		const announcerSummary = announcerDialog?.querySelector<HTMLElement>('[data-announcer-summary]');
		const announcerBody = announcerDialog?.querySelector<HTMLElement>('[data-announcer-body-content]');
		if (announcerDialog && announcerImage && announcerTitle && announcerSummary && announcerBody) {
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

			const openAnnouncer = (card: HTMLElement) => {
				const image = card.querySelector<HTMLImageElement>('img');
				const name = card.querySelector('h3')?.textContent?.trim() ?? '';
				// The card photo is already loaded, so the popup reuses it from cache instead of fetching again.
				announcerImage.src = image?.currentSrc || image?.src || '';
				announcerImage.alt = image?.alt || name;
				announcerTitle.textContent = name;
				announcerSummary.textContent = card.querySelector('p')?.textContent?.trim() ?? '';
				announcerSummary.hidden = !announcerSummary.textContent;
				const bodyTemplate = card.querySelector<HTMLTemplateElement>('template[data-announcer-body]');
				announcerBody.replaceChildren(bodyTemplate?.content.cloneNode(true) ?? document.createDocumentFragment());
				announcerBody.hidden = !announcerBody.textContent?.trim();
				announcerDialog.classList.remove('is-closing');
				announcerDialog.showModal();
				syncMarqueePause();
			};

			const finishClose = (event: AnimationEvent) => {
				if (event.target !== announcerDialog || event.pseudoElement) return;
				announcerDialog.removeEventListener('animationend', finishClose);
				announcerDialog.close();
			};
			const closeAnnouncer = () => {
				if (!announcerDialog.open || announcerDialog.classList.contains('is-closing')) return;
				if (reducedMotion.matches) {
					announcerDialog.close();
					return;
				}
				announcerDialog.classList.add('is-closing');
				announcerDialog.addEventListener('animationend', finishClose);
			};

			// One delegated listener covers every card, including the duplicated marquee group.
			announcerMarquee.addEventListener('click', (event) => {
				const card = (event.target as Element).closest<HTMLElement>('[data-announcer-card]');
				if (card) openAnnouncer(card);
			});
			announcerMarquee.addEventListener('keydown', (event) => {
				if (event.key !== 'Enter' && event.key !== ' ') return;
				const card = (event.target as Element).closest<HTMLElement>('[data-announcer-card]');
				if (!card) return;
				event.preventDefault();
				openAnnouncer(card);
			});

			announcerDialog.querySelector('[data-announcer-close]')?.addEventListener('click', closeAnnouncer);
			announcerDialog.addEventListener('click', (event) => {
				if (event.target === announcerDialog) closeAnnouncer();
			});
			announcerDialog.addEventListener('cancel', (event) => {
				event.preventDefault();
				closeAnnouncer();
			});
			announcerDialog.addEventListener('close', () => {
				announcerDialog.classList.remove('is-closing');
				announcerDialog.removeEventListener('animationend', finishClose);
				syncMarqueePause();
				// Focus returning to a partly clipped card can scroll the clipped marquee sideways; the animation handles movement instead.
				announcerMarquee.scrollLeft = 0;
			});
		}
	}

	const programCarousel = document.querySelector<HTMLElement>('[data-program-carousel]');
	const programSlides = programCarousel?.querySelectorAll<HTMLElement>('[data-program-slide]');
	const programButtons = programCarousel?.querySelectorAll<HTMLButtonElement>('[data-program-index]');
	const programCount = programCarousel?.querySelector<HTMLElement>('[data-program-count]');

	if (programCarousel && programSlides?.length && programButtons?.length && programCount) {
		const programsPerPage = 3;
		const pageCount = Math.ceil(programSlides.length / programsPerPage);
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const autoplayDelay = 6000;
		let currentPageIndex = 0;
		let autoplayTimer: number | undefined;
		let isHovered = false;
		let isFocused = false;

		const showProgramPage = (index: number) => {
			const nextPageIndex = (index + pageCount) % pageCount;
			if (nextPageIndex === currentPageIndex) return;
			const direction = nextPageIndex < currentPageIndex ? -1 : 1;
			currentPageIndex = nextPageIndex;
			const firstProgramIndex = currentPageIndex * programsPerPage;
			const lastProgramIndex = Math.min(firstProgramIndex + programsPerPage, programSlides.length);
			programSlides.forEach((slide, slideIndex) => {
				const isActive = slideIndex >= firstProgramIndex && slideIndex < lastProgramIndex;
				slide.hidden = !isActive;
				slide.classList.toggle('is-active', isActive);
				slide.classList.toggle('from-next', isActive && direction > 0);
				slide.classList.toggle('from-previous', isActive && direction < 0);
			});
			programButtons.forEach((button, buttonIndex) => {
				button.setAttribute('aria-pressed', String(buttonIndex === currentPageIndex));
			});
			programCount.textContent = `${String(firstProgramIndex + 1).padStart(2, '0')}-${String(lastProgramIndex).padStart(2, '0')} / ${String(programSlides.length).padStart(2, '0')}`;
		};

		const stopAutoplay = () => {
			if (autoplayTimer !== undefined) window.clearTimeout(autoplayTimer);
			autoplayTimer = undefined;
		};
		const startAutoplay = () => {
			stopAutoplay();
			if (pageCount < 2 || reducedMotion.matches || document.hidden || isHovered || isFocused || articleDialog?.open || programDialog?.open || newsListDialog?.open) return;
			autoplayTimer = window.setTimeout(() => {
				showProgramPage(currentPageIndex + 1);
				startAutoplay();
			}, autoplayDelay);
		};

		programCarousel.querySelector('[data-program-previous]')?.addEventListener('click', () => {
			showProgramPage(currentPageIndex - 1);
			startAutoplay();
		});
		programCarousel.querySelector('[data-program-next]')?.addEventListener('click', () => {
			showProgramPage(currentPageIndex + 1);
			startAutoplay();
		});
		programButtons.forEach((button, index) => button.addEventListener('click', () => {
			showProgramPage(index);
			startAutoplay();
		}));
		programCarousel.addEventListener('pointerenter', () => {
			isHovered = true;
			stopAutoplay();
		});
		programCarousel.addEventListener('pointerleave', () => {
			isHovered = false;
			startAutoplay();
		});
		programCarousel.addEventListener('focusin', () => {
			isFocused = true;
			stopAutoplay();
		});
		programCarousel.addEventListener('focusout', (event) => {
			if (event.relatedTarget instanceof Node && programCarousel.contains(event.relatedTarget)) return;
			isFocused = false;
			startAutoplay();
		});
		document.addEventListener('visibilitychange', startAutoplay);
		reducedMotion.addEventListener('change', startAutoplay);
		articleDialog?.addEventListener('close', startAutoplay);
		programDialog?.addEventListener('close', startAutoplay);
		newsListDialog?.addEventListener('close', startAutoplay);
		startAutoplay();
	}

	const newsCarousel = document.querySelector<HTMLElement>('[data-news-carousel]');
	const newsSlides = newsCarousel?.querySelectorAll<HTMLElement>('[data-news-slide]');
	const newsCount = newsCarousel?.querySelector<HTMLElement>('[data-news-count]');
	const newsPrevious = newsCarousel?.querySelector<HTMLButtonElement>('[data-news-previous]');
	const newsNext = newsCarousel?.querySelector<HTMLButtonElement>('[data-news-next]');
	const newsListItems = newsListDialog?.querySelector<HTMLElement>('[data-news-list-items]');
	const newsListSort = newsListDialog?.querySelector<HTMLSelectElement>('[data-news-list-sort]');
	let pauseNewsAutoplay: (() => void) | undefined;

	if (newsCarousel && newsSlides?.length && newsCount && newsPrevious && newsNext) {
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const autoplayDelay = 6000;
		let currentNewsIndex = 0;
		let autoplayTimer: number | undefined;
		let isHovered = false;
		let isFocused = false;

		const showNewsSlide = (index: number, direction: 'next' | 'previous') => {
			currentNewsIndex = (index + newsSlides.length) % newsSlides.length;
			newsSlides.forEach((slide, slideIndex) => {
				const isActive = slideIndex === currentNewsIndex;
				slide.hidden = !isActive;
				slide.setAttribute('aria-hidden', String(!isActive));
				slide.classList.toggle('from-next', isActive && direction === 'next');
				slide.classList.toggle('from-previous', isActive && direction === 'previous');
			});
			newsCount.textContent = `${String(currentNewsIndex + 1).padStart(2, '0')} / ${String(newsSlides.length).padStart(2, '0')}`;
		};

		const stopAutoplay = () => {
			if (autoplayTimer !== undefined) window.clearTimeout(autoplayTimer);
			autoplayTimer = undefined;
		};
		const startAutoplay = () => {
			stopAutoplay();
			if (newsSlides.length < 2 || reducedMotion.matches || document.hidden || isHovered || isFocused || articleDialog?.open || newsListDialog?.open) return;
			autoplayTimer = window.setTimeout(() => {
				showNewsSlide(currentNewsIndex + 1, 'next');
				startAutoplay();
			}, autoplayDelay);
		};
		pauseNewsAutoplay = stopAutoplay;

		newsPrevious.addEventListener('click', () => {
			showNewsSlide(currentNewsIndex - 1, 'previous');
			startAutoplay();
		});
		newsNext.addEventListener('click', () => {
			showNewsSlide(currentNewsIndex + 1, 'next');
			startAutoplay();
		});
		newsCarousel.addEventListener('pointerenter', () => {
			isHovered = true;
			stopAutoplay();
		});
		newsCarousel.addEventListener('pointerleave', () => {
			isHovered = false;
			startAutoplay();
		});
		newsCarousel.addEventListener('focusin', () => {
			isFocused = true;
			stopAutoplay();
		});
		newsCarousel.addEventListener('focusout', (event) => {
			if (event.relatedTarget instanceof Node && newsCarousel.contains(event.relatedTarget)) return;
			isFocused = false;
			startAutoplay();
		});
		document.addEventListener('visibilitychange', startAutoplay);
		reducedMotion.addEventListener('change', startAutoplay);
		articleDialog?.addEventListener('close', startAutoplay);
		newsListDialog?.addEventListener('close', startAutoplay);
		showNewsSlide(0, 'next');
		startAutoplay();
	}

	newsListSort?.addEventListener('change', () => {
		if (!newsListItems || !newsListSort) return;
		const sortedItems = Array.from(newsListItems.querySelectorAll<HTMLButtonElement>('[data-news-list-item]'));
		sortedItems.sort((first, second) => {
			if (newsListSort.value === 'title') {
				return (first.dataset.newsTitle ?? '').localeCompare(second.dataset.newsTitle ?? '');
			}
			const firstDate = Number(first.dataset.newsDate ?? 0);
			const secondDate = Number(second.dataset.newsDate ?? 0);
			return newsListSort.value === 'oldest' ? firstDate - secondDate : secondDate - firstDate;
		});
		sortedItems.forEach((item) => newsListItems.append(item));
	});

	if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const tiltCards = [
			...(programSlides ?? []),
			...document.querySelectorAll<HTMLElement>('[data-announcer-card]'),
		];
		// Tilt ramps from 0 at the card's center to the max at its edges.
		const tiltMax = 9;
		const edgeTilt = (position: number) => (position - 0.5) * 2 * tiltMax;
		tiltCards.forEach((card) => {
			// Pointer events can fire several times per frame, so apply at most one tilt per frame.
			let tiltFrame = 0;
			let pointer = { x: 0, y: 0 };
			card.addEventListener('pointermove', (event) => {
				pointer = { x: event.clientX, y: event.clientY };
				if (tiltFrame) return;
				tiltFrame = window.requestAnimationFrame(() => {
					tiltFrame = 0;
					const bounds = card.getBoundingClientRect();
					const horizontalPosition = Math.min(Math.max((pointer.x - bounds.left) / bounds.width, 0), 1);
					const verticalPosition = Math.min(Math.max((pointer.y - bounds.top) / bounds.height, 0), 1);
					// The pressed edge sinks away from the viewer.
					card.style.setProperty('--card-tilt-x', `${edgeTilt(horizontalPosition)}deg`);
					card.style.setProperty('--card-tilt-y', `${-edgeTilt(verticalPosition)}deg`);
				});
			});

			const resetTilt = () => {
				window.cancelAnimationFrame(tiltFrame);
				tiltFrame = 0;
				card.style.removeProperty('--card-tilt-x');
				card.style.removeProperty('--card-tilt-y');
			};
			card.addEventListener('pointerleave', resetTilt);
			card.addEventListener('pointercancel', resetTilt);
		});
	}

	const articleImage = articleDialog?.querySelector<HTMLImageElement>('[data-article-image]');
	const articleCategory = articleDialog?.querySelector<HTMLElement>('[data-article-category]');
	const articleTitle = articleDialog?.querySelector<HTMLElement>('[data-article-title]');
	const articleDescription = articleDialog?.querySelector<HTMLElement>('[data-article-description]');
	const articleBody = articleDialog?.querySelector<HTMLElement>('[data-article-body-content]');
	const articleStatus = articleDialog?.querySelector<HTMLElement>('[data-article-status]');

	const openArticle = (card: HTMLElement) => {
		if (!articleDialog || !articleImage || !articleCategory || !articleTitle || !articleDescription || !articleBody || !articleStatus) return;
		const heading = card.querySelector<HTMLElement>('h3');
		const image = card.querySelector<HTMLImageElement>('img');
		if (!heading || !image) return;

		articleImage.src = image.currentSrc || image.src;
		articleImage.alt = heading.textContent?.trim() ?? '';
		articleCategory.textContent = card.querySelector('.card-index')?.textContent?.trim() ?? '';
		articleTitle.textContent = heading.textContent?.trim() ?? '';
		articleDescription.textContent = card.querySelector('p')?.textContent?.trim() ?? '';
		articleDescription.hidden = !articleDescription.textContent;
		const bodyTemplate = card.querySelector<HTMLTemplateElement>('template[data-article-body]');
		const body = bodyTemplate?.content.cloneNode(true) ?? document.createDocumentFragment();
		articleBody.replaceChildren(body);
		articleBody.hidden = !articleBody.textContent?.trim();
		const status = card.querySelector<HTMLElement>('.card-status');
		articleStatus.textContent = status?.textContent?.trim() ?? '';
		articleStatus.hidden = !articleStatus.textContent;
		articleDialog.showModal();
	};

	document.querySelectorAll<HTMLElement>('[data-article-card]').forEach((card) => {
		card.addEventListener('click', () => {
			if (newsListDialog?.contains(card)) {
				newsListDialog.close();
				window.requestAnimationFrame(() => {
					openArticle(card);
					pauseNewsAutoplay?.();
				});
				return;
			}
			pauseNewsAutoplay?.();
			openArticle(card);
		});
		if (!(card instanceof HTMLButtonElement)) {
			card.addEventListener('keydown', (event) => {
				if (event.key !== 'Enter' && event.key !== ' ') return;
				event.preventDefault();
				openArticle(card);
			});
		}
	});

	document.querySelector<HTMLButtonElement>('[data-news-list-open]')?.addEventListener('click', () => {
		pauseNewsAutoplay?.();
		newsListDialog?.showModal();
	});
	newsListDialog?.querySelector('[data-news-list-close]')?.addEventListener('click', () => newsListDialog.close());
	newsListDialog?.addEventListener('click', (event) => {
		if (event.target === newsListDialog) newsListDialog.close();
	});

	articleDialog?.querySelector('[data-article-close]')?.addEventListener('click', () => articleDialog.close());
	articleDialog?.addEventListener('click', (event) => {
		if (event.target === articleDialog) articleDialog.close();
	});

	const programImage = programDialog?.querySelector<HTMLImageElement>('[data-program-image]');
	const programMedia = programDialog?.querySelector<HTMLElement>('[data-program-media]');
	const programEyebrow = programDialog?.querySelector<HTMLElement>('[data-program-eyebrow]');
	const programTitle = programDialog?.querySelector<HTMLElement>('[data-program-title]');
	const programSchedule = programDialog?.querySelector<HTMLElement>('[data-program-schedule]');
	const programBody = programDialog?.querySelector<HTMLElement>('[data-program-body-content]');
	const programHostsBlock = programDialog?.querySelector<HTMLElement>('[data-program-hosts-block]');
	const programHosts = programDialog?.querySelector<HTMLElement>('[data-program-hosts]');

	if (programDialog && programImage && programMedia && programEyebrow && programTitle && programSchedule && programBody && programHostsBlock && programHosts) {
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const openProgram = (card: HTMLElement) => {
			const heading = card.querySelector<HTMLElement>('h3');
			const image = card.querySelector<HTMLImageElement>('img');
			if (!heading || !image) return;
			const title = heading.textContent?.trim() ?? '';
			const imageUrl = image.currentSrc || image.src;

			// The photo is shown whole (never cropped); the same photo, blurred, fills any leftover space.
			programImage.src = imageUrl;
			programImage.alt = image.alt || title;
			programMedia.style.setProperty('--program-backdrop', `url("${imageUrl}")`);
			programEyebrow.textContent = card.querySelector('.card-index')?.textContent?.trim() ?? '';
			programTitle.textContent = title;

			const meta = card.querySelector<HTMLTemplateElement>('template[data-program-meta]')?.content;
			const slots = Array.from(meta?.querySelectorAll('[data-program-schedule-items] > li') ?? []);
			if (slots.length) {
				programSchedule.replaceChildren(...slots.map((slot) => slot.cloneNode(true)));
			} else {
				const placeholder = document.createElement('li');
				placeholder.className = 'program-slot program-slot-tba';
				placeholder.textContent = 'Schedule to be announced';
				programSchedule.replaceChildren(placeholder);
			}

			const hosts = Array.from(meta?.querySelectorAll('[data-program-host-items] > li') ?? []);
			programHosts.replaceChildren(...hosts.map((host) => host.cloneNode(true)));
			programHostsBlock.hidden = !hosts.length;

			const bodyTemplate = card.querySelector<HTMLTemplateElement>('template[data-program-body]');
			programBody.replaceChildren(bodyTemplate?.content.cloneNode(true) ?? document.createDocumentFragment());
			programBody.hidden = !programBody.textContent?.trim();

			programDialog.classList.remove('is-closing');
			programDialog.showModal();
			programDialog.querySelector<HTMLElement>('.program-dialog-copy')?.scrollTo(0, 0);
		};

		const finishProgramClose = (event: AnimationEvent) => {
			if (event.target !== programDialog || event.pseudoElement) return;
			programDialog.removeEventListener('animationend', finishProgramClose);
			programDialog.close();
		};
		const closeProgram = () => {
			if (!programDialog.open || programDialog.classList.contains('is-closing')) return;
			if (reducedMotion.matches) {
				programDialog.close();
				return;
			}
			programDialog.classList.add('is-closing');
			programDialog.addEventListener('animationend', finishProgramClose);
		};

		document.querySelectorAll<HTMLElement>('[data-program-card]').forEach((card) => {
			card.addEventListener('click', () => openProgram(card));
			card.addEventListener('keydown', (event) => {
				if (event.key !== 'Enter' && event.key !== ' ') return;
				event.preventDefault();
				openProgram(card);
			});
		});

		programDialog.querySelector('[data-program-close]')?.addEventListener('click', closeProgram);
		programDialog.addEventListener('click', (event) => {
			if (event.target === programDialog) closeProgram();
		});
		programDialog.addEventListener('cancel', (event) => {
			event.preventDefault();
			closeProgram();
		});
		programDialog.addEventListener('close', () => {
			programDialog.classList.remove('is-closing');
			programDialog.removeEventListener('animationend', finishProgramClose);
		});
	}

	const tuneInButton = document.querySelector<HTMLButtonElement>('[data-tune-in]');
	const tuneInLabel = tuneInButton?.querySelector<HTMLElement>('[data-tune-in-label]');
	const broadcast = document.querySelector<HTMLElement>('.broadcast');
	const broadcastSelection = document.querySelector<HTMLElement>('[data-broadcast-selection]');
	const broadcastModeButtons = document.querySelectorAll<HTMLButtonElement>('[data-select-broadcast]');
	const broadcastPanels = document.querySelectorAll<HTMLElement>('[data-broadcast-panel]');
	const broadcastEmpty = document.querySelector<HTMLElement>('[data-broadcast-empty]');
	const listenerDialog = document.querySelector<HTMLDialogElement>('[data-listener-dialog]');
	const listenerForm = listenerDialog?.querySelector<HTMLFormElement>('[data-listener-form]');
	const listenerFields = listenerForm?.querySelector<HTMLElement>('[data-listener-fields]');
	const listenerConfirmation = listenerForm?.querySelector<HTMLElement>('[data-listener-confirmation]');
	const listenerSubmit = listenerForm?.querySelector<HTMLButtonElement>('[data-listener-submit]');
	const dialogTitle = listenerForm?.querySelector<HTMLElement>('[data-dialog-title]');
	const googleAuth = listenerForm?.querySelector<HTMLElement>('[data-google-auth]');
	const googleSignIn = googleAuth?.querySelector<HTMLButtonElement>('[data-google-signin]');
	const googleUser = googleAuth?.querySelector<HTMLElement>('[data-google-user]');
	const googleName = googleAuth?.querySelector<HTMLElement>('[data-google-name]');
	const googleAvatar = googleAuth?.querySelector<HTMLImageElement>('[data-google-avatar]');
	const googleSignOut = googleAuth?.querySelector<HTMLButtonElement>('[data-google-signout]');
	const googleAuthNote = googleAuth?.querySelector<HTMLElement>('[data-google-auth-note]');
	const livePlayer = document.querySelector<HTMLIFrameElement>('[data-youtube-live]');
	const audioPlayerContainer = document.querySelector<HTMLElement>('[data-audio-player]');
	const fallbackAudio = audioPlayerContainer?.querySelector<HTMLAudioElement>('audio');
	const trackTitle = document.querySelector<HTMLElement>('[data-track-title]');
	const trackArtist = document.querySelector<HTMLElement>('[data-track-artist]');
	const listenerCount = document.querySelector<HTMLElement>('[data-listener-count]');
	const listenerSessionKey = 'oz-listener-details-saved';
	let listenerDetailsSaved = false;
	try {
		listenerDetailsSaved = sessionStorage.getItem(listenerSessionKey) === 'true';
	} catch {}
	let selectedBroadcast: 'audio' | 'video' | null = null;
	let nowPlayingTimer: number | undefined;

	const stopNowPlayingUpdates = () => {
		if (nowPlayingTimer !== undefined) {
			window.clearInterval(nowPlayingTimer);
			nowPlayingTimer = undefined;
		}
	};

	const updateNowPlaying = async () => {
		if (!trackTitle || !trackArtist || !listenerCount) return;

		try {
			const response = await fetch('/api/now-playing', { cache: 'no-store' });
			if (!response.ok) throw new Error('Track title unavailable.');

			const data = (await response.json()) as {
				title?: unknown;
				listeners?: unknown;
			};
			const metadata = typeof data.title === 'string' ? data.title.trim() : '';
			listenerCount.textContent = typeof data.listeners === 'number' ? data.listeners.toLocaleString() : '—';
			const separatorIndex = metadata.lastIndexOf(' - ');
			if (separatorIndex > 0 && separatorIndex < metadata.length - 3) {
				trackTitle.textContent = metadata.slice(0, separatorIndex).trim();
				trackArtist.textContent = metadata.slice(separatorIndex + 3).trim();
			} else {
				trackTitle.textContent = metadata || 'Track title unavailable';
				trackArtist.textContent = '';
			}
		} catch {
			trackTitle.textContent = 'Track title unavailable';
			trackArtist.textContent = '';
			listenerCount.textContent = '—';
		}
		syncAudioPlayerTrack();
	};

	const startNowPlayingUpdates = () => {
		if (nowPlayingTimer !== undefined || !trackTitle || !trackArtist) return;
		void updateNowPlaying();
		nowPlayingTimer = window.setInterval(() => { void updateNowPlaying(); }, 30_000);
	};

	// Video.js drives the audio stream (see src/scripts/oz-audio-player.ts). It is only downloaded once a
	// visitor shows interest in tuning in; until then, or if it fails to load, the native <audio> element is used.
	type OzAudioPlayer = import('../scripts/oz-audio-player').OzAudioPlayer;
	let audioPlayer: OzAudioPlayer | undefined;
	let audioPlayerRequest: Promise<OzAudioPlayer | undefined> | undefined;

	const syncAudioPlayerTrack = () => {
		audioPlayer?.setTrack(trackTitle?.textContent?.trim() ?? '', trackArtist?.textContent?.trim() ?? '');
	};

	const loadAudioPlayer = () => {
		const streamUrl = audioPlayerContainer?.dataset.streamUrl;
		if (!audioPlayerContainer || !fallbackAudio || !streamUrl) return Promise.resolve(undefined);
		audioPlayerRequest ??= import('../scripts/oz-audio-player')
			.then(({ createOzAudioPlayer }) => {
				audioPlayerContainer.closest('.audio-bar')?.classList.add('has-videojs');
				audioPlayer = createOzAudioPlayer(fallbackAudio, streamUrl);
				syncAudioPlayerTrack();
				return audioPlayer;
			})
			.catch(() => undefined);
		return audioPlayerRequest;
	};

	const playAudio = () => {
		if (audioPlayer) {
			audioPlayer.play();
			return;
		}
		void loadAudioPlayer().then((player) => {
			// The visitor may have switched streams while the player was loading.
			if (selectedBroadcast !== 'audio' || !broadcast?.classList.contains('is-streaming')) return;
			if (player) player.play();
			else fallbackAudio?.play().catch(() => {});
		});
	};

	const pauseAudio = () => {
		if (audioPlayer) audioPlayer.pause();
		else fallbackAudio?.pause();
	};

	// Fetch the player ahead of time when a visitor heads for the tune-in button.
	tuneInButton?.addEventListener('pointerenter', () => { void loadAudioPlayer(); }, { once: true });
	tuneInButton?.addEventListener('focus', () => { void loadAudioPlayer(); }, { once: true });

	// These stay attached after the upgrade: Video.js plays through this same element.
	fallbackAudio?.addEventListener('play', startNowPlayingUpdates);
	fallbackAudio?.addEventListener('pause', stopNowPlayingUpdates);
	fallbackAudio?.addEventListener('ended', stopNowPlayingUpdates);

	const stopBroadcast = () => {
		stopNowPlayingUpdates();
		pauseAudio();
		livePlayer?.removeAttribute('src');
		broadcast?.classList.remove('is-streaming');
		if (tuneInLabel) tuneInLabel.textContent = 'Tune in';
		broadcastPanels.forEach((panel) => { panel.hidden = true; });
		if (broadcastEmpty) broadcastEmpty.hidden = false;
	};

	// Google sign-in (Firebase, see src/scripts/oz-auth.ts) unlocks playback. Like the player, the SDK is only
	// downloaded once a visitor heads for the tune-in button.
	type OzAuth = import('../scripts/oz-auth').OzAuth;
	type OzUser = import('../scripts/oz-auth').OzUser;
	let ozAuth: OzAuth | undefined;
	let authRequest: Promise<OzAuth | undefined> | undefined;

	const renderAuth = (user: OzUser | null) => {
		if (!googleSignIn || !googleUser || !googleName || !googleAvatar || !googleAuthNote) return;
		googleSignIn.hidden = Boolean(user);
		googleUser.hidden = !user;
		googleName.textContent = user?.displayName || user?.email || '';
		googleAvatar.hidden = !user?.photoURL;
		if (user?.photoURL) googleAvatar.src = user.photoURL;
		googleAuthNote.textContent = user ? '' : 'Sign in with Google to access the live stream and chat.';
		googleAuthNote.hidden = Boolean(user);
	};

	const showAuthError = (message: string) => {
		if (!googleAuthNote) return;
		googleAuthNote.textContent = message;
		googleAuthNote.hidden = false;
	};

	const loadAuth = () => {
		authRequest ??= import('../scripts/oz-auth')
			.then(({ createOzAuth }) => {
				ozAuth = createOzAuth();
				ozAuth.onChange((user) => {
					renderAuth(user);
					// Signing out ends playback.
					if (!user && broadcast?.classList.contains('is-streaming')) stopBroadcast();
				});
				return ozAuth;
			})
			.catch(() => undefined);
		return authRequest;
	};

	tuneInButton?.addEventListener('pointerenter', () => { void loadAuth(); }, { once: true });
	tuneInButton?.addEventListener('focus', () => { void loadAuth(); }, { once: true });

	// Live chat (src/scripts/oz-chat.ts) and the Firebase SDKs it needs load as the chat comes into view.
	// Anyone can read it; sending needs the same Google sign-in as playback.
	const liveChat = document.querySelector<HTMLElement>('[data-live-chat]');
	if (liveChat?.dataset.chatRoom) {
		const chatRoom = liveChat.dataset.chatRoom;
		const chatObserver = new IntersectionObserver((entries) => {
			if (!entries.some((entry) => entry.isIntersecting)) return;
			chatObserver.disconnect();
			import('../scripts/oz-chat')
				.then(({ mountOzChat }) => mountOzChat(liveChat, { room: chatRoom, loadAuth }))
				.catch(() => {
					const empty = liveChat.querySelector<HTMLElement>('[data-chat-empty]');
					if (empty) empty.textContent = 'Chat could not be loaded. Please reload the page.';
				});
		}, { rootMargin: '200px' });
		chatObserver.observe(liveChat);
	}

	const startBroadcast = () => {
		if (!selectedBroadcast || !ozAuth?.currentUser()) return;
		broadcast?.classList.add('is-streaming');
		if (tuneInLabel) tuneInLabel.textContent = 'Change stream';
		broadcastPanels.forEach((panel) => {
			panel.hidden = panel.dataset.broadcastPanel !== selectedBroadcast;
		});
		if (broadcastEmpty) broadcastEmpty.hidden = true;

		if (selectedBroadcast === 'audio') {
			startNowPlayingUpdates();
			playAudio();
			return;
		}

		// The iframe only gets its src here, so YouTube loads nothing until a signed-in visitor picks video.
		const embedUrl = livePlayer?.dataset.youtubeLive;
		if (livePlayer && embedUrl) {
			const playerUrl = new URL(embedUrl);
			// Sign-in is async, so the click no longer counts as a user gesture: autoplay only works muted.
			playerUrl.searchParams.set('autoplay', '1');
			playerUrl.searchParams.set('mute', '1');
			playerUrl.searchParams.set('playsinline', '1');
			playerUrl.searchParams.set('rel', '0');
			livePlayer.src = playerUrl.toString();
		}
	};

	tuneInButton?.addEventListener('click', () => {
		if (!listenerDialog || !listenerForm || !listenerFields || !listenerConfirmation || !listenerSubmit || !dialogTitle || !broadcastSelection || !googleAuth) return;
		stopBroadcast();
		selectedBroadcast = null;
		void loadAudioPlayer();
		void loadAuth();
		listenerForm.reset();
		listenerFields.hidden = true;
		googleAuth.hidden = true;
		if (googleSignIn) googleSignIn.disabled = false;
		listenerConfirmation.hidden = true;
		listenerConfirmation.replaceChildren();
		listenerSubmit.hidden = true;
		listenerSubmit.disabled = false;
		broadcastSelection.hidden = false;
		dialogTitle.textContent = 'Choose how to tune in';
		listenerDialog.showModal();
		broadcastModeButtons[0]?.focus();
	});

	broadcastModeButtons.forEach((button) => {
		button.addEventListener('click', async () => {
			if (!listenerDialog || !listenerFields || !listenerConfirmation || !listenerSubmit || !dialogTitle || !broadcastSelection || !googleAuth) return;
			selectedBroadcast = button.dataset.selectBroadcast === 'video' ? 'video' : 'audio';
			broadcastSelection.hidden = true;
			dialogTitle.textContent = 'Checking sign-in...';
			const auth = await loadAuth();
			const user = await auth?.ready().catch(() => null) ?? null;
			// The visitor may have closed the dialog while sign-in was loading.
			if (!listenerDialog.open) return;
			if (listenerDetailsSaved && user) {
				listenerDialog.close();
				startBroadcast();
				return;
			}

			renderAuth(user);
			if (!auth) {
				showAuthError('Google sign-in is unavailable right now. Please try again later.');
				if (googleSignIn) googleSignIn.disabled = true;
			}
			googleAuth.hidden = false;
			// Returning listeners only need to sign in; first-timers also fill in their details.
			listenerFields.hidden = listenerDetailsSaved;
			listenerFields.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => { field.disabled = listenerDetailsSaved; });
			listenerConfirmation.hidden = true;
			listenerSubmit.hidden = listenerDetailsSaved;
			listenerSubmit.textContent = 'Continue';
			dialogTitle.textContent = listenerDetailsSaved ? 'Sign in to tune in' : 'Before you tune in';
			if (listenerDetailsSaved) googleSignIn?.focus();
			else listenerFields.querySelector<HTMLInputElement>('input')?.focus();
		});
	});

	googleSignIn?.addEventListener('click', async () => {
		const auth = ozAuth ?? await loadAuth();
		if (!auth) {
			showAuthError('Google sign-in is unavailable right now. Please try again later.');
			return;
		}
		googleSignIn.disabled = true;
		try {
			const user = await auth.signIn();
			renderAuth(user);
			const nameField = listenerForm?.elements.namedItem('name');
			if (nameField instanceof HTMLInputElement && !nameField.value && user.displayName) nameField.value = user.displayName;
			if (listenerDetailsSaved) {
				listenerDialog?.close();
				startBroadcast();
			}
		} catch (error) {
			const code = error && typeof error === 'object' && 'code' in error ? error.code : undefined;
			if (code === 'auth/popup-closed-by-user' || code === 'auth/cancelled-popup-request') return;
			showAuthError(code === 'auth/popup-blocked'
				? 'Your browser blocked the sign-in window. Allow pop-ups for this site and try again.'
				: 'Google sign-in failed. Please try again.');
		} finally {
			googleSignIn.disabled = false;
		}
	});

	googleSignOut?.addEventListener('click', () => { void ozAuth?.signOut(); });

	listenerDialog?.querySelector('[data-dialog-close]')?.addEventListener('click', () => listenerDialog.close());

	listenerForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!listenerFields || !listenerConfirmation || !listenerSubmit || !dialogTitle) return;

		if (!listenerFields.hidden) {
			if (!listenerForm.reportValidity()) return;
			const user = ozAuth?.currentUser();
			if (!user) {
				showAuthError('Please sign in with Google to continue.');
				googleSignIn?.focus();
				return;
			}
			const listener = new FormData(listenerForm);
		listenerSubmit.disabled = true;
		listenerSubmit.textContent = 'Saving...';
		try {
			const response = await fetch('/api/listeners', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					name: String(listener.get('name')).trim(),
					age: Number(listener.get('age')),
					gender: listener.get('gender'),
					location: String(listener.get('location')).trim(),
					broadcast: selectedBroadcast,
					uid: user.uid,
					email: user.email,
				}),
			});
			if (!response.ok) throw new Error('Listener details could not be saved. Please try again.');
			listenerDetailsSaved = true;
			try {
				sessionStorage.setItem(listenerSessionKey, 'true');
			} catch {}
		} catch (error) {
			const message = document.createElement('p');
			message.textContent = error instanceof Error ? error.message : 'Listener details could not be saved. Please try again.';
			listenerConfirmation.replaceChildren(message);
			listenerConfirmation.hidden = false;
			listenerSubmit.disabled = false;
			listenerSubmit.textContent = 'Continue';
			return;
		}
		listenerSubmit.disabled = false;
			const details = [
				['Name', listener.get('name')],
				['Age', listener.get('age')],
				['Gender', listener.get('gender')],
				['Location', listener.get('location')],
			] as const;
			const message = document.createElement('p');
			message.textContent = `You are ready to ${selectedBroadcast === 'video' ? 'watch' : 'listen'}.`;
			const summary = document.createElement('dl');
			details.forEach(([label, value]) => {
				const term = document.createElement('dt');
				term.textContent = label;
				const description = document.createElement('dd');
				description.textContent = String(value ?? '');
				summary.append(term, description);
			});
			listenerConfirmation.replaceChildren(message, summary);
			listenerFields.hidden = true;
			listenerFields.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => { field.disabled = true; });
			if (googleAuth) googleAuth.hidden = true;
			listenerConfirmation.hidden = false;
			listenerSubmit.textContent = selectedBroadcast === 'video' ? 'Start watching' : 'Start listening';
			dialogTitle.textContent = 'You’re all set';
			return;
		}

		listenerDialog?.close();
		startBroadcast();
	});
</script>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global([hidden]) {
		display: none !important;
	}

	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-block: 64px 56px;
	}

	:global(body) {
		margin: 0;
		background: var(--paper-grain), #FFFFF3;
		color: #000000;
		font-family: var(--font-jakarta);
	}

	:global(a) {
		color: inherit;
	}

	.bandung-page {
		width: 100%;
	}

	.screen {
		width: min(2200px, 100%);
		height: 100svh;
		min-height: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 12px;
		overflow: hidden;
		margin: 0 auto;
		padding: calc(clamp(14px, 3vh, 26px) + 64px) clamp(32px, 6vw, 96px) calc(clamp(14px, 3vh, 26px) + 56px);
		border-bottom: 2px solid #000000;
	}

	/* Sections alternate cream / sand, with one dark band, so scrolling has a rhythm. */
	.screen-sand {
		background: var(--paper-grain), #F6EDD3;
	}

	.screen-dark {
		background: var(--paper-grain), #141412;
		color: #FFFFF3;
	}

	.screen-dark .eyebrow {
		color: #A8A89C;
	}

	/* Off-screen sections skip rendering; they already clip their overflow and have a fixed height, so nothing shifts. */
	.screen:not(.listen-screen) {
		content-visibility: auto;
	}

	#online.screen {
		justify-content: flex-start;
		overflow-y: auto;
	}

	#online .screen-content {
		flex: 0 0 auto;
	}

	.listen-screen {
		position: relative;
		isolation: isolate;
		overflow: visible;
	}

	.topbar,
	.section-topline,
	.section-footer {
		min-height: 28px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}

	.topbar {
		position: fixed;
		z-index: 1000;
		top: 0;
		left: 0;
		width: 100%;
		height: 64px;
		min-height: 64px;
		padding: 0 clamp(32px, 6vw, 96px);
		border-bottom: 1px solid #D8D8CC;
		background: #FFFFF3;
	}

	.topbar-nav {
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 4px;
		margin-left: auto;
	}

	.topbar-nav-link {
		min-height: 32px;
		display: inline-flex;
		align-items: center;
		padding: 0 9px;
		border: 1px solid transparent;
		border-radius: 3px;
		color: #77776F;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		white-space: nowrap;
		transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
	}

	.topbar-nav-link:hover,
	.topbar-nav-link:focus-visible {
		border-color: #D8D8CC;
		color: #000000;
		transform: translateY(-1px);
