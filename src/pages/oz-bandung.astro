		justify-content: center;
		padding: 7px 9px;
		border: 1.5px solid var(--c-outline);
		border-radius: 8px;
		color: var(--c-text);
		font-size: 7px;
		transition: box-shadow 160ms ease, transform 160ms ease;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-align: center;
		text-decoration: none;
	}

	.outline-link:not([aria-disabled='true']):hover {
		box-shadow: 3px 3px 0 var(--c-shadow);
		transform: translate(-1px, -1px);
	}

	.outline-link[aria-disabled='true'] {
		cursor: default;
		opacity: 0.8;
	}

	.instagram-preview {
		height: 260px;
		overflow: auto;
		scrollbar-width: none;
		margin: 12px 0;
		background: var(--c-surface);
	}

	.tiktok-preview {
		height: 260px;
		display: grid;
		place-items: start center;
		overflow: auto;
		margin: 12px 0;
		background: var(--c-surface);
	}

	:global(.tiktok-preview .tiktok-embed) {
		margin: 0 auto !important;
	}

	@media (max-width: 1100px) {
		.social-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.activity-grid {
			--activity-column-count: var(--activity-tablet-columns);
		}

		.tiktok-card {
			grid-column: 1 / -1;
		}
	}

	:global(.instagram-preview::-webkit-scrollbar) {
		display: none;
	}

	:global(.instagram-preview iframe) {
		display: block;
		width: 100% !important;
		min-width: 0 !important;
		max-width: 100% !important;
		border: 0;
	}

	.activity-card {
		display: flex;
		flex-direction: column;
		width: 100%;
		transform-origin: center;
		transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
	}

	.activity-card:hover,
	.activity-card:focus-visible {
		z-index: 1;
		box-shadow: var(--box-shadow-hover);
		transform: translate(-2px, -4px);
	}

	.activity-card:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 2px;
	}

	:global(.activity-column) {
		min-width: 0;
		align-self: start;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	#activities .screen-content {
		min-height: 0;
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		margin-block: 0;
	}

	.activity-art {
		position: relative;
		overflow: hidden;
		min-height: 100px;
		aspect-ratio: var(--activity-image-ratio, 2.4 / 1);
		display: flex;
		align-items: flex-end;
		padding: 12px;
		color: #FFFFFF;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.1em;
		line-height: 1.35;
	}

	.activity-art::after {
		position: absolute;
		inset: 0;
		background: linear-gradient(0deg, rgb(0 0 0 / 58%), transparent 75%);
		content: '';
	}

	.activity-art img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 350ms ease;
	}

	.activity-card:hover .activity-art img,
	.activity-card:focus-visible .activity-art img {
		transform: scale(1.045);
	}

	.activity-art > span {
		position: relative;
		z-index: 1;
		white-space: pre-line;
	}

	.art-listen {
		background: radial-gradient(ellipse at 70% 100%, rgba(242, 189, 87, 0.40), transparent 50%), #FFF5DF;
	}

	.art-meet {
		background: linear-gradient(135deg, var(--c-accent), var(--c-surface) 64%);
	}

	.art-create {
		background: radial-gradient(circle at 30% 30%, rgba(242, 189, 87, 0.22), transparent 50%), #FFF8E8;
	}

	.activity-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(12px, 1.6vw, 18px);
	}

	.activity-info h3 {
		margin: 10px 0 6px;
		font-size: clamp(16px, 2vw, 21px);
	}

	.activity-info .card-status {
		width: 100%;
		margin-top: auto;
	}

	.news-layout {
		display: grid;
		grid-template-columns: 1.5fr 0.8fr;
		gap: 12px;
	}

	.news-articles {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.news-carousel-controls {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.news-carousel-count {
		color: var(--c-muted);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.news-list-trigger {
		align-self: flex-start;
		min-height: 36px;
		padding: 8px 12px;
		border: 1.5px solid var(--c-outline);
		border-radius: 8px;
		background: var(--c-surface);
		color: var(--c-text);
		font-size: 8px;
		transition: box-shadow 160ms ease, transform 160ms ease;
		font-weight: 700;
		letter-spacing: 0.1em;
		cursor: pointer;
	}

	.news-list-trigger:hover {
		background: var(--c-accent-soft);
		box-shadow: 3px 3px 0 var(--c-shadow);
		transform: translate(-1px, -1px);
	}

	.lead-story {
		display: grid;
		grid-template-columns: 0.85fr 1fr;
	}

	.lead-story[data-news-slide].from-next:not([hidden]) {
		animation: news-slide-from-next 320ms ease both;
	}

	.lead-story[data-news-slide].from-previous:not([hidden]) {
		animation: news-slide-from-previous 320ms ease both;
	}

	.story-art {
		position: relative;
		overflow: hidden;
		min-height: 245px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: space-between;
		padding: 18px;
		color: #FFFFFF;
		background: #333333;
	}

	.story-art::after {
		position: absolute;
		inset: 0;
		background: linear-gradient(0deg, rgb(0 0 0 / 62%), rgb(0 0 0 / 8%));
		content: '';
	}

	.story-art img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.story-art > span {
		position: relative;
		z-index: 1;
	}

	.story-stamp {
		font-size: clamp(28px, 5vw, 58px);
		font-weight: 900;
		letter-spacing: -0.09em;
		line-height: 0.85;
	}

	.story-date {
		color: #FFFFFF;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.5;
	}

	.story-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		padding: clamp(16px, 2.3vw, 26px);
	}

	.story-copy h3 {
		margin: 14px 0 10px;
		font-size: clamp(20px, 3vw, 32px);
		line-height: 1.04;
	}

	.story-copy p {
		margin-bottom: 16px;
	}

	.calendar-card {
		--card-padding: clamp(15px, 2vw, 22px);
		display: flex;
		flex-direction: column;
		padding: var(--card-padding);
	}

	.calendar-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin: calc(var(--card-padding) * -1) calc(var(--card-padding) * -1) 0;
		padding: 9px var(--card-padding);
		border-bottom: var(--box-border);
		background: var(--c-accent);
	}

	.calendar-head .card-index {
		color: var(--c-on-accent);
	}

	.calendar-icon {
		color: var(--c-on-accent);
		font-size: 19px;
	}

	.calendar-date {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 9px;
		padding: 18px 0;
	}

	.calendar-date > span {
		color: var(--c-accent);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.calendar-date strong {
		font-size: clamp(26px, 4vw, 40px);
		letter-spacing: -0.07em;
		line-height: 0.95;
	}

	.calendar-event {
		display: flex;
		align-items: flex-start;
		gap: 11px;
		padding: 14px 0;
		border-top: 1px solid var(--c-line);
	}

	.calendar-event .live-dot {
		margin-top: 4px;
	}

	.calendar-event div {
		display: grid;
		gap: 5px;
	}

	.calendar-event strong {
		font-size: 10px;
	}

	.calendar-event div span {
		color: var(--c-muted);
		font-size: 9px;
	}

	.calendar-card .outline-link {
		align-self: flex-start;
	}

	.contact-layout {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: clamp(18px, 5vw, 58px);
		padding: clamp(18px, 3vw, 34px);
		border: var(--box-border);
		border-radius: var(--box-radius);
		background: var(--c-surface);
		box-shadow: var(--box-shadow);
	}

	.contact-intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
	}

	.contact-mark {
		display: block;
		width: min(100%, 210px);
		height: auto;
	}

	.contact-intro p {
		max-width: 200px;
		margin: 17px 0 24px;
		color: var(--c-muted);
		font-size: 13px;
		line-height: 1.5;
	}

	.contact-intro .card-status {
		padding-top: 0;
		border: 0;
	}

	.contact-details {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 16px;
	}

	.contact-item {
		min-height: 83px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 6px;
		border-bottom: 1px solid var(--c-line);
	}

	.contact-item > span {
		color: var(--c-accent);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.contact-item strong {
		font-size: 13px;
	}

	.contact-item small {
		color: var(--c-muted);
		font-size: 9px;
	}

	.contact-socials {
		display: flex;
		gap: 14px;
	}

	.contact-social {
		display: inline-flex;
		color: var(--c-text);
		transition: color 180ms ease, transform 180ms ease;
	}

	.contact-social svg {
		width: 22px;
		height: 22px;
	}

	.contact-social:hover {
		color: var(--c-accent-strong);
		transform: translateY(-2px);
	}

	.contact-social:focus-visible {
		border-radius: 2px;
		outline: 2px solid var(--c-accent);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-social {
			transition: none;
		}

		.contact-social:hover {
			transform: none;
		}
	}

	.site-footer {
		padding: clamp(32px, 6vw, 72px) clamp(32px, 6vw, 96px) 18px;
		background: var(--c-footer);
		color: var(--c-on-stage);
	}

	.site-footer-main,
	.site-footer-bottom {
		width: min(1800px, 100%);
		margin: 0 auto;
	}

	.site-footer-main {
		display: grid;
		grid-template-columns: 1.5fr repeat(3, 1fr);
		gap: clamp(20px, 4vw, 52px);
		padding-bottom: clamp(28px, 5vw, 56px);
	}

	.site-footer-brand {
		max-width: 260px;
	}

	.site-footer-wordmark {
		display: inline-block;
		text-decoration: none;
	}

	.site-footer-wordmark img {
		display: block;
		width: 150px;
		height: auto;
		padding: 5px;
		border-radius: 2px;
		background: var(--c-surface);
	}

	.site-footer-brand p,
	.site-footer-column > a {
		color: var(--c-footer-muted);
		font-size: 10px;
		line-height: 1.7;
	}

	.site-footer-brand p {
		margin: 14px 0 0;
	}

	.site-footer-column h2 {
		margin: 3px 0 14px;
		color: var(--c-accent);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.site-footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding-top: 15px;
		border-top: 1px solid rgb(255 255 243 / 18%);
		color: var(--c-footer-muted);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.site-footer-bottom a {
		color: var(--c-on-stage);
		text-decoration: none;
	}

	.site-footer-bottom a:hover,
	.site-footer-bottom a:focus-visible {
		color: var(--c-accent);
	}

	.section-footer a {
		text-decoration: none;
	}

	.section-footer .progress {
		display: flex;
		gap: 5px;
	}

	.progress a {
		width: 18px;
		height: 3px;
		background: var(--c-line);
	}

	.progress a[aria-current='step'] {
		background: var(--c-accent);
	}

	@media (max-width: 650px) {
