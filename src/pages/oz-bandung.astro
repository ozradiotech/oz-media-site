		isolation: isolate;
		min-width: 0;
		aspect-ratio: 5 / 4;
		overflow: hidden;
		border: var(--box-border);
		border-radius: var(--box-radius);
		background: #FFFFF3;
		box-shadow: var(--box-shadow);
