	.topbar.is-morphing {
		border-bottom-color: rgb(216 216 204 / var(--hero-progress, 1));
		background: rgb(255 255 243 / var(--hero-progress, 1));
	}

	.topbar.is-morphing .topbar-nav {
		overflow: visible;
	}

	.topbar.is-morphing .wordmark,
	.topbar.is-morphing .topbar-nav-link {
		will-change: transform;
	}

	.topbar.is-morphing .topbar-nav-link {
		transition-property: color, background-color, border-color;
	}

	.topbar.is-morphing .topbar-nav-link:not([aria-current]) {
		border-color: rgb(216 216 204 / calc(1 - var(--hero-progress, 1)));
		color: #000000;
	}

	.topbar.is-measuring .wordmark,
	.topbar.is-measuring .topbar-nav-link {
		transition: none;
	}

	.topbar.is-entering .wordmark img {
		animation: hero-logo-in 1000ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.topbar.is-entering .topbar-nav-link {
		animation: hero-link-in 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.topbar.is-entering .topbar-nav-link:nth-child(1) { animation-delay: 300ms; }
	.topbar.is-entering .topbar-nav-link:nth-child(2) { animation-delay: 360ms; }
	.topbar.is-entering .topbar-nav-link:nth-child(3) { animation-delay: 420ms; }
	.topbar.is-entering .topbar-nav-link:nth-child(4) { animation-delay: 480ms; }
	.topbar.is-entering .topbar-nav-link:nth-child(5) { animation-delay: 540ms; }
	.topbar.is-entering .topbar-nav-link:nth-child(6) { animation-delay: 600ms; }
	.topbar.is-entering .topbar-nav-link:nth-child(7) { animation-delay: 660ms; }

	.hero-screen {
