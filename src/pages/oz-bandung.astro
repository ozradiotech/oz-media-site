	/* The OZ Video.js theme is light by default; flip its palette for the dark broadcast panel. */
	.broadcast :global(.video-js.vjs-oz) {
		--oz-surface: #141412;
		--oz-ink: #FFFFF3;
		--oz-muted: #A8A89C;
		--oz-line: rgb(255 255 243 / 18%);
		--oz-accent-soft: rgb(242 189 87 / 18%);
	}

	/* The Video.js player shows the track metadata itself, so it takes the whole bar. */
	.audio-bar.has-videojs {
		display: flex;
		padding: 16px 18px;
	}

	.audio-bar.has-videojs .icon,
	.audio-bar.has-videojs .audio-copy {
		display: none;
	}

	.audio-bar.has-videojs .audio-player {
		max-width: none;
		min-width: 0;
		min-height: 0;
		align-self: stretch;
		flex: 1;
		display: flex;
	}

	audio {
		width: 100%;
		height: 34px;
