	newsListSort?.addEventListener('change', () => {
		if (!newsListItems || !newsListSort) return;
		const sortedItems = Array.from(newsListItems.querySelectorAll<HTMLButtonElement>('[data-news-list-item]'));
		sortedItems.sort((first, second) => {
			if (newsListSort.value === 'title') {
				return (first.dataset.newsTitle ?? '').localeCompare(second.dataset.newsTitle ?? '');
			}
			const firstDate = Number(first.dataset.newsDate ?? 0);
			const secondDate = Number(second.dataset.newsDate ?? 0);
