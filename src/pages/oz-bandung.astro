---
import SectionNav from '../components/SectionNav.astro';

const audioStreamUrl = 'https://streaming.ozradio.id:8443/ozbandung';
const twitchChannel = '';
const youtubeChannelUrl = 'https://www.youtube.com/@OZMEDIANET';
const youtubeVideos = [
	{ id: 'UDmfDJTzg4w', title: 'Featured video' },
	{ id: 'dn73m2_u71E', title: 'Studio session' },
	{ id: 'ZStRwkoiTQY', title: 'Live set' },
];
const instagramUrl = 'https://www.instagram.com/ozradiobandung';

const sections = [
	{ id: 'listen', label: 'ON AIR' },
	{ id: 'programs', label: 'PROGRAMS' },
	{ id: 'online', label: 'ONLINE' },
	{ id: 'activities', label: 'ON GROUND' },
	{ id: 'news', label: 'OZ-NEWS' },
	{ id: 'contact', label: 'CONTACT' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#FFFFF3" />
		<meta name="description" content="Listen, watch and connect with OZ Radio Bandung." />
		<title>OZ Bandung — OZ Radio</title>
	</head>
	<body>
		<main class="bandung-page">
			<header class="topbar">
				<a class="wordmark" href="/" aria-label="OZ Radio home">O<span>Z</span></a>
				<span class="location-tag"><span class="live-dot"></span> BANDUNG, WEST JAVA</span>
			</header>

			<section class="screen listen-screen" id="listen" aria-labelledby="listen-title">
				<div class="screen-content listen-content">
					<div class="screen-heading listen-heading">
						<div>
							<p class="eyebrow">PLACEHOLDER · 01</p>
							<h1 id="listen-title">OZ Radio <span>Bandung</span></h1>
						</div>
					</div>

					<div class="broadcast" aria-label="OZ Bandung broadcast">
						<div class="broadcast-heading">
							<div class="broadcast-label"><span class="live-dot idle-dot"></span> LIVE FROM THE STUDIO</div>
							<span class="on-air">ON AIR</span>
						</div>
						<div class="broadcast-options">
							<button class="broadcast-option" type="button" data-tune-in>♫ <span>Tune in</span><span aria-hidden="true">↗</span></button>
						</div>
						<div class="broadcast-panel" data-broadcast-panel="audio" hidden>
							<div class="audio-bar">
								<span class="icon" aria-hidden="true">♫</span>
								<div class="audio-copy">
									<strong data-track-title>{audioStreamUrl ? 'Loading track...' : 'Audio stream unavailable'}</strong>
									<span data-track-artist aria-live="polite"></span>
								</div>
								{audioStreamUrl ? (
									<audio data-audio-player controls preload="none" src={audioStreamUrl} aria-label="OZ Bandung audio stream">
										Your browser does not support audio playback.
									</audio>
								) : (
									<span class="stream-status">AUDIO NOT CONNECTED</span>
								)}
							</div>
							<div class="listener-stats" aria-live="polite" aria-label="Live listener statistics">
								<span>LISTENERS <strong data-listener-count>—</strong></span>
							</div>
						</div>
						<div class="broadcast-panel" data-broadcast-panel="video" hidden>
							<div class="video-frame">
								{twitchChannel ? (
									<iframe
										title="OZ Bandung Twitch livestream"
										data-twitch-channel={twitchChannel}
										allow="autoplay; fullscreen"
										allowfullscreen
									></iframe>
								) : (
									<div class="video-placeholder">
										<span class="placeholder-play" aria-hidden="true">▶</span>
										<p>Studio stream coming soon</p>
										<span class="placeholder-caption">TWITCH LIVESTREAM · CHANNEL TO BE ADDED</span>
									</div>
								)}
							</div>
						</div>
					</div>

					<dialog class="listener-dialog" data-listener-dialog aria-labelledby="listener-dialog-title">
						<form class="listener-form" data-listener-form>
							<button class="dialog-close" type="button" data-dialog-close aria-label="Close">×</button>
							<p class="eyebrow" data-dialog-eyebrow>OZ BANDUNG · LIVE</p>
							<h2 id="listener-dialog-title" data-dialog-title>Choose how to tune in</h2>
							<div class="broadcast-selection" data-broadcast-selection role="group" aria-label="Choose a broadcast">
								<button class="broadcast-option" type="button" data-select-broadcast="audio">♫ <span>Listen to audio stream</span></button>
								<button class="broadcast-option" type="button" data-select-broadcast="video">▶ <span>Watch the livestream</span></button>
							</div>
							<div data-listener-fields hidden>
								<label class="listener-field">Name<input name="name" autocomplete="name" required maxlength="80" /></label>
								<label class="listener-field">Age<input name="age" type="number" inputmode="numeric" min="1" max="120" step="1" required /></label>
								<label class="listener-field">Gender<select name="gender" required>
									<option value="" selected disabled>Select gender</option>
									<option>Female</option><option>Male</option>>
								</select></label>
								<label class="listener-field">Location<input name="location" autocomplete="address-level2" required maxlength="100" /></label>
							</div>
							<div class="listener-confirmation" data-listener-confirmation hidden aria-live="polite"></div>
							<button class="listener-submit" type="submit" data-listener-submit hidden>Continue</button>
						</form>
					</dialog>

					<aside class="ad-space" aria-label="Advertisement space">
						<span class="ad-tag">ADVERTISEMENT</span>
						<strong>Advertisement.</strong>
						<span>AD SPACE · BANDUNG</span>
					</aside>
				</div>

			</section>

			<section class="screen" id="programs" aria-labelledby="programs-title">
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">02 / ON AIR PROGRAM</p>
							<h2 id="programs-title">Our<span> on air</span> program</h2>
						</div>
						<p class="section-deck">Placeholder for general description.</p>
					</div>
					<div class="program-carousel" data-program-carousel aria-roledescription="carousel" aria-label="On air programs">
						<div class="program-slides">
							<article class="program-slide is-active" data-program-slide aria-roledescription="slide" aria-label="1 of 6">
								<img src="https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?auto=format&fit=crop&w=1800&q=85" alt="" fetchpriority="high" />
								<div class="program-slide-copy"><span class="card-index">01 / ON AIR</span><h3>OZ Riental</h3><p>Program details coming soon.</p></div>
							</article>
							<article class="program-slide is-active" data-program-slide aria-roledescription="slide" aria-label="2 of 6">
								<img src="https://images.unsplash.com/photo-1516280440614-37939bbacd81?auto=format&fit=crop&w=1800&q=85" alt="" loading="lazy" />
								<div class="program-slide-copy"><span class="card-index">02 / ON AIR</span><h3>OZ We Go</h3><p>Program details coming soon.</p></div>
							</article>
							<article class="program-slide is-active" data-program-slide aria-roledescription="slide" aria-label="3 of 6">
								<img src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=1800&q=85" alt="" loading="lazy" />
								<div class="program-slide-copy"><span class="card-index">03 / ON AIR</span><h3>Morning Rush</h3><p>Program details coming soon.</p></div>
							</article>
							<article class="program-slide" data-program-slide aria-roledescription="slide" aria-label="4 of 6" hidden>
								<img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=1800&q=85" alt="" loading="lazy" />
								<div class="program-slide-copy"><span class="card-index">04 / ON AIR</span><h3>Main Aman</h3><p>Program details coming soon.</p></div>
							</article>
							<article class="program-slide" data-program-slide aria-roledescription="slide" aria-label="5 of 6" hidden>
								<img src="https://images.unsplash.com/photo-1506157786151-b8491531f063?auto=format&fit=crop&w=1800&q=85" alt="" loading="lazy" />
								<div class="program-slide-copy"><span class="card-index">05 / ON AIR</span><h3>Thursday Nite Club</h3><p>Program details coming soon.</p></div>
							</article>
							<article class="program-slide" data-program-slide aria-roledescription="slide" aria-label="6 of 6" hidden>
								<img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=1800&q=85" alt="" loading="lazy" />
								<div class="program-slide-copy"><span class="card-index">06 / ON AIR</span><h3>Miming Bebeg</h3><p>Program details coming soon.</p></div>
							</article>
						</div>
						<div class="program-carousel-controls">
							<div class="program-pagination" role="group" aria-label="Choose a group of programs">
								{[0, 3].map((index) => (
									<button class="program-dot" type="button" data-program-index={index} aria-label={`Show programs ${index + 1} to ${Math.min(index + 3, 6)}`} aria-pressed={index === 0 ? 'true' : 'false'}></button>
								))}
							</div>
							<div class="program-arrows">
								<button class="carousel-arrow" type="button" data-program-previous aria-label="Previous programs">←</button>
								<span class="program-count" data-program-count aria-live="polite">01-03 / 06</span>
								<button class="carousel-arrow" type="button" data-program-next aria-label="Next programs">→</button>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="screen" id="online" aria-labelledby="online-title">
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">03 / ONLINE</p>
							<h2 id="online-title">Online <span>digital</span></h2>
						</div>
						<p class="section-deck">Placeholder for general description.</p>
					</div>
					<div class="feature-grid social-grid">
						<article class="feature-card social-card youtube-card">
							<div class="social-topline"><span class="social-mark">▶</span><span>OZ RADIO BANDUNG · YOUTUBE</span></div>
							<div class="youtube-carousel" data-youtube-carousel>
								<div class="channel-preview" data-youtube-player>
									<span class="preview-play">▶</span>
									<span class="preview-caption">PODCASTS<br />&amp; LIVESTREAMS</span>
									<span class="preview-duration">YOUTUBE VIDEO TO BE ADDED</span>
								</div>
								<div class="youtube-carousel-nav">
									<button class="carousel-arrow" type="button" data-youtube-previous aria-label="Previous video">←</button>
									<div class="video-picker" role="group" aria-label="Select a YouTube video">
										{youtubeVideos.map((video, index) => (
											<button
												class="video-picker-item"
												type="button"
												data-youtube-video
												data-youtube-id={video.id}
												data-youtube-title={video.title}
												aria-label={`Select ${video.title}`}
												aria-pressed={index === 0 ? 'true' : 'false'}
											>
												<span>{String(index + 1).padStart(2, '0')}</span>
												{video.title}
											</button>
										))}
									</div>
									<button class="carousel-arrow" type="button" data-youtube-next aria-label="Next video">→</button>
								</div>
								<div class="youtube-current" aria-live="polite">
									<strong data-youtube-current-title>{youtubeVideos[0].title}</strong>
									<span data-youtube-current-count>01 / {String(youtubeVideos.length).padStart(2, '0')}</span>
								</div>
							</div>
							<div class="social-card-bottom">
								<div><h3>Watch podcasts.</h3><p>Live sets, studio sessions and more from OZ Radio Bandung.</p></div>
								<a class="outline-link" href={youtubeChannelUrl || undefined} aria-disabled={!youtubeChannelUrl}>
									{youtubeChannelUrl ? 'VISIT YOUTUBE ↗' : 'CHANNEL LINK COMING SOON'}
								</a>
							</div>
						</article>
						<article class="feature-card social-card instagram-card">
							<div class="social-topline"><span class="social-mark instagram-mark">◎</span><span>OZ RADIO BANDUNG · INSTAGRAM</span></div>
							<div class="instagram-preview">
								<blockquote
									class="instagram-media"
									data-instgrm-permalink="https://www.instagram.com/ozradiobandung/"
									data-instgrm-version="14"
								>
									<a href={instagramUrl}>View this profile on Instagram</a>
								</blockquote>
							</div>
							<script async src="https://www.instagram.com/embed.js" is:inline></script>
							<div class="social-card-bottom">
								<div><h3>Stay in the loop.</h3><p>Behind the scenes and everything.</p></div>
								<a class="outline-link" href={instagramUrl || undefined} aria-disabled={!instagramUrl}>
									{instagramUrl ? 'VISIT INSTAGRAM ↗' : 'PROFILE LINK COMING SOON'}
								</a>
							</div>
						</article>
					</div>
				</div>
			</section>

			<section class="screen" id="activities" aria-labelledby="activities-title">
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">04 / ON GROUND ACTIVITY</p>
							<h2 id="activities-title">On ground <span>activity.</span></h2>
						</div>
						<p class="section-deck">Placeholder for general description.</p>
					</div>
					<div class="feature-grid activity-grid">
						<article class="feature-card activity-card">
							<div class="activity-art art-listen"><span>LISTEN<br />CLOSER</span></div>
							<div class="activity-info"><span class="card-index">LIVE MUSIC</span><h3>OZubathon</h3><p>Lorem ipsum dolor sit amet.</p><span class="card-status">UPCOMING EVENTS COMING SOON</span></div>
						</article>
						<article class="feature-card activity-card">
							<div class="activity-art art-meet"><span>MEET<br />IN PERSON</span></div>
							<div class="activity-info"><span class="card-index">COMMUNITY</span><h3>Siaran Di Cafe</h3><p>Lorem ipsum dolor sit amet.</p><span class="card-status">UPCOMING EVENTS COMING SOON</span></div>
						</article>
						<article class="feature-card activity-card">
							<div class="activity-art art-create"><span>MAKE<br />SOME NOISE</span></div>
							<div class="activity-info"><span class="card-index">WORKSHOPS</span><h3>Placeholder</h3><p>Lorem ipsum dolor sit amet.</p><span class="card-status">UPCOMING EVENTS COMING SOON</span></div>
						</article>
					</div>
				</div>
			</section>

			<section class="screen" id="news" aria-labelledby="news-title">
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">05 / OZ NEWS TODAY</p>
							<h2 id="news-title">OZ <span>News.</span></h2>
						</div>
						<p class="section-deck">Placeholder for general description.</p>
					</div>
					<div class="news-layout">
						<article class="feature-card lead-story">
							<div class="story-art"><span class="story-stamp">OZ<br />NEWS</span><span class="story-date">LATEST<br />FROM BDG</span></div>
							<div class="story-copy">
								<span class="card-index">THE LATEST · EDITORIAL</span>
								<h3>News title</h3>
								<p>Lorem ipsum dolor sit amet consectetur adipiscing elit.</p>
								<span class="card-status">FIRST STORY COMING SOON</span>
							</div>
						</article>
						<aside class="feature-card calendar-card">
							<div class="calendar-head"><span class="card-index">SAVE THE DATE</span><span class="calendar-icon">▦</span></div>
							<div class="calendar-date"><span>OZ NEWS</span><strong>Event<br />calendar.</strong></div>
							<div class="calendar-event"><span class="live-dot idle-dot"></span><div><strong>Next OZ Radio event</strong><span>Date and details to be announced</span></div></div>
							<a class="outline-link" href="#activities">EXPLORE ACTIVITIES ↓</a>
						</aside>
					</div>
				</div>
			</section>

			<section class="screen contact-screen" id="contact" aria-labelledby="contact-title">
				<div class="screen-content">
					<div class="section-heading">
						<div>
							<p class="eyebrow">06 / LET'S TALK BUSINESS</p>
							<h2 id="contact-title">Contact <span>Information.</span></h2>
						</div>
						<p class="section-deck">Partnerships, collaborations, ideas — we’re listening.</p>
					</div>
					<div class="contact-layout">
						<div class="contact-intro"><span class="contact-mark">O<span>Z</span></span><p>Your friendly station.</p><span class="card-status">CONTACT DETAILS TO BE ADDED</span></div>
						<div class="contact-details">
							<div class="contact-item"><span>EMAIL</span><strong>TBA</strong><small>Business &amp; general enquiries</small></div>
							<div class="contact-item"><span>PHONE / WHATSAPP</span><strong>(022) 2013233</strong><small>Reach the OZ team</small></div>
							<div class="contact-item"><span>STUDIO</span><strong>Jl. Setrasari II No.14, Sukarasa, Kec. Sukasari, Kota Bandung, Jawa Barat 40152</strong><small>Full address coming soon</small></div>
							<div class="contact-item"><span>PARTNERSHIPS</span><strong>Let’s work together</strong><small>Contact information coming soon</small></div>
						</div>
					</div>
				</div>
				<footer class="contact-footer"><br /><span>FOOTER</span><br /></footer>
			</section>
			<SectionNav sections={sections} current="listen" />
		</main>
	</body>
</html>

<script>
	const sectionNav = document.querySelector<HTMLElement>('[data-section-nav]');
	if (sectionNav) {
		const sectionLinks = Array.from(sectionNav.querySelectorAll<HTMLAnchorElement>('[data-section-id]'));
		const previousSectionLink = sectionNav.querySelector<HTMLAnchorElement>('[data-section-previous]');
		const nextSectionLink = sectionNav.querySelector<HTMLAnchorElement>('[data-section-next]');
		const sectionProgress = sectionNav.querySelector<HTMLElement>('[data-section-progress]');

		const updateSectionNavigation = (sectionId: string) => {
			const currentIndex = sectionLinks.findIndex((link) => link.dataset.sectionId === sectionId);
			if (currentIndex < 0) return;

			const previousSection = sectionLinks[currentIndex - 1];
			const nextSection = sectionLinks[currentIndex + 1];
			if (previousSectionLink) {
				previousSectionLink.href = previousSection ? `#${previousSection.dataset.sectionId}` : '/';
				previousSectionLink.textContent = previousSection ? `← ${previousSection.dataset.sectionLabel}` : '← ALL LOCATIONS';
			}
			if (nextSectionLink) {
				nextSectionLink.href = nextSection ? `#${nextSection.dataset.sectionId}` : '/oz-bali/';
				nextSectionLink.textContent = nextSection ? `${nextSection.dataset.sectionLabel} →` : 'NEXT: BALI →';
			}
			sectionProgress?.setAttribute('aria-label', `Section ${currentIndex + 1} of ${sectionLinks.length}`);
			sectionLinks.forEach((link, linkIndex) => {
				if (linkIndex === currentIndex) link.setAttribute('aria-current', 'step');
				else link.removeAttribute('aria-current');
			});
		};

		const sectionObserver = new IntersectionObserver((entries) => {
			const visibleSection = entries
				.filter((entry) => entry.isIntersecting)
				.sort((first, second) => second.intersectionRatio - first.intersectionRatio)[0];
			if (visibleSection) updateSectionNavigation((visibleSection.target as HTMLElement).id);
		}, { threshold: 0.5 });

		document.querySelectorAll<HTMLElement>('.screen[id]').forEach((section) => sectionObserver.observe(section));
		updateSectionNavigation(window.location.hash.slice(1) || 'listen');
	}

	const youtubeCarousel = document.querySelector<HTMLElement>('[data-youtube-carousel]');
	const youtubePlayer = youtubeCarousel?.querySelector<HTMLElement>('[data-youtube-player]');
	const youtubeVideoButtons = youtubeCarousel?.querySelectorAll<HTMLButtonElement>('[data-youtube-video]');
	const youtubeCurrentTitle = youtubeCarousel?.querySelector<HTMLElement>('[data-youtube-current-title]');
	const youtubeCurrentCount = youtubeCarousel?.querySelector<HTMLElement>('[data-youtube-current-count]');

	if (youtubeCarousel && youtubePlayer && youtubeVideoButtons?.length && youtubeCurrentTitle && youtubeCurrentCount) {
		const videos = Array.from(youtubeVideoButtons, (button) => ({
			id: button.dataset.youtubeId ?? '',
			title: button.dataset.youtubeTitle ?? '',
		}));
		let currentVideoIndex = 0;

		const showVideo = (index: number) => {
			currentVideoIndex = (index + videos.length) % videos.length;
			const video = videos[currentVideoIndex];

			youtubePlayer.replaceChildren();
			if (video.id) {
				const iframe = document.createElement('iframe');
				iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(video.id)}`;
				iframe.title = video.title;
				iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
				iframe.allowFullscreen = true;
				iframe.loading = 'lazy';
				iframe.referrerPolicy = 'strict-origin-when-cross-origin';
				youtubePlayer.append(iframe);
			} else {
				const placeholder = document.createElement('div');
				placeholder.className = 'youtube-placeholder';
				placeholder.textContent = `Add a YouTube video ID for "${video.title}"`;
				youtubePlayer.append(placeholder);
			}

			youtubeCurrentTitle.textContent = video.title;
			youtubeCurrentCount.textContent = `${String(currentVideoIndex + 1).padStart(2, '0')} / ${String(videos.length).padStart(2, '0')}`;
			youtubeVideoButtons.forEach((button, buttonIndex) => {
				button.setAttribute('aria-pressed', String(buttonIndex === currentVideoIndex));
			});
		};

		youtubeCarousel.querySelector('[data-youtube-previous]')?.addEventListener('click', () => {
			showVideo(currentVideoIndex - 1);
		});
		youtubeCarousel.querySelector('[data-youtube-next]')?.addEventListener('click', () => {
			showVideo(currentVideoIndex + 1);
		});
		youtubeVideoButtons.forEach((button, index) => {
			button.addEventListener('click', () => showVideo(index));
		});
		showVideo(0);
	}

	const programCarousel = document.querySelector<HTMLElement>('[data-program-carousel]');
	const programSlides = programCarousel?.querySelectorAll<HTMLElement>('[data-program-slide]');
	const programButtons = programCarousel?.querySelectorAll<HTMLButtonElement>('[data-program-index]');
	const programCount = programCarousel?.querySelector<HTMLElement>('[data-program-count]');

	if (programCarousel && programSlides?.length && programButtons?.length && programCount) {
		const programsPerPage = 3;
		const pageCount = Math.ceil(programSlides.length / programsPerPage);
		let currentPageIndex = 0;

		const showProgramPage = (index: number) => {
			const nextPageIndex = (index + pageCount) % pageCount;
			if (nextPageIndex === currentPageIndex) return;
			const direction = nextPageIndex < currentPageIndex ? -1 : 1;
			currentPageIndex = nextPageIndex;
			const firstProgramIndex = currentPageIndex * programsPerPage;
			const lastProgramIndex = Math.min(firstProgramIndex + programsPerPage, programSlides.length);
			programSlides.forEach((slide, slideIndex) => {
				const isActive = slideIndex >= firstProgramIndex && slideIndex < lastProgramIndex;
				slide.hidden = !isActive;
				slide.classList.toggle('is-active', isActive);
				slide.classList.toggle('from-next', isActive && direction > 0);
				slide.classList.toggle('from-previous', isActive && direction < 0);
			});
			programButtons.forEach((button, buttonIndex) => {
				button.setAttribute('aria-pressed', String(buttonIndex === currentPageIndex));
			});
			programCount.textContent = `${String(firstProgramIndex + 1).padStart(2, '0')}-${String(lastProgramIndex).padStart(2, '0')} / ${String(programSlides.length).padStart(2, '0')}`;
		};

		programCarousel.querySelector('[data-program-previous]')?.addEventListener('click', () => showProgramPage(currentPageIndex - 1));
		programCarousel.querySelector('[data-program-next]')?.addEventListener('click', () => showProgramPage(currentPageIndex + 1));
		programButtons.forEach((button, index) => button.addEventListener('click', () => showProgramPage(index)));
	}

	const tuneInButton = document.querySelector<HTMLButtonElement>('[data-tune-in]');
	const broadcastSelection = document.querySelector<HTMLElement>('[data-broadcast-selection]');
	const broadcastModeButtons = document.querySelectorAll<HTMLButtonElement>('[data-select-broadcast]');
	const broadcastPanels = document.querySelectorAll<HTMLElement>('[data-broadcast-panel]');
	const broadcastEmpty = document.querySelector<HTMLElement>('[data-broadcast-empty]');
	const listenerDialog = document.querySelector<HTMLDialogElement>('[data-listener-dialog]');
	const listenerForm = listenerDialog?.querySelector<HTMLFormElement>('[data-listener-form]');
	const listenerFields = listenerForm?.querySelector<HTMLElement>('[data-listener-fields]');
	const listenerConfirmation = listenerForm?.querySelector<HTMLElement>('[data-listener-confirmation]');
	const listenerSubmit = listenerForm?.querySelector<HTMLButtonElement>('[data-listener-submit]');
	const dialogTitle = listenerForm?.querySelector<HTMLElement>('[data-dialog-title]');
	const twitchPlayer = document.querySelector<HTMLIFrameElement>('[data-twitch-channel]');
	const audioPlayer = document.querySelector<HTMLAudioElement>('[data-audio-player]');
	const trackTitle = document.querySelector<HTMLElement>('[data-track-title]');
	const trackArtist = document.querySelector<HTMLElement>('[data-track-artist]');
	const listenerCount = document.querySelector<HTMLElement>('[data-listener-count]');
	const listenerSessionKey = 'oz-listener-details-saved';
	let listenerDetailsSaved = false;
	try {
		listenerDetailsSaved = sessionStorage.getItem(listenerSessionKey) === 'true';
	} catch {}
	let selectedBroadcast: 'audio' | 'video' | null = null;
	let nowPlayingTimer: number | undefined;

	const stopNowPlayingUpdates = () => {
		if (nowPlayingTimer !== undefined) {
			window.clearInterval(nowPlayingTimer);
			nowPlayingTimer = undefined;
		}
	};

	const updateNowPlaying = async () => {
		if (!trackTitle || !trackArtist || !listenerCount) return;

		try {
			const response = await fetch('/api/now-playing', { cache: 'no-store' });
			if (!response.ok) throw new Error('Track title unavailable.');

			const data = (await response.json()) as {
				title?: unknown;
				listeners?: unknown;
			};
			const metadata = typeof data.title === 'string' ? data.title.trim() : '';
			listenerCount.textContent = typeof data.listeners === 'number' ? data.listeners.toLocaleString() : '—';
			const separatorIndex = metadata.lastIndexOf(' - ');
			if (separatorIndex > 0 && separatorIndex < metadata.length - 3) {
				trackTitle.textContent = metadata.slice(0, separatorIndex).trim();
				trackArtist.textContent = metadata.slice(separatorIndex + 3).trim();
			} else {
				trackTitle.textContent = metadata || 'Track title unavailable';
				trackArtist.textContent = '';
			}
		} catch {
			trackTitle.textContent = 'Track title unavailable';
			trackArtist.textContent = '';
			listenerCount.textContent = '—';
		}
	};

	const startNowPlayingUpdates = () => {
		if (nowPlayingTimer !== undefined || !trackTitle || !trackArtist) return;
		void updateNowPlaying();
		nowPlayingTimer = window.setInterval(() => { void updateNowPlaying(); }, 30_000);
	};

	audioPlayer?.addEventListener('play', startNowPlayingUpdates);
	audioPlayer?.addEventListener('pause', stopNowPlayingUpdates);
	audioPlayer?.addEventListener('ended', stopNowPlayingUpdates);

	const stopBroadcast = () => {
		stopNowPlayingUpdates();
		audioPlayer?.pause();
		twitchPlayer?.removeAttribute('src');
		broadcastPanels.forEach((panel) => { panel.hidden = true; });
		if (broadcastEmpty) broadcastEmpty.hidden = false;
	};

	const startBroadcast = () => {
		if (!selectedBroadcast) return;
		broadcastPanels.forEach((panel) => {
			panel.hidden = panel.dataset.broadcastPanel !== selectedBroadcast;
		});
		if (broadcastEmpty) broadcastEmpty.hidden = true;

		if (selectedBroadcast === 'audio') {
			startNowPlayingUpdates();
			audioPlayer?.play().catch(() => {});
			return;
		}

		const channel = twitchPlayer?.dataset.twitchChannel;
		if (twitchPlayer && channel) {
			const playerUrl = new URL('https://player.twitch.tv/');
			playerUrl.searchParams.set('channel', channel);
			playerUrl.searchParams.set('parent', window.location.hostname);
			playerUrl.searchParams.set('muted', 'true');
			twitchPlayer.src = playerUrl.toString();
		}
	};

	tuneInButton?.addEventListener('click', () => {
		if (!listenerDialog || !listenerForm || !listenerFields || !listenerConfirmation || !listenerSubmit || !dialogTitle || !broadcastSelection) return;
		stopBroadcast();
		selectedBroadcast = null;
		listenerForm.reset();
		listenerFields.hidden = true;
		listenerConfirmation.hidden = true;
		listenerConfirmation.replaceChildren();
		listenerSubmit.hidden = true;
		listenerSubmit.disabled = false;
		broadcastSelection.hidden = false;
		dialogTitle.textContent = 'Choose how to tune in';
		listenerDialog.showModal();
		broadcastModeButtons[0]?.focus();
	});

	broadcastModeButtons.forEach((button) => {
		button.addEventListener('click', () => {
			if (!listenerDialog || !listenerFields || !listenerConfirmation || !listenerSubmit || !dialogTitle || !broadcastSelection) return;
			selectedBroadcast = button.dataset.selectBroadcast === 'video' ? 'video' : 'audio';
			broadcastSelection.hidden = true;
			if (listenerDetailsSaved) {
				listenerDialog.close();
				startBroadcast();
				return;
			}

			listenerFields.hidden = false;
			listenerFields.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => { field.disabled = false; });
			listenerConfirmation.hidden = true;
			listenerSubmit.hidden = false;
			listenerSubmit.textContent = 'Continue';
			dialogTitle.textContent = 'Before you tune in';
			listenerFields.querySelector<HTMLInputElement>('input')?.focus();
		});
	});

	listenerDialog?.querySelector('[data-dialog-close]')?.addEventListener('click', () => listenerDialog.close());

	listenerForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!listenerFields || !listenerConfirmation || !listenerSubmit || !dialogTitle) return;

		if (!listenerFields.hidden) {
			if (!listenerForm.reportValidity()) return;
			const listener = new FormData(listenerForm);
		listenerSubmit.disabled = true;
		listenerSubmit.textContent = 'Saving...';
		try {
			const response = await fetch('/api/listeners', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					name: String(listener.get('name')).trim(),
					age: Number(listener.get('age')),
					gender: listener.get('gender'),
					location: String(listener.get('location')).trim(),
					broadcast: selectedBroadcast,
				}),
			});
			if (!response.ok) throw new Error('Listener details could not be saved. Please try again.');
			listenerDetailsSaved = true;
			try {
				sessionStorage.setItem(listenerSessionKey, 'true');
			} catch {}
		} catch (error) {
			const message = document.createElement('p');
			message.textContent = error instanceof Error ? error.message : 'Listener details could not be saved. Please try again.';
			listenerConfirmation.replaceChildren(message);
			listenerConfirmation.hidden = false;
			listenerSubmit.disabled = false;
			listenerSubmit.textContent = 'Continue';
			return;
		}
		listenerSubmit.disabled = false;
			const details = [
				['Name', listener.get('name')],
				['Age', listener.get('age')],
				['Gender', listener.get('gender')],
				['Location', listener.get('location')],
			] as const;
			const message = document.createElement('p');
			message.textContent = `You are ready to ${selectedBroadcast === 'video' ? 'watch' : 'listen'}.`;
			const summary = document.createElement('dl');
			details.forEach(([label, value]) => {
				const term = document.createElement('dt');
				term.textContent = label;
				const description = document.createElement('dd');
				description.textContent = String(value ?? '');
				summary.append(term, description);
			});
			listenerConfirmation.replaceChildren(message, summary);
			listenerFields.hidden = true;
			listenerFields.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => { field.disabled = true; });
			listenerConfirmation.hidden = false;
			listenerSubmit.textContent = selectedBroadcast === 'video' ? 'Start watching' : 'Start listening';
			dialogTitle.textContent = 'You’re all set';
			return;
		}

		listenerDialog?.close();
		startBroadcast();
	});
</script>

