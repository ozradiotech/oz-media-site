		animation: ozb-spin 160s linear infinite;
	}

	:global(:root[data-theme='night']) .hero-screen.is-offscreen::before {
		animation-play-state: paused;
	}

	:global(:root[data-theme='night']) .hero-screen::after {
		inset: auto 0 0;
		height: 38%;
		background: radial-gradient(rgb(var(--ozb-glow) / 22%) 1.1px, transparent 1.7px) 0 0 / 13px 13px;
		-webkit-mask-image: linear-gradient(to top, #000, transparent);
		mask-image: linear-gradient(to top, #000, transparent);
	}

	:global(:root[data-theme='night']) .ozb-event {
		position: relative;
		display: grid;
		justify-items: center;
		gap: clamp(8px, 1.6vh, 14px);
		text-align: center;
	}

	.ozb-presents {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--c-muted);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.42em;
		animation: ozb-rise 600ms 150ms var(--ozb-out) backwards;
	}

	.ozb-presents::before,
	.ozb-presents::after {
		width: 28px;
		height: 1px;
		background: currentColor;
		content: '';
	}

	.ozb-logo {
		display: block;
		width: min(84vw, 560px);
		height: auto;
		filter: drop-shadow(0 0 42px rgb(var(--ozb-glow) / 20%)) drop-shadow(0 22px 30px rgb(0 0 0 / 65%));
		animation: ozb-stamp 900ms 250ms var(--ozb-pop) backwards;
	}

	.ozb-deck {
		max-width: 40ch;
		margin: 0;
		color: var(--c-text-2);
		font-size: 15px;
		line-height: 1.55;
		text-wrap: balance;
		animation: ozb-rise 600ms 650ms var(--ozb-out) backwards;
	}

	.ozb-deck span {
		display: block;
		margin-top: 2px;
		color: var(--c-accent);
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.22em;
	}

	.ozb-status {
		display: grid;
		justify-items: center;
		gap: 10px;
		animation: ozb-rise 600ms 780ms var(--ozb-out) backwards;
	}

	.ozb-status [hidden] {
		display: none !important;
	}

	.ozb-chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		padding: 5px 12px;
		border: 1px solid rgb(var(--ozb-glow) / 45%);
		border-radius: 999px;
		color: var(--c-accent);
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.16em;
	}

	[data-ozb-state='live'] .ozb-chip {
		border-color: rgb(255 79 46 / 60%);
		color: var(--c-signal);
	}

	/* "Loud": four level-meter bars. They bounce faster once the marathon is live. */
	.ozb-eq {
		height: 12px;
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
	}

	.ozb-eq i {
		width: 3px;
		height: 100%;
		border-radius: 1px;
		background: currentColor;
		transform-origin: bottom;
		animation: ozb-eq 1100ms ease-in-out infinite alternate;
	}

	.ozb-eq i:nth-child(2) { animation-delay: -420ms; animation-duration: 900ms; }
	.ozb-eq i:nth-child(3) { animation-delay: -760ms; animation-duration: 1300ms; }
	.ozb-eq i:nth-child(4) { animation-delay: -210ms; animation-duration: 1000ms; }

	[data-ozb-state='live'] .ozb-eq i {
		animation-duration: 420ms;
	}

	[data-ozb-state='done'] .ozb-eq i {
		animation: none;
		transform: scaleY(0.35);
	}

	.ozb-countdown {
		display: flex;
		gap: clamp(6px, 1.2vw, 10px);
	}

	.ozb-unit {
		min-width: clamp(58px, 15vw, 76px);
		display: grid;
		justify-items: center;
		gap: 4px;
		overflow: hidden;
		padding: 10px 6px 8px;
		border-radius: 14px;
		background: var(--c-surface);
		box-shadow: inset 0 0 0 1px var(--c-line), inset 0 -3px 0 rgb(var(--ozb-glow) / 70%);
	}

	.ozb-unit b {
		display: block;
		color: var(--c-text);
		font-family: var(--font-tango);
		font-size: clamp(28px, 4.2vw, 42px);
		font-style: italic;
		font-variant-numeric: tabular-nums;
		font-weight: 700;
		line-height: 1;
		text-shadow: -0.06em 0.06em 0 var(--c-accent);
	}

	.ozb-unit small {
		color: var(--c-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.2em;
	}

	.ozb-progress {
		display: grid;
		justify-items: center;
		gap: 8px;
	}

	.ozb-progress p {
		margin: 0;
		color: var(--c-text-2);
		font-weight: 700;
	}

	.ozb-progress b {
		color: var(--c-text);
		font-family: var(--font-tango);
		font-size: 34px;
		font-style: italic;
		font-variant-numeric: tabular-nums;
		text-shadow: -0.06em 0.06em 0 var(--c-accent);
	}

	.ozb-progress small {
		margin-left: 6px;
		color: var(--c-muted);
		font-size: 10px;
		letter-spacing: 0.2em;
	}

	.ozb-progress-track {
		width: min(80vw, 420px);
		height: 8px;
		overflow: hidden;
		border-radius: 999px;
		background: var(--c-surface-2);
	}

	.ozb-progress-track span {
		display: block;
		height: 100%;
		background: linear-gradient(90deg, var(--c-accent), var(--c-signal));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 1s linear;
	}

	:global(:root[data-theme='night']) .hero-scroll-cue {
		color: var(--c-muted);
	}

	/* ---------- Ticker: the tagline on a marigold band, ruled like the logo's outline ---------- */

	:global(:root[data-theme='night']) .ozb-ticker {
		position: relative;
		z-index: 1;
		display: block;
		overflow: hidden;
		padding-block: 13px;
		background:
			linear-gradient(var(--ozb-ink) 0 0) 0 4px / 100% 1.5px no-repeat,
			linear-gradient(var(--ozb-ink) 0 0) 0 calc(100% - 4px) / 100% 1.5px no-repeat,
			var(--c-accent);
		color: var(--c-on-accent);
		contain: layout paint;
	}

	.ozb-ticker-track {
		width: max-content;
		display: flex;
		animation: ozb-marquee 48s linear infinite;
	}

	.ozb-ticker.is-offscreen .ozb-ticker-track {
		animation-play-state: paused;
	}

	.ozb-ticker-run {
		display: flex;
		flex: none;
	}

	.ozb-ticker-run > span {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-tango);
		font-size: clamp(17px, 2.2vw, 26px);
		font-style: italic;
		font-weight: 700;
		line-height: 1.1;
		white-space: nowrap;
	}

	.ozb-ticker-run > span::after {
		width: 0.3em;
		height: 0.3em;
		margin-inline: 0.9em;
		background: currentColor;
		rotate: 45deg;
		content: '';
	}

	/* ---------- Section headings: a numbered leg chip, a cream title with the "55" drop, and the logo's pinstripe ---------- */

	:global(:root[data-theme='night']) .section-heading {
		padding-bottom: 22px;
		margin-bottom: clamp(20px, 3.5vh, 40px);
	}

	:global(:root[data-theme='night']) .section-heading::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 6px;
		background:
			linear-gradient(var(--c-accent) 0 0) left top / 100% 2px no-repeat,
			linear-gradient(var(--c-accent) 0 0) left bottom / 100% 1px no-repeat;
		opacity: 0.85;
		pointer-events: none;
		transform-origin: left;
		content: '';
	}

	:global(:root[data-theme='night']) .eyebrow {
		color: var(--c-muted);
		font-weight: 800;
		letter-spacing: 0.16em;
	}

	:global(:root[data-theme='night']) .section-heading .eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 12px;
	}

	:global(:root[data-theme='night']) .section-heading .eyebrow::before {
		padding: 3px 9px 2px 7px;
		border-radius: 999px;
		background: var(--c-accent);
		color: var(--c-on-accent);
		font-family: var(--font-tango);
		font-size: 1.15em;
		font-style: italic;
		font-weight: 700;
		letter-spacing: 0;
		content: counter(oz-band, decimal-leading-zero);
	}

	:global(:root[data-theme='night']) .section-heading h2 {
		max-width: 960px;
		color: var(--c-text);
		font-family: var(--font-tango);
		font-style: italic;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1;
		text-wrap: balance;
	}

	:global(:root[data-theme='night']) .section-heading h2 span {
		color: var(--c-text);
		text-shadow: -0.055em 0.055em 0 var(--c-accent);
	}

	/* Where supported, headings rise in and the pinstripe draws across as each section scrolls into view. */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			:global(:root[data-theme='night']) .section-heading > div {
				animation: ozb-rise linear both;
				animation-timeline: view();
				animation-range: entry 5% entry 70%;
			}

			:global(:root[data-theme='night']) .section-heading::after {
				animation: ozb-draw linear both;
				animation-timeline: view();
				animation-range: entry 15% cover 40%;
			}
		}
	}

	/* ---------- Small labels: bold tracked caps instead of retro's mixed case ---------- */

	:global(:root[data-theme='night']) .card-index,
	:global(:root[data-theme='night']) .card-status,
	:global(:root[data-theme='night']) .placeholder-caption,
	:global(:root[data-theme='night']) .program-count,
	:global(:root[data-theme='night']) .news-carousel-count,
	:global(:root[data-theme='night']) .calendar-date > span,
	:global(:root[data-theme='night']) .preview-caption,
	:global(:root[data-theme='night']) .preview-duration,
	:global(:root[data-theme='night']) .story-date,
	:global(:root[data-theme='night']) .youtube-current,
	:global(:root[data-theme='night']) .video-picker-item span,
	:global(:root[data-theme='night']) .program-dialog-label,
	:global(:root[data-theme='night']) .news-list-sort-label,
	:global(:root[data-theme='night']) .news-list-item-copy time,
	:global(:root[data-theme='night']) .article-dialog-status,
	:global(:root[data-theme='night']) .listener-confirmation dt,
	:global(:root[data-theme='night']) .broadcast-label,
	:global(:root[data-theme='night']) .on-air,
	:global(:root[data-theme='night']) .stream-status,
	:global(:root[data-theme='night']) .contact-item > span,
	:global(:root[data-theme='night']) .ad-space > span,
	:global(:root[data-theme='night']) .social-topline,
	:global(:root[data-theme='night']) .listener-stats,
	:global(:root[data-theme='night']) .live-chat-heading h2,
	:global(:root[data-theme='night']) .live-chat-heading span,
	:global(:root[data-theme='night']) .live-chat-mod-control,
	:global(:root[data-theme='night']) .site-footer-column h2,
	:global(:root[data-theme='night']) .site-footer-bottom {
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	:global(:root[data-theme='night']) .card-index,
	:global(:root[data-theme='night']) .contact-item > span,
	:global(:root[data-theme='night']) .calendar-date > span {
		color: var(--c-accent);
	}

	:global(:root[data-theme='night']) .feature-card p,
	:global(:root[data-theme='night']) .contact-intro p,
	:global(:root[data-theme='night']) .calendar-event div span,
	:global(:root[data-theme='night']) .contact-item small,
	:global(:root[data-theme='night']) .news-list-item-copy p,
	:global(:root[data-theme='night']) .google-auth-note,
	:global(:root[data-theme='night']) .listener-confirmation p,
	:global(:root[data-theme='night']) .listener-confirmation dd,
	:global(:root[data-theme='night']) .announcer-card-copy p {
		line-height: 1.6;
	}

	/* ---------- Buttons and links: pills that fill marigold when pressed toward ---------- */

	:global(:root[data-theme='night']) .outline-link,
	:global(:root[data-theme='night']) .news-list-trigger {
		min-height: 40px;
		padding: 8px 16px;
		border: 1.5px solid var(--c-outline);
		border-radius: 999px;
		background: transparent;
		color: var(--c-text);
		font-weight: 800;
		letter-spacing: 0.08em;
		white-space: nowrap;
		transition: border-color 160ms ease, color 160ms ease, background-color 160ms ease, transform 160ms var(--ozb-out);
	}

	:global(:root[data-theme='night']) .social-card-bottom {
		flex-wrap: wrap;
	}

	:global(:root[data-theme='night']) .social-card-bottom .outline-link {
		flex: none;
	}

	:global(:root[data-theme='night']) .outline-link:not([aria-disabled='true']):hover,
	:global(:root[data-theme='night']) .news-list-trigger:hover {
		border-color: var(--c-accent);
		background: var(--c-accent);
		color: var(--c-on-accent);
		box-shadow: none;
		transform: none;
	}

	:global(:root[data-theme='night']) .outline-link:not([aria-disabled='true']):active,
	:global(:root[data-theme='night']) .news-list-trigger:active {
		transform: scale(0.96);
	}

	:global(:root[data-theme='night']) .carousel-chevron {
		background: color-mix(in srgb, var(--c-surface-2) 88%, transparent);
		box-shadow: 0 10px 24px -12px rgb(0 0 0 / 80%);
		color: var(--c-text);
	}

	:global(:root[data-theme='night']) .carousel-chevron:hover {
		border-color: var(--c-accent);
		background: var(--c-accent);
		color: var(--c-on-accent);
		box-shadow: 0 10px 24px -12px rgb(0 0 0 / 80%);
		transform: none;
	}

	:global(:root[data-theme='night']) .carousel-chevron:active {
		box-shadow: none;
		transform: scale(0.94);
	}

	:global(:root[data-theme='night']) .video-picker-item {
		padding: 8px 10px;
		border: 1px solid var(--c-line);
		border-radius: 12px;
		background: var(--c-surface-2);
	}

	:global(:root[data-theme='night']) .video-picker-item[aria-pressed='true'] {
		border-color: var(--c-accent);
		color: var(--c-accent);
	}

	:global(:root[data-theme='night']) .video-picker-item:hover {
		background: var(--c-surface);
		color: var(--c-text);
	}

	/* ---------- On air: the marathon studio ---------- */

	:global(:root[data-theme='night']) .live-chat-heading {
		background: var(--c-surface-2);
	}

	:global(:root[data-theme='night']) .live-chat-heading h2,
	:global(:root[data-theme='night']) .live-chat-heading span,
	:global(:root[data-theme='night']) .live-chat-mod-control,
	:global(:root[data-theme='night']) .listen-content .broadcast-label {
		color: var(--c-text);
	}

	:global(:root[data-theme='night']) .broadcast-heading {
		background: var(--c-stage-2);
		box-shadow: inset 0 -1px 0 rgb(var(--ozb-glow) / 25%);
	}

	:global(:root[data-theme='night']) .listen-content .broadcast-heading .on-air {
		padding: 4px 10px;
		border: 1px solid rgb(255 79 46 / 55%);
		border-radius: 999px;
		color: var(--c-signal);
	}

	:global(:root[data-theme='night']) .broadcast-heading .on-air::before {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--c-signal);
		box-shadow: 0 0 8px var(--c-signal);
		content: '';
		animation: ozb-signal 1.6s ease-in-out infinite;
	}

	:global(:root[data-theme='night']) .broadcast {
		background: radial-gradient(ellipse at 50% 58%, rgb(var(--ozb-glow) / 12%), transparent 62%), var(--c-stage);
	}

	:global(:root[data-theme='night']) .broadcast-backdrop img {
		filter: grayscale(1) sepia(0.5) contrast(1.1);
		opacity: 0.16;
	}

	/* The tune-in button carries the logo's ring: marigold, a gap of ink, then a fainter marigold ring. */
	:global(:root[data-theme='night']) .tune-in-icon {
		border: 0;
		box-shadow: 0 0 0 6px var(--c-stage), 0 0 0 8px rgb(var(--ozb-glow) / 60%), 0 0 0 22px rgb(var(--ozb-glow) / 7%), 0 0 60px rgb(var(--ozb-glow) / 40%);
		transition: transform 220ms var(--ozb-pop);
	}

	:global(:root[data-theme='night']) .broadcast-options .broadcast-option:hover .tune-in-icon {
		transform: scale(1.06);
	}

	:global(:root[data-theme='night']) .tune-in-frequency {
		color: var(--c-accent);
		font-weight: 800;
		letter-spacing: 0.16em;
	}

	:global(:root[data-theme='night']) .broadcast.is-streaming .broadcast-options .broadcast-option {
		min-height: 34px;
		padding: 0 14px;
		border: 1px solid var(--c-line);
		border-radius: 999px;
		background: var(--c-surface);
		color: var(--c-text);
	}

	:global(:root[data-theme='night']) .broadcast.is-streaming .broadcast-options .broadcast-option:hover {
		border-color: var(--c-accent);
		background: var(--c-accent);
		color: var(--c-on-accent);
	}

	:global(:root[data-theme='night']) .listener-stats {
		border-top-color: var(--c-line);
		background: rgb(8 8 9 / 76%);
	}

	:global(:root[data-theme='night']) .live-chat-compose {
		min-height: 48px;
		padding: 0 5px 0 12px;
		border-radius: 999px;
	}

	:global(:root[data-theme='night']) .live-chat-compose button {
		min-height: 38px;
		border-radius: 999px;
	}

	:global(:root[data-theme='night']) .google-signin,
	:global(:root[data-theme='night']) .listener-submit {
		min-height: 46px;
		border-radius: 999px;
	}

	:global(:root[data-theme='night']) .ad-space {
		border: 1px dashed var(--c-outline);
		background: transparent;
	}

	/* ---------- Announcers: the marigold band, racing-striped, like the logo's script ---------- */

	:global(:root[data-theme='night']) .screen-dark {
		--c-line: rgb(15 15 16 / 22%);
		--c-muted: rgb(15 15 16 / 62%);
		--c-outline: rgb(15 15 16 / 30%);
		--c-signal: #B42A12;
		border-bottom-color: transparent;
		background:
			repeating-linear-gradient(-55deg, rgb(15 15 16 / 4.5%) 0 18px, transparent 18px 36px),
			radial-gradient(ellipse at 12% 0%, rgb(255 255 255 / 24%), transparent 55%),
			var(--c-accent);
		color: var(--c-on-accent);
	}

	:global(:root[data-theme='night']) .screen-dark .eyebrow {
		color: #3D2A05;
	}

	:global(:root[data-theme='night']) .screen-dark .section-heading .eyebrow::before {
		background: var(--ozb-ink);
		color: var(--c-accent);
	}

	:global(:root[data-theme='night']) .screen-dark .section-heading::after {
		background:
			linear-gradient(var(--ozb-ink) 0 0) left top / 100% 2px no-repeat,
			linear-gradient(var(--ozb-ink) 0 0) left bottom / 100% 1px no-repeat;
	}

	:global(:root[data-theme='night']) .screen-dark .section-heading h2,
	:global(:root[data-theme='night']) .screen-dark .section-heading h2 span {
		color: var(--ozb-ink);
	}

	:global(:root[data-theme='night']) .screen-dark .section-heading h2 span {
		text-shadow: -0.055em 0.055em 0 var(--ozb-cream);
	}

	:global(:root[data-theme='night']) .screen-dark .announcer-card {
		border: 0;
		box-shadow: 0 0 0 1.5px rgb(15 15 16 / 85%), 0 24px 40px -18px rgb(60 35 0 / 80%);
	}

	:global(:root[data-theme='night']) .screen-dark .announcer-card[data-announcer-card]:hover {
		box-shadow: 0 0 0 2px var(--ozb-ink), 0 0 0 5px var(--c-accent), 0 0 0 6.5px var(--ozb-ink), 0 30px 50px -18px rgb(60 35 0 / 90%);
	}

	:global(:root[data-theme='night']) .screen-dark .announcer-card[data-announcer-card]:focus-visible {
		outline-color: var(--c-on-accent);
	}

	/* ---------- Cards and the rest ---------- */

	:global(:root[data-theme='night']) .social-topline,
	:global(:root[data-theme='night']) .calendar-head {
		background: transparent;
		color: var(--c-muted);
	}

	:global(:root[data-theme='night']) .social-mark,
	:global(:root[data-theme='night']) .calendar-head .card-index,
	:global(:root[data-theme='night']) .calendar-icon {
		color: var(--c-accent);
	}

	:global(:root[data-theme='night']) .activity-art > span {
		font-weight: 800;
	}

	:global(:root[data-theme='night']) .contact-layout {
		background:
			radial-gradient(rgb(var(--ozb-glow) / 12%) 1px, transparent 1.6px) right bottom / 13px 13px,
			linear-gradient(140deg, var(--c-surface), var(--c-bg) 120%);
	}

	:global(:root[data-theme='night']) .contact-item strong {
		overflow-wrap: anywhere;
	}

	:global(:root[data-theme='night']) .contact-item strong a {
		text-decoration-color: rgb(var(--ozb-glow) / 45%);
		text-underline-offset: 3px;
	}

	:global(:root[data-theme='night']) .contact-socials {
		gap: 8px;
	}

	/* 44px circles: comfortable touch targets. */
	:global(:root[data-theme='night']) .contact-social {
		width: 44px;
		height: 44px;
		place-items: center;
		display: grid;
		border: 1px solid var(--c-line);
		border-radius: 50%;
		transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
	}

