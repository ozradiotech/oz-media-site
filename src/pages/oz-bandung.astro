	const googleSignIn = googleAuth?.querySelector<HTMLButtonElement>('[data-google-signin]');
	const googleUser = googleAuth?.querySelector<HTMLElement>('[data-google-user]');
	const googleName = googleAuth?.querySelector<HTMLElement>('[data-google-name]');
	const googleAvatar = googleAuth?.querySelector<HTMLImageElement>('[data-google-avatar]');
	const googleSignOut = googleAuth?.querySelector<HTMLButtonElement>('[data-google-signout]');
	const googleAuthNote = googleAuth?.querySelector<HTMLElement>('[data-google-auth-note]');
	const livePlayer = document.querySelector<HTMLIFrameElement>('[data-youtube-live]');
	const audioPlayerContainer = document.querySelector<HTMLElement>('[data-audio-player]');
	const fallbackAudio = audioPlayerContainer?.querySelector<HTMLAudioElement>('audio');
	const trackTitle = document.querySelector<HTMLElement>('[data-track-title]');
	const trackArtist = document.querySelector<HTMLElement>('[data-track-artist]');
	const listenerCount = document.querySelector<HTMLElement>('[data-listener-count]');
	const locationInput = listenerForm?.querySelector<HTMLInputElement>('[data-location-input]');
	const locationOptions = listenerForm?.querySelector<HTMLElement>('[data-location-options]');
	const listenerSessionKey = 'oz-listener-details-saved';
	// The form asks once per session: saving or dismissing it both count.
	const listenerPromptKey = 'oz-listener-form-shown';
	let listenerDetailsSaved = false;
	let listenerPromptShown = false;
	try {
		listenerDetailsSaved = sessionStorage.getItem(listenerSessionKey) === 'true';
		listenerPromptShown = sessionStorage.getItem(listenerPromptKey) === 'true';
	} catch {}
	let selectedBroadcast: 'audio' | 'video' | null = null;
	let nowPlayingTimer: number | undefined;

	const stopNowPlayingUpdates = () => {
		if (nowPlayingTimer !== undefined) {
			window.clearInterval(nowPlayingTimer);
			nowPlayingTimer = undefined;
		}
	};

	const updateNowPlaying = async () => {
		if (!trackTitle || !trackArtist || !listenerCount) return;

		try {
			const response = await fetch('/api/now-playing', { cache: 'no-store' });
			if (!response.ok) throw new Error('Track title unavailable.');

			const data = (await response.json()) as {
				title?: unknown;
				listeners?: unknown;
			};
			const metadata = typeof data.title === 'string' ? data.title.trim() : '';
			listenerCount.textContent = typeof data.listeners === 'number' ? data.listeners.toLocaleString() : '—';
			const separatorIndex = metadata.lastIndexOf(' - ');
			if (separatorIndex > 0 && separatorIndex < metadata.length - 3) {
				trackTitle.textContent = metadata.slice(0, separatorIndex).trim();
				trackArtist.textContent = metadata.slice(separatorIndex + 3).trim();
			} else {
				trackTitle.textContent = metadata || 'Track title unavailable';
				trackArtist.textContent = '';
			}
		} catch {
			trackTitle.textContent = 'Track title unavailable';
			trackArtist.textContent = '';
			listenerCount.textContent = '—';
		}
		syncAudioPlayerTrack();
	};

	const startNowPlayingUpdates = () => {
		if (nowPlayingTimer !== undefined || !trackTitle || !trackArtist) return;
		void updateNowPlaying();
		nowPlayingTimer = window.setInterval(() => { void updateNowPlaying(); }, 30_000);
	};

	// Video.js drives the audio stream (see src/scripts/oz-audio-player.ts). It is only downloaded once a
	// visitor shows interest in tuning in; until then, or if it fails to load, the native <audio> element is used.
	type OzAudioPlayer = import('../scripts/oz-audio-player').OzAudioPlayer;
	let audioPlayer: OzAudioPlayer | undefined;
	let audioPlayerRequest: Promise<OzAudioPlayer | undefined> | undefined;

	const syncAudioPlayerTrack = () => {
		audioPlayer?.setTrack(trackTitle?.textContent?.trim() ?? '', trackArtist?.textContent?.trim() ?? '');
	};

	const loadAudioPlayer = () => {
		const streamUrl = audioPlayerContainer?.dataset.streamUrl;
		if (!audioPlayerContainer || !fallbackAudio || !streamUrl) return Promise.resolve(undefined);
		audioPlayerRequest ??= import('../scripts/oz-audio-player')
			.then(({ createOzAudioPlayer }) => {
				audioPlayerContainer.closest('.audio-bar')?.classList.add('has-videojs');
				audioPlayer = createOzAudioPlayer(fallbackAudio, streamUrl);
				syncAudioPlayerTrack();
				return audioPlayer;
			})
			.catch(() => undefined);
		return audioPlayerRequest;
	};

	const playAudio = () => {
		if (audioPlayer) {
			audioPlayer.play();
			return;
		}
		void loadAudioPlayer().then((player) => {
			// The visitor may have switched streams while the player was loading.
			if (selectedBroadcast !== 'audio' || !broadcast?.classList.contains('is-streaming')) return;
			if (player) player.play();
			else fallbackAudio?.play().catch(() => {});
		});
	};

	const pauseAudio = () => {
		if (audioPlayer) audioPlayer.pause();
		else fallbackAudio?.pause();
	};

	// Fetch the player ahead of time when a visitor heads for the tune-in button.
	tuneInButton?.addEventListener('pointerenter', () => { void loadAudioPlayer(); }, { once: true });
	tuneInButton?.addEventListener('focus', () => { void loadAudioPlayer(); }, { once: true });

	// These stay attached after the upgrade: Video.js plays through this same element.
	fallbackAudio?.addEventListener('play', startNowPlayingUpdates);
	fallbackAudio?.addEventListener('pause', stopNowPlayingUpdates);
	fallbackAudio?.addEventListener('ended', stopNowPlayingUpdates);

	const stopBroadcast = () => {
		stopNowPlayingUpdates();
		pauseAudio();
		livePlayer?.removeAttribute('src');
		broadcast?.classList.remove('is-streaming');
		if (tuneInLabel) tuneInLabel.textContent = 'Tune in';
		broadcastPanels.forEach((panel) => { panel.hidden = true; });
		if (broadcastEmpty) broadcastEmpty.hidden = false;
	};

	// Google sign-in (Firebase, see src/scripts/oz-auth.ts) is needed to send the listener form and to chat, not
	// to tune in. The SDK is only downloaded once a visitor heads for the tune-in button or the form opens.
	type OzAuth = import('../scripts/oz-auth').OzAuth;
	type OzUser = import('../scripts/oz-auth').OzUser;
	let ozAuth: OzAuth | undefined;
	let authRequest: Promise<OzAuth | undefined> | undefined;

	const renderAuth = (user: OzUser | null) => {
		if (!googleSignIn || !googleUser || !googleName || !googleAvatar || !googleAuthNote) return;
		googleSignIn.hidden = Boolean(user);
		googleUser.hidden = !user;
		googleName.textContent = user?.displayName || user?.email || '';
		googleAvatar.hidden = !user?.photoURL;
		if (user?.photoURL) googleAvatar.src = user.photoURL;
		googleAuthNote.textContent = user ? '' : 'Sign in with Google to save your details.';
		googleAuthNote.hidden = Boolean(user);
	};

	const showAuthError = (message: string) => {
		if (!googleAuthNote) return;
		googleAuthNote.textContent = message;
		googleAuthNote.hidden = false;
	};

	const loadAuth = () => {
		authRequest ??= import('../scripts/oz-auth')
			.then(({ createOzAuth }) => {
				ozAuth = createOzAuth();
				ozAuth.onChange(renderAuth);
				return ozAuth;
			})
			.catch(() => undefined);
		return authRequest;
	};

	// Live chat (src/scripts/oz-chat.ts) and the Firebase SDKs it needs load as the chat comes into view.
	// Anyone can read it; sending needs the same Google sign-in as the listener form.
	const liveChat = document.querySelector<HTMLElement>('[data-live-chat]');
	if (liveChat?.dataset.chatRoom) {
		const chatRoom = liveChat.dataset.chatRoom;
		const chatObserver = new IntersectionObserver((entries) => {
			if (!entries.some((entry) => entry.isIntersecting)) return;
			chatObserver.disconnect();
			import('../scripts/oz-chat')
				.then(({ mountOzChat }) => mountOzChat(liveChat, { room: chatRoom, loadAuth }))
				.catch(() => {
					const empty = liveChat.querySelector<HTMLElement>('[data-chat-empty]');
					if (empty) empty.textContent = 'Chat could not be loaded. Please reload the page.';
				});
		}, { rootMargin: '200px' });
		chatObserver.observe(liveChat);
	}

	const startBroadcast = () => {
		if (!selectedBroadcast) return;
		broadcast?.classList.add('is-streaming');
		if (tuneInLabel) tuneInLabel.textContent = 'Change stream';
		broadcastPanels.forEach((panel) => {
			panel.hidden = panel.dataset.broadcastPanel !== selectedBroadcast;
		});
		if (broadcastEmpty) broadcastEmpty.hidden = true;

		if (selectedBroadcast === 'audio') {
			startNowPlayingUpdates();
			playAudio();
			return;
		}

		// The iframe only gets its src here, so YouTube loads nothing until a visitor picks video.
		const embedUrl = livePlayer?.dataset.youtubeLive;
		if (livePlayer && embedUrl) {
			const playerUrl = new URL(embedUrl);
			playerUrl.searchParams.set('autoplay', '1');
			playerUrl.searchParams.set('playsinline', '1');
			playerUrl.searchParams.set('rel', '0');
			livePlayer.src = playerUrl.toString();
		}
	};

	// The dialog has two uses: picking a stream when tuning in, and the listener form, which opens by itself
	// once a visitor scrolls past the Online section. Each shows only its own parts.
	const showDialogPart = (part: 'broadcast' | 'details') => {
		if (!listenerForm || !listenerFields || !listenerConfirmation || !listenerSubmit || !broadcastSelection || !googleAuth) return;
		listenerForm.reset();
		broadcastSelection.hidden = part !== 'broadcast';
		listenerFields.hidden = part !== 'details';
		listenerFields.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => { field.disabled = part !== 'details'; });
		googleAuth.hidden = part !== 'details';
		if (googleSignIn) googleSignIn.disabled = false;
		listenerConfirmation.hidden = true;
		listenerConfirmation.replaceChildren();
		listenerSubmit.hidden = part !== 'details';
		listenerSubmit.disabled = false;
		listenerSubmit.textContent = 'Save details';
	};

	tuneInButton?.addEventListener('click', () => {
		if (!listenerDialog || !dialogTitle) return;
		stopBroadcast();
		selectedBroadcast = null;
		void loadAudioPlayer();
		showDialogPart('broadcast');
		dialogTitle.textContent = 'Choose how to tune in';
		listenerDialog.showModal();
		broadcastModeButtons[0]?.focus();
	});

	broadcastModeButtons.forEach((button) => {
		button.addEventListener('click', () => {
			selectedBroadcast = button.dataset.selectBroadcast === 'video' ? 'video' : 'audio';
			listenerDialog?.close();
			// Still inside the click, so the browser lets the stream start with sound.
			startBroadcast();
		});
	});

	let locationAutocomplete: Promise<unknown> | undefined;
	const loadLocationAutocomplete = () => {
		if (!locationInput || !locationOptions) return;
		locationAutocomplete ??= import('../scripts/oz-location-autocomplete')
			.then(({ mountLocationAutocomplete }) => mountLocationAutocomplete(locationInput, locationOptions))
			.catch(() => undefined);
	};

	const fillNameFromGoogle = (user: OzUser | null) => {
		const nameField = listenerForm?.elements.namedItem('name');
		if (nameField instanceof HTMLInputElement && !nameField.value && user?.displayName) nameField.value = user.displayName;
	};

	const openListenerForm = () => {
		if (!listenerDialog || !dialogTitle || listenerDetailsSaved || listenerPromptShown) return;
		// Wait for whatever the visitor has open (an article, a program) rather than stacking on top of it.
		const openDialog = document.querySelector<HTMLDialogElement>('dialog[open]');
		if (openDialog) {
			openDialog.addEventListener('close', openListenerForm, { once: true });
			return;
		}
		listenerPromptShown = true;
		try {
			sessionStorage.setItem(listenerPromptKey, 'true');
		} catch {}
		showDialogPart('details');
		dialogTitle.textContent = 'Tell us about you';
		loadLocationAutocomplete();
		void loadAuth().then(async (auth) => {
			if (!auth) {
				showAuthError('Google sign-in is unavailable right now. Please try again later.');
				if (googleSignIn) googleSignIn.disabled = true;
				return;
			}
			const user = await auth.ready().catch(() => null);
			renderAuth(user);
			fillNameFromGoogle(user);
		});
		listenerDialog.showModal();
	};

	if (onlineSection && !listenerDetailsSaved && !listenerPromptShown) {
		const listenerPromptObserver = new IntersectionObserver((entries) => {
			// Past means the section's bottom has gone above the viewport, not just out of view below it.
			const scrolledPast = entries.some((entry) => !entry.isIntersecting && entry.boundingClientRect.bottom <= 0);
			if (!scrolledPast) return;
			listenerPromptObserver.disconnect();
			openListenerForm();
		});
		listenerPromptObserver.observe(onlineSection);
	}

	googleSignIn?.addEventListener('click', async () => {
		const auth = ozAuth ?? await loadAuth();
		if (!auth) {
			showAuthError('Google sign-in is unavailable right now. Please try again later.');
			return;
		}
		googleSignIn.disabled = true;
		try {
			const user = await auth.signIn();
			renderAuth(user);
			fillNameFromGoogle(user);
		} catch (error) {
			const code = error && typeof error === 'object' && 'code' in error ? error.code : undefined;
			if (code === 'auth/popup-closed-by-user' || code === 'auth/cancelled-popup-request') return;
			showAuthError(code === 'auth/popup-blocked'
				? 'Your browser blocked the sign-in window. Allow pop-ups for this site and try again.'
				: 'Google sign-in failed. Please try again.');
		} finally {
			googleSignIn.disabled = false;
		}
	});

	googleSignOut?.addEventListener('click', () => { void ozAuth?.signOut(); });

	listenerDialog?.querySelector('[data-dialog-close]')?.addEventListener('click', () => listenerDialog.close());

	listenerForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!listenerFields || !listenerConfirmation || !listenerSubmit || !dialogTitle) return;

		// Once the details are saved, the button just closes the dialog.
		if (listenerFields.hidden) {
			listenerDialog?.close();
			return;
		}

		if (!listenerForm.reportValidity()) return;
		const user = ozAuth?.currentUser();
		if (!user) {
			showAuthError('Please sign in with Google to continue.');
			googleSignIn?.focus();
			return;
		}
		const listener = new FormData(listenerForm);
		listenerSubmit.disabled = true;
		listenerSubmit.textContent = 'Saving...';
		try {
			const response = await fetch('/api/listeners', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					name: String(listener.get('name')).trim(),
					age: listener.get('age'),
					gender: listener.get('gender'),
					location: String(listener.get('location')).trim(),
					broadcast: broadcast?.classList.contains('is-streaming') ? selectedBroadcast : null,
					uid: user.uid,
					email: user.email,
				}),
			});
			if (!response.ok) throw new Error('Listener details could not be saved. Please try again.');
			listenerDetailsSaved = true;
			try {
				sessionStorage.setItem(listenerSessionKey, 'true');
			} catch {}
		} catch (error) {
			const message = document.createElement('p');
			message.textContent = error instanceof Error ? error.message : 'Listener details could not be saved. Please try again.';
			listenerConfirmation.replaceChildren(message);
			listenerConfirmation.hidden = false;
			listenerSubmit.disabled = false;
			listenerSubmit.textContent = 'Save details';
			return;
		}
		listenerSubmit.disabled = false;
		const details = [
			['Name', listener.get('name')],
			['Age', listener.get('age')],
			['Gender', listener.get('gender')],
			['Location', listener.get('location')],
		] as const;
		const message = document.createElement('p');
		message.textContent = 'Thanks for listening to OZ Radio Bandung.';
		const summary = document.createElement('dl');
		details.forEach(([label, value]) => {
			const term = document.createElement('dt');
			term.textContent = label;
			const description = document.createElement('dd');
			description.textContent = String(value ?? '');
			summary.append(term, description);
		});
		listenerConfirmation.replaceChildren(message, summary);
		listenerFields.hidden = true;
		listenerFields.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => { field.disabled = true; });
		if (googleAuth) googleAuth.hidden = true;
		listenerConfirmation.hidden = false;
		listenerSubmit.textContent = 'Done';
		dialogTitle.textContent = 'You’re all set';
	});
</script>

