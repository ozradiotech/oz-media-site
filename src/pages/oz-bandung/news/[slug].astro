---
// One OZ News article, laid out like a newspaper story page: headline, standfirst, byline, lead photo,
// the body in a reading column, sharing, then related and latest stories to read next.
import { render } from 'astro:content';
import NewsLayout from '../../../layouts/NewsLayout.astro';
import {
	formatNewsDate,
	formatNewsDateTime,
	getVisibleNews,
	newsIndexPath,
	newsPath,
	readingMinutes,
	relatedNews,
	type NewsEntry,
} from '../../../lib/news';

// Built ahead of time; the CMS commits to main, which redeploys the site with the new article.
export const prerender = true;

export async function getStaticPaths() {
	const all = await getVisibleNews();
	return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}

interface Props {
	entry: NewsEntry;
	all: NewsEntry[];
}

const { entry, all } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const path = newsPath(entry);
const related = relatedNews(entry, all, 3);
const latest = all.filter((other) => other.id !== entry.id && !related.includes(other)).slice(0, 5);
const minutes = readingMinutes(entry);
const shareUrl = Astro.site ? new URL(path, Astro.site).href : '';

// Search engines read this to show the story as a news article.
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'NewsArticle',
	headline: data.title,
	description: data.summary,
	image: data.image ? [Astro.site ? new URL(data.image, Astro.site).href : data.image] : undefined,
	datePublished: data.publishedAt?.toISOString(),
	articleSection: data.category,
	inLanguage: 'id',
	author: { '@type': 'Organization', name: 'OZ Radio Bandung' },
	publisher: { '@type': 'Organization', name: 'OZ Radio Bandung' },
	mainEntityOfPage: Astro.site ? new URL(path, Astro.site).href : undefined,
};
---

<NewsLayout
	title={data.title}
	description={data.summary}
	path={path}
	image={data.image}
	imageAlt={data.imageAlt}
	article={{ publishedAt: data.publishedAt, section: data.category }}
	readingProgress
>
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

	<article class="story" lang="id" data-story>
		<header class="story-header">
			<nav class="news-crumbs" aria-label="Breadcrumb" lang="en">
				<a href="/oz-bandung">OZ Radio Bandung</a>
				<span aria-hidden="true">/</span>
				<a href={newsIndexPath}>OZ News</a>
			</nav>
			<p class="news-kicker">{data.category}</p>
			<h1 class="story-headline">{data.title}</h1>
			{data.summary && <p class="story-standfirst">{data.summary}</p>}

			<div class="story-meta" lang="en">
				<div class="story-byline">
					<img class="story-byline-mark" src="/images/logo-oz-logogram.png" alt="" width="40" height="40" />
					<p>
						<span>By <strong>OZ Radio Bandung Newsroom</strong></span>
						<span class="story-dateline">
							{data.publishedAt && <time datetime={data.publishedAt.toISOString()}>{formatNewsDateTime(data.publishedAt)}</time>}
							{data.publishedAt && <span aria-hidden="true">·</span>}
							<span>{minutes} min read</span>
						</span>
					</p>
				</div>
				<div class="story-share" data-share data-share-url={shareUrl} data-share-title={data.title}>
					<span class="story-share-label">SHARE</span>
					<a class="story-share-button" data-share-network="whatsapp" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.2-1.4A9.9 9.9 0 1 0 12 2Zm0 18.1c-1.5 0-3-.4-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.1Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" /></svg>
					</a>
					<a class="story-share-button" data-share-network="x" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.3 4.7H5.5l11.2 14.5Z" /></svg>
					</a>
					<a class="story-share-button" data-share-network="facebook" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.6V3.6a22 22 0 0 0-2.4-.1c-2.4 0-4 1.4-4 4.1v2.3H7.6V13h2.7v8h3.2Z" /></svg>
					</a>
					<button class="story-share-button" type="button" data-share-copy aria-label="Copy link">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" /></svg>
					</button>
					<span class="story-share-status" role="status" data-share-status></span>
				</div>
			</div>
		</header>

		{data.image && (
			<figure class="story-figure">
				<img src={data.image} alt={data.imageAlt} fetchpriority="high" decoding="async" />
				{data.imageAlt && <figcaption>{data.imageAlt}</figcaption>}
			</figure>
		)}

		<div class="story-body">
			<Content />
		</div>

		<footer class="story-end" lang="en">
			<a class="news-pill" href={newsIndexPath}>← ALL OZ NEWS</a>
			<a class="news-pill" href="/oz-bandung#listen"><span class="news-live-dot" aria-hidden="true"></span>LISTEN TO OZ RADIO BANDUNG</a>
		</footer>
	</article>

	{(related.length > 0 || latest.length > 0) && (
		<aside class="story-next" aria-label="More from OZ News">
			{related.length > 0 && (
				<section class="story-related" aria-labelledby="related-title">
					<h2 class="news-rule-heading" id="related-title">Read next</h2>
					<div class="story-related-grid">
						{related.map((other) => (
							<a class="news-card" href={newsPath(other)}>
								<div class="news-card-image"><img src={other.data.image} alt="" loading="lazy" decoding="async" /></div>
								<div class="news-card-copy">
									<span class="news-kicker">{other.data.category}</span>
									<h3>{other.data.title}</h3>
									{other.data.publishedAt && <time datetime={other.data.publishedAt.toISOString()}>{formatNewsDate(other.data.publishedAt)}</time>}
								</div>
							</a>
						))}
					</div>
				</section>
			)}
			{latest.length > 0 && (
				<section class="story-latest" aria-labelledby="latest-title">
					<h2 class="news-rule-heading" id="latest-title">Latest from OZ News</h2>
					<ol class="news-ranked">
						{latest.map((other) => (
							<li>
								<a href={newsPath(other)}>
									<span class="news-ranked-title">{other.data.title}</span>
									{other.data.publishedAt && <time datetime={other.data.publishedAt.toISOString()}>{formatNewsDate(other.data.publishedAt)}</time>}
								</a>
							</li>
						))}
					</ol>
					<a class="news-pill" href={newsIndexPath}>SEE ALL STORIES →</a>
				</section>
			)}
		</aside>
	)}
</NewsLayout>

<script>
	import { onEveryPage } from '../../../scripts/oz-page';

	// Share links are filled in the browser so they carry the page's real address, wherever it is hosted.
	onEveryPage(() => document.querySelectorAll<HTMLElement>('[data-share]').forEach((share) => {
		const url = share.dataset.shareUrl || location.href.split('#')[0];
		const title = share.dataset.shareTitle ?? document.title;
		const links: Record<string, string> = {
			whatsapp: `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`,
			x: `https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
			facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
		};
		share.querySelectorAll<HTMLAnchorElement>('[data-share-network]').forEach((link) => {
			link.href = links[link.dataset.shareNetwork ?? ''] ?? url;
		});

		const status = share.querySelector<HTMLElement>('[data-share-status]');
		let statusTimer: number | undefined;
		share.querySelector('[data-share-copy]')?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(url);
				if (status) status.textContent = 'Link copied';
			} catch {
				if (status) status.textContent = 'Copy failed';
			}
			window.clearTimeout(statusTimer);
			statusTimer = window.setTimeout(() => {
				if (status) status.textContent = '';
			}, 2400);
		});
	}));
</script>
