---
// One on ground activity, laid out like an OZ News story: title, standfirst, date and place, a swipeable carousel of
// every photo uploaded in the CMS (no limit), the write-up and sharing, then more activities to look at.
import { render } from 'astro:content';
import NewsLayout from '../../../layouts/NewsLayout.astro';
import StoryShare from '../../../components/StoryShare.astro';
import { activitiesIndexPath, activitiesSection, activityPath, getActivities } from '../../../lib/activities';
import { cmsImage } from '../../../lib/cms';
import { imageFrame } from '../../../lib/news';

// Rendered per request from the CMS, so a published activity or a new photo shows up without a rebuild.
export const prerender = false;

const all = await getActivities();
const entry = all.find((other) => other.id === Astro.params.slug);
if (!entry) return new Response('Activity not found', { status: 404 });
const { data } = entry;
const { photos } = data;
const { Content } = await render(entry);

const path = activityPath(entry);
const shareUrl = Astro.site ? new URL(path, Astro.site).href : '';
// The next three in the CMS's order, wrapping round, so the last activity still has something after it.
const position = all.indexOf(entry);
const more = [...new Set([1, 2, 3].map((step) => all[(position + step) % all.length]))].filter((other) => other !== entry);
const absolute = (value: string) => (Astro.site ? new URL(value, Astro.site).href : value);

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: data.title,
	description: data.summary || undefined,
	image: photos.map((photo) => absolute(photo.image)),
	articleSection: data.category,
	author: { '@type': 'Organization', name: 'OZ Radio Bandung' },
	publisher: { '@type': 'Organization', name: 'OZ Radio Bandung' },
	mainEntityOfPage: Astro.site ? absolute(path) : undefined,
};
---

<NewsLayout
	title={data.title}
	description={data.summary || `${data.title}: an OZ Radio Bandung on ground activity.`}
	path={path}
	image={data.image}
	imageAlt={data.imageAlt}
	section={activitiesSection}
	readingProgress
>
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

	<article class="story" data-story>
		<header class="story-header">
			<nav class="news-crumbs" aria-label="Breadcrumb">
				<a href="/oz-bandung">OZ Radio Bandung</a>
				<span aria-hidden="true">/</span>
				<a href={activitiesIndexPath}>On Ground Activity</a>
			</nav>
			<p class="news-kicker">{data.category}</p>
			<h1 class="story-headline">{data.title}</h1>
			{data.summary && <p class="story-standfirst">{data.summary}</p>}

			<div class="story-meta">
				<div class="story-byline">
					<img class="story-byline-mark" src="/images/logo-oz-logogram.png" alt="" width="40" height="40" />
					<p>
						<span>By <strong>OZ Radio Bandung</strong></span>
						{data.status && <span class="story-dateline">{data.status}</span>}
					</p>
				</div>
				<StoryShare url={shareUrl} title={data.title} type="activity" />
			</div>
		</header>

		{photos.length > 0 && (
			<figure class="story-figure activity-gallery" data-gallery aria-roledescription="carousel" aria-label={`Photos of ${data.title}`}>
				<div class="activity-gallery-stage">
					<ul class="activity-gallery-track" role="list" tabindex="0" aria-label="Photos, use the arrow keys to move" data-gallery-track>
						{photos.map((photo, index) => (
							<li class="activity-gallery-slide" aria-roledescription="slide" aria-label={`${index + 1} of ${photos.length}`} {...imageFrame(photo, cmsImage(photo.image, 600))}>
								<img
									src={cmsImage(photo.image, 1600)}
									alt={photo.imageAlt}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</li>
						))}
					</ul>
					{photos.length > 1 && (
						<>
							<button class="activity-gallery-arrow activity-gallery-previous" type="button" data-gallery-previous aria-label="Previous photo">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4.5 7.5 12l7.5 7.5" /></svg>
							</button>
							<button class="activity-gallery-arrow activity-gallery-next" type="button" data-gallery-next aria-label="Next photo">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4.5 16.5 12 9 19.5" /></svg>
							</button>
							<span class="activity-gallery-count" data-gallery-count>1 / {photos.length}</span>
						</>
					)}
				</div>
				{photos.length > 1 && (
					<div class="activity-gallery-thumbs" role="group" aria-label="Choose a photo" data-gallery-thumbs>
						{photos.map((photo, index) => (
							<button class="activity-gallery-thumb" type="button" aria-label={`Show photo ${index + 1}`} aria-current={index === 0 ? 'true' : undefined} data-gallery-thumb>
								<img src={cmsImage(photo.image, 300)} alt="" loading="lazy" decoding="async" />
							</button>
						))}
					</div>
				)}
			</figure>
		)}

		<div class="story-body" lang="id">
			<Content />
		</div>

		<footer class="story-end">
			<a class="news-pill" href={activitiesIndexPath}>← ALL ON GROUND ACTIVITY</a>
			<a class="news-pill" href="/oz-bandung#listen"><span class="news-live-dot" aria-hidden="true"></span>LISTEN TO OZ RADIO BANDUNG</a>
		</footer>
	</article>

	{more.length > 0 && (
		<aside class="story-next activity-next" aria-label="More on ground activity">
			<section class="story-related" aria-labelledby="more-title">
				<h2 class="news-rule-heading" id="more-title">More on ground activity</h2>
				<div class="story-related-grid">
					{more.map((other) => (
						<a class="news-card" href={activityPath(other)}>
							<div class="news-card-image" {...imageFrame(other.data, cmsImage(other.data.image, 600))}><img src={cmsImage(other.data.image, 600)} alt="" loading="lazy" decoding="async" /></div>
							<div class="news-card-copy">
								<span class="news-kicker">{other.data.category}</span>
								<h3>{other.data.title}</h3>
								{other.data.status && <span class="news-card-when">{other.data.status}</span>}
							</div>
						</a>
					))}
				</div>
				<a class="news-pill" href={activitiesIndexPath}>SEE ALL ACTIVITIES →</a>
			</section>
		</aside>
	)}
</NewsLayout>

<script>
	import { onEveryPage } from '../../../scripts/oz-page';

	// The photo carousel is a scroll-snapping strip, so it swipes on phones and trackpads by itself. The arrows,
	// thumbnails, arrow keys and counter all follow whichever photo is in view.
	onEveryPage((signal) => document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
		const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
		const slides = Array.from(track?.children ?? []) as HTMLElement[];
		const count = gallery.querySelector<HTMLElement>('[data-gallery-count]');
		const thumbStrip = gallery.querySelector<HTMLElement>('[data-gallery-thumbs]');
		const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
		if (!track || slides.length < 2) return;
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
		let current = 0;

		// Past either end it wraps round, like the carousels on OZ Bandung.
		const show = (index: number) => {
			const target = slides[(index + slides.length) % slides.length];
			track.scrollTo({ left: target.offsetLeft, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
		};

		const settle = () => {
			const index = Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / (track.clientWidth || 1))));
			if (index === current) return;
			current = index;
			if (count) count.textContent = `${current + 1} / ${slides.length}`;
			thumbs.forEach((thumb, thumbIndex) => thumb.toggleAttribute('aria-current', thumbIndex === current));
			const thumb = thumbs[current];
			if (thumb && thumbStrip) {
				thumbStrip.scrollTo({
					left: thumb.offsetLeft - (thumbStrip.clientWidth - thumb.clientWidth) / 2,
					behavior: reducedMotion.matches ? 'auto' : 'smooth',
				});
			}
		};

		let frame = 0;
		track.addEventListener('scroll', () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(settle);
		}, { passive: true, signal });
		gallery.querySelector('[data-gallery-previous]')?.addEventListener('click', () => show(current - 1), { signal });
		gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1), { signal });
		thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => show(index), { signal }));
		track.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
			event.preventDefault();
			show(current + (event.key === 'ArrowRight' ? 1 : -1));
		}, { signal });
	}));
</script>
