---
// One on ground activity, laid out like an OZ News story: title and standfirst, the event's facts (date, venue)
// and organizer, a swipeable carousel of every photo uploaded in the CMS, the write-up, the lineup, a recap
// video, partners, then more activities. Anything left empty in the CMS is left off the page.
import { render } from 'astro:content';
import NewsLayout from '../../../layouts/NewsLayout.astro';
import StoryShare from '../../../components/StoryShare.astro';
import {
	activitiesIndexPath,
	activitiesSection,
	activityCategoryLabel,
	activityEnds,
	activityPath,
	activityStatus,
	activityWhen,
	formatActivityDate,
	getActivities,
	isUpcoming,
	splitActivities,
	youtubeId,
} from '../../../lib/activities';
import { cmsImage } from '../../../lib/cms';
import { imageFrame } from '../../../lib/news';

// Rendered per request from the CMS, so a published activity or a new photo shows up without a rebuild.
export const prerender = false;

const all = await getActivities();
const entry = all.find((other) => other.id === Astro.params.slug);
if (!entry) return new Response('Activity not found', { status: 404 });
const { data } = entry;
const { photos, hosts, lineup, partners, recap } = data;
const { Content } = await render(entry);

const path = activityPath(entry);
const absolute = (value: string) => (Astro.site ? new URL(value, Astro.site).href : value);
const pageUrl = absolute(path);
const shareUrl = Astro.site ? pageUrl : '';
const category = activityCategoryLabel(data.category);
const upcoming = isUpcoming(data);
const recapId = youtubeId(recap.youtubeUrl);
// The OZ mark sits next to the byline only when OZ organises the event.
const isOzOrganizer = /^oz\b/i.test(data.organizer);
const hasRecap = Boolean(recapId || recap.videoUrl);
// What to look at next: upcoming events first while this one is upcoming, the most recent past ones otherwise.
const { upcoming: next, past } = splitActivities(all.filter((other) => other !== entry));
const more = (upcoming ? [...next, ...past] : [...past, ...next]).slice(0, 3);

// Search engines read this to list the event, with its date, place and organizer.
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Event',
	name: data.title,
	description: data.summary || undefined,
	image: photos.length ? photos.map((photo) => absolute(photo.image)) : undefined,
	startDate: data.startDate?.toISOString(),
	endDate: (data.endDate ?? activityEnds(data))?.toISOString(),
	eventStatus: 'https://schema.org/EventScheduled',
	eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
	location: data.venue ? { '@type': 'Place', name: data.venue, address: data.venue, hasMap: data.mapsUrl || undefined } : undefined,
	performer: lineup.length ? lineup.map((act) => ({ '@type': 'PerformingGroup', name: act.name })) : undefined,
	organizer: data.organizer ? { '@type': 'Organization', name: data.organizer } : undefined,
	url: Astro.site ? pageUrl : undefined,
};
---

<NewsLayout
	title={data.title}
	description={data.summary || `${data.title}: an OZ Radio Bandung on ground activity.`}
	path={path}
	image={data.image}
	imageAlt={data.imageAlt}
	section={activitiesSection}
	readingProgress
>
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

	<article class="story" data-story>
		<header class="story-header">
			<nav class="news-crumbs" aria-label="Breadcrumb">
				<a href="/oz-bandung">OZ Radio Bandung</a>
				<span aria-hidden="true">/</span>
				<a href={activitiesIndexPath}>On Ground Activity</a>
			</nav>
			<p class="news-kicker activity-kicker">
				<span class:list={['activity-status', { 'is-past': !upcoming }]}>{activityStatus(data)}</span>
				<span>{category}</span>
			</p>
			<h1 class="story-headline">{data.title}</h1>
			{data.summary && <p class="story-standfirst">{data.summary}</p>}

			<div class="activity-facts">
				<dl>
					<div>
						<dt>When</dt>
						<dd>{data.startDate ? <time datetime={data.startDate.toISOString()}>{formatActivityDate(data)}</time> : formatActivityDate(data)}</dd>
					</div>
					{data.venue && (
						<div>
							<dt>Where</dt>
							<dd>{data.mapsUrl ? <a href={data.mapsUrl} target="_blank" rel="noopener noreferrer">{data.venue} <span aria-hidden="true">↗</span></a> : data.venue}</dd>
						</div>
					)}
				</dl>
			</div>

			<div class="story-meta">
				{data.organizer && (
					<div class="story-byline">
						{isOzOrganizer && <img class="story-byline-mark" src="/images/logo-oz-logogram.png" alt="" width="40" height="40" />}
						<p><span>By <strong>{data.organizer}</strong></span></p>
					</div>
				)}
				<StoryShare url={shareUrl} title={data.title} type="activity" />
			</div>
		</header>

		{photos.length > 0 && (
			<figure class="story-figure activity-gallery" data-gallery aria-roledescription="carousel" aria-label={`Photos of ${data.title}`}>
				<div class="activity-gallery-stage">
					<ul class="activity-gallery-track" role="list" tabindex="0" aria-label="Photos, use the arrow keys to move" data-gallery-track>
						{photos.map((photo, index) => (
							<li class="activity-gallery-slide" aria-roledescription="slide" aria-label={`${index + 1} of ${photos.length}`} {...imageFrame(photo, cmsImage(photo.image, 600))}>
								<img
									src={cmsImage(photo.image, 1600)}
									alt={photo.imageAlt}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</li>
						))}
					</ul>
					{photos.length > 1 && (
						<>
							<button class="activity-gallery-arrow activity-gallery-previous" type="button" data-gallery-previous aria-label="Previous photo">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4.5 7.5 12l7.5 7.5" /></svg>
							</button>
							<button class="activity-gallery-arrow activity-gallery-next" type="button" data-gallery-next aria-label="Next photo">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4.5 16.5 12 9 19.5" /></svg>
							</button>
							<span class="activity-gallery-count" data-gallery-count>1 / {photos.length}</span>
						</>
					)}
				</div>
				{photos.length > 1 && (
					<div class="activity-gallery-thumbs" role="group" aria-label="Choose a photo" data-gallery-thumbs>
						{photos.map((photo, index) => (
							<button class="activity-gallery-thumb" type="button" aria-label={`Show photo ${index + 1}`} aria-current={index === 0 ? 'true' : undefined} data-gallery-thumb>
								<img src={cmsImage(photo.image, 300)} alt="" loading="lazy" decoding="async" />
							</button>
						))}
					</div>
				)}
			</figure>
		)}

		<div class="story-body" lang="id">
			<Content />
		</div>

		{(hosts.length > 0 || lineup.length > 0) && (
			<section class="activity-section" aria-labelledby="lineup-title">
				<h2 class="news-rule-heading" id="lineup-title">Lineup</h2>
				{hosts.length > 0 && (
					<ul class="activity-hosts" role="list" aria-label="OZ hosts">
						{hosts.map((host) => (
							<li>
								{host.image ? <img src={cmsImage(host.image, 300)} alt="" loading="lazy" decoding="async" /> : <span class="activity-host-blank" aria-hidden="true"></span>}
								<strong>{host.name}</strong>
								<span>OZ host</span>
							</li>
						))}
					</ul>
				)}
				{lineup.length > 0 && (
					<ol class="activity-lineup">
						{lineup.map((act) => (
							<li>
								{act.url ? <a href={act.url} target="_blank" rel="noopener noreferrer">{act.name}</a> : <span>{act.name}</span>}
								{act.note && <small>{act.note}</small>}
							</li>
						))}
					</ol>
				)}
			</section>
		)}

		{hasRecap && (
			<section class="activity-section" aria-labelledby="recap-title">
				<h2 class="news-rule-heading" id="recap-title">Recap</h2>
				<div class="activity-recap">
					{recapId ? (
						<iframe
							src={`https://www.youtube-nocookie.com/embed/${recapId}?rel=0`}
							title={`${data.title}: recap video`}
							loading="lazy"
							allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
							referrerpolicy="strict-origin-when-cross-origin"
							allowfullscreen
						></iframe>
					) : (
						<video controls playsinline preload="metadata" poster={data.image ? cmsImage(data.image, 1200) : undefined}>
							<source src={recap.videoUrl} type={recap.videoType} />
						</video>
					)}
				</div>
			</section>
		)}

		{partners.length > 0 && (
			<section class="activity-section" aria-labelledby="partners-title">
				<h2 class="news-rule-heading" id="partners-title">Partners &amp; sponsors</h2>
				<ul class="activity-partners" role="list">
					{partners.map((partner) => {
						const mark = partner.logo ? <img src={cmsImage(partner.logo, 400)} alt={partner.name} loading="lazy" decoding="async" /> : <span>{partner.name}</span>;
						return <li>{partner.url ? <a href={partner.url} target="_blank" rel="noopener noreferrer" title={partner.name}>{mark}</a> : mark}</li>;
					})}
				</ul>
			</section>
		)}

		<footer class="story-end">
			<a class="news-pill" href={activitiesIndexPath}>← ALL ON GROUND ACTIVITY</a>
			<a class="news-pill" href="/oz-bandung#listen"><span class="news-live-dot" aria-hidden="true"></span>LISTEN TO OZ RADIO BANDUNG</a>
		</footer>
	</article>

	{more.length > 0 && (
		<aside class="story-next activity-next" aria-label="More on ground activity">
			<section class="story-related" aria-labelledby="more-title">
				<h2 class="news-rule-heading" id="more-title">More on ground activity</h2>
				<div class="story-related-grid">
					{more.map((other) => (
						<a class="news-card" href={activityPath(other)}>
							<div class="news-card-image" {...imageFrame(other.data, cmsImage(other.data.image, 600))}><img src={cmsImage(other.data.image, 600)} alt="" loading="lazy" decoding="async" /></div>
							<div class="news-card-copy">
								<span class="news-kicker">{activityStatus(other.data)} · {activityCategoryLabel(other.data.category)}</span>
								<h3>{other.data.title}</h3>
								<span class="news-card-when">{activityWhen(other.data)}</span>
							</div>
						</a>
					))}
				</div>
				<a class="news-pill" href={activitiesIndexPath}>SEE ALL ACTIVITIES →</a>
			</section>
		</aside>
	)}
</NewsLayout>

<script>
	import { onEveryPage } from '../../../scripts/oz-page';

	// The photo carousel is a scroll-snapping strip, so it swipes on phones and trackpads by itself. The arrows,
	// thumbnails, arrow keys and counter all follow whichever photo is in view.
	onEveryPage((signal) => document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
		const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
		const slides = Array.from(track?.children ?? []) as HTMLElement[];
		const count = gallery.querySelector<HTMLElement>('[data-gallery-count]');
		const thumbStrip = gallery.querySelector<HTMLElement>('[data-gallery-thumbs]');
		const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
		if (!track || slides.length < 2) return;
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
		let current = 0;

		// Past either end it wraps round, like the carousels on OZ Bandung.
		const show = (index: number) => {
			const target = slides[(index + slides.length) % slides.length];
			track.scrollTo({ left: target.offsetLeft, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
		};

		const settle = () => {
			const index = Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / (track.clientWidth || 1))));
			if (index === current) return;
			current = index;
			if (count) count.textContent = `${current + 1} / ${slides.length}`;
			thumbs.forEach((thumb, thumbIndex) => thumb.toggleAttribute('aria-current', thumbIndex === current));
			const thumb = thumbs[current];
			if (thumb && thumbStrip) {
				thumbStrip.scrollTo({
					left: thumb.offsetLeft - (thumbStrip.clientWidth - thumb.clientWidth) / 2,
					behavior: reducedMotion.matches ? 'auto' : 'smooth',
				});
			}
		};

		let frame = 0;
		track.addEventListener('scroll', () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(settle);
		}, { passive: true, signal });
		gallery.querySelector('[data-gallery-previous]')?.addEventListener('click', () => show(current - 1), { signal });
		gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1), { signal });
		thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => show(index), { signal }));
		track.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
			event.preventDefault();
			show(current + (event.key === 'ArrowRight' ? 1 : -1));
		}, { signal });
	}));
</script>
