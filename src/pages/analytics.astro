---
import { Font } from 'astro:assets';
import '../styles/typography.css';
import '../styles/retro.css';
import { getLiveCollection } from 'astro:content';
import { getVisibleNews, newsIndexPath, newsPath } from '../lib/news';

// Not linked from anywhere yet; reach it by typing /analytics.
// The monthly social numbers come from the CMS (Digital role); without CMS_API_KEY the CMS refuses and the cards stay empty.
const socialStats = await getLiveCollection('analytics');
if (socialStats.error) console.error('[analytics]', socialStats.error);
const entries = (socialStats.entries ?? [])
	.map((entry) => entry.data)
	.sort((a, b) => a.month.localeCompare(b.month));
const hasPlaceholder = entries.some((entry) => entry.placeholder);

const breakdownStyles = [
	{ value: 'pie', label: 'Pie' },
	{ value: 'doughnut', label: 'Doughnut' },
	{ value: 'bar', label: 'Bar' },
	{ value: 'polarArea', label: 'Polar' },
	{ value: 'table', label: 'Table' },
];
const trendStyles = [
	{ value: 'line', label: 'Line' },
	{ value: 'area', label: 'Area' },
	{ value: 'bar', label: 'Bar' },
	{ value: 'table', label: 'Table' },
];

// Each card is filled in by the script below; `chart` keys into its chart definitions.
const platforms = [
	{
		id: 'overview',
		title: 'ALL PLATFORMS',
		trends: [{ chart: 'overview-trend', title: 'Platforms over time', metrics: [['views', 'Views'], ['followers', 'Followers'], ['engagement', 'Engagement']] }],
		breakdowns: [
			{ chart: 'overview-views', title: 'Views by platform', style: 'pie' },
			{ chart: 'overview-followers', title: 'Followers by platform', style: 'doughnut' },
		],
	},
	{
		id: 'youtube',
		title: 'YOUTUBE',
		trends: [{ chart: 'youtube-trend', title: 'Trend', metrics: [['views', 'Views'], ['watchTimeHours', 'Watch time (hours)'], ['subscribers', 'Subscribers'], ['subscribersGained', 'Subscribers gained'], ['impressions', 'Impressions'], ['impressionsCtr', 'Impressions CTR (%)'], ['averageViewDurationSeconds', 'Avg. view duration (s)'], ['likes', 'Likes'], ['comments', 'Comments'], ['shares', 'Shares']] }],
		breakdowns: [
			{ chart: 'youtube-traffic', title: 'Views by traffic source', style: 'pie' },
			{ chart: 'youtube-engagement', title: 'Engagement mix', style: 'doughnut' },
		],
	},
	{
		id: 'instagram',
		title: 'INSTAGRAM',
		trends: [{ chart: 'instagram-trend', title: 'Trend', metrics: [['reach', 'Reach'], ['views', 'Views'], ['followers', 'Followers'], ['followersGained', 'Followers gained'], ['profileVisits', 'Profile visits'], ['accountsEngaged', 'Accounts engaged'], ['interactions', 'Interactions'], ['websiteTaps', 'Website taps']] }],
		breakdowns: [
			{ chart: 'instagram-content', title: 'Views by content type', style: 'pie' },
			{ chart: 'instagram-engagement', title: 'Interaction mix', style: 'doughnut' },
		],
	},
	{
		id: 'tiktok',
		title: 'TIKTOK',
		trends: [{ chart: 'tiktok-trend', title: 'Trend', metrics: [['videoViews', 'Video views'], ['reach', 'Reach'], ['profileViews', 'Profile views'], ['followers', 'Followers'], ['followersGained', 'Followers gained'], ['likes', 'Likes'], ['comments', 'Comments'], ['shares', 'Shares'], ['saves', 'Saves'], ['averageWatchTimeSeconds', 'Avg. watch time (s)']] }],
		breakdowns: [
			{ chart: 'tiktok-traffic', title: 'Views by traffic source', style: 'pie' },
			{ chart: 'tiktok-engagement', title: 'Engagement mix', style: 'doughnut' },
		],
	},
];

// Website (private): Google Analytics 4 reports from /api/analytics/web.
const webTrends = [
	{ chart: 'web-daily', title: 'Day by day', style: 'line', metrics: [['activeUsers', 'Visitors'], ['newUsers', 'New visitors'], ['sessions', 'Sessions'], ['screenPageViews', 'Page views'], ['engagedSessions', 'Engaged sessions']] },
];
const webTraffic = [
	{ chart: 'web-channels', title: 'Where sessions came from', style: 'pie' },
];
const webAudience = [
	{ chart: 'web-returning', title: 'New or returning visitors', style: 'doughnut' },
	{ chart: 'web-devices', title: 'Devices', style: 'doughnut' },
	{ chart: 'web-browsers', title: 'Browsers', style: 'bar' },
	{ chart: 'web-os', title: 'Operating systems', style: 'bar' },
];
const webTables = [
	{ report: 'sources', title: 'Sources (utm_source / medium)', section: 'traffic' },
	{ report: 'pages', title: 'Most visited pages', section: 'traffic' },
	{ report: 'landingPages', title: 'Landing pages (first page of a visit)', section: 'traffic' },
	{ report: 'cities', title: 'Cities (approximate)', section: 'audience' },
	{ report: 'campaigns', title: 'Campaign links (UTM)', section: 'campaigns' },
	{ report: 'events', title: 'Events', section: 'campaigns' },
];

// Radio listening (private): filled in by the script once the visitor is signed in.
const radioTrends = [
	{ chart: 'radio-daily', title: 'Day by day', style: 'line', metrics: [['sessions', 'Listening sessions'], ['listeningHours', 'Listening hours'], ['playClicks', 'Play clicks'], ['errors', 'Stream errors']] },
	{ chart: 'radio-hours', title: 'When sessions start (WIB)', style: 'bar', metrics: undefined },
];
const radioBreakdowns = [
	{ chart: 'radio-lengths', title: 'How long people listen', style: 'bar' },
	{ chart: 'radio-ends', title: 'How sessions ended', style: 'doughnut' },
	{ chart: 'radio-devices', title: 'Sessions by device', style: 'doughnut' },
	{ chart: 'radio-device-hours', title: 'Listening hours by device', style: 'pie' },
	{ chart: 'radio-streams', title: 'Audio or livestream', style: 'pie' },
	{ chart: 'radio-sources', title: 'Where play was pressed', style: 'pie' },
	{ chart: 'radio-browsers', title: 'Browsers', style: 'bar' },
	{ chart: 'radio-errors', title: 'Stream errors', style: 'table' },
];

// Live chat (private).
const chatTrends = [
	{ chart: 'chat-daily', title: 'Day by day', style: 'line', metrics: [['messages', 'Messages'], ['chatters', 'Chatters'], ['views', 'Chat views'], ['signIns', 'Sign-ins'], ['refused', 'Refused messages']] },
	{ chart: 'chat-hours', title: 'Peak chat hours (WIB)', style: 'bar', metrics: undefined },
];
const chatBreakdowns = [
	{ chart: 'chat-viewers', title: 'Chat views: signed in or not', style: 'doughnut' },
	{ chart: 'chat-signins', title: 'Sign-in attempts', style: 'doughnut' },
	{ chart: 'chat-refusals', title: 'Why messages were refused', style: 'bar' },
	{ chart: 'chat-moderation', title: 'Moderation', style: 'bar' },
	{ chart: 'chat-disconnects', title: 'Disconnections', style: 'pie' },
	{ chart: 'chat-signin-errors', title: 'Sign-in errors', style: 'table' },
];

// Site performance (private).
const siteTrends = [
	{ chart: 'site-daily', title: 'Day by day (75th percentile)', style: 'line', metrics: [['LCP', 'Largest Contentful Paint (ms)'], ['INP', 'Interaction to Next Paint (ms)'], ['CLS', 'Cumulative Layout Shift'], ['FCP', 'First Contentful Paint (ms)'], ['TTFB', 'Time to First Byte (ms)'], ['LOAD', 'Full page load (ms)']] },
];

// Listener form breakdowns on the private panel, filled in by the script once the visitor is signed in.
const listenerBreakdowns = [
	{ chart: 'listener-gender', title: 'Gender', style: 'doughnut' },
	{ chart: 'listener-age', title: 'Age range', style: 'bar' },
	{ chart: 'listener-stream', title: 'Tuned in to', style: 'pie' },
	{ chart: 'listener-location', title: 'Top locations', style: 'bar' },
];

// Campaign links: the address the links point at, and the pages offered in the page field.
const siteUrl = Astro.site?.origin ?? 'https://ozradio.id';
// ?embed=1: shown inside the CMS admin's Analytics page, signed in by the CMS (see the script), without this header.
const embedded = Astro.url.searchParams.get('embed') === '1';
const campaignPages = [
	{ path: '/oz-bandung', label: 'OZ Radio Bandung' },
	{ path: '/oz-bandung#listen', label: 'OZ Radio Bandung · Listen live' },
	{ path: newsIndexPath, label: 'OZ News' },
	{ path: '/', label: 'All stations' },
	{ path: '/oz-bali', label: 'OZ Radio Bali' },
	...(await getVisibleNews()).map((entry) => ({ path: newsPath(entry), label: `News · ${entry.data.title}` })),
];
// Where a link is posted; utm_medium follows from it (and can still be changed).
const campaignSources = [
	{ value: 'instagram', medium: 'social' },
	{ value: 'tiktok', medium: 'social' },
	{ value: 'youtube', medium: 'social' },
	{ value: 'facebook', medium: 'social' },
	{ value: 'threads', medium: 'social' },
	{ value: 'x', medium: 'social' },
	{ value: 'whatsapp', medium: 'messaging' },
	{ value: 'email', medium: 'email' },
];
const campaignMediums = ['social', 'paid_social', 'messaging', 'email', 'referral'];
const campaignPlacements = ['bio', 'post', 'reel', 'story', 'video', 'live', 'comment', 'ad'];

const monthLabel = (month: string) =>
	new Date(`${month}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<!doctype html>
<html lang="en" class:list={{ 'is-embedded': embedded }}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#FFFFF3" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="referrer" content="no-referrer" />
		<Font cssVariable="--font-tango" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-jakarta" preload={[{ style: 'normal' }]} />
		<title>OZ Analytics</title>
	</head>
	<body>
		<main class="analytics-page">
			{!embedded && (
				<header class="page-header">
					<a class="wordmark" href="/oz-bandung" aria-label="Back to OZ Radio Bandung"><img src="/images/logo-oz-bandung.png" alt="OZ Radio Bandung" width="1246" height="648" /></a>
					<div>
						<h1>ANALYTICS</h1>
						<p class="page-subtitle">Live radio listeners, listener forms and monthly social media numbers.</p>
					</div>
				</header>
			)}

			<section class="panel live-panel" aria-labelledby="live-title">
				<div class="panel-heading">
					<h2 id="live-title">ON AIR · LISTENERS</h2>
					<p class="live-status" data-live-status aria-live="polite"><span class="live-dot" aria-hidden="true"></span><span data-live-status-text>Connecting…</span></p>
				</div>
				<div class="tiles">
					<div class="tile tile-hero">
						<span class="tile-label">Listening now</span>
						<strong class="tile-value" data-live-now>—</strong>
					</div>
					<div class="tile">
						<span class="tile-label">Peak since stream start</span>
						<strong class="tile-value" data-live-peak>—</strong>
						<span class="tile-note">From Icecast; resets when the stream reconnects.</span>
					</div>
					<div class="tile">
						<span class="tile-label">Peak while this page is open</span>
						<strong class="tile-value" data-live-session-peak>—</strong>
						<span class="tile-note" data-live-session-since></span>
					</div>
				</div>
				<article class="chart-card" data-chart="live" data-style="area">
					<header class="chart-card-header">
						<h3>Listeners while this page is open</h3>
						<div class="chart-controls">
							<div class="style-switch" role="group" aria-label="Chart style">
								{trendStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === 'area' ? 'true' : 'false'}>{style.label}</button>)}
							</div>
							<button class="action-button" type="button" data-export-live>Export CSV</button>
						</div>
					</header>
					<div class="chart-body"><canvas aria-label="Listener count over time"></canvas><div class="chart-table" hidden></div></div>
					<p class="chart-note">Sampled every 10 seconds. History is kept only in this tab.</p>
				</article>
			</section>

			<section class="panel private-panel" aria-labelledby="private-title" data-private>
				<div class="panel-heading">
					<h2 id="private-title">PRIVATE ANALYTICS</h2>
					<p class="account" data-account hidden>
						<span data-account-email></span>
						<button class="text-button" type="button" data-sign-out>Sign out</button>
					</p>
				</div>
				<div class="gate" data-gate>
					<p class="gate-message" data-gate-message aria-live="polite">Listener forms, radio listening, chat and site analytics are private. Sign in with a Google account that has analytics access.</p>
					<button class="action-button" type="button" data-sign-in>Sign in with Google</button>
				</div>
				<div class="toolbar" data-private-toolbar hidden>
					<div class="filters">
						<label class="filter">From<input type="date" data-range-from /></label>
						<label class="filter">To<input type="date" data-range-to /></label>
					</div>
					<p class="chart-note" data-private-status aria-live="polite"></p>
				</div>
			</section>

			<section class="panel" aria-labelledby="web-title" data-web-panel hidden>
				<div class="panel-heading">
					<h2 id="web-title">WEBSITE · GOOGLE ANALYTICS</h2>
				</div>
				<p class="panel-note">Traffic, audience and campaigns from Google Analytics 4, which only counts visitors who accepted analytics cookies; it reads lower than the real number of visitors. GA hides some rows when numbers are small. Refreshed at most every 10 minutes.</p>
				<p class="gate-message" data-web-status aria-live="polite" hidden></p>
				<div class="private-sections" data-web-body>
					<h3 class="section-label">Overview</h3>
					<div class="tiles" data-web-tiles></div>
					<div class="chart-grid">
						{webTrends.map((card) => (
						<article class="chart-card chart-card-wide" data-chart={card.chart} data-style={card.style}>
							<header class="chart-card-header">
								<h3>{card.title}</h3>
								<div class="chart-controls">
									{card.metrics && (
										<label class="filter filter-compact"><span class="visually-hidden">Metric</span>
											<select data-metric-select>
												{card.metrics.map(([value, label]) => <option value={value}>{label}</option>)}
											</select>
										</label>
									)}
									<div class="style-switch" role="group" aria-label="Chart style">
										{trendStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === card.style ? 'true' : 'false'}>{style.label}</button>)}
									</div>
								</div>
							</header>
							<div class="chart-body"><canvas></canvas><div class="chart-table" hidden></div></div>
						</article>
					))}
					</div>
					<h3 class="section-label">Traffic</h3>
					<div class="chart-grid">
						{webTraffic.map((card) => (
						<article class="chart-card" data-chart={card.chart} data-style={card.style}>
							<header class="chart-card-header">
								<h3>{card.title}</h3>
								<div class="chart-controls">
									<div class="style-switch" role="group" aria-label="Chart style">
										{breakdownStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === card.style ? 'true' : 'false'}>{style.label}</button>)}
									</div>
								</div>
							</header>
							<p class="chart-total" data-chart-total></p>
							<div class="chart-body chart-body-square"><canvas></canvas><div class="chart-table" hidden></div></div>
						</article>
					))}
						{webTables.filter((table) => table.section === 'traffic').map((table) => (
							<article class="chart-card chart-card-wide">
								<header class="chart-card-header">
									<h3>{table.title}</h3>
									<button class="action-button" type="button" data-export-web={table.report}>CSV</button>
								</header>
								<div class="chart-table record-table" data-web-table={table.report}></div>
							</article>
						))}
					</div>
					<h3 class="section-label">Audience</h3>
					<div class="chart-grid">
						{webAudience.map((card) => (
						<article class="chart-card" data-chart={card.chart} data-style={card.style}>
							<header class="chart-card-header">
								<h3>{card.title}</h3>
								<div class="chart-controls">
									<div class="style-switch" role="group" aria-label="Chart style">
										{breakdownStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === card.style ? 'true' : 'false'}>{style.label}</button>)}
									</div>
								</div>
							</header>
							<p class="chart-total" data-chart-total></p>
							<div class="chart-body chart-body-square"><canvas></canvas><div class="chart-table" hidden></div></div>
						</article>
					))}
						{webTables.filter((table) => table.section === 'audience').map((table) => (
							<article class="chart-card chart-card-wide">
								<header class="chart-card-header">
									<h3>{table.title}</h3>
									<button class="action-button" type="button" data-export-web={table.report}>CSV</button>
								</header>
								<div class="chart-table record-table" data-web-table={table.report}></div>
							</article>
						))}
					</div>
					<h3 class="section-label">Campaigns and events</h3>
					<div class="chart-grid">
						{webTables.filter((table) => table.section === 'campaigns').map((table) => (
							<article class="chart-card chart-card-wide">
								<header class="chart-card-header">
									<h3>{table.title}</h3>
									<button class="action-button" type="button" data-export-web={table.report}>CSV</button>
								</header>
								<div class="chart-table record-table" data-web-table={table.report}></div>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="panel" aria-labelledby="radio-title" data-radio-panel hidden>
				<div class="panel-heading">
					<h2 id="radio-title">RADIO LISTENING</h2>
					<div class="chart-controls">
						<button class="action-button" type="button" data-export-radio="sessions">Sessions CSV</button>
						<button class="action-button" type="button" data-export-radio="daily">Daily CSV</button>
						<button class="action-button" type="button" data-export-radio="events">Raw events CSV</button>
					</div>
				</div>
				<p class="panel-note">From our own listening stats, separate from Google Analytics. A listening session runs from the moment sound starts until it stops. Returning listeners are only known for visitors who accepted analytics cookies.</p>
				<div class="tiles" data-radio-tiles></div>
				<div class="chart-grid">
					{radioTrends.map((card) => (
						<article class="chart-card chart-card-wide" data-chart={card.chart} data-style={card.style}>
							<header class="chart-card-header">
								<h3>{card.title}</h3>
								<div class="chart-controls">
									{card.metrics && (
										<label class="filter filter-compact"><span class="visually-hidden">Metric</span>
											<select data-metric-select>
												{card.metrics.map(([value, label]) => <option value={value}>{label}</option>)}
											</select>
										</label>
									)}
									<div class="style-switch" role="group" aria-label="Chart style">
										{trendStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === card.style ? 'true' : 'false'}>{style.label}</button>)}
									</div>
								</div>
							</header>
							<div class="chart-body"><canvas></canvas><div class="chart-table" hidden></div></div>
						</article>
					))}
					{radioBreakdowns.map((card) => (
						<article class="chart-card" data-chart={card.chart} data-style={card.style}>
							<header class="chart-card-header">
								<h3>{card.title}</h3>
								<div class="chart-controls">
									<div class="style-switch" role="group" aria-label="Chart style">
										{breakdownStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === card.style ? 'true' : 'false'}>{style.label}</button>)}
									</div>
								</div>
							</header>
							<p class="chart-total" data-chart-total></p>
							<div class="chart-body chart-body-square"><canvas></canvas><div class="chart-table" hidden></div></div>
						</article>
					))}
				</div>
			</section>

			<section class="panel" aria-labelledby="chat-title" data-chat-panel hidden>
				<div class="panel-heading">
					<h2 id="chat-title">LIVE CHAT</h2>
					<div class="chart-controls">
						<button class="action-button" type="button" data-export-chat="daily">Daily CSV</button>
						<button class="action-button" type="button" data-export-chat="events">Raw events CSV</button>
					</div>
				</div>
				<p class="panel-note">People and views are counted apart. A <strong>chatter</strong> is a Google account that posted, known only by a scrambled id. A <strong>view</strong> is one page load that showed the chat, signed in or not; one person can make many views. Chat history starts when this tracking went live.</p>
				<div class="tiles" data-chat-tiles></div>
				<div class="chart-grid">
					{chatTrends.map((card) => (
						<article class="chart-card chart-card-wide" data-chart={card.chart} data-style={card.style}>
							<header class="chart-card-header">
								<h3>{card.title}</h3>
								<div class="chart-controls">
									{card.metrics && (
										<label class="filter filter-compact"><span class="visually-hidden">Metric</span>
											<select data-metric-select>
												{card.metrics.map(([value, label]) => <option value={value}>{label}</option>)}
											</select>
										</label>
									)}
									<div class="style-switch" role="group" aria-label="Chart style">
										{trendStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === card.style ? 'true' : 'false'}>{style.label}</button>)}
									</div>
								</div>
							</header>
							<div class="chart-body"><canvas></canvas><div class="chart-table" hidden></div></div>
						</article>
					))}
					{chatBreakdowns.map((card) => (
						<article class="chart-card" data-chart={card.chart} data-style={card.style}>
							<header class="chart-card-header">
								<h3>{card.title}</h3>
								<div class="chart-controls">
									<div class="style-switch" role="group" aria-label="Chart style">
										{breakdownStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === card.style ? 'true' : 'false'}>{style.label}</button>)}
									</div>
								</div>
							</header>
							<p class="chart-total" data-chart-total></p>
							<div class="chart-body chart-body-square"><canvas></canvas><div class="chart-table" hidden></div></div>
						</article>
					))}
				</div>
			</section>

			<section class="panel" aria-labelledby="livestream-title" data-livestream-panel hidden>
				<div class="panel-heading">
					<h2 id="livestream-title">LIVESTREAM · YOUTUBE</h2>
					<div class="chart-controls">
						<button class="action-button" type="button" data-export-livestream="broadcasts">Broadcasts CSV</button>
						<button class="action-button" type="button" data-export-livestream="snapshots" disabled>Snapshots CSV</button>
					</div>
				</div>
				<p class="panel-note">Two different measures, never added up behind your back. <strong>YouTube concurrent viewers</strong> is YouTube's official count of people watching the broadcast. <strong>Website active viewers</strong> is our own estimate: people whose embedded player is playing on this site, one per browser. <strong>Combined</strong> adds the two and is only an estimate (someone can be counted on both); it is not a YouTube figure. A dash means the number wasn't available, which is not zero.</p>
				<h3 class="section-label">Live now</h3>
				<p class="chart-note" data-livestream-live-status aria-live="polite"></p>
				<div class="tiles" data-livestream-tiles></div>
				<div class="livestream-admin" data-livestream-admin hidden>
					<h3 class="section-label">YouTube chat sync</h3>
					<dl class="sync-status" data-livestream-sync></dl>
					<div class="sync-controls" data-livestream-controls hidden>
						<label class="sync-toggle"><input type="checkbox" data-sync-setting="toYoutube" /> Website messages → YouTube</label>
						<label class="sync-toggle"><input type="checkbox" data-sync-setting="fromYoutube" /> YouTube messages → website</label>
						<button class="action-button" type="button" data-sync-action="connect">Connect YouTube channel</button>
						<button class="action-button" type="button" data-sync-action="recheck">Check now</button>
						<button class="text-button" type="button" data-sync-action="disconnect">Disconnect</button>
					</div>
					<p class="chart-note" data-livestream-admin-status aria-live="polite"></p>
				</div>
				<h3 class="section-label">History</h3>
				<div class="chart-grid">
					<article class="chart-card chart-card-wide" data-chart="livestream-history" data-style="line">
						<header class="chart-card-header">
							<h3 data-livestream-chart-title>Viewers during a broadcast</h3>
							<div class="chart-controls">
								<label class="filter filter-compact"><span class="visually-hidden">Broadcast</span>
									<select data-livestream-broadcast></select>
								</label>
								<div class="style-switch" role="group" aria-label="Chart style">
									{trendStyles.filter((style) => style.value !== 'area').map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === 'line' ? 'true' : 'false'}>{style.label}</button>)}
								</div>
							</div>
						</header>
						<div class="chart-body"><canvas aria-label="YouTube and website viewers over the broadcast"></canvas><div class="chart-table" hidden></div></div>
						<p class="chart-note" data-livestream-chart-note>Stored snapshots, not live. Gaps are times a count wasn't available.</p>
					</article>
					<article class="chart-card chart-card-wide">
						<header class="chart-card-header">
							<h3>Broadcasts</h3>
						</header>
						<div class="chart-table record-table" data-livestream-broadcasts></div>
						<p class="chart-note">Times are Jakarta time (WIB). Peaks and averages come from the stored snapshots, counting only those where the number was available.</p>
					</article>
				</div>
			</section>

			<section class="panel" aria-labelledby="site-title" data-site-panel hidden>
				<div class="panel-heading">
					<h2 id="site-title">SITE PERFORMANCE</h2>
					<div class="chart-controls">
						<button class="action-button" type="button" data-export-site="vitals">Measurements CSV</button>
						<button class="action-button" type="button" data-export-site="errors">Errors CSV</button>
					</div>
				</div>
				<p class="panel-note">How fast and stable pages are for real visitors (Core Web Vitals), and JavaScript errors. Each figure is the 75th percentile: three in four page views were at least this good. Ratings use Google's thresholds. Moving between OZ Bandung and OZ News without a reload counts as one page view, of the page the visitor arrived on.</p>
				<div class="tiles" data-site-tiles></div>
				<div class="chart-grid">
					{siteTrends.map((card) => (
						<article class="chart-card chart-card-wide" data-chart={card.chart} data-style={card.style}>
							<header class="chart-card-header">
								<h3>{card.title}</h3>
								<div class="chart-controls">
									{card.metrics && (
										<label class="filter filter-compact"><span class="visually-hidden">Metric</span>
											<select data-metric-select>
												{card.metrics.map(([value, label]) => <option value={value}>{label}</option>)}
											</select>
										</label>
									)}
									<div class="style-switch" role="group" aria-label="Chart style">
										{trendStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === card.style ? 'true' : 'false'}>{style.label}</button>)}
									</div>
								</div>
							</header>
							<div class="chart-body"><canvas></canvas><div class="chart-table" hidden></div></div>
						</article>
					))}
					<article class="chart-card chart-card-wide">
						<header class="chart-card-header"><h3>By page</h3></header>
						<div class="chart-table record-table" data-site-pages></div>
					</article>
					<article class="chart-card chart-card-wide">
						<header class="chart-card-header"><h3>By device</h3></header>
						<div class="chart-table record-table" data-site-devices></div>
					</article>
					<article class="chart-card chart-card-wide">
						<header class="chart-card-header"><h3>JavaScript errors</h3></header>
						<div class="chart-table record-table" data-site-errors></div>
					</article>
				</div>
			</section>

			<section class="panel" aria-labelledby="listeners-title" data-listener-panel hidden>
				<div class="panel-heading">
					<h2 id="listeners-title">LISTENER FORMS</h2>
					<button class="action-button" type="button" data-export-listeners>Export CSV</button>
				</div>
				<div class="tiles" data-listener-tiles></div>
				<div class="chart-grid">
					{listenerBreakdowns.map((card) => (
						<article class="chart-card" data-chart={card.chart} data-style={card.style}>
							<header class="chart-card-header">
								<h3>{card.title}</h3>
								<div class="chart-controls">
									<div class="style-switch" role="group" aria-label="Chart style">
										{breakdownStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === card.style ? 'true' : 'false'}>{style.label}</button>)}
									</div>
								</div>
							</header>
							<p class="chart-total" data-chart-total></p>
							<div class="chart-body chart-body-square"><canvas></canvas><div class="chart-table" hidden></div></div>
						</article>
					))}
					<article class="chart-card chart-card-wide">
						<header class="chart-card-header">
							<h3>Forms sent</h3>
						</header>
						<div class="chart-table record-table" data-listener-table></div>
						<p class="chart-note">Times are Jakarta time (WIB). The export has every column, including the Google account of listeners who were signed in.</p>
					</article>
				</div>
			</section>

			<section class="panel social-panel" aria-labelledby="social-title">
				<div class="panel-heading">
					<h2 id="social-title">SOCIAL MEDIA · MONTHLY</h2>
					{entries.length > 0 && (
						<div class="filters">
							<label class="filter">Month
								<select data-month-select>
									{entries.map((entry, index) => <option value={entry.month} selected={index === entries.length - 1}>{monthLabel(entry.month)}</option>)}
								</select>
							</label>
							<label class="filter">Trend range
								<select data-range-select>
									<option value="6">Last 6 months</option>
									<option value="12" selected>Last 12 months</option>
									<option value="all">All months</option>
								</select>
							</label>
							<button class="action-button" type="button" data-export-social>Export CSV</button>
						</div>
					)}
				</div>

				{hasPlaceholder && (
					<p class="placeholder-banner" role="note"><strong>SAMPLE DATA</strong> Some months still hold placeholder numbers. Replace them with the real figures from each platform's insights.</p>
				)}

				{entries.length === 0 ? (
					<p class="empty-state">No monthly numbers yet. Add a month in the CMS under “Monthly analytics”.</p>
				) : (
					<>
						<nav class="platform-tabs" role="tablist" aria-label="Platform">
							{platforms.map((platform, index) => (
								<button type="button" role="tab" id={`tab-${platform.id}`} aria-controls={`platform-${platform.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-platform-tab={platform.id}>{platform.title}</button>
							))}
						</nav>
						{platforms.map((platform, index) => (
							<div class="platform" id={`platform-${platform.id}`} role="tabpanel" aria-labelledby={`tab-${platform.id}`} data-platform={platform.id} hidden={index !== 0}>
								<div class="tiles" data-tiles={platform.id}></div>
								<div class="chart-grid">
									{platform.trends.map((card) => (
										<article class="chart-card chart-card-wide" data-chart={card.chart} data-style="line">
											<header class="chart-card-header">
												<h3>{card.title}</h3>
												<div class="chart-controls">
													<label class="filter filter-compact"><span class="visually-hidden">Metric</span>
														<select data-metric-select>
															{card.metrics.map(([value, label]) => <option value={value}>{label}</option>)}
														</select>
													</label>
													<div class="style-switch" role="group" aria-label="Chart style">
														{trendStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === 'line' ? 'true' : 'false'}>{style.label}</button>)}
													</div>
												</div>
											</header>
											<div class="chart-body"><canvas></canvas><div class="chart-table" hidden></div></div>
										</article>
									))}
									{platform.breakdowns.map((card) => (
										<article class="chart-card" data-chart={card.chart} data-style={card.style}>
											<header class="chart-card-header">
												<h3>{card.title}</h3>
												<div class="chart-controls">
													<div class="style-switch" role="group" aria-label="Chart style">
														{breakdownStyles.map((style) => <button type="button" data-style-option={style.value} aria-pressed={style.value === card.style ? 'true' : 'false'}>{style.label}</button>)}
													</div>
												</div>
											</header>
											<p class="chart-total" data-chart-total></p>
											<div class="chart-body chart-body-square"><canvas></canvas><div class="chart-table" hidden></div></div>
										</article>
									))}
								</div>
							</div>
						))}
					</>
				)}
			</section>
			<section class="panel" aria-labelledby="campaign-title" data-campaign-panel data-site-url={siteUrl}>
				<div class="panel-heading">
					<h2 id="campaign-title">CAMPAIGN LINKS</h2>
					<button class="action-button" type="button" data-export-campaigns>Export CSV</button>
				</div>
				<p class="panel-note">Share these links on Instagram, TikTok and other platforms instead of the plain address, so Google Analytics can tell which post brought each visit (Reports → Acquisition → Traffic acquisition, by session campaign). Every part is made lowercase with hyphens, so one campaign is always counted as one.</p>
				<form class="campaign-form" data-campaign-form>
					<label class="filter filter-wide">Page
						<input name="page" list="campaign-pages" value="/oz-bandung" required autocomplete="off" />
					</label>
					<datalist id="campaign-pages">
						{campaignPages.map((page) => <option value={page.path}>{page.label}</option>)}
					</datalist>
					<label class="filter">Source
						<input name="source" list="campaign-sources" value="instagram" required autocomplete="off" />
					</label>
					<datalist id="campaign-sources">
						{campaignSources.map((source) => <option value={source.value} data-medium={source.medium}></option>)}
					</datalist>
					<label class="filter">Medium
						<select name="medium">
							{campaignMediums.map((medium) => <option value={medium}>{medium}</option>)}
						</select>
					</label>
					<label class="filter">Campaign
						<input name="campaign" required placeholder="e.g. ozubathon-2026" autocomplete="off" />
					</label>
					<label class="filter">Placement
						<select name="content">
							<option value="">None</option>
							{campaignPlacements.map((placement) => <option value={placement}>{placement}</option>)}
						</select>
					</label>
				</form>
				<div class="campaign-result">
					<output class="campaign-url" data-campaign-url aria-live="polite">Give the campaign a name to get its link.</output>
					<button class="action-button" type="button" data-campaign-copy disabled>Copy link</button>
				</div>
				<div class="chart-table record-table" data-campaign-list></div>
				<p class="chart-note">Copied links are listed here in this browser only. Export them to keep them or share them with the team.</p>
			</section>
		</main>

		<script is:inline type="application/json" id="analytics-data" set:html={JSON.stringify(entries)} />
	</body>
</html>

<style>
	:root {
		--surface: #FFFFF3;
		--surface-raised: #FFFFFF;
		--ink: #000000;
		--ink-secondary: #44443F;
		--ink-muted: #77776F;
		--line: #D8D8CC;
		--accent: #f2bd57;
		--accent-soft: #FFF0D1;
		--trend-up: #008300;
		--trend-down: #d03b3b;
	}

	:global(body) {
		margin: 0;
		background: var(--surface) var(--paper-grain);
		color: var(--ink);
		font-family: var(--font-jakarta);
	}

	.analytics-page {
		box-sizing: border-box;
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 24px 64px;
		display: grid;
		gap: 32px;
	}

	.analytics-page :global(*) {
		box-sizing: border-box;
	}

	.page-header {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.wordmark img {
		display: block;
		width: 120px;
		height: auto;
	}

	h1 {
		margin: 0;
		font-size: clamp(32px, 5vw, 48px);
		line-height: 1;
	}

	.page-subtitle {
		margin: 6px 0 0;
		color: var(--ink-secondary);
	}

	.panel {
		display: grid;
		gap: 20px;
		padding: clamp(16px, 3vw, 28px);
		background: var(--surface-raised);
		border: var(--box-border);
		border-radius: var(--box-radius);
		box-shadow: var(--box-shadow);
	}

	.panel-heading {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 20px;
	}

	h2 {
		margin: 0;
		font-size: clamp(20px, 3vw, 26px);
	}

	h3 {
		margin: 0;
		font-size: 16px;
	}

	.live-status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-size: 13px;
		color: var(--ink-secondary);
	}

	.live-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--ink-muted);
	}

	.live-status[data-state='live'] .live-dot {
		background: #e34948;
		animation: pulse 1.6s ease-in-out infinite;
	}

	@keyframes pulse {
		50% { opacity: 0.35; }
	}

	@media (prefers-reduced-motion: reduce) {
		.live-status[data-state='live'] .live-dot { animation: none; }
	}

	/* Social tiles are rendered by the script below, hence the :global tile classes. */
	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
		gap: 12px;
	}

	/* Each tile is a size container so its number scales to the tile, not the viewport. */
	:global(.tile) {
		container-type: inline-size;
		min-width: 0;
		display: grid;
		align-content: start;
		gap: 4px;
		padding: 14px 16px;
		background: var(--surface);
		border: var(--box-border);
		border-radius: 10px;
	}

	:global(.tile-hero) {
		background: var(--accent-soft);
	}

	:global(.tile-label) {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-secondary);
	}

	:global(.tile-value) {
		font-family: var(--font-tango);
		font-size: clamp(18px, 17cqi, 34px);
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
		overflow-wrap: anywhere;
	}

	:global(.tile-hero .tile-value) {
		font-size: clamp(20px, 19cqi, 42px);
	}

	:global(.tile-note),
	:global(.tile-delta) {
		font-size: 12px;
		color: var(--ink-muted);
	}

	:global(.tile-delta) {
		color: var(--ink-secondary);
		font-variant-numeric: tabular-nums;
	}

	:global(.trend-arrow) {
		color: var(--ink-muted);
	}

	:global(.trend-arrow.is-up) {
		color: var(--trend-up);
	}

	:global(.trend-arrow.is-down) {
		color: var(--trend-down);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		gap: 12px;
	}

	.filter {
		display: grid;
		gap: 4px;
		font-size: 12px;
		font-weight: 700;
		color: var(--ink-secondary);
	}

	select,
	input[type='date'],
	.campaign-form input {
		min-height: 36px;
		padding: 6px 10px;
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		color: var(--ink);
		background: var(--surface);
		border: var(--box-border);
		border-radius: 8px;
		cursor: pointer;
	}

	.action-button,
	.text-button {
		font: inherit;
		font-weight: 700;
		color: var(--ink);
		cursor: pointer;
	}

	.action-button {
		min-height: 36px;
		padding: 6px 14px;
		font-size: 14px;
		background: var(--accent);
		border: var(--box-border);
		border-radius: 8px;
		box-shadow: 3px 3px 0 var(--ink);
	}

	.action-button:hover {
		background: var(--accent-soft);
	}

	.action-button:active {
		box-shadow: none;
		transform: translate(3px, 3px);
	}

	.action-button:disabled {
		cursor: wait;
		opacity: 0.6;
	}

	.text-button {
		padding: 4px 0;
		font-size: 13px;
		background: none;
		border: 0;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.action-button:focus-visible,
	.text-button:focus-visible,
	input[type='date']:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}

	.account {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 12px;
		margin: 0;
		font-size: 13px;
		color: var(--ink-secondary);
	}

	.account[hidden],
	.gate[hidden],
	.panel[hidden],
	.toolbar[hidden],
	.action-button[hidden] {
		display: none;
	}

	.gate {
		display: grid;
		justify-items: start;
		gap: 14px;
		padding: 20px;
		background: var(--surface);
		border: 2px dashed var(--line);
		border-radius: 10px;
	}

	.gate-message {
		max-width: 60ch;
		margin: 0;
		color: var(--ink-secondary);
		line-height: 1.5;
	}

	.gate-message code {
		font-size: 13px;
		overflow-wrap: anywhere;
	}

	.toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 12px;
	}

	.record-table {
		max-height: 480px;
	}

	.section-label {
		margin: 8px 0 -6px;
		font-size: 13px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-secondary);
	}

	.private-sections {
		display: grid;
		gap: 20px;
	}

	.private-sections[hidden],
	.gate-message[hidden] {
		display: none;
	}

	/* Livestream: the YouTube sync's status and switches (CMS developers can change them, Digital can look). */
	.sync-status {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
		gap: 10px 18px;
		margin: 12px 0 14px;
	}

	/* The broadcast table's "Chart" links (the rows are built in the script, hence :global). */
	.record-table :global(.livestream-show) {
		padding: 0;
		border: 0;
		background: none;
		color: var(--ink-secondary);
		font: inherit;
		font-size: 12px;
		text-decoration: underline;
		cursor: pointer;
	}

	.sync-status :global(div) {
		min-width: 0;
	}

	.sync-status :global(dt) {
		font-size: 12px;
		font-weight: 700;
		color: var(--ink-secondary);
	}

	.sync-status :global(dd) {
		margin: 2px 0 0;
		font-size: 14px;
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.sync-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 16px;
	}

	.sync-controls[hidden] {
		display: none;
	}

	.sync-toggle {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 14px;
		font-weight: 600;
		cursor: pointer;
	}

	.panel-note {
		max-width: 75ch;
		margin: -8px 0 0;
		color: var(--ink-secondary);
		font-size: 14px;
		line-height: 1.55;
	}

	.campaign-form {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr));
		gap: 12px;
	}

	.campaign-form .filter-wide {
		grid-column: 1 / -1;
	}

	.campaign-form input,
	.campaign-form select {
		width: 100%;
		min-width: 0;
	}

	.campaign-form input:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}

	.campaign-result {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}

	.campaign-url {
		min-width: 0;
		flex: 1 1 320px;
		padding: 10px 12px;
		background: var(--surface);
		border: 1px dashed var(--line);
		border-radius: 8px;
		color: var(--ink);
		font-family: ui-monospace, monospace;
		font-size: 13px;
		overflow-wrap: anywhere;
	}

	.campaign-url:empty {
		display: none;
	}

	.record-table :global(.campaign-remove) {
		padding: 0;
		border: 0;
		background: none;
		color: var(--ink-secondary);
		font: inherit;
		font-size: 12px;
		text-decoration: underline;
		cursor: pointer;
	}

	/* Listed records read left to right, unlike the number tables (.chart-table, later in this file). */
	.chart-table.record-table :global(th),
	.chart-table.record-table :global(td) {
		text-align: left;
	}

	.placeholder-banner {
		margin: 0;
		padding: 10px 14px;
		font-size: 14px;
		background: var(--accent-soft);
		border: 2px dashed var(--ink);
		border-radius: 10px;
	}

	.placeholder-banner strong {
		margin-right: 8px;
		padding: 2px 6px;
		font-size: 11px;
		letter-spacing: 0.06em;
		color: var(--surface);
		background: var(--ink);
		border-radius: 4px;
	}

	.empty-state {
		margin: 0;
		color: var(--ink-secondary);
	}

	.platform-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.platform-tabs button,
	.style-switch button {
		font: inherit;
		font-weight: 700;
		color: var(--ink);
		background: var(--surface);
		border: var(--box-border);
		cursor: pointer;
	}

	.platform-tabs button {
		padding: 8px 16px;
		font-family: var(--font-tango);
		font-size: 15px;
		border-radius: 999px;
	}

	.platform-tabs button[aria-selected='true'] {
		background: var(--accent);
		box-shadow: 3px 3px 0 var(--ink);
	}

	.platform {
		display: grid;
		gap: 20px;
	}

	.platform[hidden] {
		display: none;
	}

	.chart-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}

	.chart-card {
		display: grid;
		align-content: start;
		gap: 12px;
		min-width: 0;
		padding: 16px;
		background: var(--surface-raised);
		border: var(--box-border);
		border-radius: 10px;
	}

	.chart-card-wide {
		grid-column: 1 / -1;
	}

	.chart-card-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.chart-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}

	.style-switch {
		display: inline-flex;
		flex-wrap: wrap;
		border: var(--box-border);
		border-radius: 8px;
		overflow: hidden;
	}

	.style-switch button {
		min-height: 32px;
		padding: 4px 10px;
		font-size: 12px;
		border: 0;
		border-right: 1px solid var(--line);
	}

	.style-switch button:last-child {
		border-right: 0;
	}

	.style-switch button[aria-pressed='true'] {
		color: var(--surface);
		background: var(--ink);
	}

	.platform-tabs button:focus-visible,
	.style-switch button:focus-visible,
	select:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}

	.chart-total {
		margin: -4px 0 0;
		font-size: 13px;
		color: var(--ink-secondary);
	}

	.chart-total:empty {
		display: none;
	}

	.chart-body {
		position: relative;
		height: 300px;
	}

	.chart-body-square {
		height: 280px;
	}

	.chart-body:has(.chart-table:not([hidden])) {
		height: auto;
	}

	.chart-body:has(.chart-table:not([hidden])) canvas {
		display: none;
	}

	.chart-table {
		max-height: 320px;
		overflow: auto;
	}

	.chart-table :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
		font-variant-numeric: tabular-nums;
	}

	.chart-table :global(th),
	.chart-table :global(td) {
		padding: 8px 10px;
		text-align: right;
		border-bottom: 1px solid var(--line);
		white-space: nowrap;
	}

	.chart-table :global(th:first-child),
	.chart-table :global(td:first-child) {
		text-align: left;
	}

	.chart-table :global(thead th) {
		position: sticky;
		top: 0;
		font-size: 12px;
		color: var(--ink-secondary);
		background: var(--surface-raised);
	}

	/* Core Web Vitals ratings, Google's colours and labels. */
	:global(.rating) {
		font-weight: 700;
		white-space: nowrap;
	}

	:global(.rating::before) {
		display: inline-block;
		width: 8px;
		height: 8px;
		margin-right: 6px;
		border-radius: 50%;
		background: currentColor;
		content: '';
	}

	:global(.rating-good) {
		color: #0a7c42;
	}

	:global(.rating-needs-improvement) {
		color: #a35a00;
	}

	:global(.rating-poor) {
		color: #c5221f;
	}

	.chart-note {
		margin: 0;
		font-size: 12px;
		color: var(--ink-muted);
	}

	.visually-hidden,
	:global(.tile .visually-hidden) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (max-width: 760px) {
		.analytics-page {
			padding: 20px 16px 48px;
			gap: 24px;
		}

		.page-header {
			gap: 14px;
		}

		.wordmark img {
			width: 84px;
		}

		.chart-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.chart-body {
			height: 240px;
		}
	}
</style>

<script>
	import { Chart, type ChartConfiguration, type ChartDataset } from 'chart.js/auto';
	import type { CollectionEntry } from 'astro:content';
	import { csvFileName, toCsv, type CsvCell } from '../lib/csv';
	import { ageRanges } from '../lib/listener';
	import type { OzAuth } from '../scripts/oz-auth';

	type Month = CollectionEntry<'analytics'>['data'];
	type Format = (value: number | null | undefined) => string;
	type Series = { label: string; values: (number | null)[]; format?: Format };
	type TrendStyle = 'line' | 'area' | 'bar' | 'table';
	type BreakdownStyle = 'pie' | 'doughnut' | 'bar' | 'polarArea' | 'table';

	// Validated categorical order (dataviz reference palette, light mode). Colour follows the entity:
	// platforms always take slots 1-3, and a breakdown's slices keep their slot whatever the month.
	const palette = ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4'];
	const platformColors = { youtube: palette[0], instagram: palette[1], tiktok: palette[2] };
	const surface = '#FFFFFF';
	const ink = '#000000';
	const inkSecondary = '#44443F';
	const gridLine = '#E6E6DC';

	const bodyFont = getComputedStyle(document.body).fontFamily;
	Chart.defaults.font.family = bodyFont;
	Chart.defaults.font.size = 12;
	Chart.defaults.color = inkSecondary;
	Chart.defaults.plugins.legend.labels.usePointStyle = true;
	Chart.defaults.plugins.legend.labels.boxWidth = 8;
	Chart.defaults.plugins.tooltip.backgroundColor = ink;
	Chart.defaults.plugins.tooltip.padding = 10;
	Chart.defaults.plugins.tooltip.cornerRadius = 6;

	const numberFormat = new Intl.NumberFormat('en-US');
	const compactFormat = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
	const formatNumber = (value: number | null | undefined) => (typeof value === 'number' ? numberFormat.format(value) : '—');
	const formatDuration = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.round(seconds % 60)).padStart(2, '0')}`;
	const shortMonth = (month: string) =>
		new Date(`${month}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: '2-digit', timeZone: 'UTC' });

	// Every section's numbers can be taken to a spreadsheet as CSV.
	const downloadCsv = (name: string, headers: string[], rows: CsvCell[][]) => {
		const url = URL.createObjectURL(new Blob([toCsv(headers, rows)], { type: 'text/csv;charset=utf-8' }));
		const link = Object.assign(document.createElement('a'), { href: url, download: csvFileName(name) });
		document.body.append(link);
		link.click();
		link.remove();
		window.setTimeout(() => URL.revokeObjectURL(url), 0);
	};

	const escapeHtml = (text: string) => text.replace(/[&<>"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[char]!);

	const renderTable = (container: HTMLElement, heading: string, rows: string[], columns: Series[], format: Format = formatNumber) => {
		const head = `<tr><th scope="col">${escapeHtml(heading)}</th>${columns.map((column) => `<th scope="col">${escapeHtml(column.label)}</th>`).join('')}</tr>`;
		const body = rows
			.map((row, index) => `<tr><th scope="row">${escapeHtml(row)}</th>${columns.map((column) => `<td>${(column.format ?? format)(column.values[index])}</td>`).join('')}</tr>`)
			.join('');
		container.innerHTML = `<table><thead>${head}</thead><tbody>${body}</tbody></table>`;
	};

	/* ---------- Chart cards ---------- */

	// A card owns one canvas; switching style destroys and rebuilds its chart (or shows the table instead).
	class ChartCard {
		readonly root: HTMLElement;
		readonly canvas: HTMLCanvasElement;
		readonly table: HTMLElement;
		chart: Chart | undefined;
		// The style currently on the canvas, so live updates can patch the chart instead of rebuilding it.
		drawnStyle: string | undefined;
		style: string;
		render: () => void = () => {};

		constructor(root: HTMLElement) {
			this.root = root;
			this.canvas = root.querySelector('canvas')!;
			this.table = root.querySelector('.chart-table')!;
			this.style = root.dataset.style ?? 'line';
			root.querySelectorAll<HTMLButtonElement>('[data-style-option]').forEach((button) => {
				button.addEventListener('click', () => {
					this.style = button.dataset.styleOption!;
					root.querySelectorAll('[data-style-option]').forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
					this.render();
				});
			});
		}

		draw(config: ChartConfiguration | null) {
			this.chart?.destroy();
			this.chart = undefined;
			this.table.hidden = config !== null;
			if (config) this.chart = new Chart(this.canvas, config);
			this.drawnStyle = this.style;
		}

		trend(labels: string[], series: Series[], colors: string[], format: Format = formatNumber, heading = 'Month') {
			const style = this.style as TrendStyle;
			if (style === 'table') {
				renderTable(this.table, heading, labels, series, format);
				this.draw(null);
				return;
			}
			const datasets = series.map((item, index): ChartDataset<'line' | 'bar'> => {
				const color = colors[index];
				return style === 'bar'
					? { type: 'bar', label: item.label, data: item.values, backgroundColor: color, borderRadius: { topLeft: 4, topRight: 4 }, borderSkipped: 'start', borderColor: surface, borderWidth: { left: 1, right: 1 }, maxBarThickness: 36 }
					: {
						type: 'line',
						label: item.label,
						data: item.values,
						borderColor: color,
						backgroundColor: style === 'area' ? `${color}33` : color,
						fill: style === 'area' ? (series.length > 1 && index > 0 ? '-1' : 'origin') : false,
						borderWidth: 2,
						tension: 0.25,
						pointRadius: labels.length > 40 ? 0 : 4,
						pointHoverRadius: 6,
						pointBackgroundColor: color,
						pointBorderColor: surface,
						pointBorderWidth: 2,
					};
			});
			this.draw({
				type: style === 'bar' ? 'bar' : 'line',
				data: { labels, datasets: datasets as ChartDataset<'line'>[] },
				options: {
					responsive: true,
					maintainAspectRatio: false,
					animation: { duration: 300 },
					interaction: { mode: 'index', intersect: false },
					scales: {
						x: { grid: { display: false }, border: { color: gridLine } },
						y: { beginAtZero: true, stacked: style === 'area' && series.length > 1, grid: { color: gridLine }, border: { display: false }, ticks: { callback: (value) => compactFormat.format(Number(value)) } },
					},
					plugins: {
						legend: { display: series.length > 1, position: 'top', align: 'start' },
						tooltip: { callbacks: { label: (context) => ` ${context.dataset.label}: ${format(context.parsed.y)}` } },
					},
				},
			});
		}

		breakdown(labels: string[], values: number[], colors: string[], valueLabel = 'Value') {
			const style = this.style as BreakdownStyle;
			const total = values.reduce((sum, value) => sum + value, 0);
			const share = (value: number) => (total ? `${((value / total) * 100).toFixed(1)}%` : '—');
			const totalLabel = this.root.querySelector<HTMLElement>('[data-chart-total]');
			if (totalLabel) totalLabel.textContent = `Total ${formatNumber(total)}`;

			if (style === 'table') {
				renderTable(this.table, 'Category', labels, [{ label: valueLabel, values }, { label: 'Share', values, format: (value) => share(value ?? 0) }]);
				this.draw(null);
				return;
			}

			const isRadial = style !== 'bar';
			this.draw({
				type: style,
				data: {
					labels,
					datasets: [{
						label: valueLabel,
						data: values,
						backgroundColor: style === 'polarArea' ? colors.map((color) => `${color}CC`) : colors,
						borderColor: surface,
						borderWidth: 2,
						...(style === 'bar' ? { borderRadius: { topLeft: 4, topRight: 4 }, borderSkipped: 'start' as const, maxBarThickness: 48 } : {}),
					}],
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					animation: { duration: 300 },
					...(style === 'doughnut' ? { cutout: '58%' } : {}),
					scales: style === 'bar'
						? { x: { grid: { display: false }, border: { color: gridLine } }, y: { beginAtZero: true, grid: { color: gridLine }, border: { display: false }, ticks: { callback: (value) => compactFormat.format(Number(value)) } } }
						: style === 'polarArea'
							? { r: { grid: { color: gridLine }, ticks: { display: false } } }
							: {},
					plugins: {
						legend: { display: isRadial, position: window.innerWidth < 560 ? 'bottom' : 'right', labels: { generateLabels: (chart) => {
							const base = Chart.overrides[style === 'polarArea' ? 'polarArea' : 'doughnut'].plugins.legend.labels.generateLabels(chart);
							return base.map((item, index) => ({ ...item, text: `${item.text}  ${share(values[index])}` }));
						} } },
						tooltip: { callbacks: { label: (context) => ` ${formatNumber(values[context.dataIndex])} (${share(values[context.dataIndex])})` } },
					},
				},
			});
		}
	}

	/* ---------- Live listeners ---------- */

	const liveCardRoot = document.querySelector<HTMLElement>('[data-chart="live"]');
	if (liveCardRoot) {
		const liveCard = new ChartCard(liveCardRoot);
		const nowValue = document.querySelector<HTMLElement>('[data-live-now]')!;
		const peakValue = document.querySelector<HTMLElement>('[data-live-peak]')!;
		const sessionPeakValue = document.querySelector<HTMLElement>('[data-live-session-peak]')!;
		const sessionSince = document.querySelector<HTMLElement>('[data-live-session-since]')!;
		const status = document.querySelector<HTMLElement>('[data-live-status]')!;
		const statusText = document.querySelector<HTMLElement>('[data-live-status-text]')!;
		const samples: { at: string; time: string; listeners: number | null }[] = [];
		const maxSamples = 360; // One hour at 10-second intervals.
		const timeFormat = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
		let sessionPeak: number | null = null;
		sessionSince.textContent = `Since ${timeFormat.format(new Date())}`;

		liveCard.render = () => {
			const labels = samples.map((sample) => sample.time);
			const values = samples.map((sample) => sample.listeners);
			// Update in place while the style is unchanged so the chart doesn't flash every 10 seconds.
			const chart = liveCard.chart;
			if (chart && liveCard.drawnStyle === liveCard.style) {
				chart.data.labels = labels;
				chart.data.datasets[0].data = values;
				chart.update('none');
				return;
			}
			liveCard.trend(labels, [{ label: 'Listeners', values }], [palette[0]]);
		};

		const poll = async () => {
			const time = timeFormat.format(new Date());
			try {
				const response = await fetch('/api/now-playing', { cache: 'no-store' });
				const data = (await response.json()) as { listeners?: unknown; peakListeners?: unknown };
				if (!response.ok || typeof data.listeners !== 'number') throw new Error('Stream status unavailable.');
				const listeners = data.listeners;
				sessionPeak = Math.max(sessionPeak ?? 0, listeners);
				nowValue.textContent = formatNumber(listeners);
				peakValue.textContent = typeof data.peakListeners === 'number' ? formatNumber(data.peakListeners) : '—';
				sessionPeakValue.textContent = formatNumber(sessionPeak);
				status.dataset.state = 'live';
				statusText.textContent = `Live · updated ${time}`;
				samples.push({ at: new Date().toISOString(), time, listeners });
			} catch {
				status.dataset.state = 'offline';
				statusText.textContent = `Stream offline or unreachable · ${time}`;
				nowValue.textContent = '—';
				samples.push({ at: new Date().toISOString(), time, listeners: null });
			}
			if (samples.length > maxSamples) samples.splice(0, samples.length - maxSamples);
			liveCard.render();
		};

		poll();
		window.setInterval(poll, 10_000);

		document.querySelector('[data-export-live]')?.addEventListener('click', () => {
			downloadCsv('live-listeners', ['Time (UTC)', 'Listeners'], samples.map((sample) => [sample.at, sample.listeners]));
		});
	}

	/* ---------- Monthly social media ---------- */

	const dataElement = document.getElementById('analytics-data');
	const months = JSON.parse(dataElement?.textContent ?? '[]') as Month[];
	const monthSelect = document.querySelector<HTMLSelectElement>('[data-month-select]');
	const rangeSelect = document.querySelector<HTMLSelectElement>('[data-range-select]');

	if (months.length && monthSelect && rangeSelect) {
		const youtubeEngagement = (month: Month) => month.youtube.likes + month.youtube.comments + month.youtube.shares;
		const tiktokEngagement = (month: Month) => month.tiktok.likes + month.tiktok.comments + month.tiktok.shares + month.tiktok.saves;

		type Tile = { label: string; value: (month: Month) => number; format?: (value: number) => string; hero?: boolean; note?: (month: Month) => string };
		const tiles: Record<string, Tile[]> = {
			overview: [
				{ label: 'Total views', value: (m) => m.youtube.views + m.instagram.views + m.tiktok.videoViews, hero: true },
				{ label: 'Total followers', value: (m) => m.youtube.subscribers + m.instagram.followers + m.tiktok.followers },
				{ label: 'New followers', value: (m) => m.youtube.subscribersGained + m.instagram.followersGained + m.tiktok.followersGained },
				{ label: 'Total engagement', value: (m) => youtubeEngagement(m) + m.instagram.interactions + tiktokEngagement(m), note: () => 'Likes, comments, shares and saves' },
			],
			youtube: [
				{ label: 'Views', value: (m) => m.youtube.views, hero: true },
				{ label: 'Watch time (hours)', value: (m) => m.youtube.watchTimeHours },
				{ label: 'Subscribers', value: (m) => m.youtube.subscribers, note: (m) => `+${formatNumber(m.youtube.subscribersGained)} gained · −${formatNumber(m.youtube.subscribersLost)} lost` },
				{ label: 'Impressions', value: (m) => m.youtube.impressions },
				{ label: 'Impressions CTR', value: (m) => m.youtube.impressionsCtr, format: (v) => `${v.toFixed(1)}%` },
				{ label: 'Avg. view duration', value: (m) => m.youtube.averageViewDurationSeconds, format: formatDuration },
				{ label: 'Likes', value: (m) => m.youtube.likes },
				{ label: 'Comments', value: (m) => m.youtube.comments },
				{ label: 'Shares', value: (m) => m.youtube.shares },
			],
			instagram: [
				{ label: 'Views', value: (m) => m.instagram.views, hero: true },
				{ label: 'Reach', value: (m) => m.instagram.reach },
				{ label: 'Followers', value: (m) => m.instagram.followers, note: (m) => `+${formatNumber(m.instagram.followersGained)} this month` },
				{ label: 'Accounts engaged', value: (m) => m.instagram.accountsEngaged },
				{ label: 'Interactions', value: (m) => m.instagram.interactions },
				{ label: 'Profile visits', value: (m) => m.instagram.profileVisits },
				{ label: 'Website taps', value: (m) => m.instagram.websiteTaps },
				{ label: 'Likes', value: (m) => m.instagram.likes },
				{ label: 'Comments', value: (m) => m.instagram.comments },
				{ label: 'Shares', value: (m) => m.instagram.shares },
				{ label: 'Saves', value: (m) => m.instagram.saves },
			],
			tiktok: [
				{ label: 'Video views', value: (m) => m.tiktok.videoViews, hero: true },
				{ label: 'Reach', value: (m) => m.tiktok.reach },
				{ label: 'Followers', value: (m) => m.tiktok.followers, note: (m) => `+${formatNumber(m.tiktok.followersGained)} this month` },
				{ label: 'Profile views', value: (m) => m.tiktok.profileViews },
				{ label: 'Avg. watch time', value: (m) => m.tiktok.averageWatchTimeSeconds, format: formatDuration },
				{ label: 'Likes', value: (m) => m.tiktok.likes },
				{ label: 'Comments', value: (m) => m.tiktok.comments },
				{ label: 'Shares', value: (m) => m.tiktok.shares },
				{ label: 'Saves', value: (m) => m.tiktok.saves },
			],
		};

		const breakdowns: Record<string, { valueLabel: string; slices: [string, (m: Month) => number][] }> = {
			'overview-views': { valueLabel: 'Views', slices: [['YouTube', (m) => m.youtube.views], ['Instagram', (m) => m.instagram.views], ['TikTok', (m) => m.tiktok.videoViews]] },
			'overview-followers': { valueLabel: 'Followers', slices: [['YouTube', (m) => m.youtube.subscribers], ['Instagram', (m) => m.instagram.followers], ['TikTok', (m) => m.tiktok.followers]] },
			'youtube-traffic': { valueLabel: 'Views', slices: [['Search', (m) => m.youtube.trafficSources.search], ['Suggested', (m) => m.youtube.trafficSources.suggested], ['Browse', (m) => m.youtube.trafficSources.browse], ['External', (m) => m.youtube.trafficSources.external], ['Other', (m) => m.youtube.trafficSources.other]] },
			'youtube-engagement': { valueLabel: 'Count', slices: [['Likes', (m) => m.youtube.likes], ['Comments', (m) => m.youtube.comments], ['Shares', (m) => m.youtube.shares]] },
			'instagram-content': { valueLabel: 'Views', slices: [['Reels', (m) => m.instagram.contentViews.reels], ['Posts', (m) => m.instagram.contentViews.posts], ['Stories', (m) => m.instagram.contentViews.stories]] },
			'instagram-engagement': { valueLabel: 'Count', slices: [['Likes', (m) => m.instagram.likes], ['Comments', (m) => m.instagram.comments], ['Shares', (m) => m.instagram.shares], ['Saves', (m) => m.instagram.saves]] },
			'tiktok-traffic': { valueLabel: 'Views', slices: [['For You', (m) => m.tiktok.trafficSources.forYou], ['Following', (m) => m.tiktok.trafficSources.following], ['Profile', (m) => m.tiktok.trafficSources.profile], ['Search', (m) => m.tiktok.trafficSources.search], ['Other', (m) => m.tiktok.trafficSources.other]] },
			'tiktok-engagement': { valueLabel: 'Count', slices: [['Likes', (m) => m.tiktok.likes], ['Comments', (m) => m.tiktok.comments], ['Shares', (m) => m.tiktok.shares], ['Saves', (m) => m.tiktok.saves]] },
		};

		const platformTrendColor: Record<string, string> = { youtube: platformColors.youtube, instagram: platformColors.instagram, tiktok: platformColors.tiktok };
		const overviewMetrics: Record<string, [string, (m: Month) => number][]> = {
			views: [['YouTube', (m) => m.youtube.views], ['Instagram', (m) => m.instagram.views], ['TikTok', (m) => m.tiktok.videoViews]],
			followers: [['YouTube', (m) => m.youtube.subscribers], ['Instagram', (m) => m.instagram.followers], ['TikTok', (m) => m.tiktok.followers]],
			engagement: [['YouTube', youtubeEngagement], ['Instagram', (m) => m.instagram.interactions], ['TikTok', tiktokEngagement]],
		};

		const selectedIndex = () => Math.max(0, months.findIndex((month) => month.month === monthSelect.value));
		const trendMonths = () => {
			const end = selectedIndex() + 1;
			const range = rangeSelect.value === 'all' ? end : Number(rangeSelect.value);
			return months.slice(Math.max(0, end - range), end);
		};

		const renderTiles = () => {
			const index = selectedIndex();
			const current = months[index];
			const previous = months[index - 1];
			for (const [platform, list] of Object.entries(tiles)) {
				const container = document.querySelector<HTMLElement>(`[data-tiles="${platform}"]`);
				if (!container) continue;
				container.innerHTML = list.map((tile) => {
					const value = tile.value(current);
					const format = tile.format ?? formatNumber;
					let delta = '';
					if (previous) {
						const before = tile.value(previous);
						if (before > 0) {
							const change = ((value - before) / before) * 100;
							const [arrow, direction, word] = change > 0 ? ['▲', 'is-up', 'Up'] : change < 0 ? ['▼', 'is-down', 'Down'] : ['■', '', 'No change'];
							delta = `<span class="tile-delta"><span class="trend-arrow ${direction}" aria-hidden="true">${arrow}</span><span class="visually-hidden">${word}</span> ${Math.abs(change).toFixed(1)}% vs ${escapeHtml(shortMonth(previous.month))}</span>`;
						}
					}
					const note = tile.note ? `<span class="tile-note">${escapeHtml(tile.note(current))}</span>` : '';
					return `<div class="tile${tile.hero ? ' tile-hero' : ''}"><span class="tile-label">${escapeHtml(tile.label)}</span><strong class="tile-value">${escapeHtml(format(value))}</strong>${delta}${note}</div>`;
				}).join('');
			}
		};

		const cards = new Map<string, ChartCard>();
		document.querySelectorAll<HTMLElement>('.social-panel [data-chart]').forEach((root) => {
			const card = new ChartCard(root);
			const id = root.dataset.chart!;
			cards.set(id, card);
			const metricSelect = root.querySelector<HTMLSelectElement>('[data-metric-select]');
			metricSelect?.addEventListener('change', () => card.render());

			if (id in breakdowns) {
				const definition = breakdowns[id];
				card.render = () => {
					const month = months[selectedIndex()];
					card.breakdown(definition.slices.map(([label]) => label), definition.slices.map(([, value]) => value(month)), palette, definition.valueLabel);
				};
			} else if (id === 'overview-trend') {
				card.render = () => {
					const list = trendMonths();
					const metric = overviewMetrics[metricSelect!.value];
					card.trend(list.map((m) => shortMonth(m.month)), metric.map(([label, value]) => ({ label, values: list.map(value) })), [palette[0], palette[1], palette[2]]);
				};
			} else {
				const platform = id.replace('-trend', '') as 'youtube' | 'instagram' | 'tiktok';
				card.render = () => {
					const list = trendMonths();
					const key = metricSelect!.value;
					const label = metricSelect!.selectedOptions[0]?.textContent ?? key;
					const values = list.map((m) => (m[platform] as Record<string, unknown>)[key] as number);
					const format: Format = key.endsWith('Seconds') ? (v) => (typeof v === 'number' ? formatDuration(v) : '—') : formatNumber;
					card.trend(list.map((m) => shortMonth(m.month)), [{ label, values }], [platformTrendColor[platform]], format);
				};
			}
		});

		// Charts in hidden tabs have no size, so only draw the visible tab and redraw tabs as they open.
		const visibleCards = () => [...cards.values()].filter((card) => !card.root.closest<HTMLElement>('[data-platform]')?.hidden);
		const renderAll = () => {
			renderTiles();
			visibleCards().forEach((card) => card.render());
		};

		monthSelect.addEventListener('change', renderAll);
		rangeSelect.addEventListener('change', renderAll);

		// One row per month and one column per figure, e.g. "youtube.trafficSources.search".
		document.querySelector('[data-export-social]')?.addEventListener('click', () => {
			const flatten = (value: unknown, prefix: string, into: Map<string, CsvCell>) => {
				if (value && typeof value === 'object') {
					Object.entries(value).forEach(([key, child]) => flatten(child, prefix ? `${prefix}.${key}` : key, into));
				} else {
					into.set(prefix, value as CsvCell);
				}
				return into;
			};
			const rows = months.map((month) => flatten(month, '', new Map()));
			const columns = [...new Set(rows.flatMap((row) => [...row.keys()]))];
			downloadCsv('social-monthly', columns, rows.map((row) => columns.map((column) => row.get(column))));
		});

		const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-platform-tab]')];
		const selectTab = (tab: HTMLButtonElement) => {
			tabs.forEach((other) => {
				const selected = other === tab;
				other.setAttribute('aria-selected', String(selected));
				other.tabIndex = selected ? 0 : -1;
				document.getElementById(`platform-${other.dataset.platformTab}`)!.hidden = !selected;
			});
			visibleCards().forEach((card) => card.render());
		};
		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => selectTab(tab));
			tab.addEventListener('keydown', (event) => {
				const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
				if (!step) return;
				const next = tabs[(index + step + tabs.length) % tabs.length];
				next.focus();
				selectTab(next);
			});
		});

		renderAll();
	}

	/* ---------- Private analytics: sign-in and date range ---------- */

	// Listener forms hold personal details and radio listening is internal, so both come from /api/analytics/*, which
	// only answers Google accounts with the analytics role (scripts/chat-admin.mjs analytics <email>). One sign-in and
	// one date range serve both panels.
	const privateArea = document.querySelector<HTMLElement>('[data-private]');
	const listenerPanel = document.querySelector<HTMLElement>('[data-listener-panel]');
	const radioPanel = document.querySelector<HTMLElement>('[data-radio-panel]');
	const chatPanel = document.querySelector<HTMLElement>('[data-chat-panel]');
	const sitePanel = document.querySelector<HTMLElement>('[data-site-panel]');
	const webPanel = document.querySelector<HTMLElement>('[data-web-panel]');
	if (privateArea && listenerPanel && radioPanel && chatPanel && sitePanel && webPanel) {
		const gate = privateArea.querySelector<HTMLElement>('[data-gate]')!;
		const gateMessage = privateArea.querySelector<HTMLElement>('[data-gate-message]')!;
		const signInButton = privateArea.querySelector<HTMLButtonElement>('[data-sign-in]')!;
		const account = privateArea.querySelector<HTMLElement>('[data-account]')!;
		const accountEmail = privateArea.querySelector<HTMLElement>('[data-account-email]')!;
		const toolbar = privateArea.querySelector<HTMLElement>('[data-private-toolbar]')!;
		const fromInput = privateArea.querySelector<HTMLInputElement>('[data-range-from]')!;
		const toInput = privateArea.querySelector<HTMLInputElement>('[data-range-to]')!;
		const status = privateArea.querySelector<HTMLElement>('[data-private-status]')!;
		const panels = [webPanel, radioPanel, chatPanel, sitePanel, listenerPanel];
		const cards = new Map([...document.querySelectorAll<HTMLElement>('[data-web-panel] .chart-card[data-chart], [data-listener-panel] .chart-card[data-chart], [data-radio-panel] .chart-card[data-chart], [data-chat-panel] .chart-card[data-chart], [data-site-panel] .chart-card[data-chart]')]
			.map((root) => [root.dataset.chart!, new ChartCard(root)]));

		// The last 30 days, in Jakarta dates, until changed.
		const jakartaDate = (time: number) => new Date(time + 7 * 3_600_000).toISOString().slice(0, 10);
		toInput.value = jakartaDate(Date.now());
		fromInput.value = jakartaDate(Date.now() - 29 * 86_400_000);

		let auth: OzAuth | undefined;

		// Inside the CMS admin (Analytics page), the CMS hands over a short-lived token in the address's #fragment, which
		// never reaches a server log. It replaces Google sign-in: requests carry it, and the CMS user's role decides.
		const cmsToken = /(?:^#|&)cms=([^&]+)/.exec(location.hash)?.[1] ?? null;
		if (cmsToken) history.replaceState(null, '', location.pathname + location.search);
		const cmsEmail = (() => {
			try {
				return cmsToken ? String(JSON.parse(atob(cmsToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))).email ?? '') : '';
			} catch {
				return '';
			}
		})();
		const isEmbedded = document.documentElement.classList.contains('is-embedded');
		const signedIn = () => Boolean(cmsToken || auth?.currentUser());
		/** The Authorization header for our routes; `refresh` asks Firebase for a new ID token. */
		const authHeader = async (refresh = false) => {
			if (cmsToken) return `OZAdmin ${cmsToken}`;
			const token = await auth?.idToken(refresh);
			return token ? `Bearer ${token}` : null;
		};

		class AccessError extends Error {
			constructor(readonly status: number, message: string) {
				super(message);
			}
		}

		const showGate = (message: string, { signIn = true } = {}) => {
			gate.hidden = false;
			toolbar.hidden = true;
			panels.forEach((panel) => { panel.hidden = true; });
			gateMessage.innerHTML = message;
			signInButton.hidden = !signIn;
		};

		// The token carries the roles, so a refusal is retried once with a fresh token: an account granted access
		// after signing in doesn't have to sign out and back in.
		const request = async (path: string, extra: Record<string, string> = {}) => {
			const params = new URLSearchParams(extra);
			if (fromInput.value) params.set('from', fromInput.value);
			if (toInput.value) params.set('to', toInput.value);
			let response: Response | undefined;
			for (const refresh of cmsToken ? [false] : [false, true]) {
				const header = await authHeader(refresh);
				if (!header) throw new AccessError(401, 'Please sign in to see the analytics.');
				response = await fetch(`${path}?${params}`, { headers: { Authorization: header }, cache: 'no-store' });
				if (response.status !== 403) break;
			}
			if (!response!.ok) {
				const { error } = await response!.json().catch(() => ({})) as { error?: string };
				throw new AccessError(response!.status, error ?? 'The analytics could not be loaded.');
			}
			return response!;
		};

		const downloadFrom = async (button: HTMLButtonElement, path: string, extra: Record<string, string>) => {
			button.disabled = true;
			try {
				const response = await request(path, { ...extra, format: 'csv' });
				const url = URL.createObjectURL(await response.blob());
				const fileName = /filename="([^"]+)"/.exec(response.headers.get('Content-Disposition') ?? '')?.[1] ?? 'oz-export.csv';
				const link = Object.assign(document.createElement('a'), { href: url, download: fileName });
				document.body.append(link);
				link.click();
				link.remove();
				window.setTimeout(() => URL.revokeObjectURL(url), 0);
			} catch (error) {
				status.textContent = error instanceof Error ? error.message : 'The export failed.';
			} finally {
				button.disabled = false;
			}
		};

		// Counts per value, biggest first, with the rest folded into "Other" past `limit`.
		const countBy = (values: string[], limit = Infinity) => {
			const counts = new Map<string, number>();
			values.forEach((value) => counts.set(value, (counts.get(value) ?? 0) + 1));
			return foldOther([...counts].sort((a, b) => b[1] - a[1]), limit);
		};
		const foldOther = (sorted: [string, number][], limit: number) => {
			if (sorted.length <= limit) return sorted;
			const other = sorted.slice(limit - 1).reduce((sum, [, count]) => sum + count, 0);
			return [...sorted.slice(0, limit - 1), ['Other', other] as [string, number]];
		};
		const fromRecord = (record: Record<string, number>, labels: Record<string, string> = {}, limit = Infinity) =>
			foldOther(Object.entries(record).sort((a, b) => b[1] - a[1]).map(([key, value]) => [labels[key] ?? key, value] as [string, number]), limit);

		const tile = (label: string, value: string, note = '') =>
			`<div class="tile"><span class="tile-label">${escapeHtml(label)}</span><strong class="tile-value">${escapeHtml(value)}</strong>${note ? `<span class="tile-note">${escapeHtml(note)}</span>` : ''}</div>`;

		const drawBreakdown = (id: string, pairs: [string, number][], valueLabel: string) => {
			const card = cards.get(id);
			if (!card) return;
			card.render = () => card.breakdown(pairs.map(([label]) => label), pairs.map(([, value]) => value), palette, valueLabel);
			card.render();
		};

		/* ----- Listener forms ----- */

		type ListenerRecord = {
			createdAt: string;
			name: string;
			age: string;
			gender: string;
			location: string;
			broadcast: string | null;
			googleUid: string | null;
			googleEmail: string | null;
		};

		const listenerTiles = listenerPanel.querySelector<HTMLElement>('[data-listener-tiles]')!;
		const listenerTable = listenerPanel.querySelector<HTMLElement>('[data-listener-table]')!;
		const sentAt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jakarta', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });

		// The first records stored an exact age; they are counted in their range.
		const ageRange = (age: string) => {
			const years = Number(age);
			if (!/^\d+$/.test(age)) return age || 'Not given';
			if (years < 18) return ageRanges[0];
			const bounds = [24, 34, 44, 54, 64];
			const index = bounds.findIndex((bound) => years <= bound);
			return ageRanges[index < 0 ? ageRanges.length - 1 : index + 1];
		};

		// Places are typed freely, so "bandung" and "Bandung " count as one.
		const placeName = (location: string) => {
			const clean = location.trim().replace(/\s+/g, ' ');
			return clean ? clean.toLowerCase().replace(/(^|[\s,(-])\p{L}/gu, (letter) => letter.toUpperCase()) : 'Not given';
		};

		const renderListeners = (records: ListenerRecord[]) => {
			const total = records.length;
			const signedIn = records.filter((record) => record.googleUid).length;
			const ages = countBy(records.map((record) => ageRange(record.age)));
			const places = countBy(records.map((record) => placeName(record.location)), 8);
			listenerTiles.innerHTML = [
				tile('Forms sent', formatNumber(total)),
				tile('Signed in with Google', formatNumber(signedIn), total ? `${Math.round((signedIn / total) * 100)}% of forms` : ''),
				tile('Most common age', ages[0]?.[0] ?? '—'),
				tile('Top location', places[0]?.[0] ?? '—'),
				tile('Latest form', records[0] ? sentAt.format(new Date(records[0].createdAt)) : '—'),
			].join('');

			drawBreakdown('listener-gender', countBy(records.map((record) => record.gender || 'Not given')), 'Forms');
			// Age ranges keep their natural order rather than their size.
			const ageOrder: string[] = [...ageRanges, 'Not given'];
			drawBreakdown('listener-age', [...ages].sort((a, b) => ageOrder.indexOf(a[0]) - ageOrder.indexOf(b[0])), 'Forms');
			drawBreakdown('listener-stream', countBy(records.map((record) => record.broadcast === 'video' ? 'Livestream' : record.broadcast === 'audio' ? 'Audio stream' : 'Not playing')), 'Forms');
			drawBreakdown('listener-location', places, 'Forms');

			listenerTable.innerHTML = total
				? `<table><thead><tr>${['Sent', 'Name', 'Age', 'Gender', 'Location', 'Tuned in to', 'Google account'].map((heading) => `<th scope="col">${heading}</th>`).join('')}</tr></thead><tbody>${records.map((record) => `<tr>${[
					sentAt.format(new Date(record.createdAt)),
					record.name,
					record.age,
					record.gender,
					record.location,
					record.broadcast === 'video' ? 'Livestream' : record.broadcast === 'audio' ? 'Audio' : '—',
					record.googleEmail ?? '—',
				].map((cell) => `<td>${escapeHtml(cell)}</td>`).join('')}</tr>`).join('')}</tbody></table>`
				: '<p class="chart-note">No forms in this period.</p>';
		};

		/* ----- Radio listening ----- */

		type RadioSummary = {
			totals: {
				playClicks: number;
				streamStarts: number;
				listeningHours: number;
				medianMinutes: number;
				averageMinutes: number;
				medianWaitSeconds: number;
				errors: number;
				interruptions: number;
				knownListeners: number;
				returningListeners: number;
				anonymousSessions: number;
			};
			daily: { day: string; playClicks: number; sessions: number; listeningHours: number; errors: number }[];
			hourOfDay: number[];
			sessionLengths: [string, number][];
			endReasons: Record<string, number>;
			devices: Record<string, number>;
			deviceHours: Record<string, number>;
			streams: Record<string, number>;
			sources: Record<string, number>;
			browsers: Record<string, number>;
			errorCodes: Record<string, number>;
		};

		const radioTiles = radioPanel.querySelector<HTMLElement>('[data-radio-tiles]')!;
		const endLabels: Record<string, string> = {
			pause: 'Paused',
			stop: 'Mini player stop',
			switch: 'Changed stream',
			error: 'Stream failed',
			listener_form: 'Listener form',
			page_close: 'Left the site',
			unknown: 'Unknown (tab lost)',
		};
		const deviceLabels: Record<string, string> = { mobile: 'Mobile', tablet: 'Tablet', desktop: 'Desktop' };
		const streamLabels: Record<string, string> = { audio: 'Audio stream', video: 'Livestream' };
		const sourceLabels: Record<string, string> = { tune_in: 'Tune-in dialog', station_page: 'Player on station page', mini_player: 'Mini player on OZ News' };
		const errorLabels: Record<string, string> = { network: 'Network dropped', decode: 'Could not decode', not_supported: 'Format not supported', aborted: 'Aborted', offline: 'Gave up reconnecting' };
		const formatHours = (hours: number) => (hours >= 10 ? formatNumber(Math.round(hours)) : hours >= 1 ? hours.toFixed(1) : `${Math.round(hours * 60)} min`);
		const formatMinutes = (minutes: number) => (minutes >= 60 ? `${(minutes / 60).toFixed(1)} h` : `${minutes.toFixed(minutes < 10 ? 1 : 0)} min`);
		const shortDay = (day: string) => new Date(`${day}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });

		const renderRadio = (summary: RadioSummary) => {
			const { totals } = summary;
			const mobileShare = totals.streamStarts ? Math.round((((summary.devices.mobile ?? 0) + (summary.devices.tablet ?? 0)) / totals.streamStarts) * 100) : 0;
			radioTiles.innerHTML = [
				tile('Listening sessions', formatNumber(totals.streamStarts)),
				tile('Hours listened', formatHours(totals.listeningHours)),
				tile('Typical session', formatMinutes(totals.medianMinutes), `Median. Average ${formatMinutes(totals.averageMinutes)}`),
				tile('Play presses that started', totals.playClicks ? `${Math.min(100, Math.round((totals.streamStarts / totals.playClicks) * 100))}%` : '—', `${formatNumber(totals.playClicks)} presses`),
				tile('Wait for sound', totals.medianWaitSeconds ? `${totals.medianWaitSeconds.toFixed(1)} s` : '—', 'Median, from pressing play'),
				tile('On phones and tablets', totals.streamStarts ? `${mobileShare}%` : '—', 'Of sessions'),
				tile('Returning listeners', formatNumber(totals.returningListeners), `Of ${formatNumber(totals.knownListeners)} known (accepted cookies)`),
				tile('Stream errors', formatNumber(totals.errors), `${formatNumber(totals.interruptions)} interruptions`),
			].join('');

			const daily = cards.get('radio-daily');
			if (daily) {
				const select = daily.root.querySelector<HTMLSelectElement>('[data-metric-select]')!;
				daily.render = () => {
					const key = select.value as 'sessions' | 'listeningHours' | 'playClicks' | 'errors';
					const label = select.selectedOptions[0]?.textContent ?? key;
					const format: Format = key === 'listeningHours' ? (value) => (typeof value === 'number' ? formatHours(value) : '—') : formatNumber;
					daily.trend(summary.daily.map((day) => shortDay(day.day)), [{ label, values: summary.daily.map((day) => day[key]) }], [palette[0]], format);
				};
				select.onchange = () => daily.render();
				daily.render();
			}
			const hours = cards.get('radio-hours');
			if (hours) {
				hours.render = () => hours.trend(Array.from({ length: 24 }, (_, hour) => `${String(hour).padStart(2, '0')}:00`), [{ label: 'Sessions started', values: summary.hourOfDay }], [palette[1]]);
				hours.render();
			}

			drawBreakdown('radio-lengths', summary.sessionLengths, 'Sessions');
			drawBreakdown('radio-ends', fromRecord(summary.endReasons, endLabels), 'Sessions');
			drawBreakdown('radio-devices', fromRecord(summary.devices, deviceLabels), 'Sessions');
			drawBreakdown('radio-device-hours', fromRecord(Object.fromEntries(Object.entries(summary.deviceHours).map(([device, value]) => [device, Number(value.toFixed(2))])), deviceLabels), 'Hours');
			drawBreakdown('radio-streams', fromRecord(summary.streams, streamLabels), 'Sessions');
			drawBreakdown('radio-sources', fromRecord(summary.sources, sourceLabels), 'Sessions');
			drawBreakdown('radio-browsers', fromRecord(summary.browsers, {}, 6), 'Sessions');
			drawBreakdown('radio-errors', fromRecord(summary.errorCodes, errorLabels), 'Errors');
		};

		/* ----- Live chat ----- */

		type ChatSummary = {
			totals: {
				messages: number;
				moderatorMessages: number;
				chatters: number;
				returningChatters: number;
				activeNow: number;
				messagesPerChatter: number;
				messagesPerVisit: number;
				views: number;
				signedInViews: number;
				signInAttempts: number;
				signIns: number;
				newAccounts: number;
				refused: number;
				networkFailures: number;
				reports: number;
				hiddenByReports: number;
				moderationActions: number;
				medianFirstMessageSeconds: number;
				disconnections: number;
			};
			daily: { day: string; messages: number; chatters: number; views: number; signIns: number; refused: number }[];
			hourOfDay: number[];
			viewers: { signedIn: number; anonymous: number };
			signInOutcomes: Record<string, number>;
			signInErrors: Record<string, number>;
			refusals: Record<string, number>;
			moderation: Record<string, number>;
			disconnectCauses: Record<string, number>;
		};

		const chatTiles = chatPanel.querySelector<HTMLElement>('[data-chat-tiles]')!;
		const signInLabels: Record<string, string> = { success: 'Signed in', cancelled: 'Closed the window', failed: 'Failed' };
		const refusalLabels: Record<string, string> = {
			signed_out: 'Not signed in', banned: 'Banned', muted: 'Muted', too_fast: 'Too fast / slow mode', empty: 'Empty',
			too_long: 'Too long', emoji: 'Too many emoji', link: 'Contained a link', blocked_words: 'Blocked words',
			duplicate: 'Repeated message', error: 'Server error',
		};
		const moderationLabels: Record<string, string> = {
			delete: 'Deleted by a moderator', timeout: 'Muted by a moderator', ban: 'Banned', slowmode: 'Slow mode changed',
			auto_mute: 'Muted automatically (3 strikes)', auto_hide: 'Hidden by reports',
		};
		const disconnectLabels: Record<string, string> = { idle: 'Chat left unseen (idle)', network: 'Network dropped', leave: 'Left the page' };
		const formatAverage = (value: number) => (value ? value.toFixed(1) : '—');

		const renderChat = (summary: ChatSummary) => {
			const { totals } = summary;
			chatTiles.innerHTML = [
				tile('Messages', formatNumber(totals.messages), totals.moderatorMessages ? `${formatNumber(totals.moderatorMessages)} by moderators` : ''),
				tile('Chatters', formatNumber(totals.chatters), 'Accounts that posted'),
				tile('Returning chatters', formatNumber(totals.returningChatters), 'Posted on 2 or more days'),
				tile('Active now', formatNumber(totals.activeNow), 'Posted in the last 15 min'),
				tile('Messages per visit', formatAverage(totals.messagesPerVisit), `${formatAverage(totals.messagesPerChatter)} per chatter`),
				tile('Chat views', formatNumber(totals.views), `${formatNumber(totals.signedInViews)} signed in · ${formatNumber(totals.views - totals.signedInViews)} not`),
				tile('Sign-ins', formatNumber(totals.signIns), `${formatNumber(totals.signInAttempts)} attempts · ${formatNumber(totals.newAccounts)} new accounts`),
				tile('Time to first message', totals.medianFirstMessageSeconds ? formatMinutes(totals.medianFirstMessageSeconds / 60) : '—', 'Median, from the chat showing'),
				tile('Failed messages', formatNumber(totals.refused + totals.networkFailures), `${formatNumber(totals.refused)} refused · ${formatNumber(totals.networkFailures)} network`),
				tile('Moderation', formatNumber(totals.moderationActions), `${formatNumber(totals.reports)} reports · ${formatNumber(totals.hiddenByReports)} hidden`),
			].join('');

			const daily = cards.get('chat-daily');
			if (daily) {
				const select = daily.root.querySelector<HTMLSelectElement>('[data-metric-select]')!;
				daily.render = () => {
					const key = select.value as 'messages' | 'chatters' | 'views' | 'signIns' | 'refused';
					const label = select.selectedOptions[0]?.textContent ?? key;
					daily.trend(summary.daily.map((day) => shortDay(day.day)), [{ label, values: summary.daily.map((day) => day[key]) }], [palette[2]]);
				};
				select.onchange = () => daily.render();
				daily.render();
			}
			const hours = cards.get('chat-hours');
			if (hours) {
				hours.render = () => hours.trend(Array.from({ length: 24 }, (_, hour) => `${String(hour).padStart(2, '0')}:00`), [{ label: 'Messages', values: summary.hourOfDay }], [palette[3]]);
				hours.render();
			}

			drawBreakdown('chat-viewers', [['Signed in', summary.viewers.signedIn], ['Not signed in', summary.viewers.anonymous]], 'Views');
			drawBreakdown('chat-signins', fromRecord(Object.fromEntries(Object.entries(summary.signInOutcomes).filter(([status]) => status !== 'attempt')), signInLabels), 'Attempts');
			drawBreakdown('chat-refusals', fromRecord(summary.refusals, refusalLabels), 'Messages');
			drawBreakdown('chat-moderation', fromRecord(summary.moderation, moderationLabels), 'Actions');
			drawBreakdown('chat-disconnects', fromRecord(summary.disconnectCauses, disconnectLabels), 'Disconnections');
			drawBreakdown('chat-signin-errors', fromRecord(summary.signInErrors), 'Errors');
		};

		/* ----- Site performance ----- */

		type VitalName = 'LCP' | 'INP' | 'CLS' | 'FCP' | 'TTFB' | 'LOAD';
		type VitalRow = { views: number } & Record<VitalName, number | null>;
		type SiteSummary = {
			totals: { pageViews: number; passingShare: number | null; judgedViews: number; errors: number; pageViewsWithErrors: number };
			metrics: Record<VitalName, { p75: number | null; rating: string | null; samples: number; ratings: Record<string, number> }>;
			pages: Record<string, VitalRow>;
			devices: Record<string, VitalRow>;
			daily: ({ day: string } & Record<VitalName, number | null>)[];
			errors: { message: string; source: string; page: string; count: number; lastSeen: string }[];
		};

		const siteTiles = sitePanel.querySelector<HTMLElement>('[data-site-tiles]')!;
		const sitePages = sitePanel.querySelector<HTMLElement>('[data-site-pages]')!;
		const siteDevices = sitePanel.querySelector<HTMLElement>('[data-site-devices]')!;
		const siteErrors = sitePanel.querySelector<HTMLElement>('[data-site-errors]')!;
		const vitalOrder: VitalName[] = ['LCP', 'INP', 'CLS', 'FCP', 'TTFB', 'LOAD'];
		const vitalLabels: Record<VitalName, string> = {
			LCP: 'Largest Contentful Paint', INP: 'Interaction to Next Paint', CLS: 'Cumulative Layout Shift',
			FCP: 'First Contentful Paint', TTFB: 'Time to First Byte', LOAD: 'Full page load',
		};
		// Same thresholds as src/lib/site-events.ts (Google's).
		const vitalLimits: Partial<Record<VitalName, [number, number]>> = { LCP: [2500, 4000], INP: [200, 500], CLS: [0.1, 0.25], FCP: [1800, 3000], TTFB: [800, 1800] };
		const ratingLabels: Record<string, string> = { good: 'Good', 'needs-improvement': 'Needs improvement', poor: 'Poor' };
		const ratingOf = (name: VitalName, value: number) => {
			const limits = vitalLimits[name];
			if (!limits) return null;
			return value <= limits[0] ? 'good' : value > limits[1] ? 'poor' : 'needs-improvement';
		};
		const formatVital = (name: VitalName, value: number | null) => {
			if (value === null) return '—';
			if (name === 'CLS') return value.toFixed(2);
			return value >= 1000 ? `${(value / 1000).toFixed(1)} s` : `${Math.round(value)} ms`;
		};
		// A value with its rating colour (as HTML). The rating word is also written out, so colour isn't the only clue; the
		// tiles hide it visually (.tile .visually-hidden), the tables show it.
		const ratedCell = (name: VitalName, value: number | null) => {
			const rating = value === null ? null : ratingOf(name, value);
			const text = escapeHtml(formatVital(name, value));
			return rating ? `<span class="rating rating-${rating}">${text}<span class="visually-hidden"> (${ratingLabels[rating]})</span></span>` : text;
		};

		const vitalsTable = (container: HTMLElement, rows: Record<string, VitalRow>, heading: string, labels: Record<string, string> = {}) => {
			const entries = Object.entries(rows).sort((a, b) => b[1].views - a[1].views);
			container.innerHTML = entries.length
				? `<table><thead><tr><th scope="col">${heading}</th><th scope="col">Page views</th>${vitalOrder.map((name) => `<th scope="col" title="${vitalLabels[name]}">${name}</th>`).join('')}</tr></thead><tbody>${entries.map(([key, row]) =>
					`<tr><th scope="row">${escapeHtml(labels[key] ?? key)}</th><td>${formatNumber(row.views)}</td>${vitalOrder.map((name) => `<td>${ratedCell(name, row[name])}</td>`).join('')}</tr>`).join('')}</tbody></table>`
				: '<p class="chart-note">No measurements in this period yet.</p>';
		};

		const renderSite = (summary: SiteSummary) => {
			const { totals, metrics } = summary;
			const metricTile = (name: VitalName) => {
				const metric = metrics[name];
				const goodShare = metric.samples && vitalLimits[name] ? `${Math.round(((metric.ratings.good ?? 0) / metric.samples) * 100)}% good · ` : '';
				return `<div class="tile"><span class="tile-label">${escapeHtml(vitalLabels[name])}</span><strong class="tile-value">${ratedCell(name, metric.p75)}</strong><span class="tile-note">${escapeHtml(`${name} · ${goodShare}${formatNumber(metric.samples)} measured`)}</span></div>`;
			};
			siteTiles.innerHTML = [
				tile('Good page experience', totals.passingShare === null ? '—' : `${Math.round(totals.passingShare * 100)}%`, `Of ${formatNumber(totals.judgedViews)} page views: good LCP, CLS and INP`),
				...vitalOrder.map(metricTile),
				tile('JavaScript errors', formatNumber(totals.errors), `In ${formatNumber(totals.pageViewsWithErrors)} page views`),
			].join('');

			const daily = cards.get('site-daily');
			if (daily) {
				const select = daily.root.querySelector<HTMLSelectElement>('[data-metric-select]')!;
				daily.render = () => {
					const name = select.value as VitalName;
					const label = select.selectedOptions[0]?.textContent ?? name;
					daily.trend(summary.daily.map((day) => shortDay(day.day)), [{ label, values: summary.daily.map((day) => day[name]) }], [palette[4]], (value) => (typeof value === 'number' ? formatVital(name, value) : '—'));
				};
				select.onchange = () => daily.render();
				daily.render();
			}

			vitalsTable(sitePages, summary.pages, 'Page');
			vitalsTable(siteDevices, summary.devices, 'Device', deviceLabels);
			siteErrors.innerHTML = summary.errors.length
				? `<table><thead><tr>${['Error', 'Script', 'Page', 'Times', 'Last seen'].map((heading) => `<th scope="col">${heading}</th>`).join('')}</tr></thead><tbody>${summary.errors.map((error) => `<tr>${[
					error.message, error.source || '—', error.page, formatNumber(error.count), sentAt.format(new Date(error.lastSeen)),
				].map((cell) => `<td>${escapeHtml(cell)}</td>`).join('')}</tr>`).join('')}</tbody></table>`
				: '<p class="chart-note">No JavaScript errors in this period.</p>';
		};

		/* ----- Website (Google Analytics 4) ----- */

		type GaRow = Record<string, string | number>;
		type WebData = { reports: Record<string, GaRow[]> };

		const webStatus = webPanel.querySelector<HTMLElement>('[data-web-status]')!;
		const webBody = webPanel.querySelector<HTMLElement>('[data-web-body]')!;
		const webTiles = webPanel.querySelector<HTMLElement>('[data-web-tiles]')!;
		const gaDay = (value: string) => `${value.slice(0, 4)}-${value.slice(4, 6)}-${value.slice(6, 8)}`;
		const notSet = (value: unknown) => (value === '' || value === '(not set)' ? '—' : String(value));
		// [field, heading, how to show it]; "perVisitor" divides by the row's visitors (engagement time per visitor).
		type Column = [string, string, 'text' | 'number' | 'perVisitor'];
		const webColumns: Record<string, Column[]> = {
			sources: [['sessionSource', 'Source', 'text'], ['sessionMedium', 'Medium', 'text'], ['sessions', 'Sessions', 'number'], ['activeUsers', 'Visitors', 'number'], ['engagedSessions', 'Engaged sessions', 'number']],
			pages: [['pagePath', 'Page', 'text'], ['screenPageViews', 'Views', 'number'], ['activeUsers', 'Visitors', 'number'], ['userEngagementDuration', 'Time per visitor', 'perVisitor']],
			landingPages: [['landingPage', 'Landing page', 'text'], ['sessions', 'Sessions', 'number'], ['engagedSessions', 'Engaged sessions', 'number'], ['activeUsers', 'Visitors', 'number']],
			cities: [['city', 'City', 'text'], ['country', 'Country', 'text'], ['activeUsers', 'Visitors', 'number'], ['sessions', 'Sessions', 'number']],
			campaigns: [['sessionCampaignName', 'Campaign', 'text'], ['sessionSource', 'Source', 'text'], ['sessionMedium', 'Medium', 'text'], ['sessionManualAdContent', 'Placement', 'text'], ['sessions', 'Sessions', 'number'], ['activeUsers', 'Visitors', 'number'], ['engagedSessions', 'Engaged sessions', 'number']],
			events: [['eventName', 'Event', 'text'], ['eventCount', 'Times', 'number'], ['totalUsers', 'Visitors', 'number']],
		};
		const emptyNotes: Record<string, string> = {
			campaigns: 'No visits from campaign links in this period. Make links in Campaign links below and use them in posts.',
		};

		const renderWebTable = (name: string, rows: GaRow[]) => {
			const container = webPanel.querySelector<HTMLElement>(`[data-web-table="${name}"]`);
			const columns = webColumns[name];
			if (!container || !columns) return;
			const cell = (row: GaRow, [field, , kind]: Column) => {
				if (kind === 'text') return escapeHtml(notSet(row[field]));
				if (kind === 'perVisitor') return Number(row.activeUsers) ? formatDuration(Number(row[field]) / Number(row.activeUsers)) : '—';
				return formatNumber(Number(row[field]));
			};
			container.innerHTML = rows.length
				? `<table><thead><tr>${columns.map(([, heading]) => `<th scope="col">${heading}</th>`).join('')}</tr></thead><tbody>${rows.map((row) => `<tr>${columns.map((column) => `<td>${cell(row, column)}</td>`).join('')}</tr>`).join('')}</tbody></table>`
				: `<p class="chart-note">${escapeHtml(emptyNotes[name] ?? 'No data in this period yet.')}</p>`;
		};

		const pairs = (rows: GaRow[], dimension: string, metric: string, labels: Record<string, string> = {}, limit = 8) =>
			foldOther(rows.map((row) => [labels[String(row[dimension])] ?? notSet(row[dimension]), Number(row[metric])] as [string, number]), limit);

		const renderWeb = ({ reports }: WebData) => {
			const totals = reports.totals?.[0] ?? {};
			const number = (field: string) => Number(totals[field] ?? 0);
			webTiles.innerHTML = [
				tile('Visitors', formatNumber(number('activeUsers')), 'Who accepted cookies'),
				tile('New visitors', formatNumber(number('newUsers'))),
				tile('Sessions', formatNumber(number('sessions')), `${number('sessionsPerUser').toFixed(1)} per visitor`),
				tile('Page views', formatNumber(number('screenPageViews'))),
				tile('Engaged sessions', `${Math.round(number('engagementRate') * 100)}%`, `${formatNumber(number('engagedSessions'))} sessions over 10 s, 2+ pages or an event`),
				tile('Average session', formatDuration(number('averageSessionDuration'))),
			].join('');

			const daily = cards.get('web-daily');
			if (daily) {
				const select = daily.root.querySelector<HTMLSelectElement>('[data-metric-select]')!;
				const rows = reports.daily ?? [];
				daily.render = () => {
					const key = select.value;
					const label = select.selectedOptions[0]?.textContent ?? key;
					daily.trend(rows.map((row) => shortDay(gaDay(String(row.date)))), [{ label, values: rows.map((row) => Number(row[key])) }], [palette[0]]);
				};
				select.onchange = () => daily.render();
				daily.render();
			}

			drawBreakdown('web-channels', pairs(reports.channels ?? [], 'sessionDefaultChannelGroup', 'sessions'), 'Sessions');
			drawBreakdown('web-returning', pairs(reports.newVsReturning ?? [], 'newVsReturning', 'activeUsers', { new: 'New', returning: 'Returning' }), 'Visitors');
			drawBreakdown('web-devices', pairs(reports.devices ?? [], 'deviceCategory', 'activeUsers', { mobile: 'Mobile', desktop: 'Desktop', tablet: 'Tablet' }), 'Visitors');
			drawBreakdown('web-browsers', pairs(reports.browsers ?? [], 'browser', 'activeUsers', {}, 6), 'Visitors');
			drawBreakdown('web-os', pairs(reports.operatingSystems ?? [], 'operatingSystem', 'activeUsers', {}, 6), 'Visitors');
			Object.keys(webColumns).forEach((name) => renderWebTable(name, reports[name] ?? []));
		};

		// Loaded on its own, so a GA problem (not set up, Google unreachable) only affects this panel.
		const loadWeb = async () => {
			webStatus.hidden = false;
			webStatus.textContent = 'Loading Google Analytics…';
			try {
				const data = await (await request('/api/analytics/web')).json() as WebData;
				webStatus.hidden = true;
				webBody.hidden = false;
				renderWeb(data);
			} catch (error) {
				webBody.hidden = true;
				webStatus.textContent = error instanceof Error ? error.message : 'Google Analytics could not be loaded.';
			}
		};


		/* ----- Livestream (YouTube) ----- */

		// Loaded on its own, like Google Analytics: it is also open to CMS Developers and Digital without the analytics
		// role, and a problem here (YouTube, the CMS) leaves the other panels alone.
		type LiveNow = { state?: string; sync?: boolean; youtubeViewers?: number | null; youtubeViewersAt?: number | null; websiteViewers?: number | null; websiteViewersAt?: number | null };
		type BroadcastRow = {
			broadcastId: string; title: string; startedAt: string | null; endedAt: string | null;
			peakYoutubeViewers: number | null; peakWebsiteViewers: number | null; averageYoutubeViewers: number | null; averageWebsiteViewers: number | null;
		};
		type SnapshotRow = { recordedAt: string; youtubeConcurrentViewers: number | null; websiteActiveViewers: number | null; combinedEstimatedViewers: number | null };
		type AdminStatus = {
			configured: boolean;
			access: 'manage' | 'view';
			connection?: { connected: boolean; status: string; channelId?: string; channelTitle?: string };
			settings?: { toYoutube: boolean; fromYoutube: boolean };
			sync?: {
				active: boolean; state: string; videoId: string | null; liveChatId: string | null; title: string | null;
				readerMode: string | null; workerRunning: boolean;
				lastError: { at: number; message: string } | null; quota: { used: number; exhaustedUntil?: number } | null;
				counts: { sent: number; failed: number; imported: number } | null;
			};
			queue?: { pending: number; failed: number };
		};

		const livestreamPanel = document.querySelector<HTMLElement>('[data-livestream-panel]')!;
		const livestreamTiles = livestreamPanel.querySelector<HTMLElement>('[data-livestream-tiles]')!;
		const livestreamLiveStatus = livestreamPanel.querySelector<HTMLElement>('[data-livestream-live-status]')!;
		const livestreamAdmin = livestreamPanel.querySelector<HTMLElement>('[data-livestream-admin]')!;
		const livestreamSync = livestreamPanel.querySelector<HTMLElement>('[data-livestream-sync]')!;
		const livestreamControls = livestreamPanel.querySelector<HTMLElement>('[data-livestream-controls]')!;
		const livestreamAdminStatus = livestreamPanel.querySelector<HTMLElement>('[data-livestream-admin-status]')!;
		const livestreamSelect = livestreamPanel.querySelector<HTMLSelectElement>('[data-livestream-broadcast]')!;
		const livestreamTable = livestreamPanel.querySelector<HTMLElement>('[data-livestream-broadcasts]')!;
		const livestreamChartTitle = livestreamPanel.querySelector<HTMLElement>('[data-livestream-chart-title]')!;
		const livestreamChartNote = livestreamPanel.querySelector<HTMLElement>('[data-livestream-chart-note]')!;
		const snapshotExport = livestreamPanel.querySelector<HTMLButtonElement>('[data-export-livestream="snapshots"]')!;
		const livestreamCard = new ChartCard(livestreamPanel.querySelector<HTMLElement>('[data-chart="livestream-history"]')!);
		let livestreamTimer: number | undefined;
		let snapshotMinutes = 5;

		const wibTime = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit' });
		const wibDateTime = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jakarta', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
		const formatWhen = (value: string | number | null | undefined) => (value === null || value === undefined ? '—' : wibDateTime.format(new Date(value)));
		const formatViewerAverage = (value: number | null | undefined) => (typeof value === 'number' ? value.toLocaleString('en-US', { maximumFractionDigits: 1 }) : '—');
		const known = (value: unknown): value is number => typeof value === 'number' && Number.isFinite(value);

		const renderLiveNow = (live: LiveNow) => {
			const isLive = live.state === 'live';
			livestreamLiveStatus.textContent = isLive
				? 'Live on YouTube now. These are live measurements, refreshed every 30 seconds.'
				: live.state === 'upcoming' ? 'A broadcast is scheduled; not live yet.' : 'Not live on YouTube right now.';
			const youtube = isLive && known(live.youtubeViewers) ? live.youtubeViewers : null;
			const website = isLive && known(live.websiteViewers) ? live.websiteViewers : null;
			livestreamTiles.innerHTML = [
				tile('YouTube concurrent viewers', formatNumber(youtube), isLive && youtube === null ? 'YouTube is not sharing a count right now' : 'Official YouTube API measurement'),
				tile('Website active viewers', formatNumber(website), 'Estimated from active embedded playback'),
				tile('Combined audience (estimate)', youtube !== null && website !== null ? formatNumber(youtube + website) : '—', youtube !== null && website !== null ? 'Sum of the two; not a YouTube figure' : 'Shown only when both counts are known'),
			].join('');
		};

		const loadSnapshots = async (broadcastId: string) => {
			if (!broadcastId) return;
			snapshotExport.disabled = true;
			try {
				const { broadcast, snapshots } = await (await request('/api/analytics/livestream', { broadcast: broadcastId })).json() as { broadcast: BroadcastRow; snapshots: SnapshotRow[] };
				livestreamChartTitle.textContent = `Viewers · ${broadcast.title || broadcast.broadcastId}`;
				livestreamChartNote.textContent = `Stored snapshots (about every ${snapshotMinutes} minutes, WIB), not live. YouTube and website are separate series; gaps are times a count wasn't available.`;
				const labels = snapshots.map((row) => wibTime.format(new Date(row.recordedAt)));
				// Two separate series: different measures, never stacked into one.
				livestreamCard.render = () => livestreamCard.trend(labels, [
					{ label: 'YouTube concurrent viewers (official)', values: snapshots.map((row) => row.youtubeConcurrentViewers) },
					{ label: 'Website active viewers (estimate)', values: snapshots.map((row) => row.websiteActiveViewers) },
				], [platformColors.youtube, palette[2]], formatNumber, 'Time (WIB)');
				livestreamCard.render();
				snapshotExport.disabled = !snapshots.length;
			} catch (error) {
				livestreamChartNote.textContent = error instanceof Error ? error.message : 'The broadcast history could not be loaded.';
			}
		};

		const renderBroadcasts = (rows: BroadcastRow[]) => {
			const previous = livestreamSelect.value;
			livestreamSelect.replaceChildren(...rows.map((row) => new Option(`${formatWhen(row.startedAt)} · ${row.title || row.broadcastId}`, row.broadcastId)));
			livestreamSelect.disabled = !rows.length;
			if (rows.some((row) => row.broadcastId === previous)) livestreamSelect.value = previous;
			if (!rows.length) {
				livestreamTable.innerHTML = '<p class="chart-note">No broadcasts in this date range. History starts with the first broadcast after the YouTube channel is connected.</p>';
				livestreamCard.render = () => livestreamCard.trend([], [], palette);
				livestreamCard.render();
				snapshotExport.disabled = true;
				return;
			}
			const cell = (text: string) => `<td>${escapeHtml(text)}</td>`;
			const head = ['Broadcast', 'Started', 'Ended', 'Peak YouTube', 'Avg YouTube', 'Peak website', 'Avg website', ''].map((label) => `<th scope="col">${label}</th>`).join('');
			livestreamTable.innerHTML = `<table><thead><tr>${head}</tr></thead><tbody>${rows.map((row) =>
				`<tr><th scope="row">${escapeHtml(row.title || row.broadcastId)}</th>${cell(formatWhen(row.startedAt))}${cell(row.endedAt ? formatWhen(row.endedAt) : 'Live or unknown')}${cell(formatNumber(row.peakYoutubeViewers))}${cell(formatViewerAverage(row.averageYoutubeViewers))}${cell(formatNumber(row.peakWebsiteViewers))}${cell(formatViewerAverage(row.averageWebsiteViewers))}<td><button class="livestream-show" type="button" data-show-broadcast="${escapeHtml(row.broadcastId)}">Chart</button></td></tr>`).join('')}</tbody></table>`;
			void loadSnapshots(livestreamSelect.value);
		};

		const syncStateLabels: Record<string, string> = { OFFLINE: 'Offline', UPCOMING: 'Scheduled', LIVE: 'Live', ENDING: 'Ending', ENDED: 'Ended', ERROR: 'Error' };
		const youtubeResults: Record<string, string> = {
			connected: 'The YouTube channel is connected.',
			cancelled: 'Connecting was cancelled on the Google page.',
			state_mismatch: 'That sign-in was not started from this browser. Please try again.',
			state_expired: 'That sign-in took too long. Please try again.',
			no_refresh_token: 'Google did not grant offline access. Please try again.',
			scope_missing: 'The YouTube permission was not granted.',
			no_channel: 'That Google account has no YouTube channel.',
			wrong_channel: 'That is not the channel set in YOUTUBE_CHANNEL_ID.',
			not_configured: 'The YouTube integration is not configured on this server.',
		};

		const renderAdmin = (status: AdminStatus) => {
			livestreamAdmin.hidden = false;
			if (!status.configured) {
				livestreamSync.innerHTML = '';
				livestreamControls.hidden = true;
				livestreamAdminStatus.textContent = 'The YouTube integration is not configured on this server (see docs/youtube-unified-chat.md). The website chat works as usual.';
				return;
			}
			const sync = status.sync;
			const connection = status.connection;
			const item = (label: string, value: string) => `<div><dt>${escapeHtml(label)}</dt><dd>${escapeHtml(value)}</dd></div>`;
			livestreamSync.innerHTML = [
				item('Channel', connection?.connected ? `${connection.channelTitle ?? ''} (${connection.channelId ?? ''})` : connection?.status === 'revoked' ? 'Access revoked: connect again' : 'Not connected'),
				item('Broadcast', `${syncStateLabels[sync?.state ?? 'OFFLINE'] ?? sync?.state}${sync?.title ? ` · ${sync.title}` : ''}`),
				item('Video ID', sync?.videoId ?? '—'),
				item('Live chat ID', sync?.liveChatId ?? '—'),
				item('Chat sync', sync?.active ? `Active (${sync.readerMode === 'poll' ? 'polling' : 'streaming'})` : 'Not active'),
				item('Queued for YouTube', formatNumber(status.queue?.pending ?? 0)),
				item('Sent / failed / imported', sync?.counts ? `${formatNumber(sync.counts.sent)} / ${formatNumber(sync.counts.failed)} / ${formatNumber(sync.counts.imported)}` : '—'),
				item('Quota used today (estimate)', sync?.quota ? `${formatNumber(sync.quota.used)} units${sync.quota.exhaustedUntil ? ' · used up until reset' : ''}` : '—'),
				item('Worker', sync?.workerRunning ? 'Running' : 'Not running'),
				item('Last error', sync?.lastError ? `${formatWhen(sync.lastError.at)}: ${sync.lastError.message}` : 'None'),
			].join('');
			const manage = status.access === 'manage';
			// In the CMS, connecting and the switches are on its own YouTube & live chat page (Google's pages can't open
			// inside this frame).
			livestreamControls.hidden = isEmbedded;
			if (isEmbedded) {
				livestreamAdminStatus.textContent = 'Connect, disconnect and switch the sync on the CMS page YouTube & live chat.';
				return;
			}
			livestreamControls.querySelectorAll<HTMLInputElement>('[data-sync-setting]').forEach((input) => {
				input.checked = Boolean(status.settings?.[input.dataset.syncSetting as 'toYoutube' | 'fromYoutube']);
				input.disabled = !manage;
			});
			livestreamControls.querySelectorAll<HTMLButtonElement>('[data-sync-action]').forEach((button) => {
				const action = button.dataset.syncAction;
				button.hidden = !manage || (action === 'connect' ? Boolean(connection?.connected) : action === 'disconnect' ? !connection?.connected : false);
				if (action === 'connect') button.textContent = connection?.status === 'revoked' ? 'Reconnect YouTube channel' : 'Connect YouTube channel';
			});
			if (!manage && !livestreamAdminStatus.textContent) livestreamAdminStatus.textContent = 'View only. CMS developers can change these settings.';
		};

		const loadAdmin = async () => {
			try {
				renderAdmin(await (await request('/api/youtube/admin')).json() as AdminStatus);
			} catch (error) {
				// No Developer or Digital role in the CMS: the counts and history show, the sync status doesn't.
				if (error instanceof AccessError && error.status === 403) livestreamAdmin.hidden = true;
				else livestreamAdminStatus.textContent = error instanceof Error ? error.message : 'The sync status could not be loaded.';
			}
		};

		// The live numbers and the sync status refresh while the page is open and visible; the history when asked.
		const refreshLivestream = async () => {
			window.clearTimeout(livestreamTimer);
			if (livestreamPanel.hidden || !signedIn()) return;
			if (document.visibilityState === 'visible') {
				try {
					renderLiveNow((await (await request('/api/analytics/livestream')).json() as { live: LiveNow }).live);
					await loadAdmin();
				} catch {
					// Left as it was; the next refresh tries again.
				}
			}
			livestreamTimer = window.setTimeout(refreshLivestream, 30_000);
		};

		const loadLivestream = async () => {
			window.clearTimeout(livestreamTimer);
			try {
				const data = await (await request('/api/analytics/livestream')).json() as { live: LiveNow; snapshotIntervalSeconds: number; broadcasts: BroadcastRow[] };
				snapshotMinutes = Math.round(data.snapshotIntervalSeconds / 60) || 5;
				livestreamPanel.hidden = false;
				renderLiveNow(data.live);
				renderBroadcasts(data.broadcasts);
				void loadAdmin();
				livestreamTimer = window.setTimeout(refreshLivestream, 30_000);
			} catch (error) {
				// No access: the panel just doesn't show. Anything else is said in the panel.
				const denied = error instanceof AccessError && (error.status === 401 || error.status === 403);
				livestreamPanel.hidden = denied;
				if (!denied) livestreamLiveStatus.textContent = error instanceof Error ? error.message : 'The livestream analytics could not be loaded.';
			}
		};

		const hideLivestream = () => {
			window.clearTimeout(livestreamTimer);
			livestreamPanel.hidden = true;
		};

		const adminPost = async (path: string, body: Record<string, unknown>) => {
			const header = await authHeader();
			if (!header) throw new AccessError(401, 'Please sign in.');
			const response = await fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: header }, body: JSON.stringify(body) });
			const result = await response.json().catch(() => ({})) as { error?: string; url?: string };
			if (!response.ok) throw new AccessError(response.status, result.error ?? 'That did not work. Please try again.');
			return result;
		};

		livestreamControls.addEventListener('change', async (event) => {
			const input = event.target instanceof HTMLInputElement ? event.target : null;
			const setting = input?.dataset.syncSetting;
			if (!input || !setting) return;
			input.disabled = true;
			try {
				await adminPost('/api/youtube/admin', { action: 'settings', [setting]: input.checked });
				livestreamAdminStatus.textContent = 'Saved.';
			} catch (error) {
				input.checked = !input.checked;
				livestreamAdminStatus.textContent = error instanceof Error ? error.message : 'Could not save.';
			} finally {
				input.disabled = false;
				void loadAdmin();
			}
		});

		livestreamControls.addEventListener('click', async (event) => {
			const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-sync-action]') : null;
			const action = button?.dataset.syncAction;
			if (!button || !action) return;
			if (action === 'disconnect' && !window.confirm('Disconnect the YouTube channel? Chat sync stops until it is connected again. The website chat keeps working.')) return;
			button.disabled = true;
			try {
				if (action === 'connect') {
					const { url } = await adminPost('/api/youtube/connect', {});
					if (url) location.assign(url);
					return;
				}
				await adminPost('/api/youtube/admin', { action });
				livestreamAdminStatus.textContent = action === 'disconnect' ? 'Disconnected.' : 'Checking YouTube now…';
				window.setTimeout(() => void loadAdmin(), action === 'recheck' ? 3_000 : 0);
			} catch (error) {
				livestreamAdminStatus.textContent = error instanceof Error ? error.message : 'That did not work.';
			} finally {
				button.disabled = false;
			}
		});

		livestreamSelect.addEventListener('change', () => void loadSnapshots(livestreamSelect.value));
		livestreamTable.addEventListener('click', (event) => {
			const id = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-show-broadcast]')?.dataset.showBroadcast : undefined;
			if (!id) return;
			livestreamSelect.value = id;
			void loadSnapshots(id);
			livestreamCard.root.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		});
		livestreamPanel.querySelectorAll<HTMLButtonElement>('[data-export-livestream]').forEach((button) => {
			button.addEventListener('click', () => void downloadFrom(button, '/api/analytics/livestream',
				button.dataset.exportLivestream === 'snapshots' ? { broadcast: livestreamSelect.value } : {}));
		});

		// Back from the Google consent page (/api/youtube/callback): say how it went, once.
		const youtubeResult = new URLSearchParams(location.search).get('youtube');
		if (youtubeResult) {
			livestreamAdminStatus.textContent = youtubeResults[youtubeResult] ?? `Connecting the channel failed (${youtubeResult}).`;
			const cleanUrl = new URL(location.href);
			cleanUrl.searchParams.delete('youtube');
			history.replaceState(null, '', cleanUrl);
		}

		/* ----- Loading ----- */

		const load = async () => {
			status.textContent = 'Loading…';
			try {
				const [listeners, radio, chat, site] = await Promise.all([
					request('/api/analytics/listeners').then((response) => response.json() as Promise<{ records: ListenerRecord[] }>),
					request('/api/analytics/radio').then((response) => response.json() as Promise<RadioSummary>),
					request('/api/analytics/chat').then((response) => response.json() as Promise<ChatSummary>),
					request('/api/analytics/site').then((response) => response.json() as Promise<SiteSummary>),
				]);
				gate.hidden = true;
				toolbar.hidden = false;
				panels.forEach((panel) => { panel.hidden = false; });
				renderListeners(listeners.records);
				renderRadio(radio);
				renderChat(chat);
				renderSite(site);
				void loadWeb();
				status.textContent = `Updated ${new Date().toLocaleTimeString('en-GB')}`;
			} catch (error) {
				if (error instanceof AccessError && error.status === 403) {
					const email = escapeHtml(cmsEmail || auth?.currentUser()?.email || 'this account');
					showGate(`${email} does not have access to the analytics. Give the CMS user with this email the Developer or Digital role, then reload this page.`, { signIn: false });
				} else if (error instanceof AccessError && error.status === 401) {
					showGate(escapeHtml(error.message));
				} else {
					status.textContent = error instanceof Error ? error.message : 'The analytics could not be loaded.';
				}
			}
		};

		fromInput.addEventListener('change', load);
		toInput.addEventListener('change', load);
		fromInput.addEventListener('change', () => void loadLivestream());
		toInput.addEventListener('change', () => void loadLivestream());

		listenerPanel.querySelector<HTMLButtonElement>('[data-export-listeners]')?.addEventListener('click', (event) => {
			void downloadFrom(event.currentTarget as HTMLButtonElement, '/api/analytics/listeners', {});
		});
		radioPanel.querySelectorAll<HTMLButtonElement>('[data-export-radio]').forEach((button) => {
			button.addEventListener('click', () => void downloadFrom(button, '/api/analytics/radio', { table: button.dataset.exportRadio ?? 'sessions' }));
		});
		webPanel.querySelectorAll<HTMLButtonElement>('[data-export-web]').forEach((button) => {
			button.addEventListener('click', () => void downloadFrom(button, '/api/analytics/web', { table: button.dataset.exportWeb ?? 'totals' }));
		});
		sitePanel.querySelectorAll<HTMLButtonElement>('[data-export-site]').forEach((button) => {
			button.addEventListener('click', () => void downloadFrom(button, '/api/analytics/site', { table: button.dataset.exportSite ?? 'vitals' }));
		});
		chatPanel.querySelectorAll<HTMLButtonElement>('[data-export-chat]').forEach((button) => {
			button.addEventListener('click', () => void downloadFrom(button, '/api/analytics/chat', { table: button.dataset.exportChat ?? 'daily' }));
		});

		signInButton.addEventListener('click', async () => {
			if (!auth) return;
			signInButton.disabled = true;
			try {
				await auth.signIn();
			} catch (error) {
				const code = error && typeof error === 'object' && 'code' in error ? error.code : undefined;
				if (code === 'auth/unauthorized-domain') {
					showGate(`Google sign-in is not allowed on ${escapeHtml(location.hostname)} yet. Add it in the Firebase console under Authentication → Settings → Authorized domains, then try again.`);
				} else if (code !== 'auth/popup-closed-by-user' && code !== 'auth/cancelled-popup-request') {
					console.warn('Google sign-in failed:', error);
					showGate(code === 'auth/popup-blocked'
						? 'Your browser blocked the sign-in window. Allow pop-ups for this site and try again.'
						: `Google sign-in failed${typeof code === 'string' ? ` (${escapeHtml(code)})` : ''}. Please try again.`);
				}
			} finally {
				signInButton.disabled = false;
			}
		});

		privateArea.querySelector('[data-sign-out]')?.addEventListener('click', () => { void auth?.signOut(); });

		if (cmsToken) {
			// Signed in by the CMS: no Google sign-in here.
			account.hidden = false;
			accountEmail.textContent = cmsEmail ? `${cmsEmail} (CMS)` : 'CMS user';
			privateArea.querySelector<HTMLElement>('[data-sign-out]')!.hidden = true;
			void load();
			void loadLivestream();
		} else if (isEmbedded) {
			showGate('Open this from the CMS admin (Analytics), which signs you in.', { signIn: false });
		} else {
			signInButton.disabled = true;
			import('../scripts/oz-auth')
				.then(async ({ createOzAuth, isAuthConfigured }) => {
					if (!isAuthConfigured) {
						showGate('Google sign-in is not set up on this site, so the private analytics cannot be shown.', { signIn: false });
						return;
					}
					auth = createOzAuth();
					await auth.ready();
					signInButton.disabled = false;
					auth.onChange((user) => {
						account.hidden = !user;
						accountEmail.textContent = user?.email ?? '';
						if (user) {
							void load();
							void loadLivestream();
						} else {
							hideLivestream();
						}
						if (!user) showGate('Listener forms, radio listening, chat and site analytics are private. Sign in with a Google account that has analytics access.');
					});
				})
				.catch(() => showGate('Google sign-in could not be loaded. Please reload the page.', { signIn: false }));
		}
	}

	/* ---------- Campaign links ---------- */

	// Builds links with UTM parameters for social posts. GA treats "Instagram" and "instagram" as two sources, so
	// every part is normalised the same way: lowercase, words joined by hyphens.
	const campaignPanel = document.querySelector<HTMLElement>('[data-campaign-panel]');
	if (campaignPanel) {
		type CampaignLink = { createdAt: string; url: string; page: string; source: string; medium: string; campaign: string; content: string };

		const siteUrl = campaignPanel.dataset.siteUrl ?? location.origin;
		const form = campaignPanel.querySelector<HTMLFormElement>('[data-campaign-form]')!;
		const output = campaignPanel.querySelector<HTMLOutputElement>('[data-campaign-url]')!;
		const copyButton = campaignPanel.querySelector<HTMLButtonElement>('[data-campaign-copy]')!;
		const list = campaignPanel.querySelector<HTMLElement>('[data-campaign-list]')!;
		const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
		const storageKey = 'oz-campaign-links';
		const created = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });

		const slug = (value: string) => value.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

		// Accepts a path ("/oz-bandung") or a full link to this site, and keeps any #section.
		const pagePath = (value: string) => {
			try {
				const url = new URL(value.trim() || '/', siteUrl);
				return url.origin === new URL(siteUrl).origin ? `${url.pathname}${url.hash}` : null;
			} catch {
				return null;
			}
		};

		let links: CampaignLink[] = [];
		try {
			links = JSON.parse(localStorage.getItem(storageKey) ?? '[]');
		} catch {}
		const saveLinks = () => {
			try {
				localStorage.setItem(storageKey, JSON.stringify(links));
			} catch {}
		};

		let current: CampaignLink | null = null;
		const build = () => {
			const path = pagePath(field('page').value);
			const source = slug(field('source').value);
			const campaign = slug(field('campaign').value);
			const medium = field('medium').value;
			const content = field('content').value;
			if (!path) {
				current = null;
				output.textContent = `The page must be on ${new URL(siteUrl).host}.`;
			} else if (!source || !campaign) {
				current = null;
				output.textContent = !source ? 'Pick where the link will be posted.' : 'Give the campaign a name to get its link.';
			} else {
				const [pathname, hash = ''] = path.split('#');
				const url = new URL(pathname, siteUrl);
				url.searchParams.set('utm_source', source);
				url.searchParams.set('utm_medium', medium);
				url.searchParams.set('utm_campaign', campaign);
				if (content) url.searchParams.set('utm_content', content);
				url.hash = hash;
				current = { createdAt: new Date().toISOString(), url: url.href, page: path, source, medium, campaign, content };
				output.textContent = url.href;
			}
			copyButton.disabled = !current;
		};

		const renderLinks = () => {
			list.innerHTML = links.length
				? `<table><thead><tr>${['Copied', 'Campaign', 'Source', 'Medium', 'Placement', 'Link', ''].map((heading) => `<th scope="col">${heading}</th>`).join('')}</tr></thead><tbody>${links.map((link, index) => `<tr>${[
					created.format(new Date(link.createdAt)),
					link.campaign,
					link.source,
					link.medium,
					link.content || '—',
					link.url,
				].map((cell) => `<td>${escapeHtml(cell)}</td>`).join('')}<td><button class="campaign-remove" type="button" data-remove="${index}">Remove</button></td></tr>`).join('')}</tbody></table>`
				: '';
		};

		// Picking a known source sets its usual medium.
		field('source').addEventListener('input', () => {
			const option = form.querySelector<HTMLOptionElement>(`#campaign-sources option[value="${CSS.escape(slug(field('source').value))}"]`);
			if (option?.dataset.medium) field('medium').value = option.dataset.medium;
		});
		form.addEventListener('input', build);
		form.addEventListener('change', build);
		form.addEventListener('submit', (event) => event.preventDefault());

		copyButton.addEventListener('click', async () => {
			if (!current) return;
			try {
				await navigator.clipboard.writeText(current.url);
				copyButton.textContent = 'Copied';
			} catch {
				copyButton.textContent = 'Copy failed: select the link instead';
			}
			window.setTimeout(() => { copyButton.textContent = 'Copy link'; }, 2000);
			links = [current, ...links.filter((link) => link.url !== current!.url)].slice(0, 200);
			saveLinks();
			renderLinks();
		});

		list.addEventListener('click', (event) => {
			const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-remove]') : null;
			if (!button) return;
			links.splice(Number(button.dataset.remove), 1);
			saveLinks();
			renderLinks();
		});

		campaignPanel.querySelector('[data-export-campaigns]')?.addEventListener('click', () => {
			downloadCsv('campaign-links', ['Copied at (UTC)', 'Link', 'Page', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content'],
				links.map((link) => [link.createdAt, link.url, link.page, link.source, link.medium, link.campaign, link.content]));
		});

		build();
		renderLinks();
	}
</script>
