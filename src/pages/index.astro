---
import { Font } from 'astro:assets';
import '../styles/typography.css';
import '../styles/page-transitions.css';
const locations = [
	{ name: 'Bandung', href: '/oz-bandung/', logo: '/images/logo-oz-bandung.png', transitionName: 'oz-bandung-logo' },
	{ name: 'Bali', href: '/oz-bali/', logo: '/images/logo-oz-bali.png' },
];
---

<!doctype html>
<html lang="en" data-page="home">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#FFFFF3" />
		<meta name="description" content="Location select for OZ Radio" />
		<Font cssVariable="--font-tango" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-jakarta" preload={[{ style: 'normal' }]} />
		<title>OZ Radio — Choose your frequency</title>
		<script type="speculationrules" is:inline set:html={JSON.stringify({ prefetch: [{ where: { href_matches: '/oz-bandung/' }, eagerness: 'moderate' }] })} />
	</head>
	<body>
		<main class="landing">
			<section class="chooser" aria-labelledby="page-title">
				<h1 id="page-title"><img src="/images/logo-oz-media.png" alt="OZ Media" /></h1>
				<p class="intro">Where music meets stories, content meets community, and ideas become experiences beyond the airwaves.</p>
				
				<nav class="locations" aria-label="Choose a location">
					{locations.map((location) => (
						<div class="location-item">
							<a class="location-link" href={location.href} aria-label={`OZ Radio ${location.name}`}>
								<img class="location-logo" src={location.logo} alt="" width="1246" height="648" style={location.transitionName && `view-transition-name: ${location.transitionName}`} />
							</a>
						</div>
					))}
				</nav>
			</section>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		background: #FFFFF3;
		color: #000000;
		font-family: var(--font-jakarta);
	}

	:global(a) {
		color: inherit;
	}

	.landing {
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		padding: 64px clamp(20px, 5vw, 64px) 22px;
	}

	.topbar,
	.footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}

	.topbar {
		position: fixed;
		z-index: 1000;
		top: 0;
		left: 0;
		width: 100%;
		height: 64px;
		min-height: 64px;
		padding: 0 clamp(20px, 5vw, 64px);
		border-bottom: 1px solid #D8D8CC;
		background: #FFFFF3;
	}

	.topbar-nav {
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 4px;
		margin-left: auto;
	}

	.topbar-nav-link {
		min-height: 32px;
		display: inline-flex;
		align-items: center;
		padding: 0 9px;
		border: 1px solid transparent;
		border-radius: 3px;
		color: #77776F;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		white-space: nowrap;
		transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
	}

	.topbar-nav-link:hover,
	.topbar-nav-link:focus-visible {
		border-color: #D8D8CC;
		color: #000000;
		transform: translateY(-1px);
	}

	.topbar,
	.footer {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.wordmark {
		font-size: 25px;
		font-weight: 900;
		letter-spacing: -0.06em;
		text-decoration: none;
		flex: 0 0 auto;
	}

	.wordmark img {
		display: block;
		width: 88px;
		height: auto;
	}

	.wordmark span {
		color: #f2bd57;
	}

	.footer {
		color: #77776F;
	}

	.chooser {
		width: min(820px, 100%);
		margin: auto;
		padding: 70px 0 90px;
		text-align: center;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 9px;
		margin: 0 0 22px;
		color: #707068;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.live-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #f2bd57;
		box-shadow: 0 0 0 4px rgb(242 189 87 / 12%);
	}

	h1 {
		margin: 0;
	}

	h1 img {
		display: block;
		width: min(100%, 520px);
		height: auto;
		margin: 0 auto;
	}

	.intro {
		margin: 24px 0 38px;
		color: #77776F;
		font-size: 20px;
		line-height: 1.6;
	}

	.locations {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: center;
		gap: 0;
	}

	.location-item {
		position: relative;
		min-width: 0;
		padding: 20px;
	}

	.location-item:first-child::after {
		position: absolute;
		top: 50%;
		right: 0;
		width: 1px;
		height: 120px;
		background: #D8D8CC;
		content: '';
		transform: translateY(-50%);
	}

	.location-link {
		display: flex;
		min-height: 150px;
		align-items: center;
		justify-content: center;
		text-decoration: none;
	}

	.location-link:focus-visible {
		border-radius: 3px;
		outline: 2px solid #f2bd57;
		outline-offset: 4px;
	}

	.location-logo {
		display: block;
		/* Box matches the logos' shared aspect ratio so the Bandung logo morphs without distortion. */
		width: min(100%, 288px);
		height: auto;
		aspect-ratio: 1246 / 648;
		transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.location-link:hover .location-logo,
	.location-link:focus-visible .location-logo {
		transform: scale(1.2) rotate(-1deg);
	}

	.footer {
		padding-top: 16px;
		border-top: 1px solid #D8D8CC;
		font-size: 9px;
	}

	@media (max-width: 560px) {
		.landing {
			padding: 64px 18px 18px;
		}

		.topbar {
			height: 56px;
			min-height: 56px;
			padding: 0 16px;
			gap: 8px;
		}

		.topbar-nav {
			flex: 1;
			gap: 2px;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.topbar-nav::-webkit-scrollbar {
			display: none;
		}

		.topbar-nav-link {
			min-height: 32px;
			padding: 0 5px;
			font-size: 7px;
		}

		.chooser {
			padding: 68px 0;
		}

		.locations {
			grid-template-columns: 1fr;
		}

		.location-item:first-child::after {
			top: auto;
			right: 25%;
			bottom: 0;
			width: 50%;
			height: 1px;
		}

		.footer span:nth-child(2) {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.location-logo {
			transition: none;
		}
	}
</style>
