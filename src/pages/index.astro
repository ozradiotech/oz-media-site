---
import { Font } from 'astro:assets';
import '../styles/typography.css';
import '../styles/page-transitions.css';
import '../styles/retro.css';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
const locations = [
	{ name: 'Bandung', href: '/oz-bandung/', logo: '/images/logo-oz-bandung.png', transitionName: 'oz-bandung-logo' },
	{ name: 'Bali', href: '/oz-bali/', logo: '/images/logo-oz-bali.png' },
];
---

<!doctype html>
<html lang="en" data-page="home">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<ThemeHead />
		<meta name="description" content="Location select for OZ Radio" />
		<Font cssVariable="--font-tango" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-jakarta" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-mono" />
		<title>OZ Radio — Choose your frequency</title>
		<script type="speculationrules" is:inline set:html={JSON.stringify({ prefetch: [{ where: { href_matches: '/oz-bandung/' }, eagerness: 'moderate' }] })} />
	</head>
	<body>
		<div class="landing-bg" aria-hidden="true">
			<!-- Cover-fit: on portrait screens the image is sized by height, so it needs ~1.5× the viewport height in width. -->
			<img
				class="landing-bg-photo"
				src="/images/index-bg-1600.webp"
				srcset="/images/index-bg-960.webp 960w, /images/index-bg-1600.webp 1600w, /images/index-bg-2400.webp 2400w"
				sizes="max(100vw, 150svh)"
				width="4918"
				height="3281"
				alt=""
				fetchpriority="high"
			/>
			<canvas class="landing-wave" data-landing-wave></canvas>
		</div>
		<div class="landing-switch"><ThemeSwitch /></div>
		<main class="landing">
			<section class="chooser" aria-labelledby="page-title">
				<h1 id="page-title" data-sticker><img src="/images/logo-oz-media.png" alt="OZ Media" /></h1>
				<p class="intro">OZ MEDIA AND BEYOND</p>

				<nav class="locations" aria-label="Choose a location">
					{locations.map((location) => (
						<div class="location-item">
							<a class="location-link" data-sticker href={location.href} aria-label={`OZ Radio ${location.name}`}>
								<img class="location-logo" src={location.logo} alt="" width="1246" height="648" style={location.transitionName && `view-transition-name: ${location.transitionName}`} />
							</a>
						</div>
					))}
				</nav>
			</section>
		</main>
	</body>
</html>

<script>
	// Ribbon wave along the bottom of the page (modelled on index-bg-design-guide/wave.png). Each ribbon is the area
	// between two curves of one continuous wave field, so ribbons pinch and swell where the lines bunch together.
	const canvas = document.querySelector<HTMLCanvasElement>('[data-landing-wave]');
	const ctx = canvas?.getContext('2d');

	if (canvas && ctx) {
		const RIBBONS = 24;
		const STEP = 8; // CSS px between sampled points
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
		let width = 0;
		let height = 0;
		let gradient: CanvasGradient | undefined;

		const resize = () => {
			const dpr = Math.min(devicePixelRatio || 1, 2);
			width = canvas.clientWidth;
			height = canvas.clientHeight;
			if (!width || !height) return;
			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			gradient = ctx.createLinearGradient(0, 0, width, 0);
			gradient.addColorStop(0, '#f5b117');
			gradient.addColorStop(1, '#fa8010');
		};

		// y of wave line u (0 = top line, RIBBONS = bottom line) at x, time t in seconds.
		const waveY = (u: number, x: number, t: number) => {
			const depth = u / RIBBONS;
			const top = height * 0.3;
			const base = top + depth * (height - top);
			// Hills are tallest on the top lines and flatten out towards the bottom edge.
			const amp = height * 0.2 * (1 - depth) ** 1.4 + height * 0.01;
			const k = (Math.PI * 2) / Math.max(width, 900);
			const shape =
				0.62 * Math.sin(x * k * 1.15 + t * 0.22 + u * 0.09) +
				0.38 * Math.sin(x * k * 2.3 - t * 0.17 + 1.4 + u * 0.05);
			const bob = Math.sin(t * 0.5 + u * 0.12) * height * 0.025 * (1 - depth);
			return base + amp * shape + bob;
		};

		const draw = (time: number) => {
			if (!gradient) return;
			const t = time / 1000;
			ctx.clearRect(0, 0, width, height);
			ctx.fillStyle = gradient;
			ctx.beginPath();
			for (let i = 0; i < RIBBONS; i++) {
				const lastX = width + STEP;
				for (let x = -STEP; x <= lastX; x += STEP) {
					const y = waveY(i, x, t);
					x === -STEP ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
				}
				// Ribbons are a little thicker on the left, like the reference.
				for (let x = lastX; x >= -STEP; x -= STEP) {
					ctx.lineTo(x, waveY(i + 0.58 - 0.16 * (x / width), x, t));
				}
				ctx.closePath();
			}
			ctx.fill();
		};

		let frame = 0;
		const loop = (time: number) => {
			draw(time);
			frame = requestAnimationFrame(loop);
		};
		const start = () => {
			cancelAnimationFrame(frame);
			if (reduceMotion.matches) draw(0);
			else frame = requestAnimationFrame(loop);
		};

		new ResizeObserver(() => {
			resize();
			if (reduceMotion.matches) draw(0);
		}).observe(canvas);
		reduceMotion.addEventListener('change', start);
		resize();
		start();
	}
</script>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		background: var(--paper-grain), var(--c-bg);
		color: var(--c-text);
		font-family: var(--font-jakarta);
	}

	:global(a) {
		color: inherit;
	}

	/* Fixed studio photo, a theme-tinted scrim for legibility, then the wave over the bottom of the page. */
	.landing-bg {
		position: fixed;
		z-index: 0;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.landing-bg-photo,
	.landing-bg::after,
	.landing-wave {
		position: absolute;
		display: block;
	}

	.landing-bg-photo {
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 55%;
	}

	.landing-bg::after {
		z-index: 1;
		inset: 0;
		background:
			var(--paper-grain),
			radial-gradient(ellipse 70% 60% at 50% 40%, rgb(255 255 243 / 86%), rgb(255 255 243 / 64%));
		content: '';
	}

	.landing-wave {
		z-index: 2;
		right: 0;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 58svh;
	}

	.landing {
		position: relative;
		z-index: 1;
		min-height: 100svh;
		display: flex;
		overflow: clip;
		flex-direction: column;
		padding: 64px clamp(20px, 5vw, 64px) 22px;
	}

	.topbar,
	.footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}

	.topbar {
		position: fixed;
		z-index: 1000;
		top: 0;
		left: 0;
		width: 100%;
		height: 64px;
		min-height: 64px;
		padding: 0 clamp(20px, 5vw, 64px);
		border-bottom: 1px solid var(--c-line);
		background: var(--c-surface);
	}

	.topbar-nav {
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 4px;
		margin-left: auto;
	}

	.topbar-nav-link {
		min-height: 32px;
		display: inline-flex;
		align-items: center;
		padding: 0 9px;
		border: 1px solid transparent;
		border-radius: 3px;
		color: var(--c-muted);
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		white-space: nowrap;
		transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
	}

	.topbar-nav-link:hover,
	.topbar-nav-link:focus-visible {
		border-color: var(--c-line);
		color: var(--c-text);
		transform: translateY(-1px);
	}

	.topbar,
	.footer {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.wordmark {
		font-size: 25px;
		font-weight: 900;
		letter-spacing: -0.06em;
		text-decoration: none;
		flex: 0 0 auto;
	}

	.wordmark img {
		display: block;
		width: 88px;
		height: auto;
	}

	.wordmark span {
		color: var(--c-accent);
	}

	.footer {
		color: var(--c-muted);
	}

	.chooser {
		width: min(820px, 100%);
		margin: auto;
		padding: 70px 0 90px;
		text-align: center;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 9px;
		margin: 0 0 22px;
		color: #707068;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.live-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--c-accent);
		box-shadow: 0 0 0 4px rgb(242 189 87 / 12%);
	}

	h1 {
		margin: 0;
	}

	h1 img {
		display: block;
		width: min(100%, 520px);
		height: auto;
		margin: 0 auto;
	}

	.intro {
		margin: 24px 0 38px;
		color: var(--c-text-2);
		font-size: 20px;
		line-height: 1.6;
	}

	.locations {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: center;
		gap: 0;
	}

	.location-item {
		position: relative;
		min-width: 0;
		padding: 20px;
	}

	.location-item:first-child::after {
		position: absolute;
		top: 50%;
		right: 0;
		width: 1px;
		height: 120px;
		background: var(--c-line);
		content: '';
		transform: translateY(-50%);
	}

	/* White die-cut edge so the gold logos stand off the matching wave (also feeds the night [data-sticker] rule). */
	.location-link {
		--sticker-edge: #fff;
		--sticker-width: 3px;

		display: flex;
		min-height: 150px;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		filter:
			drop-shadow(var(--sticker-width) 0 0 var(--sticker-edge))
			drop-shadow(calc(var(--sticker-width) * -1) 0 0 var(--sticker-edge))
			drop-shadow(0 var(--sticker-width) 0 var(--sticker-edge))
			drop-shadow(0 calc(var(--sticker-width) * -1) 0 var(--sticker-edge));
	}

	.location-link:focus-visible {
		border-radius: 3px;
		outline: 2px solid var(--c-accent);
		outline-offset: 4px;
	}

	.location-logo {
		display: block;
		/* Box matches the logos' shared aspect ratio so the Bandung logo morphs without distortion. */
		width: min(100%, 288px);
		height: auto;
		aspect-ratio: 1246 / 648;
		transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.location-link:hover .location-logo,
	.location-link:focus-visible .location-logo {
		transform: scale(1.2) rotate(-1deg);
	}

	.footer {
		padding-top: 16px;
		border-top: 1px solid var(--c-line);
		font-size: 9px;
	}

	@media (max-width: 560px) {
		.landing {
			padding: 64px 18px 18px;
		}

		.topbar {
			height: 56px;
			min-height: 56px;
			padding: 0 16px;
			gap: 8px;
		}

		.topbar-nav {
			flex: 1;
			gap: 2px;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.topbar-nav::-webkit-scrollbar {
			display: none;
		}

		.topbar-nav-link {
			min-height: 32px;
			padding: 0 5px;
			font-size: 7px;
		}

		.chooser {
			padding: 68px 0;
		}

		.locations {
			grid-template-columns: 1fr;
		}

		.location-item:first-child::after {
			top: auto;
			right: 25%;
			bottom: 0;
			width: 50%;
			height: 1px;
		}

		.footer span:nth-child(2) {
			display: none;
		}
	}

	.landing-switch {
		position: fixed;
		z-index: 10;
		top: 12px;
		right: clamp(10px, 3vw, 28px);
	}

	/* Night Shift style (tokens in src/styles/themes.css). */
	:global(:root[data-theme='night'] body) {
		background: var(--c-bg);
	}

	:global(:root[data-theme='night']) .landing-bg::after {
		background: radial-gradient(ellipse 70% 60% at 50% 40%, rgb(14 13 11 / 82%), rgb(14 13 11 / 55%));
	}

	:global(:root[data-theme='night']) .landing {
		isolation: isolate;
		background: radial-gradient(closest-side at 50% 40%, rgb(242 189 87 / 14%), transparent 80%);
	}

	/* Broadcast rings behind the chooser and monitor scanlines over the page. */
	:global(:root[data-theme='night']) .landing::before,
	:global(:root[data-theme='night']) .landing::after {
		position: absolute;
		z-index: -1;
		pointer-events: none;
		content: '';
	}

	:global(:root[data-theme='night']) .landing::before {
		top: 40%;
		left: 50%;
		width: min(150vmin, 1200px);
		aspect-ratio: 1;
		background: repeating-radial-gradient(circle, transparent 0 54px, rgb(242 189 87 / 9%) 54px 55px);
		-webkit-mask-image: radial-gradient(circle, #000 20%, transparent 68%);
		mask-image: radial-gradient(circle, #000 20%, transparent 68%);
		translate: -50% -50%;
		animation: night-rings 5s ease-in-out infinite alternate;
	}

	:global(:root[data-theme='night']) .landing::after {
		inset: 0;
		background: repeating-linear-gradient(to bottom, rgb(255 255 255 / 2.2%) 0 1px, transparent 1px 3px);
	}

	:global(:root[data-theme='night']) .intro {
		color: var(--c-accent);
		font-family: var(--font-mono);
		letter-spacing: 0.24em;
		text-shadow: 0 0 18px rgb(242 189 87 / 40%);
	}

	:global(:root[data-theme='night']) .location-item:first-child::after {
		background: linear-gradient(transparent, var(--c-line), transparent);
	}

	@keyframes night-rings {
		from { opacity: 1; scale: 1; }
		to { opacity: 0.45; scale: 1.1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.location-logo {
			transition: none;
		}

		:global(:root[data-theme='night']) .landing::before {
			animation: none;
		}
	}
</style>
