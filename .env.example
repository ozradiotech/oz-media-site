# Copy to .env and fill in. Never commit .env. Values here are placeholders.

# ---------- Firebase (Google sign-in and the live chat) ----------
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_DATABASE_URL=
# Optional: App Check (reCAPTCHA Enterprise site key).
PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# The service-account key file's JSON, on one line, in single quotes.
FIREBASE_SERVICE_ACCOUNT=
CRON_SECRET=

# ---------- Analytics ----------
PUBLIC_GA_MEASUREMENT_ID=
GA_PROPERTY_ID=
ANALYTICS_SALT=

# ---------- Payload CMS ----------
CMS_URL=http://localhost:3000
CMS_API_KEY=
SITE_URL=http://127.0.0.1:4321

# ---------- YouTube live chat sync (experimental, docs/youtube-unified-chat.md) ----------
# Off unless the client id, secret and encryption key are all set. YOUTUBE_SYNC=off turns it off with them set.
YOUTUBE_SYNC=on
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional. Defaults to SITE_URL + /api/youtube/callback; must match the client's authorized redirect URI exactly.
YOUTUBE_REDIRECT_URI=
# 32 random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Encrypts the stored refresh token. Changing it means connecting the channel again.
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# Optional: only this channel may be connected (the OZ Radio channel id, UC…).
YOUTUBE_CHANNEL_ID=
# Seconds. Defaults shown.
YOUTUBE_BROADCAST_CHECK_INTERVAL=120
YOUTUBE_VIEWER_COUNT_REFRESH_INTERVAL=60
YOUTUBE_CHAT_POLL_MIN_INTERVAL=10
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_OUTBOUND_PER_MINUTE=20
WEBSITE_VIEWER_HEARTBEAT_INTERVAL=20
WEBSITE_VIEWER_SESSION_TTL=60
LIVESTREAM_SNAPSHOT_INTERVAL=300
