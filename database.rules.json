{
	"rules": {
		".read": false,
		".write": false,
		"chat": {
			"rooms": {
				"$room": {
					"messages": {
						".read": "query.orderByKey == true && query.limitToLast <= 100",
						".indexOn": ["ts", "u"]
					},
					"meta": {
						".read": true
					}
				}
			},
			"private": {
				"users": {
					".indexOn": ["last"]
				}
			}
		}
	}
}
